<file path="src/styles/global.css">
/* Tokeny z Asseco Design System (project/tokens.json) */
@font-face {
  font-family: 'Geomanist';
  src: url('/fonts/geomanist-regular.woff2') format('woff2');
  font-weight: 300 500;
  font-style: normal;
  font-display: swap;
}

:root {
  /* Kolory */
  --c-ink: #01080F;          /* u-black */
  --c-white: #FFFFFF;
  --c-accent: #1D9BF0;       /* u-blue: tylko tło przycisków i znaczniki, nie tekst */
  --c-link: #0066CC;         /* dark-blue: linki, kontrast 5.6:1 */
  --c-bright: #66CCFF;       /* bright-blue: akcent na ciemnym tle */
  --c-tint: #D9ECFD;         /* light-blue */
  --c-gray-100: #F9F9F9;
  --c-gray-200: #F1F1F1;
  --c-gray-300: #E2E2E2;     /* obramowanie pól */
  --c-gray-400: #DEDEDE;     /* obramowanie kart */
  --c-ok: #007B28;
  --c-ink-70: rgba(1, 8, 15, 0.7);
  --c-ink-10: rgba(1, 8, 15, 0.1);
  --c-white-70: rgba(255, 255, 255, 0.7);
  --c-white-20: rgba(255, 255, 255, 0.2);
  --c-ink-20: rgba(1, 8, 15, 0.2);
  --c-ink-75: rgba(1, 8, 15, 0.75);
  --c-ink-80: rgba(1, 8, 15, 0.8);
  --c-ink-85: rgba(1, 8, 15, 0.85);

  /* Kolory stałe – nie zmieniają się w trybie ciemnym (tekst na akcencie, etykiety na zdjęciach) */
  --c-black: #01080F;
  --c-paper: #FFFFFF;
  --c-photo-bg: #F1F1F1;       /* tło pod zdjęciem produktu; najlepiej wyglądają zdjęcia z przezroczystym tłem */

  /* Stany i komunikaty */
  --c-warn-bg: #FFF4D6;
  --c-warn-ink: #7A4B00;
  --c-ok-bg: #E3F5E8;
  --c-err: #B3261E;
  --c-err-bg: #FBE4E0;
  --c-star: #E0A100;
  --c-star-ink: #B07D00;
  --c-header-bg: rgba(255, 255, 255, 0.92);
  --c-dark-section: var(--c-ink);

  color-scheme: light;

  /* Typografia */
  --font: 'Geomanist', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Arial, sans-serif;
  --fs-h1: clamp(2.375rem, 4.5vw, 4.1875rem);   /* 38 → 67 px */
  --fs-h2: clamp(2.25rem, 3.6vw, 3.5rem);       /* 36 → 56 px */
  --fs-h3: clamp(1.75rem, 2.6vw, 2.5rem);       /* 28 → 40 px */
  --fs-h4: 1.4375rem;                            /* 23 px */
  --fs-lead: 1.25rem;                            /* 20 px */
  --fs-body: 1rem;
  --fs-small: 0.875rem;

  /* Odstępy: jednostka 12 / 24 px */
  --s-1: 12px; --s-2: 24px; --s-3: 36px; --s-4: 48px; --s-6: 72px; --s-8: 96px;
  --section-y: clamp(56px, 7vw, 92px);
  --container: 1280px;

  /* Promienie: tylko te z design systemu */
  --r-field: 8px;
  --r-search: 4px;
  --r-pill: 300px;
}

/* Tryb ciemny: atrybut data-theme ustawia skrypt w <head> (wybór klienta albo ustawienie systemu).
   Ink i white zamieniają się rolami: ink = kolor tekstu, white = tło strony. */
:root[data-theme='dark'] {
  --c-ink: #EAF1F7;
  --c-white: #01080F;
  --c-link: #6CC0FF;
  --c-bright: #66CCFF;
  --c-tint: #0B2236;
  --c-gray-100: #08121C;
  --c-gray-200: #0E1A26;
  --c-gray-300: #2A3846;
  --c-gray-400: #1E2B37;
  --c-ok: #4CC27A;
  --c-ink-70: rgba(234, 241, 247, 0.7);
  --c-ink-10: rgba(234, 241, 247, 0.12);
  --c-ink-20: rgba(234, 241, 247, 0.22);
  --c-ink-75: rgba(234, 241, 247, 0.75);
  --c-ink-80: rgba(234, 241, 247, 0.8);
  --c-ink-85: rgba(234, 241, 247, 0.85);
  --c-photo-bg: #0E1A26;       /* zdjęcia z przezroczystym tłem (PNG/WebP) leżą na ciemnej karcie */
  --c-warn-bg: #2B2211;
  --c-warn-ink: #F2C46B;
  --c-ok-bg: #0F2A1A;
  --c-err: #FF8A7A;
  --c-err-bg: #33120D;
  --c-star-ink: #E8B23A;
  --c-header-bg: rgba(1, 8, 15, 0.88);
  --c-dark-section: #0B1824;
  color-scheme: dark;
}

*, *::before, *::after { box-sizing: border-box; }

html { -webkit-text-size-adjust: 100%; scroll-behavior: smooth; }
@media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }

body {
  margin: 0;
  font-family: var(--font);
  font-size: var(--fs-body);
  line-height: 1.5;
  letter-spacing: 0.01em;
  color: var(--c-ink);
  background: var(--c-white);
}

h1, h2, h3, h4 { margin: 0; font-weight: 300; line-height: 1.15; letter-spacing: -0.01em; }
h1 { font-size: var(--fs-h1); letter-spacing: -0.015em; }
h2 { font-size: var(--fs-h2); }
h3 { font-size: var(--fs-h4); font-weight: 400; }
p { margin: 0; }
img { max-width: 100%; height: auto; display: block; }  /* height: auto – aspect-ratio z CSS wygrywa z atrybutem height */
[hidden] { display: none !important; }

a { color: var(--c-link); transition: opacity 150ms ease; }
a:hover { opacity: 0.7; }
:focus-visible { outline: 2px solid var(--c-link); outline-offset: 3px; }

.container { max-width: var(--container); margin: 0 auto; padding-inline: var(--s-2); }
.section { padding-block: var(--section-y); }
.section--tint { background: var(--c-gray-100); }
.section--dark { background: var(--c-dark-section); color: var(--c-paper); }
.lead { font-size: var(--fs-lead); color: var(--c-ink-70); max-width: 34rem; }
.section--dark .lead { color: var(--c-white-70); }
.muted { color: var(--c-ink-70); }

/* Przyciski */
.btn {
  display: inline-flex; align-items: center; justify-content: center; gap: 12px;
  min-height: 52px; padding: 0 28px; border: 0; border-radius: var(--r-pill);
  font: inherit; font-size: 1rem; text-decoration: none; cursor: pointer;
  background: var(--c-ink); color: var(--c-white);
  transition: opacity 150ms ease;
}
.btn:hover { opacity: 0.7; }
.btn--accent { background: var(--c-accent); color: var(--c-black); }
.btn--ghost { background: transparent; color: inherit; box-shadow: inset 0 0 0 1px currentColor; }
.btn--lg { min-height: 56px; padding: 0 32px; font-size: 1.125rem; }

.link-arrow { display: inline-flex; align-items: center; gap: 12px; font-size: 1.125rem; color: inherit; text-decoration: none; }

/* Pola formularzy */
.field { display: flex; flex-direction: column; gap: 8px; font-size: var(--fs-small); }
.input {
  height: 52px; padding: 0 16px; border: 0; border-radius: var(--r-field);
  box-shadow: inset 0 0 0 1px var(--c-gray-300); font: inherit; font-size: 1rem; background: var(--c-white); color: var(--c-ink);
}
.input:focus { box-shadow: inset 0 0 0 1px var(--c-ink); outline: none; }

/* Zdjęcie zastępcze do czasu podmiany na packshoty */
.ph {
  display: flex; align-items: center; justify-content: center; text-align: center;
  padding: var(--s-2); background: var(--c-gray-300); color: var(--c-ink-70); font-size: var(--fs-small);
}

.sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

/* Nagłówek podstrony */
.page-hero { padding-block: var(--s-6) var(--s-4); }
.page-hero__inner { display: flex; flex-direction: column; gap: var(--s-2); }
.crumbs { font-size: var(--fs-small); color: var(--c-ink-70); }
.crumbs a { color: var(--c-ink-75); }

/* Przełączniki w formie pigułek (filtry, wybór tematu) */
.pill-group { display: flex; flex-wrap: wrap; gap: 10px; }
.pill {
  min-height: 44px; padding: 0 22px; border: 0; border-radius: var(--r-pill);
  background: transparent; color: var(--c-ink); box-shadow: inset 0 0 0 1px var(--c-ink);
  font: inherit; font-size: 1rem; cursor: pointer; display: inline-flex; align-items: center; gap: 6px;
}
.pill[aria-pressed='true'], .pill:has(input:checked) { background: var(--c-ink); color: var(--c-white); }
.pill input { position: absolute; opacity: 0; pointer-events: none; }
.pill:has(input:focus-visible) { outline: 2px solid var(--c-link); outline-offset: 3px; }

/* Akordeon na <details> */
.acc { box-shadow: inset 0 0 0 1px var(--c-gray-400); background: var(--c-white); }
.acc summary { list-style: none; cursor: pointer; min-height: 72px; padding: var(--s-2) 32px; display: flex; justify-content: space-between; align-items: center; gap: var(--s-2); font-size: 1.25rem; line-height: 1.3; }
.acc summary::-webkit-details-marker { display: none; }
.acc summary::after { content: '+'; font-size: 1.75rem; font-weight: 300; flex-shrink: 0; }
.acc[open] summary::after { content: '−'; }
.acc__body { padding: 0 32px 32px; max-width: 640px; color: var(--c-ink-75); font-size: 1.0625rem; line-height: 1.6; display: flex; flex-direction: column; gap: var(--s-1); }

/* Zdjęcie produktu z etykietą dostępności (karty, strona produktu, koszyk) */
.media { position: relative; display: block; }
.media img { background: var(--c-photo-bg); }
.media--out_of_stock img { filter: grayscale(1); opacity: 0.6; }
.p-badge {
  position: absolute; top: 12px; left: 12px; z-index: 1; max-width: calc(100% - 24px);
  padding: 6px 12px; border-radius: var(--r-pill); font-size: 0.8125rem; line-height: 1.2;
  background: var(--c-accent); color: var(--c-black);
}
.p-badge--out_of_stock { background: var(--c-black); color: var(--c-paper); }

/* Tagi produktu */
.p-tags { display: flex; flex-wrap: wrap; gap: 6px; list-style: none; margin: 0; padding: 0; }
.p-tag { display: inline-flex; align-items: center; min-height: 28px; padding: 0 12px; border-radius: var(--r-pill); background: var(--c-tint); color: var(--c-ink); font-size: 0.8125rem; line-height: 1.2; }

/* Animacja „leci do koszyka” (lib/cart-fx.ts) */
.fly { border-radius: 50%; overflow: hidden; background: var(--c-photo-bg); box-shadow: 0 6px 24px rgba(1, 8, 15, 0.25), 0 0 0 2px var(--c-accent); }
.fly img { width: 100%; height: 100%; object-fit: contain; padding: 6px; }
</file>

<file path="src/layouts/Base.astro">
---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;     // strony z danymi zamówienia – zawsze poza Google
  noReferrer?: boolean;  // adres strony zawiera identyfikator zamówienia – nie przekazujemy go dalej
}
const { title, description, noindex = false, noReferrer = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, 'https://can-c.pl');
---
<!doctype html>
<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Motyw przed pierwszym malowaniem strony (bez mignięcia jasnego tła): wybór klienta albo ustawienie systemu -->
    <script is:inline>
      (function () {
        var t = null;
        try { t = localStorage.getItem('canc-theme'); } catch (e) {}
        var dark = t ? t === 'dark' : window.matchMedia && matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.dataset.theme = dark ? 'dark' : 'light';
      })();
    </script>
    <meta name="color-scheme" content="light dark" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <!-- Do startu sklepu staging nie może trafić do Google. W dniu startu: zmienna builda PUBLIC_SITE_INDEXABLE=true -->
    {(noindex || import.meta.env.PUBLIC_SITE_INDEXABLE !== 'true') && <meta name="robots" content="noindex, nofollow" />}
    {noReferrer && <meta name="referrer" content="no-referrer" />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pl_PL" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <link rel="preload" href="/fonts/geomanist-regular.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <a class="skip" href="#tresc">Przejdź do treści</a>
    <Header />
    <main id="tresc">
      <slot />
    </main>
    <Footer />
    <script>
      // Aktualne dane sklepu z panelu admina (kontakt, firma) – podmiana w oznaczonych miejscach strony
      type SiteData = Record<string, string>;
      const KEY = 'canc-site-v1';
      const apply = (s: SiteData) => {
        document.querySelectorAll<HTMLElement>('[data-site]').forEach((el) => {
          const v = s[el.dataset.site!];
          if (typeof v !== 'string') return;
          if (v) { el.textContent = v; el.hidden = false; }
          else if (el.hasAttribute('data-site-hide-empty')) el.hidden = true;
        });
        document.querySelectorAll<HTMLElement>('[data-notice]').forEach((el) => { el.hidden = !(s as any).noticeActive; });
        document.querySelectorAll<HTMLAnchorElement>('[data-site-href]').forEach((el) => {
          const href = el.dataset.siteHref!.replace(/\{(\w+)\}/g, (_, k) => (s[k] ?? '').replace(k === 'phone' ? /\s/g : /$^/, ''));
          if (!/\{|:$/.test(href)) el.href = href;
        });
      };
      try {
        const cached = JSON.parse(sessionStorage.getItem(KEY) || 'null');
        if (cached && Date.now() - cached.at < 300_000) apply(cached.site);
        else fetch('/api/ustawienia').then((r) => (r.ok ? r.json() : null)).then((site) => {
          if (!site) return;
          apply(site);
          try { sessionStorage.setItem(KEY, JSON.stringify({ at: Date.now(), site })); } catch { /* tryb prywatny */ }
        }).catch(() => {});
      } catch { /* brak pamięci sesji – zostają dane z config.ts */ }
    </script>
  </body>
</html>

<style>
  .skip { position: absolute; left: 12px; top: -60px; padding: 12px 20px; background: var(--c-ink); color: var(--c-white); z-index: 20; border-radius: var(--r-pill); }
  .skip:focus { top: 12px; }
</style>
</file>

<file path="src/pages/api/admin/kody.ts">
import type { APIRoute } from 'astro';
import { getEnv, json } from '../../../lib/env';
import { db } from '../../../lib/supabase';
import { requireAdmin } from '../../../lib/admin-auth';
import { normalizeCode } from '../../../lib/discounts';
import { sendMail } from '../../../lib/mail';
import { getSite } from '../../../lib/site-settings';
import { personalCodeHtml } from '../../../lib/email-templates';

export const prerender = false;

export const GET: APIRoute = async ({ request, url, locals }) => {
  const env = await getEnv(locals);
  if (!(await requireAdmin(request, env))) return json(401, { error: 'Brak dostępu.' });
  try {
    const sb = db(env);
    // Kto użył kodu: wszystkie zamówienia z tym kodem (też nieopłacone i anulowane – status w kolumnie)
    const usesId = url.searchParams.get('uses');
    if (usesId) {
      if (!/^[0-9a-f-]{36}$/i.test(usesId)) return json(400, { error: 'Nieprawidłowy kod.' });
      const [c] = await sb.select<any>(`discount_codes?select=*,customers(email,first_name,last_name)&id=eq.${usesId}`);
      if (!c) return json(404, { error: 'Nie znaleziono kodu.' });
      const orders = await sb.select<any>(
        `orders?select=id,number,created_at,status,email,total,discount_code_amount,source,shipping_address,customer_id,customers(first_name,last_name)&discount_code=eq.${encodeURIComponent(c.code)}&order=created_at.desc&limit=500`,
      );
      return json(200, {
        code: c,
        uses: orders.map((o) => ({
          id: o.id, number: o.number, created_at: o.created_at, status: o.status, email: o.email, total: o.total,
          amount: o.discount_code_amount, source: o.source, customer_id: o.customer_id,
          name: [o.customers?.first_name, o.customers?.last_name].filter(Boolean).join(' ') || o.shipping_address?.name || '',
        })),
      });
    }
    const rows = await sb.select<any>('discount_codes?select=*,customers(email)&order=created_at.desc&limit=200');
    // Skuteczność kodów: opłacone zamówienia z kodem
    const used = await sb.select<{ discount_code: string; total: number; discount_code_amount: number; created_at: string }>(
      'orders?select=discount_code,total,discount_code_amount,created_at&discount_code=not.is.null&status=in.(paid,shipped,completed)&limit=10000',
    );
    const stats: Record<string, { orders: number; revenue: number; discount: number; last: string | null }> = {};
    for (const o of used) {
      const s = (stats[o.discount_code] ??= { orders: 0, revenue: 0, discount: 0, last: null });
      s.orders++; s.revenue += o.total; s.discount += o.discount_code_amount;
      if (!s.last || o.created_at > s.last) s.last = o.created_at;
    }
    return json(200, { rows: rows.map((r) => ({ ...r, stats: stats[r.code] ?? { orders: 0, revenue: 0, discount: 0, last: null } })) });
  } catch (e) {
    console.error('Admin kody: ' + (e instanceof Error ? e.message : String(e)));
    return json(500, { error: 'Błąd pobierania kodów.' });
  }
};

type Sb = ReturnType<typeof db>;

// Pola kodu z formularza (tworzenie i edycja) → wiersz do zapisu albo komunikat błędu
async function parseCodeFields(sb: Sb, b: any) {
  const code = normalizeCode(b.code);
  const type = b.type === 'amount' ? 'amount' : 'percent';
  const raw = String(b.value ?? '').replace(',', '.');
  const value = type === 'percent' ? Math.round(Number(raw)) : Math.round(Number(raw) * 100);
  const min_total = Math.round(Number(String(b.min_total || 0).replace(',', '.')) * 100);
  const max_uses = b.max_uses ? Math.round(Number(b.max_uses)) : null;
  const toIso = (d: unknown) => (typeof d === 'string' && d ? new Date(d).toISOString() : null);
  const starts_at = toIso(b.starts_at), ends_at = toIso(b.ends_at);

  if (!/^[A-Z0-9_-]{3,30}$/.test(code)) return { error: 'Kod: 3–30 znaków (litery, cyfry, - i _).' };
  if (!Number.isFinite(value) || value <= 0 || (type === 'percent' && value > 100)) return { error: 'Nieprawidłowa wartość rabatu.' };
  if (!Number.isFinite(min_total) || min_total < 0) return { error: 'Nieprawidłowa minimalna kwota.' };
  if (max_uses !== null && (!Number.isInteger(max_uses) || max_uses < 1)) return { error: 'Nieprawidłowy limit użyć.' };
  if ((starts_at && isNaN(+new Date(starts_at))) || (ends_at && isNaN(+new Date(ends_at)))) return { error: 'Nieprawidłowa data.' };
  if (starts_at && ends_at && starts_at > ends_at) return { error: 'Data końca jest wcześniejsza niż początku.' };

  let customer_id: string | null = null;
  const email = String(b.email || '').trim().toLowerCase();
  if (email) {
    const [c] = await sb.select<{ id: string }>(`customers?select=id&email=eq.${encodeURIComponent(email)}`);
    if (!c) return { error: 'Nie ma klienta z takim e-mailem.' };
    customer_id = c.id;
  }
  return {
    row: {
      code, type, value, min_total, max_uses, customer_id, starts_at, ends_at,
      once_per_customer: b.once_per_customer !== false,
      description: String(b.description || '').trim().slice(0, 200) || null,
    },
  };
}

// { action: 'create', code, type, value, min_total, starts_at, ends_at, max_uses, once_per_customer, email, description }
// { action: 'update', id, ...te same pola }
// { action: 'toggle', id, active }
export const POST: APIRoute = async ({ request, locals }) => {
  const env = await getEnv(locals);
  const admin = await requireAdmin(request, env);
  if (!admin) return json(401, { error: 'Brak dostępu.' });
  let b: any;
  try { b = await request.json(); } catch { return json(400, { error: 'Nieprawidłowe dane.' }); }
  const sb = db(env);

  try {
    if (b.action === 'toggle') {
      if (!/^[0-9a-f-]{36}$/i.test(b.id || '')) return json(400, { error: 'Nieprawidłowy kod.' });
      const [row] = await sb.update(`discount_codes?id=eq.${b.id}`, { active: b.active === true }, 'id,active');
      return row ? json(200, { row }) : json(404, { error: 'Nie znaleziono.' });
    }
    // Kod osobisty z karty klienta: { action: 'personal', customer_id, type, value, days, min_total, notify, message }
    if (b.action === 'personal') {
      if (!/^[0-9a-f-]{36}$/i.test(b.customer_id || '')) return json(400, { error: 'Nieprawidłowy klient.' });
      const [cust] = await sb.select<any>(`customers?select=id,email,first_name&id=eq.${b.customer_id}`);
      if (!cust) return json(404, { error: 'Nie znaleziono klienta.' });
      const type = b.type === 'amount' ? 'amount' : 'percent';
      const raw = String(b.value ?? '').replace(',', '.');
      const value = type === 'percent' ? Math.round(Number(raw)) : Math.round(Number(raw) * 100);
      if (!Number.isFinite(value) || value <= 0 || (type === 'percent' && value > 100)) return json(422, { error: 'Nieprawidłowa wartość rabatu.' });
      const days = Math.min(365, Math.max(1, Math.round(Number(b.days) || 30)));
      const min_total = Math.max(0, Math.round(Number(String(b.min_total || 0).replace(',', '.')) * 100)) || 0;
      // Kod: imię bez polskich znaków + losowe znaki, np. ANNA-7K2Q
      const base = String(cust.first_name || 'DLA').normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/ł/gi, 'L').toUpperCase().replace(/[^A-Z]/g, '').slice(0, 10) || 'DLA';
      const alphabet = 'ABCDEFGHJKLMNPQRSTUVWXYZ23456789';
      let code = '';
      for (let attempt = 0; attempt < 5 && !code; attempt++) {
        const rnd = Array.from(crypto.getRandomValues(new Uint8Array(4)), (x) => alphabet[x % alphabet.length]).join('');
        const candidate = `${base}-${rnd}`;
        const exists = await sb.select(`discount_codes?select=id&code=eq.${candidate}`);
        if (!exists.length) code = candidate;
      }
      if (!code) return json(500, { error: 'Nie udało się wygenerować kodu. Spróbuj ponownie.' });
      const ends_at = new Date(Date.now() + days * 864e5).toISOString();
      await sb.insert('discount_codes', { code, type, value, min_total, max_uses: 1, once_per_customer: true, customer_id: cust.id, ends_at, description: 'Kod przygotowany specjalnie dla Ciebie' }, 'id');
      console.log(`Admin ${admin} utworzył kod osobisty ${code}`);

      let mailed = false;
      if (b.notify !== false) {
        const site = await getSite(env);
        const origin = new URL(request.url).origin;
        const val = type === 'percent' ? `${value}%` : `${(value / 100).toFixed(2).replace('.', ',')} zł`;
        const msg = String(b.message || '').replace(/\r/g, '').trim().slice(0, 600);
        try {
          await sendMail(env, {
            to: cust.email,
            replyTo: env.CONTACT_TO?.split(',')[0]?.trim(),
            subject: `Rabat ${val} na kolejne zamówienie – Can-C`,
            html: personalCodeHtml({ site, origin, firstName: cust.first_name, message: msg, code, val, minTotal: min_total, endsAt: ends_at }),
            text: [
              `Dzień dobry${cust.first_name ? ` ${cust.first_name}` : ''},`, '',
              msg || 'dziękujemy, że jesteś z nami. Przygotowaliśmy dla Ciebie osobisty kod rabatowy:',
              '', `Kod: ${code}`, `Rabat: ${val}${min_total ? ` (od ${(min_total / 100).toFixed(2).replace('.', ',')} zł)` : ''}`,
              `Ważny do: ${new Date(ends_at).toLocaleDateString('pl-PL', { timeZone: 'Europe/Warsaw' })}`, '',
              `Wpisz go przy zamówieniu: ${origin}/produkt/krople-can-c/`,
              'Kod znajdziesz też w swoim koncie w sklepie.', '',
              `Zespół Can-C · ${site.email}`,
            ].join('\n'),
          });
          mailed = true;
        } catch (e) { console.error('Mail z kodem osobistym: ' + (e instanceof Error ? e.message : String(e))); }
      }
      return json(200, { code, mailed });
    }

    if (b.action === 'update') {
      if (!/^[0-9a-f-]{36}$/i.test(b.id || '')) return json(400, { error: 'Nieprawidłowy kod.' });
      const [cur] = await sb.select<any>(`discount_codes?select=id,code,used_count&id=eq.${b.id}`);
      if (!cur) return json(404, { error: 'Nie znaleziono kodu.' });
      const parsed = await parseCodeFields(sb, b);
      if ('error' in parsed) return json(422, { error: parsed.error });
      const row = parsed.row;
      // Zamówienia trzymają tekst kodu – po pierwszym użyciu nazwy nie zmieniamy, żeby nie zgubić historii i statystyk
      if (row.code !== cur.code) {
        const used = await sb.select(`orders?select=id&discount_code=eq.${encodeURIComponent(cur.code)}&limit=1`);
        if (cur.used_count > 0 || used.length) return json(422, { error: 'Kod był już użyty w zamówieniu – nie można zmienić jego nazwy. Wyłącz go i utwórz nowy.' });
      }
      if (row.max_uses !== null && row.max_uses < cur.used_count) return json(422, { error: `Limit nie może być mniejszy niż liczba dotychczasowych użyć (${cur.used_count}).` });
      const [saved] = await sb.update(`discount_codes?id=eq.${b.id}`, row, 'id,code');
      console.log(`Admin ${admin} zmienił kod ${cur.code}${row.code !== cur.code ? ` → ${row.code}` : ''}`);
      return json(200, { row: saved });
    }

    if (b.action !== 'create') return json(400, { error: 'Nieznana akcja.' });

    const parsed = await parseCodeFields(sb, b);
    if ('error' in parsed) return json(422, { error: parsed.error });
    const [row] = await sb.insert('discount_codes', parsed.row, 'id,code');
    console.log(`Admin ${admin} utworzył kod ${parsed.row.code}`);
    return json(200, { row });
  } catch (e) {
    const msg = e instanceof Error ? e.message : String(e);
    if (msg.includes('duplicate') || msg.includes('23505')) return json(409, { error: 'Taki kod już istnieje.' });
    console.error('Admin kod zapis: ' + msg);
    return json(500, { error: 'Błąd zapisu.' });
  }
};
</file>

<file path="src/pages/api/p24/status.ts">
import type { APIRoute } from 'astro';
import { getEnv, json } from '../../../lib/env';
import { db } from '../../../lib/supabase';
import { p24Config, isValidNotification, type P24Notification } from '../../../lib/p24';
import { finalizePayment } from '../../../lib/payments';

export const prerender = false;

// Powiadomienie od Przelewy24 po płatności (urlStatus).
// Kolejność: podpis → zgodność z zamówieniem → potwierdzenie w P24 → status „opłacone” → e-maile.
export const POST: APIRoute = async ({ request, locals }) => {
  const env = await getEnv(locals);
  let n: P24Notification;
  try { n = await request.json(); } catch { return json(400, { error: 'bad body' }); }

  const p24 = p24Config(env);
  const sb = db(env);

  if (!(await isValidNotification(p24, n))) {
    console.warn('P24: nieprawidłowy podpis powiadomienia dla sesji ' + n?.sessionId + ' (sprawdź sekret P24_CRC i P24_MERCHANT_ID)');
    return json(400, { error: 'bad sign' });
  }
  if (!/^[0-9a-f-]{36}$/i.test(n.sessionId)) return json(400, { error: 'bad session' });

  const [order] = await sb.select<any>(`orders?select=id,number,email,status,total,currency,shipping_method,shipping_point,shipping_address,wants_invoice&id=eq.${n.sessionId}`);
  if (!order) { console.warn('P24: powiadomienie dla nieznanej sesji ' + n.sessionId); return json(404, { error: 'order not found' }); }

  await sb.insert('order_events', { order_id: order.id, type: 'p24_notification', data: { ...n, sign: undefined } }, 'id');

  // Już opłacone (P24 może wysłać powiadomienie ponownie) – nic więcej nie robimy
  if (order.status !== 'pending_payment') return json(200, { ok: true });

  if (n.amount !== order.total || n.currency !== order.currency) {
    console.error('P24: kwota niezgodna z zamówieniem', order.number, n.amount, order.total);
    await sb.update(`orders?id=eq.${order.id}`, { status: 'on_hold' }, 'id');
    await sb.insert('order_events', { order_id: order.id, type: 'amount_mismatch', data: { paid: n.amount, expected: order.total } }, 'id');
    return json(200, { ok: true });
  }

  const result = await finalizePayment(env, sb, p24, order, { orderId: n.orderId, methodId: n.methodId, origin: new URL(request.url).origin });
  if (result === 'verify_failed') return json(502, { error: 'verify failed' }); // P24 ponowi powiadomienie
  return json(200, { ok: true });
};
