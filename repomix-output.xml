<file path="src/pages/zamowienie/index.astro">
---
import Base from '../../layouts/Base.astro';
import { products } from '../../data/shop';
import { FURGONETKA_MAP_KEY } from '../../config';

const catalog = products.map(({ slug, name, price, bundles, size }) => ({ slug, name, price, bundles: !!bundles, size }));
---
<Base title="Dostawa i płatność | Can-C" description="Złóż zamówienie w sklepie Can-C.">
  {FURGONETKA_MAP_KEY && <script is:inline src="https://furgonetka.pl/js/dist/map/map.js" async></script>}
  <section class="section checkout-wrap">
    <div class="container">
      <ol class="steps" aria-label="Etapy zamówienia">
        <li><a href="/koszyk/">1. Koszyk</a></li><li aria-current="step">2. Dostawa i płatność</li><li>3. Potwierdzenie</li>
      </ol>

      <div data-empty hidden class="empty">
        <h1>Koszyk jest pusty</h1>
        <a href="/#produkty" class="btn">Przejdź do produktów</a>
      </div>

      <form class="checkout" data-checkout novalidate hidden>
        <div class="checkout__main">
          <h1 class="title">Dostawa i płatność</h1>
      <p class="cart-notice" data-notice hidden role="status"><span data-site="noticeText"></span></p>

          <fieldset class="box">
            <legend>1. Twoje dane</legend>
            <div class="grid2">
              <label class="field">E-mail<input class="input" type="email" name="email" autocomplete="email" required /></label>
              <label class="field">Telefon (do powiadomień o paczce)<input class="input" type="tel" name="phone" autocomplete="tel" inputmode="tel" required placeholder="np. 600 100 200" /></label>
              <label class="field">Imię<input class="input" type="text" name="firstName" autocomplete="given-name" required /></label>
              <label class="field">Nazwisko<input class="input" type="text" name="lastName" autocomplete="family-name" required /></label>
            </div>
          </fieldset>

          <fieldset class="box">
            <legend>2. Dostawa</legend>
            <label class="choice"><input type="radio" name="shippingMethod" value="inpost_locker" checked />
              <span class="choice__text"><span>InPost Paczkomat 24/7</span><span class="muted">Odbiór o dowolnej porze</span></span><span class="ok">0,00 zł</span></label>
            <label class="choice"><input type="radio" name="shippingMethod" value="dpd" />
              <span class="choice__text"><span>Kurier DPD</span><span class="muted">Dostawa pod wskazany adres</span></span><span class="ok">0,00 zł</span></label>

            <div class="sub" data-locker data-map-key={FURGONETKA_MAP_KEY}>
              <div class="locker-pick" data-map-wrap hidden>
                <div class="locker-pick__info">
                  <span data-locker-label>Nie wybrano Paczkomatu</span>
                  <span class="muted" data-locker-name></span>
                </div>
                <button type="button" class="btn" data-map-open>Wybierz Paczkomat na mapie</button>
              </div>
              <label class="field" data-locker-manual>Kod Paczkomatu<input class="input" type="text" name="locker" placeholder="np. WRO01M" autocapitalize="characters" maxlength="15" /></label>
              <input type="hidden" name="lockerName" />
              <a href="https://inpost.pl/znajdz-paczkomat" target="_blank" rel="noopener" data-locker-link>Znajdź Paczkomat na mapie InPost</a>
            </div>
            <div class="sub grid3" data-address hidden>
              <label class="field">Ulica i numer<input class="input" type="text" name="street" autocomplete="street-address" /></label>
              <label class="field">Kod pocztowy<input class="input" type="text" name="postcode" autocomplete="postal-code" placeholder="00-000" maxlength="6" /></label>
              <label class="field">Miejscowość<input class="input" type="text" name="city" autocomplete="address-level2" /></label>
            </div>
          </fieldset>

          <fieldset class="box">
            <legend>3. Faktura i uwagi</legend>
            <label class="check"><input type="checkbox" name="invoice" data-invoice-toggle /> Chcę fakturę na firmę</label>
            <div class="sub grid2" data-invoice hidden>
              <label class="field">Nazwa firmy<input class="input" type="text" name="company" autocomplete="organization" /></label>
              <label class="field">NIP<input class="input" type="text" name="nip" inputmode="numeric" maxlength="13" /></label>
              <label class="field">Ulica i numer<input class="input" type="text" name="invStreet" /></label>
              <label class="field">Kod pocztowy<input class="input" type="text" name="invPostcode" placeholder="00-000" maxlength="6" /></label>
              <label class="field">Miejscowość<input class="input" type="text" name="invCity" /></label>
            </div>
            <label class="field">Uwagi do zamówienia (opcjonalnie)<textarea class="input textarea" name="note" rows="3" maxlength="500"></textarea></label>
          </fieldset>
          <label class="hp" aria-hidden="true">Strona www<input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
        </div>

        <aside class="summary">
          <h2>Podsumowanie</h2>
          <ul class="lines" data-lines></ul>
          <div class="promo" data-promo>
            <label class="field">Kod rabatowy
              <span class="promo__row"><input class="input" type="text" name="discountCode" autocomplete="off" maxlength="30" /><button type="button" class="btn btn--ghost" data-apply-code>Użyj</button></span>
            </label>
            <p class="promo__msg small" role="status" data-code-msg></p>
          </div>
          <dl>
            <div><dt>Produkty</dt><dd data-subtotal></dd></div>
            <div><dt>Rabat za zestaw</dt><dd data-discount></dd></div>
            <div data-code-line hidden><dt data-code-name>Kod rabatowy</dt><dd data-code-amount></dd></div>
            <div><dt>Dostawa</dt><dd class="ok">0,00 zł</dd></div>
            <div class="total"><dt>Razem</dt><dd data-total></dd></div>
          </dl>
          <label class="check small"><input type="checkbox" name="terms" required /> <span>Akceptuję <a href="/regulamin/" target="_blank">Regulamin</a> i zapoznałem się z <a href="/polityka-prywatnosci/" target="_blank">Polityką prywatności</a>.</span></label>
          <label class="check small"><input type="checkbox" name="marketing" /> <span>Chcę otrzymywać informacje o promocjach (opcjonalnie).</span></label>
          <button type="submit" class="btn btn--lg" data-submit>Zamawiam i płacę</button>
          <p class="error" role="alert" data-error></p>
          <p class="muted note">Płatność BLIK, przelewem lub kartą w serwisie Przelewy24. Nie przechowujemy danych kart.</p>
        </aside>
      </form>
    </div>
  </section>
</Base>

<script define:vars={{ catalog }}>
  // Dane z chwili budowania jako zapas; aktualne ceny i dostępność z bazy
  window.__CANC_CATALOG__ = catalog;
  window.__CANC_READY__ = fetch('/api/produkty')
    .then((r) => (r.ok ? r.json() : null))
    // API podaje ceny w groszach, a ta strona liczy w złotych; niedostępne produkty bez ceny
    .then((list) => { if (Array.isArray(list) && list.length) window.__CANC_CATALOG__ = list.map((p) => ({ ...p, price: p.price === null || p.avail === 'out_of_stock' ? null : p.price / 100 })); })
    .catch(() => {});
</script>

<script>
  import { getCart } from '../../lib/cart';

  (async () => {
  await (window as any).__CANC_READY__;

  type P = { slug: string; name: string; price: number | null; bundles: boolean };
  const catalog: P[] = (window as any).__CANC_CATALOG__ ?? [];
  const pln = new Intl.NumberFormat('pl-PL', { style: 'currency', currency: 'PLN' });
  const rate = (q: number, b: boolean) => (!b ? 0 : q >= 4 ? 0.1 : q >= 2 ? 0.08 : 0);

  const form = document.querySelector<HTMLFormElement>('[data-checkout]')!;
  const items = getCart().filter((i) => catalog.some((p) => p.slug === i.slug && p.price !== null));

  if (!items.length) {
    document.querySelector<HTMLElement>('[data-empty]')!.hidden = false;
  } else {
    form.hidden = false;

    // Podgląd sumy (ostateczną kwotę liczy serwer)
    let subtotal = 0, discount = 0;
    const ul = form.querySelector('[data-lines]')!;
    for (const it of items) {
      const p = catalog.find((c) => c.slug === it.slug)!;
      const gross = (p.price ?? 0) * it.qty;
      const d = gross * rate(it.qty, p.bundles);
      subtotal += gross; discount += d;
      const li = document.createElement('li');
      li.innerHTML = '<span></span><span></span>';
      li.children[0].textContent = `${p.name} × ${it.qty}`;
      li.children[1].textContent = pln.format(gross - d);
      ul.append(li);
    }
    form.querySelector('[data-subtotal]')!.textContent = pln.format(subtotal);
    form.querySelector('[data-discount]')!.textContent = discount ? `−${pln.format(discount)}` : pln.format(0);
    form.querySelector('[data-total]')!.textContent = pln.format(subtotal - discount);

    // ---------- Kod rabatowy (podgląd liczy serwer) ----------
    let appliedCode = '';
    const codeInput = form.querySelector<HTMLInputElement>('input[name="discountCode"]')!;
    const codeMsg = form.querySelector<HTMLElement>('[data-code-msg]')!;
    const codeLine = form.querySelector<HTMLElement>('[data-code-line]')!;
    const resetCode = () => { appliedCode = ''; codeLine.hidden = true; form.querySelector('[data-total]')!.textContent = pln.format(subtotal - discount); };
    form.querySelector('[data-apply-code]')!.addEventListener('click', async () => {
      const code = codeInput.value.trim();
      if (!code) { resetCode(); codeMsg.textContent = ''; return; }
      codeMsg.textContent = 'Sprawdzanie…';
      try {
        const res = await fetch('/api/rabat', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ code, email: String(new FormData(form).get('email') || ''), items }) });
        const d = await res.json();
        if (!res.ok) { resetCode(); codeMsg.textContent = d.error || 'Nie udało się sprawdzić kodu.'; return; }
        appliedCode = d.code;
        codeLine.hidden = false;
        form.querySelector('[data-code-name]')!.textContent = `Kod ${d.code}`;
        form.querySelector('[data-code-amount]')!.textContent = `−${pln.format(d.amount / 100)}`;
        form.querySelector('[data-total]')!.textContent = pln.format(d.total / 100);
        codeMsg.textContent = 'Kod dodany.';
      } catch { codeMsg.textContent = 'Nie udało się sprawdzić kodu.'; }
    });
    codeInput.addEventListener('input', () => { if (appliedCode && codeInput.value.trim().toUpperCase() !== appliedCode) { resetCode(); codeMsg.textContent = ''; } });
    (window as any).__cancCode = () => appliedCode;

    // ---------- Uzupełnienie danych zalogowanego klienta ----------
    (async () => {
      try {
        const { sb } = await import('../../lib/sb-client');
        const { data } = await sb().auth.getSession();
        const session = data.session;
        if (!session) return;
        const res = await fetch('/api/konto/profil', { headers: { Authorization: `Bearer ${session.access_token}` } });
        if (!res.ok) return;
        const p = await res.json();
        const fill = (n: string, v: unknown) => { const el = form.elements.namedItem(n) as HTMLInputElement | null; if (el && !el.value && v) el.value = String(v); };
        fill('email', session.user.email); fill('phone', p.phone); fill('firstName', p.first_name); fill('lastName', p.last_name);
        fill('locker', p.default_locker); fill('street', p.default_address?.street); fill('postcode', p.default_address?.postcode); fill('city', p.default_address?.city);
        if (p.default_locker) {
          const label = form.querySelector('[data-locker-label]'); if (label) label.textContent = `Paczkomat ${p.default_locker}`;
        }
        if (p.billing?.nip) {
          const t = form.querySelector<HTMLInputElement>('[data-invoice-toggle]')!; t.checked = true; t.dispatchEvent(new Event('change'));
          fill('company', p.billing.company); fill('nip', p.billing.nip); fill('invStreet', p.billing.street); fill('invPostcode', p.billing.postcode); fill('invCity', p.billing.city);
        }
      } catch { /* niezalogowany albo brak konfiguracji – formularz działa normalnie */ }
    })();

    // Pola zależne od wyboru
    const locker = form.querySelector<HTMLElement>('[data-locker]')!;
    const address = form.querySelector<HTMLElement>('[data-address]')!;
    form.querySelectorAll<HTMLInputElement>('input[name="shippingMethod"]').forEach((r) =>
      r.addEventListener('change', () => { locker.hidden = r.value !== 'inpost_locker'; address.hidden = r.value !== 'dpd'; }),
    );
    const invoice = form.querySelector<HTMLElement>('[data-invoice]')!;
    form.querySelector<HTMLInputElement>('[data-invoice-toggle]')!.addEventListener('change', (e) => {
      invoice.hidden = !(e.target as HTMLInputElement).checked;
    });

    const errorEl = form.querySelector<HTMLElement>('[data-error]')!;
    // Mapa punktów Furgonetki (jeśli skonfigurowano klucz). Pole ręczne zostaje jako zapas.
    const mapKey = locker.dataset.mapKey;
    if (mapKey) {
      const wrap = locker.querySelector<HTMLElement>('[data-map-wrap]')!;
      const manual = locker.querySelector<HTMLElement>('[data-locker-manual]')!;
      const codeInput = form.querySelector<HTMLInputElement>('input[name="locker"]')!;
      const nameInput = form.querySelector<HTMLInputElement>('input[name="lockerName"]')!;
      wrap.hidden = false;
      manual.hidden = true;
      locker.querySelector<HTMLElement>('[data-locker-link]')!.hidden = true;
      locker.querySelector('[data-map-open]')!.addEventListener('click', () => {
        const F = (window as any).Furgonetka;
        if (!F) { manual.hidden = false; errorEl.textContent = 'Mapa nie załadowała się. Wpisz kod Paczkomatu ręcznie.'; return; }
        new F.Map({
          apiKey: mapKey,
          courierServices: ['inpost'],
          courierServicesFilter: ['inpost'],
          city: String(new FormData(form).get('city') || ''),
          locale: 'pl',
          callback: (params: any) => {
            codeInput.value = params.point.code;
            nameInput.value = params.point.name || '';
            locker.querySelector('[data-locker-label]')!.textContent = `Paczkomat ${params.point.code}`;
            locker.querySelector('[data-locker-name]')!.textContent = params.point.name || '';
            locker.querySelector('[data-map-open]')!.textContent = 'Zmień Paczkomat';
          },
        }).show();
      });
    }

    const error = form.querySelector<HTMLElement>('[data-error]')!;
    const submit = form.querySelector<HTMLButtonElement>('[data-submit]')!;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      error.textContent = '';
      const fd = new FormData(form);
      const val = (k: string) => String(fd.get(k) ?? '');
      if (!fd.get('terms')) { error.textContent = 'Zaakceptuj regulamin, aby złożyć zamówienie.'; return; }

      submit.disabled = true;
      submit.textContent = 'Przekierowanie do płatności…';
      try {
        const res = await fetch('/api/zamowienie', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            items,
            email: val('email'), phone: val('phone'), firstName: val('firstName'), lastName: val('lastName'),
            shippingMethod: val('shippingMethod'), locker: val('locker'), lockerName: val('lockerName'),
            street: val('street'), postcode: val('postcode'), city: val('city'),
            invoice: fd.get('invoice') !== null,
            company: val('company'), nip: val('nip'), invStreet: val('invStreet'), invPostcode: val('invPostcode'), invCity: val('invCity'),
            note: val('note'), terms: true, marketing: fd.get('marketing') !== null, website: val('website'),
            discountCode: (window as any).__cancCode?.() || '',
          }),
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok || !data.redirect) throw new Error(data.error || 'Nie udało się złożyć zamówienia. Spróbuj ponownie.');
        location.href = data.redirect;
      } catch (err) {
        error.textContent = (err as Error).message;
        submit.disabled = false;
        submit.textContent = 'Zamawiam i płacę';
      }
    });
  }
  })();
</script>

<style>
  .cart-notice { padding: 14px 18px; background: var(--c-warn-bg); color: var(--c-warn-ink); }
  .cart-notice[hidden] { display: none; }
  .checkout-wrap { background: var(--c-gray-100); padding-top: var(--s-3); }
  .steps { list-style: none; margin: 0 0 var(--s-3); padding: 0; display: flex; flex-wrap: wrap; gap: 8px 24px; font-size: var(--fs-small); color: var(--c-ink-70); }
  .steps [aria-current] { color: var(--c-ink); }
  .steps a { color: inherit; }
  .empty { display: flex; flex-direction: column; align-items: flex-start; gap: var(--s-2); }
  .empty[hidden], .checkout[hidden] { display: none; }
  .title { font-size: var(--fs-h3); margin-bottom: var(--s-1); }

  .checkout { display: flex; flex-wrap: wrap; gap: var(--s-3); align-items: flex-start; }
  .checkout__main { flex: 999 1 560px; min-width: 0; display: flex; flex-direction: column; gap: var(--s-2); }
  .box { margin: 0; border: 0; background: var(--c-white); padding: var(--s-3); display: flex; flex-direction: column; gap: 16px; }
  .box legend { float: left; width: 100%; font-size: var(--fs-h4); padding: 0 0 8px; }
  .grid2 { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 16px; }
  .grid3 { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 16px; }
  .sub { padding: var(--s-2); background: var(--c-tint); display: flex; flex-direction: column; gap: 12px; }
  .sub.grid2, .sub.grid3 { display: grid; }
  .sub[hidden] { display: none !important; }
  .choice { min-height: 72px; padding: 16px 24px; border-radius: var(--r-field); box-shadow: inset 0 0 0 1px var(--c-gray-300); display: flex; align-items: center; gap: 16px; cursor: pointer; }
  .choice:has(input:checked) { box-shadow: inset 0 0 0 1px var(--c-ink); }
  .choice input { width: 20px; height: 20px; margin: 0; accent-color: var(--c-ink); }
  .choice__text { flex: 1; display: flex; flex-direction: column; gap: 2px; font-size: 1.125rem; }
  .choice__text .muted { font-size: var(--fs-small); }
  .ok { color: var(--c-ok); }
  .locker-pick { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px; }
  .locker-pick[hidden], [data-locker-manual][hidden], [data-locker-link][hidden] { display: none; }
  .locker-pick__info { display: flex; flex-direction: column; gap: 2px; font-size: 1.125rem; }
  .locker-pick__info .muted { font-size: var(--fs-small); }
  .check { display: flex; gap: 12px; align-items: flex-start; }
  .check input { width: 18px; height: 18px; margin: 3px 0 0; accent-color: var(--c-ink); flex-shrink: 0; }
  .small { font-size: var(--fs-small); line-height: 24px; color: var(--c-ink-75); }
  .textarea { height: auto; padding: 12px 16px; resize: vertical; }
  .hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }

  .summary { flex: 1 1 340px; position: sticky; top: 90px; background: var(--c-white); padding: var(--s-3); display: flex; flex-direction: column; gap: var(--s-2); }
  .summary h2 { font-size: var(--fs-h4); font-weight: 400; }
  .lines { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 8px; }
  :global(.lines li) { display: flex; justify-content: space-between; gap: 12px; }
  .summary dl { margin: 0; display: flex; flex-direction: column; gap: 12px; padding-top: var(--s-2); border-top: 1px solid var(--c-ink-10); }
  .summary dl div { display: flex; justify-content: space-between; }
  .summary dd { margin: 0; }
  .summary .total { padding-top: 12px; border-top: 1px solid var(--c-ink-10); font-size: var(--fs-h4); }
  .summary .btn:disabled { opacity: 0.5; cursor: wait; }
  .error { color: var(--c-err); }
  .promo { padding-top: var(--s-2); border-top: 1px solid var(--c-ink-10); display: flex; flex-direction: column; gap: 6px; }
  .promo__row { display: flex; gap: 8px; }
  .promo__row .input { flex: 1; min-width: 0; text-transform: uppercase; }
  .promo__row .btn { min-height: 52px; padding: 0 18px; }
  .promo__msg:empty { display: none; }
  [data-code-line][hidden] { display: none !important; }
  .error:empty { display: none; }
  .note { font-size: 0.8125rem; }
</style>
</file>

<file path="src/pages/admin/index.astro">
---
// Panel admina – styl z „Can - Design System” (Metrix). Niezależny od stylów sklepu.
import { FURGONETKA_PANEL_URL } from '../../config';
---
<!doctype html>
<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Panel Can-C</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Poppins:wght@400;500&display=swap" rel="stylesheet" />
  </head>
  <body data-furgonetka={FURGONETKA_PANEL_URL}>
    <div class="app">
      <aside class="side" aria-label="Nawigacja panelu">
        <a href="/admin/" class="logo" aria-label="Panel Can-C">
          <span class="logo__mark" aria-hidden="true">C</span><span class="logo__text">Can-C</span>
        </a>
        <nav class="nav">
          <button type="button" class="nav__item" data-tab="orders" aria-current="page">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7.5 7.7V6.6a4.5 4.5 0 0 1 9 0v1.1M5.2 21h13.6a1.4 1.4 0 0 0 1.4-1.6L19 9a1.4 1.4 0 0 0-1.4-1.3H6.4A1.4 1.4 0 0 0 5 9L3.8 19.4A1.4 1.4 0 0 0 5.2 21Z" /></svg>
            <span>Zamówienia</span><span class="badge" data-count-paid></span>
          </button>
          <button type="button" class="nav__item" data-tab="customers">
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="9" cy="8" r="3.5" /><path d="M2.5 20c.6-3.4 3.3-5.5 6.5-5.5s5.9 2.1 6.5 5.5M16 4.8a3.5 3.5 0 0 1 0 6.4M18.5 14.8c1.6.8 2.7 2.6 3 5.2" /></svg>
            <span>Klienci</span>
          </button>
          <button type="button" class="nav__item" data-tab="products">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3.5 7.5 12 3l8.5 4.5v9L12 21l-8.5-4.5v-9ZM3.5 7.5 12 12m0 0 8.5-4.5M12 12v9" /></svg>
            <span>Produkty</span>
          </button>
          <button type="button" class="nav__item" data-tab="reviews">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m12 3 2.6 5.6 6 .7-4.5 4.1 1.2 6L12 16.4 6.7 19.4l1.2-6L3.4 9.3l6-.7L12 3Z" /></svg>
            <span>Opinie</span><span class="badge" data-count-reviews></span>
          </button>
          <button type="button" class="nav__item" data-tab="codes">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3.5 12.6V5a1.5 1.5 0 0 1 1.5-1.5h7.6l8 8a1.5 1.5 0 0 1 0 2.1l-7.4 7.4a1.5 1.5 0 0 1-2.1 0l-7.6-7.6Z" /><circle cx="8" cy="8" r="1.4" /></svg>
            <span>Kody rabatowe</span>
          </button>
          <button type="button" class="nav__item" data-tab="automations">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 7v5l3 2M21 12a9 9 0 1 1-3-6.7M21 4v4h-4" /></svg>
            <span>Automaty</span>
          </button>
          <button type="button" class="nav__item" data-tab="settings">
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="3" /><path d="M19.4 15a1.6 1.6 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.6 1.6 0 0 0-1.8-.3 1.6 1.6 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.6 1.6 0 0 0-1-1.5 1.6 1.6 0 0 0-1.8.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.6 1.6 0 0 0 .3-1.8 1.6 1.6 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1a1.6 1.6 0 0 0 1.5-1 1.6 1.6 0 0 0-.3-1.8l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.6 1.6 0 0 0 1.8.3H9a1.6 1.6 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.6 1.6 0 0 0 1 1.5 1.6 1.6 0 0 0 1.8-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.6 1.6 0 0 0-.3 1.8V9a1.6 1.6 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.6 1.6 0 0 0-1.5 1Z" /></svg>
            <span>Ustawienia sklepu</span>
          </button>
        </nav>
        <div class="side__foot">
          <a href="/" class="nav__item nav__item--muted" target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 10.5 12 4l8 6.5V20a1 1 0 0 1-1 1h-4.5v-6h-5v6H5a1 1 0 0 1-1-1v-9.5Z" /></svg>
            <span>Otwórz sklep</span>
          </a>
          <a href="/cdn-cgi/access/logout" class="nav__item nav__item--danger">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 12H4m0 0 3.5-3.5M4 12l3.5 3.5M10 7V5.5A1.5 1.5 0 0 1 11.5 4h7A1.5 1.5 0 0 1 20 5.5v13a1.5 1.5 0 0 1-1.5 1.5h-7a1.5 1.5 0 0 1-1.5-1.5V17" /></svg>
            <span>Wyloguj</span>
          </a>
        </div>
      </aside>

      <div class="main">
        <header class="top">
          <div class="top__row">
            <h1 class="top__title" data-title>Zamówienia</h1>
            <span class="top__user">Can-C · sklep</span>
          </div>
          <div class="crumbs"><span>Panel</span><span>/</span><span data-crumb>Zamówienia</span></div>
        </header>

        <div class="content">
          <!-- ZAMÓWIENIA -->
          <section data-view="orders" class="stack">
            <div class="kpis">
              <div class="kpi">
                <span class="kpi__icon kpi__icon--amber" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M7.5 7.7V6.6a4.5 4.5 0 0 1 9 0v1.1M5.2 21h13.6a1.4 1.4 0 0 0 1.4-1.6L19 9a1.4 1.4 0 0 0-1.4-1.3H6.4A1.4 1.4 0 0 0 5 9L3.8 19.4A1.4 1.4 0 0 0 5.2 21Z" /></svg></span>
                <div class="kpi__row">
                  <div class="kpi__m"><span class="kpi__label">Do wysłania</span><span class="kpi__value" data-k="paid">–</span></div>
                  <div class="kpi__m"><span class="kpi__label">Wstrzymane</span><span class="kpi__value" data-k="on_hold">–</span></div>
                  <div class="kpi__m"><span class="kpi__label">W drodze</span><span class="kpi__value" data-k="shipped">–</span></div>
                </div>
              </div>
              <div class="kpi">
                <span class="kpi__icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 19V5m0 14h16M8 15v-3m4 3V9m4 6V7" /></svg></span>
                <div class="kpi__row">
                  <div class="kpi__m"><span class="kpi__label">Sprzedaż dziś</span><span class="kpi__value" data-k="revenueToday">–</span></div>
                  <div class="kpi__m"><span class="kpi__label">Zamówienia dziś</span><span class="kpi__value" data-k="ordersToday">–</span></div>
                </div>
              </div>
              <div class="kpi">
                <span class="kpi__icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M7 3v3m10-3v3M4 9h16M5 5h14a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1Z" /></svg></span>
                <div class="kpi__row">
                  <div class="kpi__m"><span class="kpi__label">Sprzedaż 30 dni</span><span class="kpi__value" data-k="revenue30">–</span></div>
                  <div class="kpi__m"><span class="kpi__label">Zamówienia</span><span class="kpi__value" data-k="orders30">–</span></div>
                  <div class="kpi__m"><span class="kpi__label">Średnio</span><span class="kpi__value" data-k="avg30">–</span></div>
                </div>
              </div>
            </div>

            <div class="card">
              <div class="card__head">
                <h2 class="card__title">Zamówienia klientów</h2>
                <button type="button" class="btn btn--sm" data-new-order>+ Nowe zamówienie</button>
                <form class="search" data-search role="search">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5" /><path d="m20 20-4.2-4.2" /></svg>
                  <label class="sr-only" for="q">Szukaj</label>
                  <input id="q" name="q" type="search" placeholder="Numer lub e-mail" />
                </form>
              </div>
              <div class="tabs" role="tablist" aria-label="Status">
                <button type="button" class="tab" data-status="paid" aria-pressed="true">Do wysłania <span data-count="paid"></span></button>
                <button type="button" class="tab" data-status="on_hold" aria-pressed="false">Wstrzymane <span data-count="on_hold"></span></button>
                <button type="button" class="tab" data-status="shipped" aria-pressed="false">Wysłane</button>
                <button type="button" class="tab" data-status="pending_payment" aria-pressed="false">Czekają na płatność <span data-count="pending_payment"></span></button>
                <button type="button" class="tab" data-status="completed" aria-pressed="false">Zrealizowane</button>
                <button type="button" class="tab" data-status="cancelled" aria-pressed="false">Anulowane</button>
                <button type="button" class="tab" data-status="" aria-pressed="false">Wszystkie</button>
              </div>
              <div class="table-wrap">
                <table class="table">
                  <thead><tr><th>Nr</th><th>Data</th><th>Klient</th><th>Produkty</th><th>Dostawa</th><th class="r">Kwota</th><th>Status</th></tr></thead>
                  <tbody data-rows></tbody>
                </table>
              </div>
              <div class="pager">
                <span class="muted" data-page></span>
                <div class="pager__btns">
                  <button type="button" class="icon-btn" data-prev aria-label="Poprzednia strona"><svg viewBox="0 0 24 24"><path d="m14.5 6-6 6 6 6" /></svg></button>
                  <button type="button" class="icon-btn" data-next aria-label="Następna strona"><svg viewBox="0 0 24 24"><path d="m9.5 6 6 6-6 6" /></svg></button>
                </div>
              </div>
            </div>
          </section>

          <!-- KLIENCI -->
          <section data-view="customers" class="stack" hidden>
            <div class="card">
              <div class="card__head">
                <h2 class="card__title">Klienci <span class="muted" data-c-total></span></h2>
                <div class="actions">
                  <a class="btn btn--outline btn--sm" data-c-csv href="/api/admin/klienci?format=csv">Pobierz CSV</a>
                  <a class="btn btn--outline btn--sm" data-c-match href="/api/admin/klienci?format=match" title="Lista do Google Ads / Meta – tylko osoby ze zgodą marketingową">Eksport Customer Match</a>
                </div>
              </div>
              <div class="tabs" role="tablist" aria-label="Segmenty klientów">
                <button type="button" class="tab" data-seg="" aria-pressed="true">Wszyscy</button>
                <button type="button" class="tab" data-seg="treatment" aria-pressed="false" title="Koniec kuracji w ciągu 3 tygodni albo w ostatnich 2 tygodniach">Kończy się kuracja</button>
                <button type="button" class="tab" data-seg="regular" aria-pressed="false" title="2 i więcej opłaconych zamówień">Stali klienci</button>
                <button type="button" class="tab" data-seg="winback" aria-pressed="false" title="2+ zamówienia, ostatnie ponad 60 dni temu">Do odzyskania</button>
                <button type="button" class="tab" data-seg="one_time" aria-pressed="false" title="1 zamówienie ponad 60 dni temu">Jeden zakup, nie wrócili</button>
                <button type="button" class="tab" data-seg="new" aria-pressed="false">Nowi (30 dni)</button>
                <button type="button" class="tab" data-seg="consent" aria-pressed="false">Ze zgodą marketingową</button>
                <button type="button" class="tab" data-seg="no_orders" aria-pressed="false">Bez zakupów</button>
              </div>
              <form class="c-tools" data-c-search role="search">
                <span class="search search--wide">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5" /><path d="m20 20-4.2-4.2" /></svg>
                  <label class="sr-only" for="cq">Szukaj klienta</label>
                  <input id="cq" type="search" placeholder="Imię i nazwisko, e-mail, telefon, miejscowość" />
                </span>
                <label class="check"><input type="checkbox" data-c-buyers /> Tylko kupujący</label>
              </form>
              <div class="table-wrap">
                <table class="table">
                  <thead><tr data-c-head>
                    <th data-sort="name">Imię i nazwisko</th><th data-sort="last_active">Ostatnio aktywny</th><th data-sort="created">Data rejestracji</th><th data-sort="email">E-mail</th>
                    <th data-sort="orders" class="r">Zamówienia</th><th data-sort="spent" class="r">Suma wydatków</th><th data-sort="avg" class="r">Średnia wartość</th>
                    <th data-sort="country">Kraj</th><th data-sort="city">Miejscowość</th><th data-sort="postcode">Kod pocztowy</th><th data-sort="phone">Telefon</th>
                  </tr></thead>
                  <tbody data-c-rows></tbody>
                </table>
              </div>
              <div class="pager">
                <span class="muted" data-c-page></span>
                <div class="pager__btns">
                  <label class="field field--inline">Wierszy na stronie
                    <select class="input sm" data-c-size><option>50</option><option>100</option><option>200</option><option>500</option></select>
                  </label>
                  <button type="button" class="icon-btn" data-c-prev aria-label="Poprzednia strona"><svg viewBox="0 0 24 24"><path d="m14.5 6-6 6 6 6" /></svg></button>
                  <button type="button" class="icon-btn" data-c-next aria-label="Następna strona"><svg viewBox="0 0 24 24"><path d="m9.5 6 6 6-6 6" /></svg></button>
                </div>
              </div>
            </div>
          </section>

          <!-- PRODUKTY -->
          <section data-view="products" class="stack" hidden>
            <div class="card">
              <div class="card__head">
                <h2 class="card__title">Produkty</h2>
                <div class="actions">
                  <a class="btn btn--outline btn--sm" href="/feed/google.xml" target="_blank" rel="noopener">Feed Google Merchant</a>
                  <button type="button" class="btn btn--sm" data-new-product>+ Nowy produkt</button>
                </div>
              </div>
              <div class="table-wrap">
                <table class="table">
                  <thead><tr><th></th><th>Produkt</th><th class="r">Cena</th><th class="r">Stan</th><th>Dostępność</th><th>Opinie</th><th>Status</th></tr></thead>
                  <tbody data-products></tbody>
                </table>
              </div>
            </div>
          </section>

          <!-- OPINIE -->
          <section data-view="reviews" class="stack" hidden>
            <div class="card">
              <div class="card__head">
                <h2 class="card__title">Opinie o produktach</h2>
                <div class="actions">
                  <a class="btn btn--outline btn--sm" href="/feed/opinie.xml" target="_blank" rel="noopener">Feed opinii Google</a>
                  <button type="button" class="btn btn--sm" data-new-review>+ Dodaj opinię</button>
                </div>
              </div>
              <div class="tabs" role="tablist" aria-label="Status opinii">
                <button type="button" class="tab" data-rstatus="pending" aria-pressed="true">Do moderacji <span data-rcount></span></button>
                <button type="button" class="tab" data-rstatus="approved" aria-pressed="false">Opublikowane</button>
                <button type="button" class="tab" data-rstatus="rejected" aria-pressed="false">Odrzucone</button>
                <button type="button" class="tab" data-rstatus="" aria-pressed="false">Wszystkie</button>
              </div>
              <div class="table-wrap">
                <table class="table">
                  <thead><tr><th>Data</th><th>Produkt</th><th>Autor</th><th>Ocena</th><th>Treść</th><th>Status</th><th></th></tr></thead>
                  <tbody data-reviews></tbody>
                </table>
              </div>
            </div>
          </section>
          <!-- AUTOMATY -->
          <section data-view="automations" class="stack" hidden>
            <div class="card">
              <div class="card__head"><h2 class="card__title">Przypomnienie o końcu kuracji</h2><span class="st" data-auto-state></span></div>
              <p class="muted">Codziennie o 8:00 sklep wysyła klientom ze zgodą marketingową e-mail „Kończy Ci się zapas kropli” z przyciskiem „Zamów ponownie”. Stali klienci (2+ zamówienia) dostają dodatkowo jednorazowy kod rabatowy. Każdy klient dostaje jedno przypomnienie na zamówienie. W mailu jest link „wypisz się”.</p>
              <p class="notice" data-auto-warn hidden></p>
              <form class="code-form" data-auto-form novalidate>
                <label class="check code-form__wide"><input type="checkbox" name="enabled" /> Automat włączony</label>
                <label class="field">Wyślij na ile dni przed końcem zapasu<input class="input" name="daysBefore" type="number" min="1" max="30" /></label>
                <label class="field">Rabat dla stałych klientów (%; 0 = bez kodu)<input class="input" name="regularCodePercent" type="number" min="0" max="50" /></label>
                <label class="field">Ważność kodu (dni)<input class="input" name="codeValidDays" type="number" min="1" max="90" /></label>
                <label class="field">Maks. maili dziennie<input class="input" name="maxPerRun" type="number" min="1" max="200" /></label>
                <div class="actions code-form__wide">
                  <button class="btn">Zapisz</button>
                  <button type="button" class="btn btn--outline" data-auto-run>Wyślij teraz do osób z listy poniżej</button>
                </div>
              </form>
            </div>
            <div class="card">
              <div class="card__head"><h2 class="card__title">Dziś dostaliby przypomnienie <span class="muted" data-auto-count></span></h2></div>
              <div class="table-wrap"><table class="table"><thead><tr><th>Klient</th><th>E-mail</th><th class="r">Zamówienia</th><th class="r">Ostatnio opakowań</th><th>Koniec zapasu</th><th>Kod rabatowy</th></tr></thead><tbody data-auto-list></tbody></table></div>
            </div>
            <div class="card">
              <div class="card__head"><h2 class="card__title">Ostatnio wysłane</h2></div>
              <div class="table-wrap"><table class="table"><thead><tr><th>Data</th><th>Klient</th><th>Kod</th></tr></thead><tbody data-auto-hist></tbody></table></div>
            </div>
          </section>

          <!-- USTAWIENIA SKLEPU -->
          <section data-view="settings" class="stack" hidden>
            <p class="notice">Dane pojawiają się w stopce, na stronach Kontakt, O nas, w regulaminie, polityce prywatności i w e-mailach. Po zapisaniu na stronie zobaczysz je w ciągu kilku minut. W wyszukiwarce Google i na stronach wygenerowanych wcześniej zaktualizują się przy najbliższym wdrożeniu sklepu.</p>
            <form class="stack" data-settings-form novalidate>
            <div class="card">
              <div class="card__head"><h2 class="card__title">Komunikat na stronie</h2><span class="st" data-notice-state></span></div>
              <p class="muted">Pasek nad nagłówkiem na wszystkich stronach oraz informacja w koszyku, przy zamówieniu i w mailu z potwierdzeniem. Np. „Urlop do 15 sierpnia – zamówienia wysyłamy od 16 sierpnia.”</p>
              <div class="code-form">
                <label class="check code-form__wide"><input type="checkbox" name="noticeEnabled" /> Pokazuj komunikat</label>
                <label class="field code-form__wide">Treść<input class="input" name="noticeText" maxlength="300" /></label>
                <label class="field">Pokazuj od (opcjonalnie)<input class="input" name="noticeFrom" type="datetime-local" /></label>
                <label class="field">Pokazuj do (opcjonalnie)<input class="input" name="noticeTo" type="datetime-local" /></label>
              </div>
            </div>
            <div class="card">
              <div class="card__head"><h2 class="card__title">Pasek promocji i wysyłka</h2></div>
