import type { APIRoute } from 'astro';
import { getEnv, json } from '../../../lib/env';
import { db } from '../../../lib/supabase';
import { requireAdmin } from '../../../lib/admin-auth';
import { str, EMAIL_RE, POSTCODE_RE, LOCKER_RE, cleanPhone, validPhone, validNip } from '../../../lib/validate';

export const prerender = false;

// Kolumny, po których można sortować (nazwa w panelu → kolumna widoku)
const SORTABLE: Record<string, string> = {
  name: 'full_name', last_active: 'last_active_at', created: 'created_at', email: 'email',
  orders: 'orders_count', spent: 'total_spent', avg: 'avg_order', country: 'country',
  city: 'city', postcode: 'postcode', phone: 'phone',
};
const PAGE_SIZES = [50, 100, 200, 500];
const COLS = 'id,full_name,first_name,last_name,email,phone,created_at,last_active_at,last_order_at,orders_count,total_spent,avg_order,country,city,postcode,has_account,marketing_consent,source,admin_note,last_order_packs,treatment_end_at';

// Gotowe segmenty klientów do kampanii
function segmentFilters(seg: string): string[] {
  const ago = (days: number) => encodeURIComponent(new Date(Date.now() - days * 864e5).toISOString());
  const ahead = (days: number) => encodeURIComponent(new Date(Date.now() + days * 864e5).toISOString());
  switch (seg) {
    case 'treatment': return [`treatment_end_at=gte.${ago(14)}`, `treatment_end_at=lte.${ahead(21)}`]; // kończy się kuracja
    case 'regular': return ['orders_count=gte.2'];                                                    // stali klienci
    case 'winback': return ['orders_count=gte.2', `last_order_at=lt.${ago(60)}`];                     // stali, nie kupują od 60 dni
    case 'one_time': return ['orders_count=eq.1', `last_order_at=lt.${ago(60)}`];                     // jeden zakup, nie wrócili
    case 'new': return [`created_at=gte.${ago(30)}`];                                                 // nowi w 30 dni
    case 'consent': return ['marketing_consent=is.true'];                                             // ze zgodą marketingową
    case 'no_orders': return ['orders_count=eq.0'];                                                   // konta bez zakupów
    default: return [];
  }
}

function buildFilters(url: URL) {
  const filters: string[] = [];
  const q = (url.searchParams.get('q') || '').trim().slice(0, 80).replace(/[*,()"\\]/g, ' ').replace(/\s+/g, ' ');
  if (q) {
    const like = encodeURIComponent(`*${q}*`);
    const digits = q.replace(/\D/g, '');
    const ors = [`full_name.ilike.${like}`, `email.ilike.${like}`, `city.ilike.${like}`];
    if (digits.length >= 3) ors.push(`phone.ilike.${encodeURIComponent(`*${digits.slice(-9)}*`)}`);
    filters.push(`or=(${ors.join(',')})`);
  }
  if (url.searchParams.get('buyers') === '1') filters.push('orders_count=gt.0');
  filters.push(...segmentFilters(url.searchParams.get('segment') || ''));
  const col = SORTABLE[url.searchParams.get('sort') || ''] || 'last_active_at';
  const dir = url.searchParams.get('dir') === 'asc' ? 'asc' : 'desc';
  const order = `${col}.${dir}.nullslast`;
  return { f: filters.length ? `&${filters.join('&')}` : '', order };
}

const cell = (v: unknown) => { const t = String(v ?? ''); return /[";,\n]/.test(t) ? `"${t.replace(/"/g, '""')}"` : t; };

export const GET: APIRoute = async ({ request, url, locals }) => {
  const env = await getEnv(locals);
  const admin = await requireAdmin(request, env);
  if (!admin) return json(401, { error: 'Brak dostępu.' });
  const sb = db(env);

  try {
    const id = url.searchParams.get('id');
    if (id) {
      if (!/^[0-9a-f-]{36}$/i.test(id)) return json(400, { error: 'Nieprawidłowy identyfikator.' });
      const [c] = await sb.select(`customer_stats?select=${COLS}&id=eq.${id}`);
      if (!c) return json(404, { error: 'Nie znaleziono klienta.' });
      const [extra] = await sb.select(`customers?select=default_address,default_locker,billing,consent_at,consent_source&id=eq.${id}`);
      const orders = await sb.select(`orders?select=id,number,created_at,status,total,discount_code,source,order_items(name,qty)&customer_id=eq.${id}&order=created_at.desc&limit=100`);
      const codes = await sb.select(`discount_codes?select=code,type,value,ends_at,active,used_count,max_uses&customer_id=eq.${id}&order=created_at.desc&limit=20`);
      return json(200, { customer: { ...c, ...extra }, orders, codes });
    }

    const { f, order } = buildFilters(url);
    const format = url.searchParams.get('format');

    if (format === 'csv' || format === 'match') {
      // Customer Match (Google Ads / Meta): domyślnie tylko osoby ze zgodą marketingową
      const consentOnly = format === 'match' && url.searchParams.get('all') !== '1';
      const rows = await sb.select<any>(`customer_stats?select=${COLS}${f}${consentOnly ? '&marketing_consent=is.true' : ''}&order=${order}&limit=10000`);
      const zl = (g: number) => (g / 100).toFixed(2).replace('.', ',');
      const d = (s: string | null) => (s ? new Date(s).toLocaleDateString('pl-PL') : '');
      let body: string, name: string;
      if (format === 'match') {
        const phone = (p: string | null) => { const x = String(p || '').replace(/\D/g, ''); return x.length === 9 ? `+48${x}` : x ? `+${x}` : ''; };
        body = ['Email,Phone,First Name,Last Name,Country,Zip', ...rows.map((r) => [r.email, phone(r.phone), r.first_name, r.last_name, r.country || 'PL', r.postcode].map(cell).join(','))].join('\r\n');
        name = 'customer-match';
      } else {
        const head = ['Imię i nazwisko', 'E-mail', 'Telefon', 'Ostatnio aktywny', 'Data rejestracji', 'Zamówienia', 'Suma wydatków', 'Średnia wartość', 'Kraj', 'Miejscowość', 'Kod pocztowy', 'Konto', 'Zgoda marketingowa', 'Koniec kuracji', 'Notatka'];
        body = '\uFEFF' + [head.join(';'), ...rows.map((r) => [r.full_name, r.email, r.phone, d(r.last_active_at), d(r.created_at), r.orders_count, zl(r.total_spent), zl(r.avg_order), r.country, r.city, r.postcode, r.has_account ? 'tak' : 'nie', r.marketing_consent ? 'tak' : 'nie', d(r.treatment_end_at), r.admin_note].map(cell).join(';'))].join('\r\n');
        name = 'klienci';
      }
      console.log(`Admin ${admin} wyeksportował ${rows.length} klientów (${format})`);
      return new Response(body, {
        headers: { 'Content-Type': 'text/csv; charset=utf-8', 'Content-Disposition': `attachment; filename="${name}-can-c-${new Date().toISOString().slice(0, 10)}.csv"`, 'Cache-Control': 'no-store' },
      });
    }

    const size = PAGE_SIZES.includes(Number(url.searchParams.get('size'))) ? Number(url.searchParams.get('size')) : 50;
    const page = Math.max(1, Number(url.searchParams.get('page')) || 1);
    const { rows, total } = await sb.selectCount(`customer_stats?select=${COLS}${f}&order=${order}&limit=${size}&offset=${(page - 1) * size}`);
    return json(200, { rows, total, page, pages: Math.max(1, Math.ceil(total / size)), size });
  } catch (e) {
    console.error('Admin klienci: ' + (e instanceof Error ? e.message : String(e)));
    return json(500, { error: 'Błąd pobierania klientów. Czy uruchomiono skrypt 008_segmenty_notatki.sql?' });
  }
};

// Notatka o kliencie: { id, note }
export const POST: APIRoute = async ({ request, locals }) => {
  const env = await getEnv(locals);
  const admin = await requireAdmin(request, env);
  if (!admin) return json(401, { error: 'Brak dostępu.' });
  let b: any;
  try { b = await request.json(); } catch { return json(400, { error: 'Nieprawidłowe dane.' }); }
  if (!/^[0-9a-f-]{36}$/i.test(b?.id || '')) return json(400, { error: 'Nieprawidłowy klient.' });

  // Edycja danych klienta: { id, action: 'update', ... }
  if (b.action === 'update') {
    const sb = db(env);
    const [cur] = await sb.select<any>(`customers?select=id,email,user_id,marketing_consent&id=eq.${b.id}`);
    if (!cur) return json(404, { error: 'Nie znaleziono klienta.' });
    const email = str(b.email, 200).toLowerCase();
    const phone = cleanPhone(b.phone);
    const locker = str(b.default_locker, 15).toUpperCase();
    const addr = { street: str(b.street, 120), postcode: str(b.postcode, 6), city: str(b.city, 60), country: str(b.country, 2).toUpperCase() || 'PL' };
    const inv = { company: str(b.company, 150), nip: str(b.nip, 13).replace(/\D/g, ''), street: str(b.invStreet, 120), postcode: str(b.invPostcode, 6), city: str(b.invCity, 60) };
    const hasInv = Boolean(inv.company || inv.nip);
    const errors: string[] = [];
    if (!EMAIL_RE.test(email)) errors.push('Nieprawidłowy e-mail.');
    if (email !== cur.email && cur.user_id) errors.push('Klient ma konto – e-mail służy do logowania i zmienia go sam klient (lub przez wsparcie Supabase).');
    if (phone && !validPhone(phone)) errors.push('Telefon: 9 cyfr.');
    if (locker && !LOCKER_RE.test(locker)) errors.push('Nieprawidłowy kod Paczkomatu.');
    if (addr.postcode && !POSTCODE_RE.test(addr.postcode)) errors.push('Kod pocztowy: 00-000.');
    if (hasInv && (!inv.company || !validNip(inv.nip))) errors.push('Faktura: podaj firmę i poprawny NIP.');
    if (errors.length) return json(422, { error: errors.join(' ') });
    if (email !== cur.email) {
      const dup = await sb.select(`customers?select=id&email=eq.${encodeURIComponent(email)}`);
      if (dup.length) return json(409, { error: 'Inny klient ma już ten e-mail.' });
    }
    const patch: Record<string, unknown> = {
      email, first_name: str(b.first_name, 60) || null, last_name: str(b.last_name, 60) || null, phone: phone || null,
      default_locker: locker || null, default_address: addr.street || addr.city ? addr : null, billing: hasInv ? inv : null,
    };
    const consent = b.marketing_consent === true;
    if (consent !== cur.marketing_consent) Object.assign(patch, consent ? { marketing_consent: true, consent_at: new Date().toISOString(), consent_source: `panel (${admin})` } : { marketing_consent: false });
    try {
      const [row] = await sb.update(`customers?id=eq.${b.id}`, patch, 'id');
      if (email !== cur.email) await sb.update(`orders?customer_id=eq.${b.id}&status=in.(pending_payment,paid,on_hold)`, { email }, 'id');
      console.log(`Admin ${admin} edytował klienta ${b.id}`);
      return json(200, { row });
    } catch (e) {
      console.error('Edycja klienta: ' + (e instanceof Error ? e.message : String(e)));
      return json(500, { error: 'Nie udało się zapisać.' });
    }
  }

  const note = String(b.note ?? '').replace(/\r/g, '').trim().slice(0, 1000);
  try {
    const [row] = await db(env).update(`customers?id=eq.${b.id}`, { admin_note: note || null }, 'id,admin_note');
    return row ? json(200, { row }) : json(404, { error: 'Nie znaleziono klienta.' });
  } catch (e) {
    console.error('Notatka klienta: ' + (e instanceof Error ? e.message : String(e)));
    return json(500, { error: 'Nie udało się zapisać notatki.' });
  }
};
</file>

<file path="src/pages/api/admin/upload.ts">
import type { APIRoute } from 'astro';
import { getEnv, json } from '../../../lib/env';
import { requireAdmin } from '../../../lib/admin-auth';

export const prerender = false;

const TYPES: Record<string, string> = { 'image/webp': 'webp', 'image/jpeg': 'jpg', 'image/png': 'png' };

// Pobranie istniejącego zdjęcia (do usuwania tła w przeglądarce) – omija CORS obcych serwerów.
// Tylko admin, tylko https i tylko obrazy do 8 MB; Worker i tak nie sięga do sieci prywatnych (global_fetch_strictly_public).
export const GET: APIRoute = async ({ request, url, locals }) => {
  const env = await getEnv(locals);
  if (!(await requireAdmin(request, env))) return json(401, { error: 'Brak dostępu.' });
  const src = url.searchParams.get('src') || '';
  if (!/^https:\/\/[^\s]+$/.test(src)) return json(400, { error: 'Nieprawidłowy adres zdjęcia.' });
  try {
    const res = await fetch(src, { redirect: 'follow' });
    const type = (res.headers.get('Content-Type') || '').split(';')[0].trim();
    if (!res.ok || !/^image\/(png|jpeg|webp|gif)$/.test(type)) return json(422, { error: 'Pod tym adresem nie ma zdjęcia.' });
    const buf = await res.arrayBuffer();
    if (buf.byteLength > 8 * 1024 * 1024) return json(413, { error: 'Zdjęcie jest większe niż 8 MB.' });
    return new Response(buf, { headers: { 'Content-Type': type, 'Cache-Control': 'no-store' } });
  } catch (e) {
    console.error('Pobranie zdjęcia: ' + (e instanceof Error ? e.message : String(e)));
    return json(502, { error: 'Nie udało się pobrać zdjęcia.' });
  }
};

// Wysyłka zdjęcia produktu do Supabase Storage (publiczny bucket „products”)
export const POST: APIRoute = async ({ request, locals }) => {
  const env = await getEnv(locals);
  const admin = await requireAdmin(request, env);
  if (!admin) return json(401, { error: 'Brak dostępu.' });
  const form = await request.formData().catch(() => null);
  const file = form?.get('file');
  const product = String(form?.get('product') || 'produkt').replace(/[^a-z0-9-]/g, '').slice(0, 60) || 'produkt';
  if (!(file instanceof File)) return json(400, { error: 'Brak pliku.' });
  const ext = TYPES[file.type];
  if (!ext) return json(415, { error: 'Dozwolone formaty: WebP, JPG, PNG.' });
  if (file.size > 5 * 1024 * 1024) return json(413, { error: 'Plik jest większy niż 5 MB.' });

  const base = (env.SUPABASE_URL || '').replace(/\/+$/, '').replace(/\/rest\/v1$/, '');
  const key = env.SUPABASE_SECRET_KEY || '';
  const name = `${product}/${Date.now()}-${crypto.randomUUID().slice(0, 8)}.${ext}`;
  const res = await fetch(`${base}/storage/v1/object/products/${name}`, {
    method: 'POST',
    headers: { apikey: key, ...(key.startsWith('eyJ') ? { Authorization: `Bearer ${key}` } : {}), 'Content-Type': file.type, 'Cache-Control': 'max-age=31536000', 'x-upsert': 'false' },
    body: file.stream(),
    // @ts-ignore – wymagane przy wysyłaniu strumienia
    duplex: 'half',
  });
  if (!res.ok) {
    console.error('Upload zdjęcia: ' + res.status + ' ' + (await res.text()));
    return json(502, { error: 'Nie udało się zapisać zdjęcia. Czy istnieje bucket „products” w Supabase Storage?' });
  }
  return json(200, { url: `${base}/storage/v1/object/public/products/${name}` });
};
</file>

<file path="src/pages/api/furgonetka/orders/[id]/tracking_number.ts">
import type { APIRoute } from 'astro';
import { getEnv, json } from '../../../../../lib/env';
import { db } from '../../../../../lib/supabase';
import { authorized } from '../../../../../lib/furgonetka';
import { sendMail } from '../../../../../lib/mail';
import { trackingUrl, carrierLabel } from '../../../../../lib/tracking';
import { orderShippedHtml } from '../../../../../lib/email-templates';
import { getSite } from '../../../../../lib/site-settings';

export const prerender = false;

// POST /api/furgonetka/orders/{numer}/tracking_number  { tracking: { number, courierService } }
// Furgonetka odsyła numer przesyłki po jej utworzeniu.
export const POST: APIRoute = async ({ request, params, locals }) => {
  const env = await getEnv(locals);
  if (!authorized(request, env)) return json(401, { error: 'Unauthorized' });

  const number = Number(params.id);
  let b: any;
  try { b = await request.json(); } catch { return json(400, { error: 'Bad request' }); }
  const tracking = String(b?.tracking?.number || '').replace(/\s/g, '').slice(0, 60);
  const carrier = String(b?.tracking?.courierService || '').slice(0, 40);
  if (!Number.isInteger(number) || !tracking) return json(400, { error: 'Bad request' });

  try {
    const sb = db(env);
    const [order] = await sb.select<any>(`orders?select=id,number,email,status,tracking_number&number=eq.${number}`);
    if (!order) return json(404, { error: 'Not found' });

    await sb.insert('order_events', { order_id: order.id, type: 'furgonetka_tracking', data: { tracking, carrier } }, 'id');
    if (order.tracking_number === tracking) return json(200, {}); // powtórzone powiadomienie

    const patch: Record<string, unknown> = { tracking_number: tracking, carrier: carrier || null };
    const becomesShipped = ['paid', 'on_hold'].includes(order.status);
    if (becomesShipped) Object.assign(patch, { status: 'shipped', shipped_at: new Date().toISOString() });
    await sb.update(`orders?id=eq.${order.id}`, patch, 'id');
    if (becomesShipped) {
      await sb.insert('order_events', { order_id: order.id, type: 'status_change', data: { from: order.status, to: 'shipped', by: 'Furgonetka', carrier, tracking } }, 'id');
    }

    try {
      await sendMail(env, {
        to: order.email,
        subject: `Zamówienie nr ${order.number} zostało wysłane – Can-C`,
        replyTo: env.CONTACT_TO?.split(',')[0]?.trim(),
        html: orderShippedHtml({ site: await getSite(env), origin: new URL(request.url).origin, number: order.number, carrier: carrierLabel(carrier), tracking, trackingUrl: trackingUrl(carrier, tracking) }),
        text: [
          'Dzień dobry,', '',
          `Twoje zamówienie nr ${order.number} zostało nadane (${carrierLabel(carrier)}).`,
          `Numer przesyłki: ${tracking}`,
          `Śledzenie: ${trackingUrl(carrier, tracking)}`, '',
          'Dziękujemy za zakupy!', 'Zespół Can-C',
        ].join('\n'),
      });
      await sb.insert('order_events', { order_id: order.id, type: 'mail_shipped', data: {} }, 'id');
    } catch (e) {
      console.error('Mail o wysyłce (Furgonetka): ' + (e instanceof Error ? e.message : String(e)));
    }
    return json(200, {});
  } catch (e) {
    console.error('Furgonetka tracking: ' + (e instanceof Error ? e.message : String(e)));
    return json(500, { error: 'Server error' });
  }
};
</file>

<file path="src/pages/api/furgonetka/orders/index.ts">
import type { APIRoute } from 'astro';
import { getEnv, json } from '../../../../lib/env';
import { db } from '../../../../lib/supabase';
import { authorized, fromWarsaw, toFurgonetkaOrder } from '../../../../lib/furgonetka';

export const prerender = false;

// GET /api/furgonetka/orders?datetime=2026-11-02T10:00:00&limit=100
// Furgonetka cyklicznie pobiera zamówienia zmienione po podanej dacie (od najstarszych).
// Przekazujemy tylko zamówienia z nowego sklepu, opłacone lub później (nieopłacone nie trafiają do wysyłki).
export const GET: APIRoute = async ({ request, url, locals }) => {
  const env = await getEnv(locals);
  if (!authorized(request, env)) return json(401, { error: 'Unauthorized' });

  const since = fromWarsaw(url.searchParams.get('datetime') || '') || '2000-01-01T00:00:00Z';
  const limit = Math.min(100, Math.max(1, Number(url.searchParams.get('limit')) || 100));
  const sources = env.ALLOW_WC_ACTIONS === 'true' ? 'shop,admin,woocommerce' : 'shop,admin';

  try {
    const rows = await db(env).select(
      `orders?select=id,number,created_at,updated_at,paid_at,email,status,total,shipping_cost,shipping_method,shipping_point,shipping_address,billing,customer_note,` +
        `order_items(product_id,name,qty,total,products(ean)),customers(first_name,last_name,phone)` +
        `&source=in.(${sources})&status=in.(paid,on_hold,shipped,completed,cancelled)` +
        `&updated_at=gt.${encodeURIComponent(since)}&order=updated_at.asc&limit=${limit}`,
    );
    return json(200, rows.map(toFurgonetkaOrder));
  } catch (e) {
    console.error('Furgonetka orders: ' + (e instanceof Error ? e.message : String(e)));
    return json(500, { error: 'Server error' });
  }
};
</file>

<file path="src/pages/api/odstapienie.ts">
import type { APIRoute } from 'astro';
import { getEnv, json } from '../../lib/env';
import { db } from '../../lib/supabase';
import { sendMail } from '../../lib/mail';
import { getSite } from '../../lib/site-settings';
import { withdrawalConfirmHtml } from '../../lib/email-templates';

export const prerender = false;

// Funkcja odstąpienia od umowy: zapis oświadczenia + potwierdzenie na trwałym nośniku (e-mail)
export const POST: APIRoute = async ({ request, locals }) => {
  const origin = request.headers.get('Origin');
  if (origin && new URL(origin).host !== new URL(request.url).host) return json(403, { error: 'Niedozwolone źródło żądania.' });

  let b: any;
  try { b = await request.json(); } catch { return json(400, { error: 'Nieprawidłowe dane.' }); }
  if (String(b.website || '')) return json(200, { ok: true, number: b.number });

  const number = Number(String(b.number || '').replace(/\D/g, ''));
  const email = String(b.email || '').trim().toLowerCase().slice(0, 200);
  const name = String(b.name || '').replace(/[\r\n]+/g, ' ').trim().slice(0, 120);
  const scope = b.scope === 'part' ? 'part' : 'all';
  const items = String(b.items || '').replace(/[\r\n]+/g, ' ').trim().slice(0, 300);
  const note = String(b.note || '').replace(/\r/g, '').trim().slice(0, 1000);

  if (!Number.isInteger(number) || number <= 0) return json(422, { error: 'Podaj numer zamówienia.' });
  if (!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(email)) return json(422, { error: 'Podaj e-mail użyty przy zamówieniu.' });
  if (name.length < 3) return json(422, { error: 'Podaj imię i nazwisko.' });
  if (scope === 'part' && items.length < 3) return json(422, { error: 'Napisz, których produktów dotyczy odstąpienie.' });

  const env = await getEnv(locals);
  const site = await getSite(env);
  try {
    const sb = db(env);
    const [order] = await sb.select<any>(`orders?select=id,number,email,status,created_at&number=eq.${number}&email=eq.${encodeURIComponent(email)}`);
    // Ta sama odpowiedź dla złego numeru i złego e-maila – nie zdradzamy, czy zamówienie istnieje
    if (!order) return json(404, { error: 'Nie znaleźliśmy zamówienia o tym numerze dla podanego e-maila. Sprawdź dane albo napisz do nas.' });

    const recent = await sb.select(`order_events?select=id&order_id=eq.${order.id}&type=eq.withdrawal`);
    if (recent.length >= 3) return json(429, { error: 'Oświadczenie dla tego zamówienia zostało już złożone. Odpowiemy wkrótce.' });

    const receivedAt = new Date();
    await sb.insert('order_events', { order_id: order.id, type: 'withdrawal', data: { name, scope, items: scope === 'part' ? items : 'całe zamówienie', note } }, 'id');

    const when = receivedAt.toLocaleString('pl-PL', { timeZone: 'Europe/Warsaw' });
    const scopeText = scope === 'part' ? `część zamówienia: ${items}` : 'całe zamówienie';
    await sendMail(env, {
      to: email,
      replyTo: env.CONTACT_TO?.split(',')[0]?.trim(),
      subject: `Potwierdzenie odstąpienia od umowy – zamówienie nr ${order.number}`,
      html: withdrawalConfirmHtml({ site, origin: new URL(request.url).origin, name, number: order.number, when, scopeText, note }),
      text: [
        `Dzień dobry ${name},`, '',
        `potwierdzamy otrzymanie oświadczenia o odstąpieniu od umowy sprzedaży (zamówienie nr ${order.number}).`,
        `Data i godzina otrzymania: ${when}`,
        `Zakres: ${scopeText}`, note ? `Uwagi: ${note}` : '', '',
        'Co dalej:',
        `1. Odeślij produkt w ciągu 14 dni – najwygodniej przez formularz szybkich zwrotów: ${site.returnsUrl}`,
        `   albo na adres: ${site.company}, ${site.address}.`,
        '2. Zwrócimy pieniądze tą samą metodą płatności w ciągu 14 dni (możemy wstrzymać zwrot do otrzymania produktu lub dowodu nadania).',
        '', 'Zwrotowi podlegają produkty w nienaruszonym, fabrycznie zamkniętym opakowaniu.', '',
        `Zespół Can-C · ${site.email}`,
      ].filter((l) => l !== '').join('\n'),
    });
    if (env.CONTACT_TO) {
      await sendMail(env, {
        to: env.CONTACT_TO.split(',').map((s) => s.trim()),
        replyTo: email,
        subject: `[can-c.pl] Odstąpienie od umowy – zamówienie nr ${order.number}`,
        text: `Klient: ${name} <${email}>\nZamówienie: ${order.number} (status: ${order.status})\nZakres: ${scopeText}\nUwagi: ${note || '—'}\nOtrzymano: ${when}`,
      }).catch((e) => console.error('Mail do sklepu (odstąpienie): ' + (e instanceof Error ? e.message : String(e))));
    }
    return json(200, { ok: true, number: order.number });
  } catch (e) {
    console.error('Odstąpienie: ' + (e instanceof Error ? e.message : String(e)));
    return json(500, { error: `Nie udało się zapisać oświadczenia. Wyślij je e-mailem na ${site.email}.` });
  }
};
</file>

