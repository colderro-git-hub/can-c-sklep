---
import Base from '../layouts/Base.astro';
import Arrow from '../components/Arrow.astro';
import { products, lineTotal, formatPrice } from '../data/shop';

const drops = products.find((p) => p.slug === 'krople-can-c')!;
const plan = [
  { label: '1 miesiąc', qty: 1, rec: '1 opakowanie' },
  { label: '2 miesiące', qty: 2, rec: 'Zestaw 2 opakowań' },
  { label: '3–4 miesiące', qty: 4, rec: 'Zestaw 4 opakowań' },
  { label: '6 miesięcy', qty: 6, rec: '6 opakowań' },
].map((p) => {
  const total = lineTotal(drops, p.qty);
  const regular = drops.price !== null ? drops.price * p.qty : null;
  const saved = total !== null && regular ? Math.round((1 - total / regular) * 100) : 0;
  return { ...p, price: `${formatPrice(total)}${saved ? ` · oszczędzasz ${saved}%` : ''}` };
});
const defaultPlan = 2;

const openSteps = [
  'Zdejmij dolny pierścień zabezpieczający.',
  'Dokręć nakrętkę zgodnie z ruchem wskazówek zegara. Kolec w nakrętce przebije dyszę.',
  'Odkręć nakrętkę w przeciwnym kierunku i zdejmij ją.',
  'Delikatnie naciśnij fiolkę, aby wydobyć kroplę. Po użyciu załóż nakrętkę.',
];
const applySteps = [
  { t: 'Odchyl głowę do tyłu', d: 'Patrz w górę. Przy problemach z szyją połóż się lub usiądź w fotelu z odchylanym oparciem.' },
  { t: 'Zakroplij jedną kroplę', d: 'Nie dotykaj końcówką fiolki oka ani rzęs.' },
  { t: 'Powoli zamknij oko', d: 'Zamknij je delikatnie, bez zaciskania powiek.' },
  { t: 'Odczekaj 60 sekund', d: 'Nie mrugaj i nie otwieraj oka. W tym czasie kropla wchłania się w tkankę.' },
  { t: 'Powtórz przy drugiej kropli', d: 'Jeśli stosujesz dwie krople, powtórz całą procedurę.' },
];
const toc = [
  { href: '#dawkowanie', label: 'Dawkowanie' },
  { href: '#otwieranie', label: 'Otwieranie fiolki' },
  { href: '#zakraplanie', label: 'Zakraplanie' },
  { href: '#kuracja', label: 'Ile opakowań potrzebujesz' },
];

const howTo = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: 'Jak stosować krople do oczu Can-C',
  step: applySteps.map((s, i) => ({ '@type': 'HowToStep', position: i + 1, name: s.t, text: s.d })),
};
---
<Base title="Jak stosować krople Can-C | Dawkowanie i aplikacja" description="Dawkowanie kropli Can-C, otwieranie fiolki i prawidłowe zakraplanie krok po kroku. Sprawdź, ile opakowań potrzebujesz na kurację.">
  <script type="application/ld+json" set:html={JSON.stringify(howTo)} />

  <section class="page-hero">
    <div class="container hero-split">
      <div class="page-hero__inner">
        <nav class="crumbs" aria-label="Ścieżka"><a href="/">Strona główna</a> / Stosowanie</nav>
        <h1>Jak stosować krople Can-C</h1>
        <p class="lead">Pierwsze efekty mogą pojawić się po miesiącu. Producent zaleca kurację trwającą co najmniej 3–5 miesięcy.</p>
      </div>
      <nav class="toc" aria-label="Na tej stronie">
        {toc.map((t) => (
          <a href={t.href}>{t.label}
            <svg width="10" height="16" viewBox="0 0 10 16" fill="none" aria-hidden="true"><path d="M5 0v14M1 10l4 4 4-4" stroke="currentColor" stroke-width="1.2" /></svg>
          </a>
        ))}
      </nav>
    </div>
  </section>

  <section id="dawkowanie" class="section section--dark">
    <div class="container stack">
      <h2>Dawkowanie</h2>
      <div class="dose-grid">
        <div class="dose"><span class="dose__num">1–2</span><span class="dose__t">krople do oka, dwa razy dziennie</span><span class="dose__d">Standardowe dawkowanie w trakcie kuracji.</span></div>
        <div class="dose"><span class="dose__num">4</span><span class="dose__t">krople do oka dziennie to maksimum</span><span class="dose__d">Większa dawka nie daje dodatkowych korzyści. Nie przekraczaj jej.</span></div>
        <div class="dose"><span class="dose__num">1</span><span class="dose__t">kropla raz dziennie, profilaktycznie</span><span class="dose__d">Po zakończeniu kuracji, z okresowymi przerwami.</span></div>
      </div>
      <p class="note-dark">Krople Can-C nie zastępują leczenia. Jeśli masz zdiagnozowaną chorobę oczu, przed rozpoczęciem kuracji porozmawiaj z okulistą.</p>
    </div>
  </section>

  <section id="otwieranie" class="section">
    <div class="container stack">
      <div class="intro">
        <h2>Otwieranie fiolki</h2>
        <p class="lead">Fiolka jest fabrycznie zamknięta. Przy pierwszym użyciu przebijasz ją kolcem w nakrętce.</p>
      </div>
      <ol class="open-steps">
        {openSteps.map((t, i) => (
          <li>
            <div class="ph open-steps__img">[Ilustracja {i + 1}]</div>
            <span class="open-steps__n">{i + 1}</span>
            <span class="open-steps__t">{t}</span>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section id="zakraplanie" class="section section--tint">
    <div class="container split">
      <div class="split__aside">
        <h2>Zakraplanie</h2>
        <p class="lead">Najważniejsze jest 60 sekund z zamkniętym okiem. Nawet jedno mrugnięcie wypycha większość kropli.</p>
        <div class="ph apply-img">[Ilustracja: odchylona głowa, zakraplanie]</div>
      </div>
      <ol class="apply split__main">
        {applySteps.map((s, i) => (
          <li>
            <span class="apply__n">{i + 1}</span>
            <span class="apply__text"><span class="apply__t">{s.t}</span><span class="muted">{s.d}</span></span>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section id="kuracja" class="section">
    <div class="container split">
      <div class="split__aside">
        <h2 class="h3">Ile opakowań potrzebujesz</h2>
        <p class="lead">Jedno opakowanie (2 × 5 ml) wystarcza na około miesiąc przy standardowym dawkowaniu.</p>
      </div>
      <div class="calc split__main" data-calc>
        <fieldset>
          <legend>Jak długo planujesz kurację?</legend>
          <div class="pill-group">
            {plan.map((p, i) => (
              <label class="pill">
                <input type="radio" name="plan" value={p.qty} checked={i === defaultPlan} data-rec={p.rec} data-price={p.price} />
                {p.label}
              </label>
            ))}
          </div>
        </fieldset>
        <div class="calc__result" aria-live="polite">
          <span class="muted">Polecamy</span>
          <span class="calc__rec" data-rec-out>{plan[defaultPlan].rec}</span>
          <span data-price-out>{plan[defaultPlan].price}</span>
        </div>
        <a href={`/produkt/krople-can-c/?zestaw=${plan[defaultPlan].qty}`} class="btn" data-go>Przejdź do zamówienia <Arrow /></a>
      </div>
    </div>
  </section>
</Base>

<script>
  const calc = document.querySelector<HTMLElement>('[data-calc]');
  if (calc) {
    const rec = calc.querySelector<HTMLElement>('[data-rec-out]')!;
    const price = calc.querySelector<HTMLElement>('[data-price-out]')!;
    const go = calc.querySelector<HTMLAnchorElement>('[data-go]')!;
    calc.querySelectorAll<HTMLInputElement>('input[name="plan"]').forEach((r) =>
      r.addEventListener('change', () => {
        rec.textContent = r.dataset.rec ?? '';
        price.textContent = r.dataset.price ?? '';
        go.href = `/produkt/krople-can-c/?zestaw=${r.value}`;
      }),
    );
  }
</script>

