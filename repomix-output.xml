import type { APIRoute } from 'astro';
import { getEnv, json } from '../../../lib/env';
import { db } from '../../../lib/supabase';
import { requireAdmin } from '../../../lib/admin-auth';

export const prerender = false;

const STATUSES = ['pending_payment', 'paid', 'on_hold', 'shipped', 'completed', 'cancelled', 'refunded', 'failed'];
const PAGE = 50;

// Lista zamówień: ?status=paid&q=18772|email&page=1
export const GET: APIRoute = async ({ request, url, locals }) => {
  const env = await getEnv(locals);
  if (!(await requireAdmin(request, env))) return json(401, { error: 'Brak dostępu.' });

  const status = url.searchParams.get('status') || '';
  const q = (url.searchParams.get('q') || '').trim().slice(0, 100);
  const page = Math.max(1, Number(url.searchParams.get('page')) || 1);

  const filters: string[] = [];
  if (STATUSES.includes(status)) filters.push(`status=eq.${status}`);
  if (/^\d+$/.test(q)) filters.push(`number=eq.${q}`);
  else if (q) filters.push(`email=ilike.*${encodeURIComponent(q.toLowerCase().replace(/[*,()]/g, ''))}*`);

  try {
    const sb = db(env);
    const { rows, total } = await sb.selectCount(
      `orders?select=id,number,created_at,email,status,total,shipping_method,shipping_point,tracking_number,carrier,source,shipping_address,order_items(name,qty)` +
        (filters.length ? `&${filters.join('&')}` : '') +
        `&order=created_at.desc&limit=${PAGE}&offset=${(page - 1) * PAGE}`,
    );
    // Liczniki do zakładek (tylko statusy wymagające działania)
    const counts: Record<string, number> = {};
    for (const s of ['paid', 'on_hold', 'pending_payment', 'shipped']) {
      counts[s] = (await sb.selectCount(`orders?select=id&status=eq.${s}&limit=1`)).total;
    }
    // Sprzedaż: ostatnie 30 dni i dzisiaj (opłacone, wysłane, zrealizowane)
    const day = 24 * 60 * 60 * 1000;
    const since30 = new Date(Date.now() - 30 * day).toISOString();
    const paidRows = await sb.select<{ total: number; paid_at: string }>(
      `orders?select=total,paid_at&status=in.(paid,shipped,completed)&paid_at=gte.${encodeURIComponent(since30)}&limit=5000`,
    );
    const todayStart = new Date(new Date().toLocaleString('en-US', { timeZone: 'Europe/Warsaw' }));
    todayStart.setHours(0, 0, 0, 0);
    const offset = Date.now() - new Date(new Date().toLocaleString('en-US', { timeZone: 'Europe/Warsaw' })).getTime();
    const todayUtc = todayStart.getTime() + offset;
    const sum = (rs: { total: number }[]) => rs.reduce((a, r) => a + r.total, 0);
    const today = paidRows.filter((r) => new Date(r.paid_at).getTime() >= todayUtc);
    const stats = {
      revenue30: sum(paidRows), orders30: paidRows.length,
      avg30: paidRows.length ? Math.round(sum(paidRows) / paidRows.length) : 0,
      revenueToday: sum(today), ordersToday: today.length,
    };
    return json(200, { rows, total, page, pages: Math.max(1, Math.ceil(total / PAGE)), counts, stats });
  } catch (e) {
    console.error('Admin orders: ' + (e instanceof Error ? e.message : String(e)));
    return json(500, { error: 'Błąd pobierania zamówień.' });
  }
};
</file>

<file path="src/pages/api/admin/ustawienia.ts">
import type { APIRoute } from 'astro';
import { getEnv, json } from '../../../lib/env';
import { db } from '../../../lib/supabase';
import { requireAdmin } from '../../../lib/admin-auth';
import { getSite, clearSiteCache, SITE_KEYS, CONTENT_KEYS } from '../../../lib/site-settings';
import { getCustomRobots, clearRobotsCache, defaultRobots, invalidRobotsLines, renderRobots, ROBOTS_MAX } from '../../../lib/robots';

export const prerender = false;

export const GET: APIRoute = async ({ request, locals }) => {
  const env = await getEnv(locals);
  if (!(await requireAdmin(request, env))) return json(401, { error: 'Brak dostępu.' });
  clearSiteCache(); clearRobotsCache();
  const custom = await getCustomRobots(env);
  return json(200, { site: await getSite(env), robots: { text: custom, default: defaultRobots(), preview: renderRobots(custom, 'https://can-c.pl') } });
};

export const POST: APIRoute = async ({ request, locals }) => {
  const env = await getEnv(locals);
  const admin = await requireAdmin(request, env);
  if (!admin) return json(401, { error: 'Brak dostępu.' });
  let b: any;
  try { b = await request.json(); } catch { return json(400, { error: 'Nieprawidłowe dane.' }); }

  // robots.txt – osobny zapis (klucz settings 'robots'); pusta treść = domyślna
  if (b.action === 'robots') {
    const text = String(b.text ?? '').replace(/\r/g, '').replace(/\t/g, ' ').trim();
    if (text.length > ROBOTS_MAX) return json(422, { error: `robots.txt może mieć maks. ${ROBOTS_MAX} znaków.` });
    const bad = invalidRobotsLines(text);
    if (bad.length) return json(422, { error: `Nieprawidłowe linie: ${bad.slice(0, 5).join(', ')}. Każda linia to „Pole: wartość”, komentarz (#) albo pusta.` });
    try {
      await db(env).upsert('settings', { key: 'robots', value: { text }, updated_at: new Date().toISOString(), updated_by: admin }, 'key', 'key');
      clearRobotsCache();
      console.log(`Admin ${admin} zmienił robots.txt`);
      return json(200, { robots: { text, default: defaultRobots(), preview: renderRobots(text, 'https://can-c.pl') } });
    } catch (e) {
      console.error('Zapis robots.txt: ' + (e instanceof Error ? e.message : String(e)));
      return json(500, { error: 'Nie udało się zapisać robots.txt.' });
    }
  }

  const v: Record<string, string> = {};
  for (const k of SITE_KEYS) v[k] = String(b[k] ?? '').replace(/[\r\n\t]+/g, ' ').trim().slice(0, 200);

  const errors: string[] = [];
  if (!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(v.email)) errors.push('Nieprawidłowy e-mail.');
  if (v.phone && !/^[+\d][\d\s-]{6,20}$/.test(v.phone)) errors.push('Nieprawidłowy telefon.');
  if (!v.company || !v.address) errors.push('Podaj nazwę firmy i adres.');
  if (v.nip && !/^\d{10}$/.test(v.nip.replace(/\D/g, ''))) errors.push('NIP: 10 cyfr.');
  if (v.regon && !/^\d{9}(\d{5})?$/.test(v.regon.replace(/\D/g, ''))) errors.push('REGON: 9 lub 14 cyfr.');
  for (const k of ['facebook', 'returnsUrl'] as const) if (v[k] && !/^https:\/\/[^\s]+$/.test(v[k])) errors.push(`Adres ${k === 'facebook' ? 'Facebooka' : 'szybkich zwrotów'} musi zaczynać się od https://`);
  if (errors.length) return json(422, { error: errors.join(' ') });
  v.nip = v.nip.replace(/\D/g, ''); v.regon = v.regon.replace(/\D/g, '');

  // Treści: pasek promocji, czas wysyłki, komunikat
  const LIMITS: Record<string, number> = { promo1: 80, promo2: 80, promo3: 80, shippingTime: 80, noticeText: 300 };
  for (const k of CONTENT_KEYS) v[k] = String(b[k] ?? '').replace(/[\r\n\t]+/g, ' ').trim().slice(0, LIMITS[k] ?? 40);
  v.noticeEnabled = b.noticeEnabled === true || b.noticeEnabled === 'true' ? 'true' : '';
  const toIso = (x: string) => { if (!x) return ''; const d = new Date(x); return isNaN(+d) ? 'bad' : d.toISOString(); };
  v.noticeFrom = toIso(v.noticeFrom); v.noticeTo = toIso(v.noticeTo);
  if (v.noticeFrom === 'bad' || v.noticeTo === 'bad') return json(422, { error: 'Nieprawidłowa data komunikatu.' });
  if (v.noticeFrom && v.noticeTo && v.noticeFrom > v.noticeTo) return json(422, { error: 'Data końca komunikatu jest wcześniejsza niż początku.' });
  if (v.noticeEnabled && !v.noticeText) return json(422, { error: 'Wpisz treść komunikatu albo go wyłącz.' });
  if (!v.shippingTime) return json(422, { error: 'Podaj czas wysyłki.' });

  try {
    await db(env).upsert('settings', { key: 'site', value: v, updated_at: new Date().toISOString(), updated_by: admin }, 'key', 'key');
    clearSiteCache();
    console.log(`Admin ${admin} zmienił ustawienia sklepu`);
    return json(200, { site: v });
  } catch (e) {
    console.error('Zapis ustawień: ' + (e instanceof Error ? e.message : String(e)));
    return json(500, { error: 'Nie udało się zapisać. Czy uruchomiono skrypt 006_ustawienia.sql?' });
  }
};
</file>

<file path="src/pages/api/zamowienie/status.ts">
import type { APIRoute } from 'astro';
import { getEnv, json } from '../../../lib/env';
import { db } from '../../../lib/supabase';
import { getCatalog, leadTimeText } from '../../../lib/catalog';
import { getSite } from '../../../lib/site-settings';
import { p24Config, paymentMethodName } from '../../../lib/p24';

export const prerender = false;

// Pełne podsumowanie pokazujemy tylko przez tyle dni od złożenia zamówienia.
// Identyfikator to losowy UUID (122 bity), ale adres strony zostaje w historii przeglądarki.
const DETAILS_DAYS = 7;
const PAID = ['paid', 'shipped', 'completed'];
const CLOSED = ['cancelled', 'failed', 'refunded'];

type Order = {
  id: string; number: number; status: string; total: number; subtotal: number; discount: number; shipping_cost: number;
  discount_code: string | null; discount_code_amount: number; created_at: string; paid_at: string | null; email: string;
  shipping_method: string; shipping_point: string | null; shipping_address: Record<string, string> | null;
  billing: Record<string, string> | null; wants_invoice: boolean; customer_note: string | null; payment_provider: string | null;
};

// Status i podsumowanie zamówienia dla strony „Dziękujemy”
export const GET: APIRoute = async ({ url, locals }) => {
  const id = url.searchParams.get('id') || '';
  if (!/^[0-9a-f-]{36}$/i.test(id)) return json(400, { error: 'Nieprawidłowy identyfikator.' });
  const env = await getEnv(locals);
  try {
    const sb = db(env);
    const [o] = await sb.select<Order>(
      `orders?select=id,number,status,total,subtotal,discount,shipping_cost,discount_code,discount_code_amount,created_at,paid_at,email,shipping_method,shipping_point,shipping_address,billing,wants_invoice,customer_note,payment_provider&id=eq.${id}`,
    );
    if (!o) return json(404, { error: 'Nie znaleziono zamówienia.' });
    const base = { number: o.number, status: o.status, total: o.total };
    const fresh = Date.now() - new Date(o.created_at).getTime() < DETAILS_DAYS * 864e5;
    if (!fresh || CLOSED.includes(o.status)) return json(200, { ...base, details: null });

    const [items, catalog, site] = await Promise.all([
      sb.select<{ product_id: string; name: string; qty: number; unit_price: number; discount: number; total: number }>(
        `order_items?select=product_id,name,qty,unit_price,discount,total&order_id=eq.${id}`,
      ),
      getCatalog(env).catch(() => []),
      getSite(env),
    ]);

    // Termin wysyłki: jeden dla całego zamówienia albo przy każdym produkcie, gdy się różnią
    const lines = items.map((i) => {
      const p = catalog.find((c) => c.id === i.product_id);
      return {
        slug: i.product_id, name: i.name, qty: i.qty, unitPrice: i.unit_price, discount: i.discount, total: i.total,
        image: p?.images[0]?.url || null, leadTime: leadTimeText(p?.lead_time, site.shippingTime),
      };
    });
    const leadTimes = [...new Set(lines.map((l) => l.leadTime))];

    // Metoda płatności: identyfikator z powiadomienia P24 → nazwa z API P24
    const provider = o.payment_provider || 'przelewy24';
    let method: string | null = null;
    if (PAID.includes(o.status) && provider === 'przelewy24') {
      try {
        const events = await sb.select<{ data: { methodId?: number } }>(
          `order_events?select=data&order_id=eq.${id}&type=in.(p24_verified,p24_notification)&order=created_at.desc&limit=5`,
        );
        const methodId = events.map((e) => Number(e.data?.methodId)).find((n) => n > 0);
        if (methodId) method = await paymentMethodName(p24Config(env), methodId);
      } catch (e) {
        console.error('Status zamówienia – metoda płatności: ' + (e instanceof Error ? e.message : String(e)));
      }
    }

    const a = o.shipping_address || {};
    const details = {
      createdAt: o.created_at,
      paidAt: o.paid_at,
      email: o.email,
      items: lines,
      subtotal: o.subtotal,
      bundleDiscount: Math.max(0, o.discount - (o.discount_code_amount || 0)),
      code: o.discount_code,
      codeAmount: o.discount_code_amount || 0,
      shipping: o.shipping_cost,
      delivery: {
        method: o.shipping_method,
        point: o.shipping_point,
        pointName: a.point_name || null,
        name: a.name || null,
        phone: a.phone || null,
        street: a.street || null,
        postcode: a.postcode || null,
        city: a.city || null,
      },
      invoice: o.wants_invoice && o.billing
        ? { company: o.billing.company || '', nip: o.billing.nip || '', street: o.billing.street || '', postcode: o.billing.postcode || '', city: o.billing.city || '' }
        : null,
      note: o.customer_note,
      payment: {
        provider: provider === 'przelewy24' ? 'Przelewy24'
          : provider.startsWith('ręcznie') ? `Płatność przyjęta przez sklep${provider.slice(8).trim() ? ` (${provider.replace(/^ręcznie:?\s*/, '')})` : ''}`
          : provider,
        method,
      },
      shippingTime: leadTimes.length === 1 ? leadTimes[0] : null,
      notice: site.noticeActive ? site.noticeText : null,
      contact: { email: site.email, phone: site.phone || null },
    };
    return json(200, { ...base, details });
  } catch (e) {
    console.error('Status zamówienia: ' + (e instanceof Error ? e.message : String(e)));
    return json(500, { error: 'Błąd serwera.' });
  }
};
</file>

<file path="src/pages/api/produkty.ts">
import type { APIRoute } from 'astro';
import { getEnv, json } from '../../lib/env';
import { getCatalog, leadTimeText } from '../../lib/catalog';
import { getSite } from '../../lib/site-settings';

export const prerender = false;

// Publiczny katalog dla koszyka i formularza zamówienia (ceny tylko do podglądu – płatność liczy serwer)
export const GET: APIRoute = async ({ locals }) => {
  try {
    const env = await getEnv(locals);
    const [list, site] = await Promise.all([getCatalog(env), getSite(env)]);
    const body = list.map((p) => ({
      slug: p.id, name: p.name, size: p.subtitle || '', price: p.current, regular: p.price, onSale: p.onSale,
      bundles: p.bundles, avail: p.avail, image: p.images[0]?.url || null, imageAlt: p.images[0]?.alt || p.name,
      leadTime: leadTimeText(p.lead_time, site.shippingTime),
    }));
    return new Response(JSON.stringify(body), { headers: { 'Content-Type': 'application/json; charset=utf-8', 'Cache-Control': 'public, max-age=60' } });
  } catch (e) {
    console.error('API produkty: ' + (e instanceof Error ? e.message : String(e)));
    return json(500, { error: 'Błąd pobierania produktów.' });
  }
};
