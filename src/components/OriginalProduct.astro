---
// Sekcja „Oryginalny produkt” na karcie produktu (treść: /admin → Strony → Karta produktu).
import Icon from './Icon.astro';
import { getEnv } from '../lib/env';
import { getPageContent, getSection, visible, fs } from '../lib/page-content';

interface Props { productId: string }
const { productId } = Astro.props;
const env = await getEnv(Astro.locals);
const rows = await getPageContent(env, 'product').catch(() => []);
const d: any = getSection(rows, 'product.original') ?? {
  products: ['krople-can-c'],
  badge: 'Oryginalny produkt',
  h2: 'Kupujesz oryginalne krople Can-C',
  lead: 'Can-C sprzedajemy od 2013 roku. Każde opakowanie pochodzi bezpośrednio z oficjalnej dystrybucji i ma oznaczenie zatwierdzenia Innovative Vision Products (IVP).',
  items: [
    'Na pudełku jest oznaczenie zatwierdzenia przez IVP',
    'Opakowanie fabrycznie zamknięte, z numerem partii i datą ważności',
    'W zestawie 2 fiolki po 5 ml',
    'Do każdego zamówienia wystawiamy paragon albo fakturę',
  ],
  image_url: null, image_alt: 'Opakowanie kropli Can-C z oznaczeniem IVP',
  link_label: 'Masz wątpliwości? Napisz do nas', link_href: '/kontakt/',
};
const list = ((d.products as string[]) || []).map((x) => String(x).trim()).filter(Boolean);
const show = visible(d) && (!list.length || list.includes(productId));
const items = ((d.items as string[]) || []).filter(Boolean);
---
{show && (
  <section class="w og" aria-labelledby="og-h">
    <div class="og__img">
      {d.image_url
        ? <img src={d.image_url} alt={d.image_alt || ''} loading="lazy" />
        : <span class="og__ph"><Icon name="shield-check" size={64} stroke={1.25} /></span>}
    </div>
    <div class="og__txt">
      {d.badge && <span class="peach og__badge" style={fs(d, 'badge')}><Icon name="shield-check" size={18} />{d.badge}</span>}
      <h2 id="og-h" class="h3" style={fs(d, 'h2')}>{d.h2}</h2>
      {d.lead && <p class="lead" style={fs(d, 'lead')}>{d.lead}</p>}
      {items.length > 0 && <ul class="dots og__list" style={fs(d, 'items')}>{items.map((i) => <li>{i}</li>)}</ul>}
      {d.link_label && <a href={d.link_href || '/kontakt/'} class="lnk"><Icon name="arrow-right" size={16} />{d.link_label}</a>}
    </div>
  </section>
)}

<style>
  .og { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: 45px; align-items: center; margin-top: 90px; margin-bottom: 90px; }
  .og__img { aspect-ratio: 4 / 3; border-radius: 200px 32px 32px 32px; background: var(--band); overflow: hidden; display: flex; align-items: center; justify-content: center; }
  .og__img img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .og__ph { color: var(--accent); }
  .og__txt { display: flex; flex-direction: column; align-items: flex-start; gap: 20px; }
  .og__badge { display: inline-flex; align-items: center; gap: 8px; padding: 6px 14px; border-radius: 99px; font-size: 14px; line-height: 21px; }
  .og__badge :global(svg) { color: var(--accent-text); }
  .og__list { font-size: 18px; line-height: 28px; color: var(--muted); }
  @media (max-width: 900px) {
    .og { grid-template-columns: minmax(0, 1fr); gap: 24px; margin-top: 56px; margin-bottom: 56px; }
    .og__img { border-radius: 120px 24px 24px 24px; }
    .og__list { font-size: 16px; line-height: 26px; }
  }
</style>
