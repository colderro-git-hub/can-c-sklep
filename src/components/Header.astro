---
const nav = [
  { href: '/produkt/krople-can-c/', label: 'Krople' },
  { href: '/#produkty', label: 'Kapsułki' },
  { href: '/produkt/krople-can-c-k9/', label: 'Can-C K9' },
  { href: '/stosowanie/', label: 'Stosowanie' },
  { href: '/#faq', label: 'FAQ' },
  { href: '/kontakt/', label: 'Kontakt' },
];
const current = Astro.url.pathname;
---
<div class="promo">
  <div class="container promo__inner">
    <span>Darmowa dostawa w Polsce</span>
    <span>Do 10% rabatu przy 2 i 4 opakowaniach</span>
    <span>Płatność BLIK i Przelewy24</span>
  </div>
</div>

<header class="header">
  <div class="container header__inner">
    <a href="/" class="logo" aria-label="Can-C, strona główna">Can-C</a>

    <nav class="nav nav--desktop" aria-label="Główna">
      {nav.map((item) => (
        <a href={item.href} aria-current={current === item.href ? 'page' : undefined}>{item.label}</a>
      ))}
    </nav>

    <details class="menu">
      <summary class="menu__toggle" aria-label="Menu">
        <svg width="22" height="22" viewBox="0 0 22 22" fill="none" aria-hidden="true"><path d="M2 6h18M2 11h18M2 16h18" stroke="currentColor" stroke-width="1.2" /></svg>
      </summary>
      <nav class="nav nav--mobile" aria-label="Główna (telefon)">
        {nav.map((item) => (
          <a href={item.href} aria-current={current === item.href ? 'page' : undefined}>{item.label}</a>
        ))}
      </nav>
    </details>

    <div class="actions">
      <a href="/konto/" class="icon-btn" aria-label="Twoje konto">
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true"><circle cx="10" cy="6.5" r="3.5" stroke="currentColor" stroke-width="1.2" /><path d="M3 18c.8-3.5 3.6-5.5 7-5.5s6.2 2 7 5.5" stroke="currentColor" stroke-width="1.2" /></svg>
      </a>
      <a href="/koszyk/" class="cart">Koszyk <span class="cart__count" aria-label="liczba produktów">0</span></a>
      <a href="https://can-c.store/" class="lang" hreflang="en">EN</a>
    </div>
  </div>
</header>

<style>
  .promo { background: var(--c-gray-200); font-size: var(--fs-small); color: rgba(1, 8, 15, 0.85); }
  .promo__inner { display: flex; flex-wrap: wrap; justify-content: center; gap: 4px 36px; padding-block: 10px; }

  .header { position: sticky; top: 0; z-index: 10; background: rgba(255, 255, 255, 0.92); backdrop-filter: blur(32px); border-bottom: 1px solid var(--c-ink-10); }
  .header__inner { min-height: 72px; display: flex; align-items: center; gap: var(--s-2); }
  .logo { font-size: 1.75rem; line-height: 1; color: var(--c-ink); text-decoration: none; margin-right: auto; }

  .menu__toggle { list-style: none; width: 44px; height: 44px; display: none; align-items: center; justify-content: center; cursor: pointer; }
  .menu__toggle::-webkit-details-marker { display: none; }
  .nav { display: flex; gap: 28px; }
  .nav a { color: var(--c-ink); text-decoration: none; padding: 12px 0; }
  .nav a[aria-current='page'] { box-shadow: inset 0 -1px 0 var(--c-ink); }

  .actions { order: 3; display: flex; align-items: center; gap: 8px; }
  .icon-btn { width: 44px; height: 44px; display: flex; align-items: center; justify-content: center; color: var(--c-ink); }
  .cart { height: 44px; padding: 0 20px; border-radius: var(--r-pill); background: var(--c-ink); color: var(--c-white); text-decoration: none; display: flex; align-items: center; gap: 10px; font-size: 0.9375rem; }
  .cart__count { min-width: 22px; height: 22px; border-radius: var(--r-pill); background: var(--c-accent); color: var(--c-ink); font-size: 0.8125rem; display: inline-flex; align-items: center; justify-content: center; }
  .lang { color: var(--c-ink); text-decoration: none; font-size: var(--fs-small); padding: 12px 8px; }

  /* Desktop: menu w linii; telefon: menu zwijane */
  .menu { display: none; }
  @media (max-width: 960px) {
    .nav--desktop, .lang { display: none; }
    .menu { display: block; order: 4; }
    .menu__toggle { display: flex; }
    .nav--mobile { position: absolute; left: 0; right: 0; top: 100%; flex-direction: column; gap: 0; padding: 12px 24px 24px; background: var(--c-white); border-bottom: 1px solid var(--c-ink-10); }
    .nav--mobile a { padding: 14px 0; border-bottom: 1px solid var(--c-ink-10); }
  }
</style>
