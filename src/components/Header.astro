---
import { site } from '../config';
import { getEnv } from '../lib/env';
import { getSite } from '../lib/site-settings';

const env = await getEnv(Astro.locals).catch(() => ({}));
const siteData = await getSite(env as any).catch(() => null);
const promos = [
  siteData?.promo1 || site.promo1 || '',
  siteData?.promo2 || site.promo2 || '',
  siteData?.promo3 || site.promo3 || '',
].filter(Boolean);
const notice = siteData?.noticeActive ? siteData.noticeText : '';

type Props = {
  nav?: string;
};
const { nav = '' } = Astro.props as Props;

const navItems = [
  { key: 'krople',    label: 'Krople',    href: '/produkt/krople-can-c/' },
  { key: 'kapsulki',  label: 'Kapsułki',  href: '/produkt/krople-can-c/' },
  { key: 'k9',        label: 'Can-C K9',  href: '/produkt/krople-can-c-k9/' },
  { key: 'stosowanie',label: 'Stosowanie',href: '/stosowanie/' },
  { key: 'faq',       label: 'FAQ',       href: '/faq/' },
  { key: 'kontakt',   label: 'Kontakt',   href: '/kontakt/' },
];
---

{notice && (
  <div class="notice-bar" data-notice>
    <div class="container">{notice}</div>
  </div>
)}

<div class="promo-bar" data-notice-bar>
  {promos.map(p => <span data-site="promo">{p}</span>)}
</div>

<header class="site-header">
  <div class="site-header__inner">
    <a href="/" class="site-logo">
      <span class="site-logo__circle" aria-hidden="true"></span>
      <span class="site-logo__name">Can-C</span>
    </a>
    <div class="site-header__right">
      <nav aria-label="Menu sklepu" class="site-nav">
        {navItems.map(item => (
          <a
            href={item.href}
            class="site-nav__link"
            aria-current={nav === item.key ? 'page' : undefined}
          >{item.label}</a>
        ))}
      </nav>
      <div class="site-actions">
        <a href="/konto/" aria-label="Moje konto" class="icon-btn">
          <svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <circle cx="12" cy="8" r="4"/>
            <path d="M4 21c1.5-4 4.5-6 8-6s6.5 2 8 6"/>
          </svg>
        </a>
        <button type="button" aria-label="Tryb ciemny" class="icon-btn" id="theme-toggle">
          <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M20 14.5A8.5 8.5 0 0 1 9.5 4 8.5 8.5 0 1 0 20 14.5z"/>
          </svg>
        </button>
        <a href="/koszyk/" class="cart-btn" data-cart-link>
          Koszyk
          <span class="cart-btn__count" data-cart-count aria-live="polite">0</span>
        </a>
        <a href="#" lang="en" class="lang-link">EN</a>
      </div>
    </div>
  </div>
</header>

<style>
  .notice-bar {
    background: var(--ink); color: var(--surface);
    padding: 10px var(--page-px); font-size: var(--fs-small); font-weight: 300;
    text-align: center;
  }
  .site-header__right { display: flex; align-items: center; gap: 24px 45px; flex-wrap: wrap; }
  .lang-link { font-size: 1.125rem; font-weight: 400; color: var(--ink); text-decoration: none; padding: 0 4px; }
  @media (max-width: 1000px) {
    .site-nav { display: none; }
  }
</style>

<script>
  import { getCart, onCartChange } from '../lib/cart';
  function updateCount() {
    const c = getCart().reduce((s, i) => s + i.qty, 0);
    document.querySelectorAll('[data-cart-count]').forEach(el => { el.textContent = String(c); });
  }
  updateCount();
  onCartChange(updateCount);

  // Podmiana data-site
  fetch('/api/ustawienia').then(r => r.json()).then(d => {
    document.querySelectorAll('[data-site]').forEach(el => {
      const k = (el as HTMLElement).dataset.site!;
      if (d[k]) el.textContent = d[k];
    });
  }).catch(() => {});

  // Tryb ciemny – wyłączony dla frontendu (panel admina ma własny)
  const btn = document.getElementById('theme-toggle');
  btn?.addEventListener('click', () => {
    const html = document.documentElement;
    const dark = html.getAttribute('data-theme') === 'dark';
    html.setAttribute('data-theme', dark ? 'light' : 'dark');
    try { localStorage.setItem('canc-theme', dark ? 'light' : 'dark'); } catch {}
  });
</script>
