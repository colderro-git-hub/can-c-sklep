---
// Wspólny układ podstron informacyjnych i dokumentów prawnych: nagłówek, spis treści, treść, boczne linki.
import Base from '../layouts/Base.astro';
import { site, LEGAL_DRAFT, LEGAL_EFFECTIVE_DATE } from '../config';
import NewsletterForm from './NewsletterForm.astro';

interface Props {
  title: string;
  description: string;
  lead?: string;
  toc?: { id: string; title: string }[];
  legal?: boolean;   // dokument prawny: data obowiązywania, informacja o projekcie, przycisk drukowania
  newsletter?: boolean; // karta zapisu na newsletter w panelu bocznym
}
const { title, description, lead, toc = [], legal = false, newsletter = false } = Astro.props;
const path = Astro.url.pathname;
const links = [
  { href: '/formy-dostawy/', label: 'Formy dostawy' },
  { href: '/formy-platnosci/', label: 'Formy płatności' },
  { href: '/odstapienie-od-umowy/', label: 'Zwroty i reklamacje' },
  { href: '/regulamin/', label: 'Regulamin' },
  { href: '/polityka-prywatnosci/', label: 'Polityka prywatności' },
  { href: '/o-nas/', label: 'O nas' },
];
---
<Base title={`${title} | Can-C`} description={description}>
  <section class="w ip-top">
    <div class="row ip-head">
      <div class="ip-head__l">
        <nav class="crumb" aria-label="Okruszki"><a href="/">Strona główna</a> / {title}</nav>
        <h1 class="h1">{title}</h1>
        {legal && <span class="k">Obowiązuje od: {LEGAL_EFFECTIVE_DATE}</span>}
      </div>
      {lead && <p class="p p--lg fl" style="width:533px">{lead}</p>}
    </div>
    {legal && LEGAL_DRAFT && (
      <p class="ip-draft" role="note">Projekt dokumentu do weryfikacji przez prawnika przed startem sklepu. Treść opisuje działanie nowego sklepu, ale nie stanowi porady prawnej.</p>
    )}
  </section>

  <section class="w row ip-body">
    <article class="ip-prose">
      <slot />
      {legal && <p class="ip-print"><button type="button" class="btn btn-o btn-s" onclick="window.print()">Wydrukuj albo zapisz jako PDF</button></p>}
    </article>

    <aside class={`fl ip-side${newsletter ? ' ip-side--static' : ''}`}>
      {toc.length > 0 && (
        <nav class="ip-card" aria-label="Spis treści">
          <span class="ip-side__t">Na tej stronie</span>
          <div class="ip-anc">{toc.map((t) => <a href={`#${t.id}`}>{t.title} <span aria-hidden="true">↓</span></a>)}</div>
        </nav>
      )}
      <nav class="ip-card" aria-label="Informacje dla klienta">
        <span class="ip-side__t">Informacje</span>
        <div class="ip-anc">{links.map((l) => <a href={l.href} aria-current={path === l.href ? 'page' : undefined}>{l.label} <span aria-hidden="true">→</span></a>)}</div>
      </nav>
      <div class="ip-help">
        <span class="ip-side__t">Masz pytanie?</span>
        <p><span data-site="hours">{site.hours}</span><br /><a href={`mailto:${site.email}`} data-site-href="mailto:{email}"><span data-site="email">{site.email}</span></a></p>
        <a href="/kontakt/" class="btn btn--white btn-s" style="align-self:flex-start;margin-top:10px">Napisz do nas</a>
      </div>
      {newsletter && <NewsletterForm variant="card" titleSize={24} lead="Promocje, kody rabatowe i nowości – prosto na Twój e-mail." />}
    </aside>
  </section>
</Base>

<style>
  .ip-top { margin-top: 45px; }
  .ip-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 45px; }
  .ip-head__l { display: flex; flex-direction: column; gap: 24px; }
  .ip-draft { margin-top: 24px; padding: 14px 18px; border-radius: var(--r-md); background: var(--peach); color: var(--ink); font-size: 14px; line-height: 21px; max-width: 819px; }
  .ip-body { margin-top: 90px; margin-bottom: 90px; display: flex; align-items: flex-start; gap: 45px; }
  .ip-prose { flex-grow: 1; min-width: 0; max-width: 819px; }
  .ip-prose :global(section) { scroll-margin-top: 24px; padding-top: 45px; margin-top: 45px; border-top: 1px solid var(--line); }
  .ip-prose :global(section:first-child) { padding-top: 0; margin-top: 0; border-top: none; }
  .ip-prose :global(h2) { font-size: clamp(2rem, 3vw, 2.75rem); line-height: 1.1; font-weight: 300; margin-bottom: 24px; }
  .ip-prose :global(h3) { font-size: 24px; line-height: 28px; font-weight: 400; margin: 24px 0 10px; }
  .ip-prose :global(p), .ip-prose :global(li) { font-size: 16px; line-height: 24px; font-weight: 300; color: var(--muted); text-align: left; }
  .ip-prose :global(p) { margin-bottom: 14px; }
  .ip-prose :global(strong) { font-weight: 500; color: var(--ink); }
  .ip-prose :global(a) { color: var(--ink); text-underline-offset: 3px; }
  .ip-prose :global(ol), .ip-prose :global(ul) { margin: 0 0 14px; padding-left: 22px; display: flex; flex-direction: column; gap: 10px; }
  .ip-prose :global(ul) { list-style: none; padding: 0; }
  .ip-prose :global(ul li) { position: relative; padding-left: 22px; text-align: left; }
  .ip-prose :global(ul li)::before {
    content: ''; position: absolute; left: 0; top: 8px; top: calc(0.5lh - 4px);
    width: 8px; height: 8px; border-radius: 50%; background: var(--accent);
  }
  .ip-prose :global(table) { width: 100%; border-collapse: collapse; margin-bottom: 16px; font-size: 16px; line-height: 24px; }
  .ip-prose :global(th), .ip-prose :global(td) { text-align: left; padding: 14px 10px; border-top: 1px solid var(--line); vertical-align: top; font-weight: 300; }
  .ip-prose :global(th) { font-size: 14px; line-height: 21px; font-weight: 400; color: var(--muted); }
  .ip-prose :global(.table-wrap) { overflow-x: auto; }
  .ip-prose :global(.card) { background: var(--band); border: none; border-radius: var(--r-lg); padding: 32px; margin-bottom: 16px; }
  .ip-prose :global(.card p) { color: var(--ink); text-align: left; }
  .ip-prose :global(.todo) { background: var(--peach); padding: 0 4px; border-radius: 4px; }
  .ip-print { margin-top: 24px; }
  .ip-side { width: 436px; flex-shrink: 0; display: flex; flex-direction: column; gap: 14px; position: sticky; top: 14px; }
  .ip-card { border: 1px solid var(--line); border-radius: var(--r-lg); padding: 32px; display: flex; flex-direction: column; gap: 14px; }
  /* Z kartą newslettera panel jest wyższy niż ekran – bez przyklejania, żeby dół był osiągalny */
  .ip-side--static { position: static; }
  .ip-side__t { font-size: 24px; line-height: 28px; font-weight: 400; }
  .ip-anc { border-bottom: 1px solid var(--line); }
  .ip-anc a { display: flex; justify-content: space-between; gap: 24px; padding: 14px 0; border-top: 1px solid var(--line); font-size: 16px; line-height: 24px; font-weight: 300; color: var(--ink); text-decoration: none; }
  .ip-anc a:hover { color: var(--accent-text); }
  .ip-anc a[aria-current] { font-weight: 500; }
  .ip-anc a span { color: var(--accent); }
  .ip-help { background: var(--primary); color: #FFFFFF; border-radius: var(--r-lg); padding: 32px; display: flex; flex-direction: column; gap: 14px; }
  .ip-help p { font-size: 16px; line-height: 24px; font-weight: 300; color: var(--on-dark-soft); }
  .ip-help a:not(.btn) { color: #FFFFFF; }
  @media (max-width: 1000px) { .ip-side { position: static; } .ip-body { margin-top: 45px; } }
  @media print {
    :global(.hd), :global(.hd-promo), :global(.hd-notice), :global(.ft), .ip-side, .crumb, .ip-print { display: none !important; }
    .ip-prose { max-width: none; }
  }
</style>
