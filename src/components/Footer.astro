---
import { site } from '../config';
import { getEnv } from '../lib/env';
import { getPageContent, getSection } from '../lib/page-content';

// Stopka próbuje pobrać treści z bazy; przy awarii lub braku SUPABASE_URL używa fallbacku z kodu
let columns: { title: string; links: { href: string; label: string }[] }[] = [];
let badges: string[] = [];
try {
  const env = await getEnv(Astro.locals);
  const rows = await getPageContent(env, 'footer');
  const colData = getSection<{ columns: typeof columns }>(rows, 'footer.columns');
  const badgeData = getSection<{ items: string[] }>(rows, 'footer.badges');
  if (colData?.columns?.length) columns = colData.columns;
  if (badgeData?.items?.length) badges = badgeData.items;
} catch { /* fallback poniżej */ }
if (!columns.length) columns = [
  { title: 'Sklep', links: [
    { href: '/produkt/krople-can-c/', label: 'Krople Can-C' },
    { href: '/produkt/krople-can-c-k9/', label: 'Can-C K9 dla psa' },
    { href: '/#produkty', label: 'Kapsułki 60 i 90' },
    { href: '/konto/', label: 'Moje konto' },
  ]},
  { title: 'Zakupy', links: [
    { href: '/formy-dostawy/', label: 'Formy dostawy' },
    { href: '/formy-platnosci/', label: 'Formy płatności' },
    { href: '/odstapienie-od-umowy/', label: 'Zwroty i reklamacje' },
    { href: '/odstapienie-od-umowy/#odstapienie', label: 'Odstąp od umowy' },
  ]},
  { title: 'Informacje', links: [
    { href: '/o-nas/', label: 'O nas' },
    { href: '/regulamin/', label: 'Regulamin' },
    { href: '/polityka-prywatnosci/', label: 'Polityka prywatności' },
    { href: '/kontakt/', label: 'Kontakt' },
  ]},
];
if (!badges.length) badges = ['BLIK', 'Przelewy24', 'Karta', 'InPost Paczkomat', 'Kurier DPD'];
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="container footer__inner">
    <div class="footer__cols">
      <div class="footer__brand">
        <span class="footer__logo">Can-C</span>
        <span class="footer__muted"><span data-site="email">{site.email}</span><br /><span data-site="hours">{site.hours}</span></span>
      </div>
      {columns.map((col) => (
        <nav aria-label={col.title} class="footer__col">
          <span class="footer__muted">{col.title}</span>
          {col.links.map((l) => <a href={l.href}>{l.label}</a>)}
        </nav>
      ))}
    </div>
    <ul class="chips" aria-label="Metody płatności i dostawy">
      {badges.map((m) => <li>{m}</li>)}
    </ul>
    <p class="legal"><span data-site="company">{site.company}</span>, <span data-site="address">{site.address}</span> · NIP <span data-site="nip">{site.nip}</span> · REGON <span data-site="regon">{site.regon}</span> · © 2012–{year}</p>
  </div>
</footer>

<style>
  .footer { background: var(--c-dark-section); color: var(--c-paper); padding: var(--s-6) 0 var(--s-3); }
  .footer__inner { display: flex; flex-direction: column; gap: var(--s-4); }
  .footer__cols { display: flex; flex-wrap: wrap; gap: var(--s-4) var(--s-6); }
  .footer__brand { flex: 1 1 260px; display: flex; flex-direction: column; gap: 16px; }
  .footer__logo { font-size: 1.75rem; }
  .footer__col { flex: 1 1 160px; display: flex; flex-direction: column; gap: 12px; font-size: var(--fs-small); }
  .footer__col a { color: var(--c-paper); text-decoration: none; }
  .footer__muted { color: var(--c-white-70); font-size: var(--fs-small); }
  .chips { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .chips li { padding: 6px 14px; border-radius: var(--r-pill); box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.5); font-size: 0.8125rem; }
  .legal { padding-top: var(--s-2); border-top: 1px solid var(--c-white-20); font-size: var(--fs-small); line-height: 24px; letter-spacing: 0.2px; color: var(--c-white-70); }
</style>
