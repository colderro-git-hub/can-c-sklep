---
import { site } from '../config';
import { getEnv } from '../lib/env';
import { getPageContent, getSection } from '../lib/page-content';

let columns: { title: string; links: { href: string; label: string }[] }[] = [];
let badges: string[] = [];
try {
  const env = await getEnv(Astro.locals);
  const rows = await getPageContent(env, 'footer');
  const colData = getSection<{ columns: typeof columns }>(rows, 'footer.columns');
  const badgeData = getSection<{ items: string[] }>(rows, 'footer.badges');
  if (colData?.columns?.length) columns = colData.columns;
  if (badgeData?.items?.length) badges = badgeData.items;
} catch {}
if (!columns.length) columns = [
  { title: 'Sklep', links: [
    { href: '/produkt/krople-can-c/', label: 'Krople Can-C' },
    { href: '/produkt/krople-can-c-k9/', label: 'Can-C K9 dla psa' },
    { href: '/sklep/', label: 'Wszystkie produkty' },
    { href: '/konto/', label: 'Moje konto' },
  ]},
  { title: 'Zakupy', links: [
    { href: '/formy-dostawy/', label: 'Formy dostawy' },
    { href: '/formy-platnosci/', label: 'Formy płatności' },
    { href: '/odstapienie-od-umowy/', label: 'Zwroty i reklamacje' },
    { href: '/odstapienie-od-umowy/', label: 'Odstąp od umowy' },
  ]},
  { title: 'Informacje', links: [
    { href: '/o-nas/', label: 'O nas' },
    { href: '/regulamin/', label: 'Regulamin' },
    { href: '/polityka-prywatnosci/', label: 'Polityka prywatności' },
    { href: '/kontakt/', label: 'Kontakt' },
  ]},
];
if (!badges.length) badges = ['BLIK', 'Przelewy24', 'Karta', 'InPost Paczkomat', 'Kurier DPD'];
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="footer__inner">
    <div class="footer__cols">
      <div class="footer__brand">
        <div class="footer__logo-row">
          <span class="footer__logo-circle" aria-hidden="true"></span>
          <span class="footer__logo-name">Can-C</span>
        </div>
        <p class="footer__muted">
          <span data-site="email">{site.email}</span><br/>
          <span data-site="hours">{site.hours}</span>
        </p>
      </div>
      {columns.map(col => (
        <nav aria-label={col.title} class="footer__col">
          <span class="footer__col-title">{col.title}</span>
          {col.links.map(l => <a href={l.href}>{l.label}</a>)}
        </nav>
      ))}
    </div>
    <ul class="footer__chips" aria-label="Metody płatności i dostawy">
      {badges.map(m => <li>{m}</li>)}
    </ul>
    <p class="footer__legal">
      <span data-site="company">{site.company}</span>,
      <span data-site="address">{site.address}</span> ·
      NIP <span data-site="nip">{site.nip}</span> ·
      REGON <span data-site="regon">{site.regon}</span> ·
      © 2012–{year}
    </p>
  </div>
</footer>
