---
const columns = [
  { title: 'Sklep', links: [
    { href: '/produkt/krople-can-c/', label: 'Krople Can-C' },
    { href: '/produkt/krople-can-c-k9/', label: 'Can-C K9 dla psa' },
    { href: '/#produkty', label: 'Kapsułki 60 i 90' },
    { href: '/konto/', label: 'Moje konto' },
  ]},
  { title: 'Zakupy', links: [
    { href: '/dostawa/', label: 'Dostawa' },
    { href: '/platnosci/', label: 'Płatności' },
    { href: '/zwroty/', label: 'Zwroty i reklamacje' },
    { href: '/odstapienie-od-umowy/', label: 'Odstąpienie od umowy' },
  ]},
  { title: 'Informacje', links: [
    { href: '/o-nas/', label: 'O nas' },
    { href: '/regulamin/', label: 'Regulamin' },
    { href: '/polityka-prywatnosci/', label: 'Polityka prywatności' },
    { href: '/kontakt/', label: 'Kontakt' },
  ]},
];
const methods = ['BLIK', 'Przelewy24', 'Karta', 'InPost Paczkomat', 'Kurier DPD'];
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="container footer__inner">
    <div class="footer__cols">
      <div class="footer__brand">
        <span class="footer__logo">Can-C</span>
        <span class="footer__muted">[adres e-mail sklepu] · [telefon]</span>
      </div>
      {columns.map((col) => (
        <nav aria-label={col.title} class="footer__col">
          <span class="footer__muted">{col.title}</span>
          {col.links.map((l) => <a href={l.href}>{l.label}</a>)}
        </nav>
      ))}
    </div>
    <ul class="chips" aria-label="Metody płatności i dostawy">
      {methods.map((m) => <li>{m}</li>)}
    </ul>
    <p class="legal">Colderro Ewa Zimna, [adres siedziby], Wysoka · NIP [NIP] · REGON [REGON] · © 2012–{year}</p>
  </div>
</footer>

<style>
  .footer { background: var(--c-ink); color: var(--c-white); padding: var(--s-6) 0 var(--s-3); }
  .footer__inner { display: flex; flex-direction: column; gap: var(--s-4); }
  .footer__cols { display: flex; flex-wrap: wrap; gap: var(--s-4) var(--s-6); }
  .footer__brand { flex: 1 1 260px; display: flex; flex-direction: column; gap: 16px; }
  .footer__logo { font-size: 1.75rem; }
  .footer__col { flex: 1 1 160px; display: flex; flex-direction: column; gap: 12px; font-size: var(--fs-small); }
  .footer__col a { color: var(--c-white); text-decoration: none; }
  .footer__muted { color: var(--c-white-70); font-size: var(--fs-small); }
  .chips { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .chips li { padding: 6px 14px; border-radius: var(--r-pill); box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.5); font-size: 0.8125rem; }
  .legal { padding-top: var(--s-2); border-top: 1px solid var(--c-white-20); font-size: var(--fs-small); line-height: 24px; letter-spacing: 0.2px; color: var(--c-white-70); }
</style>
