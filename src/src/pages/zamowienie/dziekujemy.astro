---
import Base from '../../layouts/Base.astro';
---
<Base title="Dziękujemy za zamówienie | Can-C" description="Potwierdzenie zamówienia w sklepie Can-C.">
  <section class="section">
    <div class="container thanks" data-thanks>
      <div data-state="checking">
        <h1>Sprawdzamy płatność…</h1>
        <p class="lead">To zwykle trwa kilka sekund. Nie zamykaj tej strony.</p>
      </div>

      <div data-state="paid" hidden>
        <p class="badge">Płatność przyjęta</p>
        <h1>Dziękujemy za zamówienie</h1>
        <p class="lead">Numer zamówienia: <strong data-number></strong>. Potwierdzenie wysłaliśmy e-mailem.</p>
        <p class="muted">Gdy paczka zostanie nadana, wyślemy numer przesyłki.</p>
        <div class="actions"><a href="/" class="btn">Wróć do sklepu</a><a href="/konto/" class="btn btn--ghost">Moje zamówienia</a></div>
      </div>

      <div data-state="pending" hidden>
        <h1>Czekamy na potwierdzenie płatności</h1>
        <p class="lead">Zamówienie nr <strong data-number></strong> jest zapisane. Gdy Przelewy24 potwierdzi wpłatę, wyślemy e-mail.</p>
        <p class="muted">Jeśli płatność została przerwana, możesz złożyć zamówienie ponownie albo <a href="/kontakt/">napisać do nas</a>.</p>
        <div class="actions"><a href="/koszyk/" class="btn">Wróć do koszyka</a></div>
      </div>

      <div data-state="error" hidden>
        <h1>Nie znaleźliśmy zamówienia</h1>
        <p class="lead">Jeśli płatność została pobrana, <a href="/kontakt/">napisz do nas</a> – wyjaśnimy to od razu.</p>
      </div>
    </div>
  </section>
</Base>

<script>
  import { clearCart } from '../../lib/cart';

  const root = document.querySelector<HTMLElement>('[data-thanks]')!;
  const show = (state: string, number?: number) => {
    root.querySelectorAll<HTMLElement>('[data-state]').forEach((el) => { el.hidden = el.dataset.state !== state; });
    if (number) root.querySelectorAll('[data-number]').forEach((el) => { el.textContent = String(number); });
  };

  const id = new URLSearchParams(location.search).get('id');
  let tries = 0;

  async function check() {
    if (!id) return show('error');
    try {
      const res = await fetch(`/api/zamowienie/status?id=${encodeURIComponent(id)}`);
      if (!res.ok) return show('error');
      const o = await res.json();
      if (['paid', 'shipped', 'completed'].includes(o.status)) { clearCart(); return show('paid', o.number); }
      // Powiadomienie z P24 może przyjść kilka sekund po powrocie klienta – sprawdzamy przez ok. 30 s
      if (++tries < 10) return setTimeout(check, 3000);
      show('pending', o.number);
    } catch {
      if (++tries < 10) setTimeout(check, 3000); else show('error');
    }
  }
  check();
</script>

<style>
  .thanks { max-width: 720px; }
  .thanks > div { display: flex; flex-direction: column; gap: var(--s-2); }
  .thanks > div[hidden] { display: none; }
  .badge { align-self: flex-start; padding: 6px 14px; border-radius: var(--r-pill); background: #E3F5E8; color: var(--c-ok); font-size: var(--fs-small); }
  .actions { display: flex; flex-wrap: wrap; gap: var(--s-1); }
</style>
