  }
  /* Telefon: boksy zaufania jako zwarte wiersze (liczba + opis po lewej, ikona po prawej) */
  @media (max-width: 700px) {
    .trust { grid-template-columns: minmax(0, 1fr); gap: 10px; }
    .trust-box { height: auto; display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 14px; padding: 16px 20px; }
    .trust-box__num, :global(.trust-box__icon), .trust-box__sub { position: static; }
    .trust-box__num { font-size: 28px; line-height: 36px; }
    .trust-box__sub { font-size: 16px; line-height: 24px; font-weight: 300; color: var(--muted); white-space: normal; }
