---
import Icon from '../components/Icon.astro';
import Base from '../layouts/Base.astro';
import { products as fallback, features, reviews, faqs, formatPrice } from '../data/shop';
import { applyPromotions, qtyOptions } from '../lib/promotions';
import { getPromotions } from '../lib/promotions-db';
import { getEnv } from '../lib/env';
import { getCatalog, testReviewsFilter } from '../lib/catalog';
import { db } from '../lib/supabase';
import { visible, fs, getPageContent, getSection, getSections, applyTokens } from '../lib/page-content';
import { getSite } from '../lib/site-settings';
import type { Availability } from '../lib/pricing';
import { AVAIL_LABEL } from '../lib/catalog';
import Stars from '../components/Stars.astro';
import NewsletterForm from '../components/NewsletterForm.astro';
import ProductCard from '../components/ProductCard.astro';
import FaqItem from '../components/FaqItem.astro';
import { imgUrl, srcset } from '../lib/img';

// Strona główna z aktualnymi produktami i treściami z bazy; przy awarii bazy - dane zapasowe z kodu
export const prerender = false;
type Card = { slug: string; tag: string; tags: string[]; avail: Availability; name: string; desc: string; price: number | null; regular: number | null; onSale: boolean; image?: string; alt?: string; rating: number; reviews: number };
let products: Card[];
try {
  const list = await getCatalog(await getEnv(Astro.locals));
  products = list.map((p) => ({
    slug: p.id, tag: p.subtitle || '', tags: p.tags, avail: p.avail, name: p.name, desc: p.short_description || '',
    price: p.current === null ? null : p.current / 100, regular: p.price === null ? null : p.price / 100, onSale: p.onSale,
    image: p.images[0]?.url, alt: p.images[0]?.alt || p.name, rating: p.rating.avg, reviews: p.rating.count,
  }));
} catch (e) {
  console.error('Strona główna - katalog: ' + (e instanceof Error ? e.message : String(e)));
  products = fallback.map((p) => ({ slug: p.slug, tag: p.tag, tags: [], avail: 'in_stock' as Availability, name: p.name, desc: p.desc, price: p.price, regular: p.price, onSale: false, image: p.image, alt: p.name, rating: 0, reviews: 0 }));
}
Astro.response.headers.set('Cache-Control', 'public, max-age=60');
// Średnia ocen ze wszystkich produktów (ważona liczbą opinii)
const ratingCount = products.reduce((n, p) => n + p.reviews, 0);
const ratingAvg = ratingCount ? Math.round((products.reduce((n, p) => n + p.rating * p.reviews, 0) / ratingCount) * 10) / 10 : 0;

// Treści z CMS (strona główna + FAQ)
const env = await getEnv(Astro.locals);
const [homeRows, faqRows, site] = await Promise.all([
  getPageContent(env, 'home').catch(() => []),
  getPageContent(env, 'faq').catch(() => []),
  getSite(env).catch(() => null),
]);
const tokens = site ? { company: site.company, hours: site.hours, email: site.email, shippingTime: site.shippingTime } : {};
const at = (key: string, fb: any, rows = homeRows): any => (getSection(rows, key) ?? fb);

const hero = at('home.hero', {
  kicker: 'Oryginalne krople zatwierdzone przez IVP',
  h1: 'Krople do oczu Can-C z N-acetylokarnozyną',
  lead: 'Codzienne wsparcie dla zmęczonych oczu. Można stosować przy soczewkach kontaktowych.',
  cta_primary_label: 'Zamów krople', cta_primary_href: '/produkt/krople-can-c/',
  cta_secondary_label: 'Jak stosować', cta_secondary_href: '/stosowanie/',
  trust_boxes: ['0 zł | InPost i DPD', '14 dni | Na zwrot', 'BLIK | Przelewy24, karta'] as string[],
  image_url: null as string | null, image_alt: 'Krople Can-C',
});
// H1 w dwóch liniach: „pierwsza | druga” (druga z wcięciem); dawny tekst bez „|” dzielimy jak w projekcie
const heroH1 = String(hero.h1 || '').includes('|')
  ? String(hero.h1).split('|').map((x: string) => x.trim()).filter(Boolean)
  : String(hero.h1 || '') === 'Krople do oczu Can-C z N-acetylokarnozyną' ? ['Krople do oczu Can-C', 'z N-acetylokarnozyną'] : [String(hero.h1 || '')];
// Boksy zaufania pod hero: „liczba | opis”, ikony wg kolejności
const TRUST_ICONS = ['truck', 'undo-2', 'credit-card'] as const;
const trustRaw = ((hero.trust_boxes as string[]) || []).filter((x) => String(x).includes('|'));
const trustBoxes = (trustRaw.length ? trustRaw : ['0 zł | InPost i DPD', '14 dni | Na zwrot', 'BLIK | Przelewy24, karta'])
  .slice(0, 3).map((x: string, i: number) => { const [num, sub] = x.split('|').map((y) => y.trim()); return { num, sub: sub || '', icon: TRUST_ICONS[i] }; });
// Nagłówki z łamaniem wiersza: „|” albo nowa linia → <br>
const lines = (t: unknown) => String(t ?? '').split(/\s*\|\s*|\n/).map((x) => x.trim()).filter(Boolean);
const productsCms = at('home.products', {
  h2: 'Produkty', lead: 'Krople do oczu, kapsułki i wersja dla psa. Wszystkie wysyłamy za darmo w ciągu 1 dnia roboczego.',
  link_label: 'Zobacz wszystkie', link_href: '/sklep/',
});
const bundlesCms = at('home.bundles', {
  h2: 'Kupuj więcej, | płać mniej',
  lead: 'Jedno opakowanie wystarcza na około miesiąc. Dłuższa kuracja to niższa cena za sztukę, a dostawa zawsze jest darmowa.',
  badge: 'Polecany', perks: ['Darmowa dostawa'] as string[], button: 'Wybierz zestaw',
});
const faqHead = at('home.faq', { h2: 'Najczęstsze | pytania', link_label: 'Wszystkie pytania', link_href: '/faq/' });
const newsletterCms = at('home.newsletter', {
  h2: 'Rabaty i nowości | na Twój e-mail',
  text: 'Zapisz się na newsletter - jako pierwszy dowiesz się o promocjach i dostaniesz kody rabatowe dla subskrybentów. Bez spamu, wypisujesz się jednym kliknięciem.',
});
const why = at('home.why', {
  h2: 'Dlaczego | krople Can-C', lead: 'Can-C sprzedajemy od 2013 roku. Oto, co wyróżnia te krople.',
  link_label: 'Przeczytaj, jak stosować', link_href: '/stosowanie/',
  image_url: null as string | null, image_alt: '',
  features: features as { title: string; text: string }[],
});
// 4 punkty (mozaika): pola p1..p4 z panelu, a gdy puste - dawna lista „features”
const whyPoints = [1, 2, 3, 4].map((n) => ({
  title: String((why as any)[`p${n}_title`] ?? (why.features as any[])?.[n - 1]?.title ?? ''),
  text: String((why as any)[`p${n}_text`] ?? (why.features as any[])?.[n - 1]?.text ?? ''),
})).filter((p) => p.title || p.text);
const reviewsCms = at('home.reviews', { h2: 'Opinie klientów', items: reviews as { quote: string; author: string }[], cta_text: 'Kupiłeś Can-C? Podziel się wrażeniami.', cta_label: 'Napisz opinię', cta_href: '/produkt/krople-can-c/#opinia' });

// 5 najnowszych zatwierdzonych opinii z bazy (z produktem, którego dotyczą); bez opinii w bazie - teksty z CMS
type HomeReview = { quote: string; author: string; slug?: string; productName?: string; image?: string };
const shorten = (t: string, n = 180) => (t.length > n ? t.slice(0, t.lastIndexOf(' ', n) > 120 ? t.lastIndexOf(' ', n) : n).trimEnd() + '…' : t);
let latestReviews: HomeReview[] = [];
try {
  const rows = await db(env).select<{ product_id: string; author_name: string; body: string }>(
    `reviews?select=product_id,author_name,body&status=eq.approved${testReviewsFilter(env)}&order=created_at.desc&limit=5`);
  latestReviews = rows.map((r) => {
    const prod = products.find((x) => x.slug === r.product_id);
    return { quote: shorten(r.body), author: r.author_name, slug: r.product_id, productName: prod?.name, image: prod?.image };
  });
} catch { /* baza niedostępna - zostają teksty z CMS */ }
const homeReviews: HomeReview[] = latestReviews.length ? latestReviews : (reviewsCms.items as HomeReview[]).slice(0, 5);
// Układ: 3 opinie, karta „Napisz opinię”, kolejne opinie
const reviewSlots: (HomeReview | 'cta')[] = [...homeReviews.slice(0, 3), 'cta', ...homeReviews.slice(3)];
const benefitsRaw = at('home.benefits', {
  h2: 'Korzyści używania kropli Can-C',
  lead: 'Krople Can-C z N-acetylokarnozyną wspierają oczy na co dzień - szczególnie gdy wzrok zaczyna odczuwać upływ czasu i zmęczenie ekranem.',
  card_title: 'Z N-acetylokarnozyną',
  card_text: 'Opatentowana formuła, która dociera do soczewki oka. Jedno opakowanie wystarcza na około miesiąc kuracji.',
  card_items: [] as string[],
  card_image_url: null as string | null,
  card_image_alt: 'Krople Can-C',
  items: [
    'Zmniejszają występowanie i rozwój zaćmy starczej.',
    'Korzystne przy dyskomforcie noszenia soczewek kontaktowych.',
    'Pomagają przy walce z chorobami rogówki.',
    'Walka z przemęczeniem oczu.',
    'Łagodzą efekt zespołu suchego oka.',
    'Poprawiają funkcję starzejącego się oka.',
    'Przywracają ostrość widzenia.',
  ] as string[],
  cta_label: 'Jak używać kropli Can-C',
  cta_href: '/stosowanie/',
  image_url: null as string | null,
  image_alt: 'Korzyści stosowania kropli Can-C',
});
// Układ w 3 kolumnach (karta · zdjęcie · nagłówek z listą). Starsze dane z CMS mają tylko „items” -
// wtedy pierwsze 3 punkty trafiają do karty, reszta do prawej kolumny.
const benAll = ((benefitsRaw.items as string[]) || []).filter(Boolean);
const benCardItems = ((benefitsRaw.card_items as string[]) || []).filter(Boolean);
const benefits = {
  ...benefitsRaw,
  card_items: benCardItems.length ? benCardItems : benAll.slice(0, 3),
  items: benCardItems.length ? benAll : benAll.slice(3),
};
const bold = (t: string) => t.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');
const k9 = at('home.k9', { tag: 'DLA PSA', h2: 'Krople Can-C K9 z N-acetylokarnozyną', lead: '', cta_label: 'Zobacz Can-C K9', cta_href: '/produkt/krople-can-c-k9/', image_url: null as string | null, image_alt: 'Can-C K9' });
const faqCatLabel: Record<string, string> = { produkt: 'Produkt', stosowanie: 'Stosowanie', zamowienia: 'Zamówienia i dostawa', zwroty: 'Płatności i zwroty' };
const escHtml = (t: string) => t.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
const faqCms = getSections<{ cat: string; home: boolean; q: string; a: string; __hidden?: boolean }>(faqRows, 'item')
  .filter((f) => f.home && !f.__hidden && f.q && f.a)
  .map((f) => ({ q: f.q, a: applyTokens(f.a, tokens), cat: f.cat }));
const faqList: { q: string; a: string; cat?: string }[] = faqCms.length ? faqCms : faqs;

const dropsPrice = products.find((p) => p.slug === 'krople-can-c')?.price ?? fallback[0].price ?? 0;
// Zestawy kropli: progi i rabaty z promocji ilościowych (panel: Kody rabatowe → Promocje)
const promos = await getPromotions(env).catch(() => []);
const many = (n: number, one: string, few: string, lots: string) => (n === 1 ? one : n % 10 >= 2 && n % 10 <= 4 && (n % 100 < 12 || n % 100 > 14) ? few : lots);
const dropsUnit = Math.round((dropsPrice ?? 0) * 100); // grosze
const setQtys = (() => { const q = qtyOptions('krople-can-c', promos); return q.join() === '1,2,3' ? [1, 2, 4] : q.slice(0, 3); })();
const bundleRows = setQtys.map((qty) => {
  const gross = dropsUnit * qty;
  const disc = applyPromotions([{ product_id: 'krople-can-c', qty, unit_price: dropsUnit }], promos).total;
  const pct = gross ? Math.round((disc / gross) * 100) : 0;
  const total = (gross - disc) / 100;
  return {
    qty, pct,
    label: `${qty} ${many(qty, 'opakowanie', 'opakowania', 'opakowań')}`,
    months: `${qty} ${many(qty, 'miesiąc', 'miesiące', 'miesięcy')} kuracji`,
    total: formatPrice(total),
    unit: `${formatPrice(total / qty)} za sztukę`,
    save: pct ? `Oszczędzasz ${pct}%` : 'Cena regularna',
  };
});
---
<Base title="Krople do oczu Can-C z N-acetylokarnozyną" description="Oryginalne krople Can-C z N-acetylokarnozyną. Darmowa dostawa, szybka wysyłka.">
  <!-- HERO -->
  {visible(hero) && (
  <section class="container" style="margin-top: 45px">
    <div class="hero" style="position:relative;height:638px">
      {/* Kształty w jednej warstwie: cień (drop-shadow) obrysowuje cały kształt, bez szwów między kawałkami */}
      <div class="hero-art" aria-hidden={hero.image_url ? undefined : 'true'}>
      {[
        { st: 'left:64.46%;right:0;top:0;height:545px;border-radius:50px', l: '-64.46cqw', t: 0 },
        { st: 'left:0;top:221px;width:72.38%;height:324px;border-radius:50px', l: '0px', t: 221 },
        { st: 'left:0;top:221px;width:35.54%;height:417px;border-radius:50px', l: '0px', t: 221 },
        { st: 'left:calc(64.46% - 50px);top:171px;width:50px;height:50px', l: 'calc(50px - 64.46cqw)', t: 171, m: 'radial-gradient(circle at 0 0,transparent 49.5px,#000 50px)' },
        { st: 'left:35.54%;top:545px;width:50px;height:50px', l: '-35.54cqw', t: 545, m: 'radial-gradient(circle at 100% 100%,transparent 49.5px,#000 50px)' },
      ].map((sh, i) => (
        <div class="hero-shape" style={`position:absolute;${sh.st};background:var(--image);overflow:hidden${sh.m ? `;-webkit-mask-image:${sh.m};mask-image:${sh.m}` : ''}`}>
          {hero.image_url && <img src={imgUrl(hero.image_url, 2000)} srcset={srcset(hero.image_url, [800, 1200, 1600, 2000])} sizes="100vw" alt={i === 0 ? hero.image_alt : ''} aria-hidden={i === 0 ? undefined : 'true'} class="hero-fill" style={`left:${sh.l};top:-${sh.t}px`} loading="eager" decoding="async" />}
        </div>
      ))}
      </div>
      {!hero.image_url && <span class="hero-shape" style="position:absolute;left:64.46%;right:0;top:300px;text-align:center;font-size:14px;font-weight:300;color:var(--muted)">[zdjęcie z panelu: Strony → Hero]</span>}
      {hero.image_url && <img src={imgUrl(hero.image_url, 800)} srcset={srcset(hero.image_url, [480, 640, 800, 1200])} sizes="92vw" alt="" class="hero-mobile-img" loading="lazy" />}
      <div style="position:absolute;left:0;top:0;display:flex;flex-direction:column;gap:14px">
        {hero.kicker && <span class="tag" style={fs(hero, 'kicker', 'align-self:flex-start;min-height:36px;padding:0 16px;font-size:16px')}>{hero.kicker}</span>}
        <h1 class="hero-h1" style={fs(hero, 'h1', 'margin:0;font-size:clamp(2.5rem,5vw,4.5rem);line-height:1.111;font-weight:300;letter-spacing:-0.05em')}>
          {heroH1.map((line: string, i: number) => i === 0
            ? <span style="display:block">{line}</span>
            : <span class="hero-h1__2"><span class="hero-dash" aria-hidden="true"></span>{line}</span>)}
        </h1>
      </div>
      {hero.lead && <p style={fs(hero, 'lead', 'position:absolute;left:39%;right:0;top:590px;font-size:16px;line-height:24px;font-weight:300;color:var(--muted);text-align:left')}>{hero.lead}</p>}
    </div>
    <div class="hero-bottom">
      <div class="trust">
        {trustBoxes.map((t) => (
          <div class="trust-box">
            <span class="trust-box__num">{t.num}</span>
            <Icon name={t.icon} size={36} stroke={1.5} class="trust-box__icon" />
            <span class="trust-box__sub">{t.sub}</span>
          </div>
        ))}
      </div>
      <span aria-hidden="true" class="hero-bottom__sep"></span>
      <div class="hero-cta">
        <a href={hero.cta_primary_href} class="btn btn--wide">
          {hero.cta_primary_label}
          <Icon name="arrow-right" size={20} />
        </a>
        {hero.cta_secondary_label && <a href={hero.cta_secondary_href} class="btn btn--outline btn--wide">{hero.cta_secondary_label}</a>}
      </div>
    </div>
  </section>
  )}

  <!-- PRODUKTY -->
  {visible(productsCms) && (
  <section class="section section--band sec-gap" id="produkty">
    <div class="container">
      <div style="display:flex;align-items:flex-end;justify-content:space-between;gap:45px;flex-wrap:wrap">
        <div style="display:flex;flex-direction:column;gap:24px">
          <h2 class="h2" style={fs(productsCms, 'h2')} set:html={lines(productsCms.h2).map(escHtml).join('<br/>')} />
          {productsCms.lead && <p class="lead" style={fs(productsCms, 'lead', 'max-width:517px')}>{productsCms.lead}</p>}
        </div>
        {productsCms.link_label && <a href={productsCms.link_href} class="link-arrow">
          <Icon name="arrow-right" size={16} />
          {productsCms.link_label}
        </a>}
      </div>
      <div class="products-grid" data-list="Strona główna">
        {products.map((p) => (
          <ProductCard slug={p.slug} name={p.name} tag={p.tag} image={p.image} alt={p.alt} avail={p.avail}
            price={p.price} regular={p.regular} onSale={p.onSale} flag={p.tags[0] ? p.tags[0].charAt(0).toUpperCase() + p.tags[0].slice(1) : undefined} />
        ))}
      </div>
    </div>
  </section>
  )}

  <!-- KORZYŚCI: 3 kolumny - karta (3) · zdjęcie (4) · nagłówek, lista, przycisk (5) -->
  {visible(benefits) && (
  <section class="container sec-gap ben">
    <div class="ben__card">
      <div class="ben__card-img">
        {benefits.card_image_url
          ? <img src={imgUrl(benefits.card_image_url, 640)} srcset={srcset(benefits.card_image_url, [320, 480, 640, 800])} sizes="(max-width: 700px) 92vw, 360px" alt={benefits.card_image_alt || ''} loading="lazy" />
          : <span class="ben__ph">[zdjęcie: krople]</span>}
      </div>
      {benefits.card_title && <h3 class="ben__card-t" style={fs(benefits, 'card_title')}>{benefits.card_title}</h3>}
      {benefits.card_text && <p class="ben__card-p" style={fs(benefits, 'card_text')}>{benefits.card_text}</p>}
      {benefits.card_items.length > 0 && <ul class="dots ben__card-list" style={fs(benefits, 'card_items')}>{benefits.card_items.map((item: string) => <li set:html={bold(item)} />)}</ul>}
    </div>
    <div class="ben__img">
      {benefits.image_url
        ? <img src={imgUrl(benefits.image_url, 800)} srcset={srcset(benefits.image_url, [480, 640, 800, 1200])} sizes="(max-width: 700px) 92vw, (max-width: 1200px) 46vw, 480px" alt={benefits.image_alt} loading="lazy" />
        : <span class="ben__ph">[zdjęcie: zbliżenie oka]</span>}
    </div>
    <div class="ben__head">
      <h2 class="h2" style={fs(benefits, 'h2')}>{benefits.h2}</h2>
      {benefits.lead && <p class="lead" style={fs(benefits, 'lead')}>{benefits.lead}</p>}
    </div>
    <div class="ben__body">
      {benefits.items.length > 0 && <ul class="dots ben__list" style={fs(benefits, 'items')}>{benefits.items.map((item: string) => <li set:html={bold(item)} />)}</ul>}
      {benefits.cta_label && <a href={benefits.cta_href} class="btn">{benefits.cta_label}</a>}
    </div>
  </section>
  )}

  <!-- ZESTAWY -->
  {visible(bundlesCms) && (
  <section class="container sec-gap">
    <div class="bundles-head">
      <h2 class="h2" style={fs(bundlesCms, 'h2')} set:html={lines(bundlesCms.h2).map(escHtml).join('<br/>')} />
      {bundlesCms.lead && <p class="lead bundles-head__p" style={fs(bundlesCms, 'lead')}>{bundlesCms.lead}</p>}
    </div>
    <div class="bundles-grid">
      {bundleRows.map((b, i) => (
        <div class={`bundle-card${i === 1 ? ' bundle-card--featured' : ''}`}>
          {i > 0 && (i === 1 || b.pct > 0) && <span class="tag tag--peach" style="position:absolute;right:24px;top:24px">{[i === 1 ? bundlesCms.badge : '', b.pct ? `−${b.pct}%` : ''].filter(Boolean).join(' ')}</span>}
          <span style="font-size:18px;line-height:27px;font-weight:400">{b.label}</span>
          <div>
            <div style="font-size:3rem;line-height:72px;font-weight:300">{b.total}</div>
            <div style={`font-size:14px;line-height:21px;font-weight:300;color:${i === 1 ? 'rgba(255,255,255,0.65)' : 'var(--muted)'}`}>{b.unit}</div>
          </div>
          <ul style={`list-style:none;margin:0;padding:14px 0 0;border-top:1px solid ${i === 1 ? 'var(--on-dark-line)' : 'var(--line)'};display:flex;flex-direction:column;gap:10px;font-size:16px;line-height:24px;font-weight:300`}>
            <li style="display:flex;align-items:center;gap:14px">
              <span class="bullet" aria-hidden="true"></span>
              {b.months}
            </li>
            {i > 0 && <li style="display:flex;align-items:center;gap:14px">
              <span class="bullet" aria-hidden="true"></span>
              {b.save !== 'Cena regularna' ? b.save : ''}
            </li>}
            {((bundlesCms.perks as string[]) || []).filter(Boolean).map((perk: string) => <li style={fs(bundlesCms, 'perks', 'display:flex;align-items:center;gap:14px')}>
              <span class="bullet" aria-hidden="true"></span>
              {perk}
            </li>)}
          </ul>
          <a href={`/produkt/krople-can-c/?zestaw=${b.qty}`} class={i === 1 ? 'btn btn--white btn--wide' : 'btn btn--outline btn--wide'}>{bundlesCms.button}</a>
        </div>
      ))}
    </div>
  </section>
  )}

  <!-- DLACZEGO -->
  {visible(why) && (
  <section class="container sec-gap why2">
    <div class="why2__side">
      <div class="why2__img">
        {why.image_url
          ? <img src={imgUrl(why.image_url, 800)} srcset={srcset(why.image_url, [480, 640, 800, 1200])} sizes="(max-width: 1000px) 92vw, 520px" alt={why.image_alt || ''} loading="lazy" />
          : <span class="ben__ph">[grafika]</span>}
      </div>
      <h2 class="h2" style={fs(why, 'h2')} set:html={lines(why.h2).map(escHtml).join('<br/>')} />
      {why.lead && <p class="lead" style={fs(why, 'lead', 'text-align:left')}>{why.lead}</p>}
      {why.link_label && <a href={why.link_href} class="link-arrow">
        <Icon name="arrow-right" size={16} />
        {why.link_label}
      </a>}
    </div>
    <div class="why2__grid">
      {whyPoints.map((f, i) => (
        <div class={`why2__card why2__card--${i + 1}`}>
          <span class="why2__n">0{i + 1}</span>
          <div class="why2__txt">
            {f.title && <h3 class="why2__t" style={fs(why, `p${i + 1}_title`)}>{f.title}</h3>}
            {f.text && <p class="why2__p" style={fs(why, `p${i + 1}_text`)}>{f.text}</p>}
          </div>
        </div>
      ))}
    </div>
  </section>
  )}

  <!-- OPINIE -->
  {visible(reviewsCms) && (
  <section class="section section--band sec-gap">
    <div class="container home-split">
      <div class="home-side">
        <h2 class="h2" style={fs(reviewsCms, 'h2')}>{reviewsCms.h2}</h2>
        <div style="display:flex;align-items:center;gap:14px">
          <span style="font-size:4rem;line-height:64px;font-weight:300">{ratingAvg ? ratingAvg.toLocaleString('pl-PL', { minimumFractionDigits: 1, maximumFractionDigits: 1 }) : '-'}</span>
          <div style="display:flex;flex-direction:column;gap:4px">
            <Stars value={ratingAvg || 5} size={16} label={`Średnia ocena ${ratingAvg || 5} na 5`} />
            <span style="font-size:14px;font-weight:300;color:var(--muted)">{ratingCount ? `na podstawie ${ratingCount} ${ratingCount === 1 ? 'opinii' : 'opinii'}` : 'opinie klientów'}</span>
          </div>
        </div>
      </div>
      <div class="home-split__main rv-grid">
        {reviewSlots.map((r) => r === 'cta' ? (
          <div style="border-radius:20px;padding:24px;background:var(--image);display:flex;flex-direction:column;justify-content:space-between;gap:24px">
            <span style={fs(reviewsCms, 'cta_text', 'font-size:1.5rem;line-height:28px;font-weight:400')}>{reviewsCms.cta_text}</span>
            {reviewsCms.cta_label && <a href={reviewsCms.cta_href} class="btn btn--outline btn--sm" style="align-self:flex-start">{reviewsCms.cta_label}</a>}
          </div>
        ) : (
          <figure style="margin:0;background:var(--surface);border:1px solid var(--line);border-radius:20px;padding:24px;display:flex;flex-direction:column;gap:14px">
            <div style="display:flex;align-items:center;gap:14px">
              {r.slug
                ? <a href={`/produkt/${r.slug}/`} class="rv-thumb" title={r.productName} aria-label={`Opinia o produkcie: ${r.productName || r.slug}`}>
                    {r.image ? <img src={imgUrl(r.image, 160)} alt="" width="44" height="44" loading="lazy" /> : null}
                  </a>
                : <span class="rv-thumb" aria-hidden="true"></span>}
              <figcaption style="font-size:18px;line-height:27px;font-weight:500">{r.author}</figcaption>
            </div>
            <Icon name="quote" size={20} stroke={1.5} style="color:var(--accent)" />
            <blockquote style="margin:0;font-size:16px;line-height:24px;font-weight:300;color:var(--muted);text-align:left">{r.quote}</blockquote>
          </figure>
        ))}
      </div>
    </div>
  </section>
  )}

  <!-- K9 -->
  {visible(k9) && (
  <section class="container home-split home-split--center sec-gap">
    <div class="k9-img">
      {k9.image_url
        ? <img src={imgUrl(k9.image_url, 1200)} srcset={srcset(k9.image_url, [480, 640, 800, 1200, 1600])} sizes="(max-width: 1000px) 92vw, 640px" alt={k9.image_alt} loading="lazy" style="width:100%;height:100%;object-fit:cover" />
        : <span style="font-size:14px;font-weight:300;color:var(--muted)">[zdjęcie: pies]</span>}
    </div>
    <div class="home-split__main">
      {k9.tag && <span class="tag tag--peach" style={fs(k9, 'tag', 'align-self:flex-start')}>{k9.tag}</span>}
      <h2 class="h2" style={fs(k9, 'h2')}>{k9.h2}</h2>
      {k9.lead && <p class="lead" style={fs(k9, 'lead', 'text-align:left')}>{k9.lead}</p>}
      <div style="display:flex;align-items:center;gap:24px;margin-top:21px;flex-wrap:wrap">
        <a href={k9.cta_href} class="btn">
          {k9.cta_label}
          <Icon name="arrow-right" size={20} />
        </a>
      </div>
    </div>
  </section>
  )}

  <!-- FAQ -->
  {visible(faqHead) && (
  <section class="container home-split sec-gap">
    <div class="home-side">
      <h2 class="h2" style={fs(faqHead, 'h2')} set:html={lines(faqHead.h2).map(escHtml).join('<br/>')} />
      {faqHead.link_label && <a href={faqHead.link_href} class="link-arrow">
        <Icon name="arrow-right" size={16} />
        {faqHead.link_label}
      </a>}
    </div>
    <div class="home-split__main" style="gap:14px">
      {faqList.map((f, i) => (
        <FaqItem cat={f.cat ? faqCatLabel[f.cat] : undefined} q={f.q} answer={escHtml(f.a)} open={i === 0} />
      ))}
    </div>
  </section>
  )}

  <!-- NEWSLETTER (zapis z obowiązkową zgodą i potwierdzeniem e-mailem) -->
  {visible(newsletterCms) && (
  <section class="w sec-gap" id="newsletter" style="margin-bottom:90px">
    <div class="row cta-box">
      <div class="fl cta-box__l">
        <h2 class="h2" style={fs(newsletterCms, 'h2')} set:html={lines(newsletterCms.h2).map(escHtml).join('<br/>')} />
        {newsletterCms.text && <p class="p" style={fs(newsletterCms, 'text')}>{newsletterCms.text}</p>}
      </div>
      <div class="fl cta-box__r">
        <NewsletterForm variant="light" title="" lead="" />
      </div>
    </div>
  </section>
  )}
</Base>


<style>
  /* Hero: kształty w px pod kontener 1300 px; węższe ekrany - układ pionowy */
  .hero { overflow: hidden; container-type: inline-size; }
  /* Jedno zdjęcie na cały kształt: każdy fragment ma kopię zdjęcia przesuniętą o swoją pozycję (cqw = szerokość hero) */
  .hero-art { position: absolute; inset: 0; pointer-events: none; }
  /* Cień całego kształtu hero (jak --shadow-soft w global.css, ale po obrysie); wyłączany przez ?cienie=0 */
  :global(html:not(.no-shadows)) .hero-art { filter: drop-shadow(0 1px 1px rgba(20, 28, 43, .05)) drop-shadow(0 10px 22px rgba(20, 28, 43, .08)); }
  .hero-fill { position: absolute; width: 100cqw; height: 638px; max-width: none; object-fit: cover; display: block; }
  .hero-mobile-img { display: none; }
  /* H1 nie wchodzi pod zdjęcie (prawy kształt zaczyna się na 64,46%); druga linia z kreską jak w projekcie */
  .hero > div[style*="left:0;top:0"] { z-index: 2; max-width: calc(64.46% - 40px); }
  .hero-h1__2 { position: relative; display: block; padding-left: 68px; }
  .hero-dash { position: absolute; left: 9px; top: 0.56em; width: 50px; height: 2px; background: var(--primary); }
  @media (max-width: 1380px) {
    .hero { height: auto !important; display: flex; flex-direction: column; }
    .hero-art, .hero > span.hero-shape, .hero > span[aria-hidden="true"] { display: none; }
    .hero > div[style*="position:absolute;left:0;top:0"] { position: static !important; }
    .hero-h1__2 { padding-left: 0; }
    .hero-dash { display: none; }
    .hero > div[style*="left:0;top:0"] { max-width: none; }
    .hero-mobile-img { display: block; order: 3; width: 100%; aspect-ratio: 4 / 3; max-height: 520px; margin-top: 24px; object-fit: cover; border-radius: 32px; background: var(--image); }
    .hero > p { position: static !important; width: auto !important; margin-top: 24px; order: 2; }
    .hero-bottom > span[aria-hidden="true"] { display: none; }
  }
  @media (max-width: 1000px) {
    .hero h1 { font-size: 2.5rem !important; }
  }

  /* Trust boxes */
  /* Wiersz pod hero: boksy dzielą lewą część, przyciski mają szerokość zdjęcia nad nimi */
  .hero-bottom { display: flex; align-items: center; gap: 45px; margin-top: 45px; }
  .trust { flex: 1; min-width: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; }
  .hero-bottom__sep { width: 1px; height: 98px; background: var(--line); flex-shrink: 0; }
  .hero-cta { flex: 0 0 35.54%; display: flex; flex-direction: column; gap: 14px; }
  .trust-box {
    position: relative; height: 146px;
    border: 1px solid var(--line); border-radius: 20px; box-sizing: border-box;
  }
  .trust-box__num { position: absolute; left: 23px; top: 23px; font-size: 3rem; line-height: 72px; font-weight: 300; }
  :global(.trust-box__icon) { position: absolute; right: 23px; top: 23px; color: var(--accent); }
  .trust-box__sub { position: absolute; left: 23px; bottom: 23px; font-size: 1.5rem; line-height: 36px; font-weight: 200; white-space: nowrap; }
