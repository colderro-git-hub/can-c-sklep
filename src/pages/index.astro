  @media (max-width: 700px) {
  }
  @media (max-width: 600px) {
    .sec-gap { margin-top: 56px; }
    .sec-line { padding-top: 56px; }
    .products-grid { margin-top: 32px; }
    .bundles-grid { margin-top: 32px; }
    .why-grid, .rv-grid { grid-template-columns: minmax(0, 1fr); }
    .why-card { padding: 24px; }
    .why-card__n { font-size: 2.25rem; line-height: 48px; }
