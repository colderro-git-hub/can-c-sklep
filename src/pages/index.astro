  .home-side { width: 408px; flex-shrink: 0; display: flex; flex-direction: column; gap: 24px; }
  /* Korzyści (wariant A): siatka z obszarami - na telefonie kolejność nagłówek → zdjęcie → lista → karta */
  .ben {
    display: grid; gap: 24px 45px; align-items: center;
    grid-template-columns: minmax(0, 3fr) minmax(0, 4fr) minmax(0, 5fr);
    grid-template-rows: 1fr auto auto 1fr;
    grid-template-areas: "card img ." "card img head" "card img body" "card img .";
