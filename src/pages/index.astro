<script>
  // Karuzela hero (src/lib/hero-slider.ts) - działa tylko, gdy w /Strony są kolejne slajdy
  import '../lib/hero-slider';

  // Opinie: wyróżniona karta zmienia się co 7 s (pauza po najechaniu / fokusie, „ogranicz ruch” = tylko strzałki)
  {
    const box = document.querySelector<HTMLElement>('[data-rv]');
    const slides = Array.from(box?.querySelectorAll<HTMLElement>('[data-rv-slide]') || []);
    if (box && slides.length > 1) {
      let cur = 0, t = 0, hold = false;
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const count = box.querySelector('[data-rv-count]');
      const show = (n: number) => {
        cur = (n + slides.length) % slides.length;
        slides.forEach((s, i) => { s.hidden = i !== cur; });
        if (count) count.textContent = `${cur + 1} / ${slides.length}`;
        plan();
      };
      const plan = () => { clearTimeout(t); if (!reduced && !hold && !document.hidden) t = window.setTimeout(() => show(cur + 1), 7000); };
      box.querySelector('[data-rv-prev]')?.addEventListener('click', () => show(cur - 1));
      box.querySelector('[data-rv-next]')?.addEventListener('click', () => show(cur + 1));
      ['mouseenter', 'focusin'].forEach((e) => box.addEventListener(e, () => { hold = true; clearTimeout(t); }));
      ['mouseleave', 'focusout'].forEach((e) => box.addEventListener(e, () => { hold = false; plan(); }));
      document.addEventListener('visibilitychange', plan);
      // Start dopiero, gdy sekcja jest na ekranie
      new IntersectionObserver(([e]) => { if (e.isIntersecting) plan(); else clearTimeout(t); }).observe(box);
    }
  }
</script>
