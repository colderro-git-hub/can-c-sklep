    .home-side { width: 100%; }
    .home-split__main { min-width: 0; flex-basis: 100%; }
    .k9-img { width: 100%; border-radius: 300px 20px 20px 20px; }
    .why-shape { width: 180px; height: 112px; }
    .cta-box { flex-direction: column; align-items: stretch; padding: 32px 24px; border-radius: 32px; gap: 24px; }
