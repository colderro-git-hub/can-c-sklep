---
import Base from '../layouts/Base.astro';
import Arrow from '../components/Arrow.astro';
import { products as fallback, bundles, features, reviews, faqs, formatPrice } from '../data/shop';
import { getEnv } from '../lib/env';
import { getCatalog } from '../lib/catalog';
import type { Availability } from '../lib/pricing';
import AvailBadge from '../components/AvailBadge.astro';
import ProductTags from '../components/ProductTags.astro';

// Strona główna z aktualnymi produktami z bazy; przy awarii bazy – dane zapasowe z kodu
export const prerender = false;
type Card = { slug: string; tag: string; tags: string[]; avail: Availability; name: string; desc: string; price: number | null; regular: number | null; onSale: boolean; image?: string; alt?: string; rating: number; reviews: number };
let products: Card[];
try {
  const list = await getCatalog(await getEnv(Astro.locals));
  products = list.map((p) => ({
    slug: p.id, tag: p.subtitle || '', tags: p.tags, avail: p.avail, name: p.name, desc: p.short_description || '',
    price: p.current === null ? null : p.current / 100, regular: p.price === null ? null : p.price / 100, onSale: p.onSale,
    image: p.images[0]?.url, alt: p.images[0]?.alt || p.name, rating: p.rating.avg, reviews: p.rating.count,
  }));
} catch (e) {
  console.error('Strona główna – katalog: ' + (e instanceof Error ? e.message : String(e)));
  products = fallback.map((p) => ({ slug: p.slug, tag: p.tag, tags: [], avail: 'in_stock' as Availability, name: p.name, desc: p.desc, price: p.price, regular: p.price, onSale: false, image: p.image, alt: p.name, rating: 0, reviews: 0 }));
}
Astro.response.headers.set('Cache-Control', 'public, max-age=60');

const dropsPrice = products.find((p) => p.slug === 'krople-can-c')?.price ?? fallback[0].price ?? 0;
const bundleRows = bundles.map((b) => {
  const total = dropsPrice * b.qty * (1 - b.discount);
  return {
    ...b,
    total: formatPrice(total),
    unit: `${formatPrice(total / b.qty)} za sztukę`,
    save: b.discount ? `Oszczędzasz ${Math.round(b.discount * 100)}%` : 'Cena regularna',
  };
});
---
<Base
  title="Krople do oczu Can-C z N-acetylokarnozyną | Oryginał, darmowa dostawa"
  description="Oryginalne krople Can-C zatwierdzone przez IVP. Darmowa dostawa InPost i kurierem, do 10% rabatu przy zestawach, płatność BLIK."
>
  <!-- Hero -->
  <section class="section section--dark">
    <div class="container hero">
      <div class="hero__text">
        <p class="hero__kicker">Oryginalne krople zatwierdzone przez IVP</p>
        <h1>Krople do oczu Can-C z N-acetylokarnozyną</h1>
        <p class="lead">Codzienne wsparcie dla zmęczonych oczu. Można stosować przy soczewkach kontaktowych. Jedno opakowanie to miesięczna kuracja.</p>
        <div class="hero__cta">
          <a href="/produkt/krople-can-c/" class="btn btn--accent btn--lg">Zamów krople <Arrow /></a>
          <a href="/stosowanie/" class="btn btn--ghost btn--lg">Jak stosować</a>
        </div>
        <ul class="hero__trust">
          <li>Darmowa dostawa InPost i kurier</li>
          <li>BLIK, Przelewy24, karta</li>
          <li>Zwrot do 14 dni</li>
        </ul>
      </div>
      <div class="ph hero__img">[Packshot: krople Can-C 2 × 5 ml na ciemnym tle]</div>
    </div>
  </section>

  <!-- Produkty -->
  <section class="section" id="produkty">
    <div class="container stack">
      <div class="section-head">
        <h2>Produkty</h2>
        <a href="/sklep/" class="link-arrow">Zobacz wszystkie <Arrow /></a>
      </div>
      <div class="grid grid--4">
        {products.map((p) => (
          <article class="card">
            <div class={`media media--${p.avail}`}>
              {p.image
                ? <img src={p.image} alt={p.alt} width="400" height="300" loading="lazy" class="card__img" />
                : <div class="ph card__img">[Packshot: {p.name}]</div>}
              <AvailBadge avail={p.avail} />
            </div>
            <div class="card__body">
              {p.tag && <span class="card__tag">{p.tag}</span>}
              <h3><a href={`/produkt/${p.slug}/`} class="card__link">{p.name}</a></h3>
              <ProductTags tags={p.tags} max={3} />
              <p class="muted card__desc">{p.desc}</p>
              <div class="card__foot">
                <span class="card__price">{formatPrice(p.price)}{p.onSale && <s class="muted card__regular"> {formatPrice(p.regular)}</s>}{p.reviews > 0 && <span class="card__rating" aria-label={`Ocena ${p.rating} na 5`}> ★ {p.rating.toLocaleString('pl-PL')}</span>}</span>
                {p.price !== null && p.avail !== 'out_of_stock'
                  ? <button type="button" class="round-btn" data-quick-add={p.slug} aria-label={`Dodaj do koszyka: ${p.name}`}>
                      <svg class="round-btn__plus" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M8 2v12M2 8h12" stroke="currentColor" stroke-width="1.4" /></svg>
                      <svg class="round-btn__ok" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="m3 8.5 3.2 3L13 4.5" stroke="currentColor" stroke-width="1.6" /></svg>
                    </button>
                  : <a href={`/produkt/${p.slug}/`} class="round-btn" aria-label={`Zobacz produkt: ${p.name}`}>
                      <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.4" /></svg>
                    </a>}
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Zestawy -->
  <section class="section section--tint">
    <div class="container stack">
      <div class="intro">
        <h2>Kupuj więcej, płać mniej</h2>
        <p class="lead">Jedno opakowanie wystarcza na miesiąc. Dłuższa kuracja to niższa cena za sztukę.</p>
      </div>
      <div class="grid grid--3">
        {bundleRows.map((b) => (
          <div class:list={['bundle', { 'bundle--featured': b.featured }]}>
            <div class="bundle__top">
              <span class="bundle__qty">{b.label}</span>
              {b.featured && <span class="badge">Polecany</span>}
            </div>
            <div>
              <p class="bundle__total">{b.total}</p>
              <p class="muted">{b.unit}</p>
            </div>
            <ul class="bundle__list">
              <li>{b.months}</li>
              <li>{b.save}</li>
              <li>Darmowa dostawa</li>
            </ul>
            <a href={`/produkt/krople-can-c/?zestaw=${b.qty}`} class="btn">Wybierz zestaw</a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Dlaczego -->
  <section class="section" id="dlaczego">
    <div class="container split">
      <div class="split__aside">
        <h2>Dlaczego krople Can-C</h2>
        <p class="lead">Pierwsze krople na świecie z N-acetylokarnozyną, badane i zatwierdzone przez Innovative Vision Products.</p>
        <a href="/stosowanie/" class="link-arrow">Przeczytaj, jak stosować <Arrow /></a>
      </div>
      <div class="grid grid--2 split__main">
        {features.map((f) => (
          <div class="feature">
            <h3>{f.title}</h3>
            <p class="muted">{f.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Opinie -->
  <section class="section reviews">
    <div class="container stack">
      <h2 class="h3">Opinie klientów</h2>
      <div class="grid grid--3">
        {reviews.map((r) => (
          <figure class="review">
            <svg width="32" height="24" viewBox="0 0 32 24" aria-hidden="true" class="quote-mark"><path d="M0 24V13C0 5 4 1 12 0v5c-4 1-6 4-6 8h6v11H0zm18 0V13c0-8 4-12 12-13v5c-4 1-6 4-6 8h6v11H18z" fill="currentColor" /></svg>
            <blockquote>{r.quote}</blockquote>
            <figcaption class="muted">{r.author}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- K9 -->
  <section class="section">
    <div class="container split split--center">
      <div class="ph k9__img">[Zdjęcie: pies + krople Can-C K9]</div>
      <div class="split__aside">
        <span class="card__tag">DLA PSA</span>
        <h2 class="h3">Krople Can-C K9 z N-acetylokarnozyną</h2>
        <p class="lead">Wersja dla psów. Wielu właścicieli stosuje je profilaktycznie u ras podatnych na problemy z oczami. Skonsultuj kurację z lekarzem weterynarii.</p>
        <a href="/produkt/krople-can-c-k9/" class="btn" style="align-self: flex-start">Zobacz Can-C K9 <Arrow /></a>
      </div>
    </div>
  </section>

  <!-- FAQ: natywne <details>, działa bez JavaScriptu -->
  <section class="section section--tint" id="faq">
    <div class="container split">
      <div class="split__aside">
        <h2>Najczęstsze pytania</h2>
        <a href="/faq/" class="link-arrow">Wszystkie pytania <Arrow /></a>
      </div>
      <div class="split__main faq">
        {faqs.map((f, i) => (
          <details class="faq__item" open={i === 0}>
            <summary>{f.q}</summary>
            <p class="muted">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Newsletter -->
  <section class="section">
    <div class="container split">
      <div class="split__aside">
        <h2 class="h3">Rabat [X%] dla nowych klientów</h2>
        <p class="lead">Zapisz się na newsletter. Informujemy tylko o promocjach i nowościach.</p>
      </div>
      <form class="split__main newsletter" method="post" action="/api/newsletter">
        <label class="field" for="nl-email">Adres e-mail
          <span class="newsletter__row">
            <input id="nl-email" name="email" type="email" required autocomplete="email" placeholder="jan@przyklad.pl" class="input" />
            <button type="submit" class="btn">Zapisz się</button>
          </span>
        </label>
        <label class="consent">
          <input type="checkbox" name="consent" required />
          <span>Wyrażam zgodę na otrzymywanie od Colderro Ewa Zimna informacji handlowych drogą elektroniczną, zgodnie z <a href="/polityka-prywatnosci/">Polityką prywatności</a>.</span>
        </label>
      </form>
    </div>
  </section>
</Base>

<script>
  import { addItem } from '../lib/cart';
  import { flyToCart, announceAdded } from '../lib/cart-fx';
  // „+” na karcie: 1 sztuka do koszyka bez wchodzenia na stronę produktu
  document.querySelectorAll<HTMLButtonElement>('[data-quick-add]').forEach((b) => b.addEventListener('click', () => {
    const slug = b.dataset.quickAdd!;
    addItem(slug, 1);
    b.classList.add('is-added');
    setTimeout(() => b.classList.remove('is-added'), 1600);
    const img = b.closest('.card')?.querySelector<HTMLImageElement>('img');
    flyToCart(img || b, img?.src).then(() => announceAdded({ slug, qty: 1 }));
  }));
</script>

<style>
  .stack { display: flex; flex-direction: column; gap: var(--s-4); }
  .intro { display: flex; flex-direction: column; gap: var(--s-2); max-width: 600px; }
  .h3 { font-size: var(--fs-h3); font-weight: 300; }
  .section-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: var(--s-2); padding-bottom: var(--s-2); border-bottom: 1px solid var(--c-ink-10); }

  .grid { display: grid; gap: var(--s-2); }
  .grid--4 { grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); }
  .grid--3 { grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: var(--s-3); }
  .grid--2 { grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: var(--s-4) var(--s-3); }

  .split { display: flex; flex-wrap: wrap; gap: var(--s-4) var(--s-6); }
  .split--center { align-items: center; }
  .split__aside { flex: 1 1 360px; display: flex; flex-direction: column; gap: var(--s-2); }
  .split__main { flex: 2 1 520px; min-width: 0; }

  /* Hero */
  .hero { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s-6); }
  .hero__text { flex: 1 1 480px; min-width: 0; display: flex; flex-direction: column; gap: var(--s-3); }
  .hero__text h1 { max-width: 40rem; }
  .hero__kicker { font-size: var(--fs-small); color: var(--c-white-70); }
  .hero__cta { display: flex; flex-wrap: wrap; gap: var(--s-1); }
  .hero__trust { list-style: none; margin: 0; padding: var(--s-2) 0 0; display: flex; flex-wrap: wrap; gap: 12px 36px; border-top: 1px solid var(--c-white-20); color: rgba(255, 255, 255, 0.85); }
  .hero__img { flex: 1 1 420px; aspect-ratio: 7 / 8; background: rgba(255, 255, 255, 0.05); box-shadow: inset 0 0 0 1px var(--c-white-20); color: var(--c-white-70); }

  /* Karta produktu: pas zdjęcia nad białą przestrzenią, bez cienia i zaokrągleń.
     Link w nazwie rozciąga się na całą kartę (klik w zdjęcie też otwiera produkt); przycisk „+” leży nad nim. */
  .card { position: relative; display: flex; flex-direction: column; background: var(--c-gray-100); }
  .card__img { aspect-ratio: 4 / 3; width: 100%; object-fit: contain; padding: 16px; background: var(--c-photo-bg); }
  .card__link::after { content: ''; position: absolute; inset: 0; z-index: 1; }
  .card:has(.card__link:focus-visible) { outline: 2px solid var(--c-link); outline-offset: 3px; }
  .card__link:focus-visible { outline: none; }
  .card__body { padding: var(--s-2); display: flex; flex-direction: column; gap: var(--s-1); flex-grow: 1; }
  .card__tag { font-size: 0.8125rem; letter-spacing: 0.08em; color: var(--c-ink-70); }
  .card__link { color: inherit; text-decoration: none; }
  .card__desc { flex-grow: 1; }
  .card__foot { display: flex; justify-content: space-between; align-items: center; padding-top: var(--s-1); }
  .card__price { font-size: 1.25rem; }
  .card__regular { font-size: 0.9375rem; }
  .card__rating { font-size: 0.875rem; color: var(--c-star-ink); }
  .round-btn { position: relative; z-index: 2; width: 48px; height: 48px; border: 0; padding: 0; border-radius: 24px; background: var(--c-ink); color: var(--c-white); display: flex; align-items: center; justify-content: center; cursor: pointer; transition: background-color 200ms ease; }
  .round-btn:hover { opacity: 0.8; }
  .round-btn__ok { display: none; }
  .round-btn.is-added { background: var(--c-ok); color: var(--c-paper); }
  .round-btn.is-added .round-btn__plus { display: none; }
  .round-btn.is-added .round-btn__ok { display: block; }

  /* Zestawy */
  .bundle { background: var(--c-white); padding: var(--s-3); display: flex; flex-direction: column; gap: var(--s-2); box-shadow: inset 0 0 0 1px var(--c-gray-400); }
  .bundle--featured { box-shadow: inset 0 0 0 1px var(--c-ink); }
  .bundle__top { display: flex; justify-content: space-between; align-items: center; min-height: 32px; }
  .bundle__qty { font-size: 1.125rem; }
  .badge { font-size: 0.8125rem; padding: 6px 14px; border-radius: var(--r-pill); background: var(--c-accent); color: var(--c-black); }
  .bundle__total { font-size: 2.5rem; font-weight: 300; line-height: 1.15; letter-spacing: -0.01em; }
  .bundle__list { list-style: none; margin: 0; padding: var(--s-2) 0 0; display: flex; flex-direction: column; gap: var(--s-1); border-top: 1px solid var(--c-ink-10); }

  .feature { display: flex; flex-direction: column; gap: var(--s-1); padding-top: var(--s-2); border-top: 1px solid var(--c-ink-10); }

  .reviews { background: var(--c-tint); }
  .review { margin: 0; display: flex; flex-direction: column; gap: var(--s-2); }
  .quote-mark { color: var(--c-link); }
  .review blockquote { margin: 0; font-size: 1.25rem; }

  .k9__img { flex: 1 1 420px; aspect-ratio: 4 / 3; }

  /* FAQ */
  .faq { display: flex; flex-direction: column; gap: var(--s-1); }
  .faq__item { background: var(--c-white); box-shadow: inset 0 0 0 1px var(--c-gray-400); }
  .faq__item summary { list-style: none; cursor: pointer; min-height: 72px; padding: var(--s-2) 32px; display: flex; justify-content: space-between; align-items: center; gap: var(--s-2); font-size: 1.25rem; line-height: 1.3; }
  .faq__item summary::-webkit-details-marker { display: none; }
  .faq__item summary::after { content: '+'; font-size: 1.75rem; font-weight: 300; }
  .faq__item[open] summary::after { content: '−'; }
  .faq__item p { padding: 0 32px 32px; max-width: 600px; }

  /* Newsletter */
  .newsletter { display: flex; flex-direction: column; gap: 16px; }
  .newsletter__row { display: flex; flex-wrap: wrap; gap: var(--s-1); }
  .newsletter__row .input { flex: 1 1 240px; }
  .consent { display: flex; gap: 12px; align-items: flex-start; font-size: var(--fs-small); line-height: 24px; color: var(--c-ink-75); }
  .consent input { width: 18px; height: 18px; margin: 3px 0 0; accent-color: var(--c-ink); flex-shrink: 0; }
</style>
