---
import Icon from '../components/Icon.astro';
import Base from '../layouts/Base.astro';
import { products as fallback, features, reviews, faqs, formatPrice } from '../data/shop';
import { applyPromotions, qtyOptions } from '../lib/promotions';
import { getPromotions } from '../lib/promotions-db';
import { getEnv } from '../lib/env';
import { getCatalog } from '../lib/catalog';
import { db } from '../lib/supabase';
import { getPageContent, getSection, getSections, applyTokens } from '../lib/page-content';
import { getSite } from '../lib/site-settings';
import type { Availability } from '../lib/pricing';
import { AVAIL_LABEL } from '../lib/catalog';
import Stars from '../components/Stars.astro';
import NewsletterForm from '../components/NewsletterForm.astro';
import ProductCard from '../components/ProductCard.astro';
import FaqItem from '../components/FaqItem.astro';

// Strona główna z aktualnymi produktami i treściami z bazy; przy awarii bazy – dane zapasowe z kodu
export const prerender = false;
type Card = { slug: string; tag: string; tags: string[]; avail: Availability; name: string; desc: string; price: number | null; regular: number | null; onSale: boolean; image?: string; alt?: string; rating: number; reviews: number };
let products: Card[];
try {
  const list = await getCatalog(await getEnv(Astro.locals));
  products = list.map((p) => ({
    slug: p.id, tag: p.subtitle || '', tags: p.tags, avail: p.avail, name: p.name, desc: p.short_description || '',
    price: p.current === null ? null : p.current / 100, regular: p.price === null ? null : p.price / 100, onSale: p.onSale,
    image: p.images[0]?.url, alt: p.images[0]?.alt || p.name, rating: p.rating.avg, reviews: p.rating.count,
  }));
} catch (e) {
  console.error('Strona główna – katalog: ' + (e instanceof Error ? e.message : String(e)));
  products = fallback.map((p) => ({ slug: p.slug, tag: p.tag, tags: [], avail: 'in_stock' as Availability, name: p.name, desc: p.desc, price: p.price, regular: p.price, onSale: false, image: p.image, alt: p.name, rating: 0, reviews: 0 }));
}
Astro.response.headers.set('Cache-Control', 'public, max-age=60');
// Średnia ocen ze wszystkich produktów (ważona liczbą opinii)
const ratingCount = products.reduce((n, p) => n + p.reviews, 0);
const ratingAvg = ratingCount ? Math.round((products.reduce((n, p) => n + p.rating * p.reviews, 0) / ratingCount) * 10) / 10 : 0;

// Treści z CMS (strona główna + FAQ)
const env = await getEnv(Astro.locals);
const [homeRows, faqRows, site] = await Promise.all([
  getPageContent(env, 'home').catch(() => []),
  getPageContent(env, 'faq').catch(() => []),
  getSite(env).catch(() => null),
]);
const tokens = site ? { company: site.company, hours: site.hours, email: site.email, shippingTime: site.shippingTime } : {};
const at = (key: string, fb: any, rows = homeRows): any => (getSection(rows, key) ?? fb);

const hero = at('home.hero', {
  kicker: 'Oryginalne krople zatwierdzone przez IVP',
  h1: 'Krople do oczu Can-C z N-acetylokarnozyną',
  lead: 'Codzienne wsparcie dla zmęczonych oczu. Można stosować przy soczewkach kontaktowych.',
  cta_primary_label: 'Zamów krople', cta_primary_href: '/produkt/krople-can-c/',
  cta_secondary_label: 'Jak stosować', cta_secondary_href: '/stosowanie/',
  trust: ['Darmowa dostawa InPost i kurier', 'BLIK, Przelewy24, karta', 'Zwrot do 14 dni'],
  image_url: null as string | null, image_alt: 'Krople Can-C',
});
const why = at('home.why', {
  h2: 'Dlaczego krople Can-C', lead: '', link_label: 'Przeczytaj, jak stosować', link_href: '/stosowanie/',
  features: features as { title: string; text: string }[],
});
const reviewsCms = at('home.reviews', { h2: 'Opinie klientów', items: reviews as { quote: string; author: string }[] });

// 5 najnowszych zatwierdzonych opinii z bazy (z produktem, którego dotyczą); bez opinii w bazie – teksty z CMS
type HomeReview = { quote: string; author: string; slug?: string; productName?: string; image?: string };
const shorten = (t: string, n = 180) => (t.length > n ? t.slice(0, t.lastIndexOf(' ', n) > 120 ? t.lastIndexOf(' ', n) : n).trimEnd() + '…' : t);
let latestReviews: HomeReview[] = [];
try {
  const rows = await db(env).select<{ product_id: string; author_name: string; body: string }>(
    'reviews?select=product_id,author_name,body&status=eq.approved&order=created_at.desc&limit=5');
  latestReviews = rows.map((r) => {
    const prod = products.find((x) => x.slug === r.product_id);
    return { quote: shorten(r.body), author: r.author_name, slug: r.product_id, productName: prod?.name, image: prod?.image };
  });
} catch { /* baza niedostępna – zostają teksty z CMS */ }
const homeReviews: HomeReview[] = latestReviews.length ? latestReviews : (reviewsCms.items as HomeReview[]).slice(0, 5);
// Układ: 3 opinie, karta „Napisz opinię”, kolejne opinie
const reviewSlots: (HomeReview | 'cta')[] = [...homeReviews.slice(0, 3), 'cta', ...homeReviews.slice(3)];
const benefits = at('home.benefits', {
  kicker: 'DLACZEGO KROPLE CAN-C?',
  h2: 'Korzyści używania kropli Can-C',
  items: [
    'Zmniejszają występowanie i rozwój zaćmy starczej.',
    'Korzystne przy dyskomforcie noszenia soczewek kontaktowych.',
    'Pomagają przy walce z chorobami rogówki.',
    'Walka z przemęczeniem oczu.',
    'Łagodzą efekt zespołu suchego oka.',
    'Poprawiają funkcję starzejącego się oka.',
    'Przywracają ostrość widzenia.',
  ] as string[],
  cta_label: 'Jak używać kropli Can-C',
  cta_href: '/stosowanie/',
  image_url: null as string | null,
  image_alt: 'Korzyści stosowania kropli Can-C',
});
const k9 = at('home.k9', { tag: 'DLA PSA', h2: 'Krople Can-C K9 z N-acetylokarnozyną', lead: '', cta_label: 'Zobacz Can-C K9', cta_href: '/produkt/krople-can-c-k9/', image_url: null as string | null, image_alt: 'Can-C K9' });
const faqCatLabel: Record<string, string> = { produkt: 'Produkt', stosowanie: 'Stosowanie', zamowienia: 'Zamówienia i dostawa', zwroty: 'Płatności i zwroty' };
const escHtml = (t: string) => t.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
const faqCms = getSections<{ cat: string; home: boolean; q: string; a: string }>(faqRows, 'item')
  .filter((f) => f.home)
  .map((f) => ({ q: f.q, a: applyTokens(f.a, tokens), cat: f.cat }));
const faqList: { q: string; a: string; cat?: string }[] = faqCms.length ? faqCms : faqs;

const dropsPrice = products.find((p) => p.slug === 'krople-can-c')?.price ?? fallback[0].price ?? 0;
// Zestawy kropli: progi i rabaty z promocji ilościowych (panel: Kody rabatowe → Promocje)
const promos = await getPromotions(env).catch(() => []);
const many = (n: number, one: string, few: string, lots: string) => (n === 1 ? one : n % 10 >= 2 && n % 10 <= 4 && (n % 100 < 12 || n % 100 > 14) ? few : lots);
const dropsUnit = Math.round((dropsPrice ?? 0) * 100); // grosze
const setQtys = (() => { const q = qtyOptions('krople-can-c', promos); return q.join() === '1,2,3' ? [1, 2, 4] : q.slice(0, 3); })();
const bundleRows = setQtys.map((qty) => {
  const gross = dropsUnit * qty;
  const disc = applyPromotions([{ product_id: 'krople-can-c', qty, unit_price: dropsUnit }], promos).total;
  const pct = gross ? Math.round((disc / gross) * 100) : 0;
  const total = (gross - disc) / 100;
  return {
    qty, pct,
    label: `${qty} ${many(qty, 'opakowanie', 'opakowania', 'opakowań')}`,
    months: `${qty} ${many(qty, 'miesiąc', 'miesiące', 'miesięcy')} kuracji`,
    total: formatPrice(total),
    unit: `${formatPrice(total / qty)} za sztukę`,
    save: pct ? `Oszczędzasz ${pct}%` : 'Cena regularna',
  };
});
---
<Base title="Krople do oczu Can-C z N-acetylokarnozyną" description="Oryginalne krople Can-C z N-acetylokarnozyną. Darmowa dostawa, szybka wysyłka.">
  <!-- HERO -->
  <section class="container" style="margin-top: 45px">
    <div class="hero" style="position:relative;height:638px">
      <!-- Kształty tła -->
      <div class="hero-shape" style="position:absolute;left:64.46%;right:0;top:0;height:545px;background:var(--image);border-radius:50px"></div>
      <div class="hero-shape" style="position:absolute;left:0;top:221px;width:72.38%;height:324px;background:var(--image);border-radius:50px"></div>
      <div class="hero-shape" style="position:absolute;left:0;top:221px;width:35.54%;height:417px;background:var(--image);border-radius:50px"></div>
      <div class="hero-shape" style="position:absolute;left:calc(64.46% - 50px);top:171px;width:50px;height:50px;background:radial-gradient(circle at 0 0,transparent 49.5px,var(--image) 50px)"></div>
      <div class="hero-shape" style="position:absolute;left:35.54%;top:545px;width:50px;height:50px;background:radial-gradient(circle at 100% 100%,transparent 49.5px,var(--image) 50px)"></div>
      {hero.image_url
        ? <img src={hero.image_url} alt={hero.image_alt} class="hero-shape" style="position:absolute;left:64.46%;right:0;top:0;width:auto;height:545px;object-fit:cover;border-radius:50px" width="462" height="545" loading="eager" />
        : <span class="hero-shape" style="position:absolute;left:64.46%;right:0;top:300px;text-align:center;font-size:14px;font-weight:300;color:var(--muted)">[zdjęcie: opakowanie Can-C]</span>}
      <!-- Tekst -->
      <div style="position:absolute;left:0;top:0;display:flex;flex-direction:column;gap:14px">
        <span class="tag" style="align-self:flex-start;height:36px;padding:0 16px;font-size:16px">{hero.kicker}</span>
        <h1 style="margin:0;font-size:clamp(2.5rem,5vw,4.5rem);line-height:1.111;font-weight:300;letter-spacing:-0.05em">
          <span style="display:block">Krople do oczu Can-C</span>
          <span style="display:block;padding-left:68px">z N-acetylokarnozyną</span>
        </h1>
      </div>
      <span aria-hidden="true" style="position:absolute;left:9px;top:169px;width:50px;height:2px;background: var(--primary)"></span>
      <p style="position:absolute;left:39%;right:0;top:590px;font-size:16px;line-height:24px;font-weight:300;color:var(--muted);text-align:left">{hero.lead}</p>
    </div>

    <!-- Bloki zaufania + CTA -->
    <div class="hero-bottom">
      <div class="trust">
        <div class="trust-box">
          <span class="trust-box__num">0 zł</span>
          <Icon name="truck" size={36} stroke={1.5} class="trust-box__icon" />
          <span class="trust-box__sub">InPost i DPD</span>
        </div>
        <div class="trust-box">
          <span class="trust-box__num">14 dni</span>
          <Icon name="undo-2" size={36} stroke={1.5} class="trust-box__icon" />
          <span class="trust-box__sub">Na zwrot</span>
        </div>
        <div class="trust-box">
          <span class="trust-box__num">BLIK</span>
          <Icon name="credit-card" size={36} stroke={1.5} class="trust-box__icon" />
          <span class="trust-box__sub">Przelewy24, karta</span>
        </div>
      </div>
      <span aria-hidden="true" class="hero-bottom__sep"></span>
      <div class="hero-cta">
        <a href={hero.cta_primary_href} class="btn btn--wide">
          {hero.cta_primary_label}
          <Icon name="arrow-right" size={20} />
        </a>
        {hero.cta_secondary_label && <a href={hero.cta_secondary_href} class="btn btn--outline btn--wide">{hero.cta_secondary_label}</a>}
      </div>
    </div>
  </section>

  <!-- PRODUKTY -->
  <section class="section section--band sec-gap" id="produkty">
    <div class="container">
      <div style="display:flex;align-items:flex-end;justify-content:space-between;gap:45px;flex-wrap:wrap">
        <div style="display:flex;flex-direction:column;gap:24px">
          <h2 class="h2">Produkty</h2>
          <p class="lead" style="max-width:517px">Krople do oczu, kapsułki i wersja dla psa. Wszystkie wysyłamy za darmo w ciągu 1 dnia roboczego.</p>
        </div>
        <a href="/sklep/" class="link-arrow">
          <Icon name="arrow-right" size={16} />
          Zobacz wszystkie
        </a>
      </div>
      <div class="products-grid" data-list="Strona główna">
        {products.map((p) => (
          <ProductCard slug={p.slug} name={p.name} tag={p.tag} image={p.image} alt={p.alt} avail={p.avail}
            price={p.price} regular={p.regular} onSale={p.onSale} flag={p.tags[0] ? p.tags[0].charAt(0).toUpperCase() + p.tags[0].slice(1) : undefined} />
        ))}
      </div>
    </div>
  </section>

  <!-- KORZYŚCI -->
  <section class="container home-split home-split--center sec-gap">
    <div class="ben-img">
      {benefits.image_url
        ? <img src={benefits.image_url} alt={benefits.image_alt} style="width:100%;height:100%;object-fit:cover" />
        : <span style="font-size:14px;font-weight:300;color:var(--muted)">[zdjęcie: zbliżenie oka]</span>}
    </div>
    <div class="home-split__main" style="gap:45px">
      <h2 class="h2">{benefits.h2}</h2>
      <ul class="benefits-list">
        {(benefits.items as string[]).map((item: string) => (
          <li class="lead" style="display:flex;align-items:flex-start;gap:14px;padding-top:14px;border-top:1px solid var(--line)">
            <Icon name="check" size={18} style="flex-shrink:0;margin-top:5px" />
            <span set:html={item.replace(/\*\*(.+?)\*\*/g,'<strong>$1</strong>')} />
          </li>
        ))}
      </ul>
      {benefits.cta_label && <a href={benefits.cta_href} class="btn" style="align-self:flex-start">{benefits.cta_label}</a>}
    </div>
  </section>

  <!-- ZESTAWY -->
  <section class="container sec-gap">
    <div class="sec-line"></div>
    <div class="bundles-head">
      <h2 class="h2">Kupuj więcej,<br/>płać mniej</h2>
      <p class="lead bundles-head__p">Jedno opakowanie wystarcza na około miesiąc. Dłuższa kuracja to niższa cena za sztukę, a dostawa zawsze jest darmowa.</p>
    </div>
    <div class="bundles-grid">
      {bundleRows.map((b, i) => (
        <div class={`bundle-card${i === 1 ? ' bundle-card--featured' : ''}`}>
          {i > 0 && (i === 1 || b.pct > 0) && <span class="tag tag--peach" style="position:absolute;right:24px;top:24px">{[i === 1 ? 'Polecany' : '', b.pct ? `−${b.pct}%` : ''].filter(Boolean).join(' ')}</span>}
          <span style="font-size:18px;line-height:27px;font-weight:400">{b.label}</span>
          <div>
            <div style="font-size:3rem;line-height:72px;font-weight:300">{b.total}</div>
            <div style={`font-size:14px;line-height:21px;font-weight:300;color:${i === 1 ? 'rgba(255,255,255,0.65)' : 'var(--muted)'}`}>{b.unit}</div>
          </div>
          <ul style={`list-style:none;margin:0;padding:14px 0 0;border-top:1px solid ${i === 1 ? 'var(--on-dark-line)' : 'var(--line)'};display:flex;flex-direction:column;gap:10px;font-size:16px;line-height:24px;font-weight:300`}>
            <li style="display:flex;align-items:center;gap:14px">
              <Icon name="check" size={18} />
              {b.months}
            </li>
            {i > 0 && <li style="display:flex;align-items:center;gap:14px">
              <Icon name="check" size={18} />
              {b.save !== 'Cena regularna' ? b.save : ''}
            </li>}
            <li style="display:flex;align-items:center;gap:14px">
              <Icon name="check" size={18} />
              Darmowa dostawa
            </li>
          </ul>
          <a href={`/produkt/krople-can-c/?zestaw=${b.qty}`} class={i === 1 ? 'btn btn--white btn--wide' : 'btn btn--outline btn--wide'}>Wybierz zestaw</a>
        </div>
      ))}
    </div>
  </section>

  <!-- DLACZEGO -->
  <section class="container home-split sec-gap">
    <div class="home-side">
      <div class="why-shape" aria-hidden="true"></div>
      <h2 class="h2">{why.h2}</h2>
      {why.lead && <p class="lead" style="text-align:left">{why.lead}</p>}
      {why.link_label && <a href={why.link_href} class="link-arrow">
        <Icon name="arrow-right" size={16} />
        {why.link_label}
      </a>}
    </div>
    <div class="home-split__main why-grid">
      {(why.features as {title:string;text:string}[]).map((f, i) => (
        <div class="why-card">
          <span class="why-card__n">0{i+1}</span>
          <h3 style="margin:0;font-size:1.5rem;line-height:28px;font-weight:400">{f.title}</h3>
          <p class="lead" style="text-align:left">{f.text}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- OPINIE -->
  <section class="section section--band sec-gap">
    <div class="container home-split">
      <div class="home-side">
        <h2 class="h2">{reviewsCms.h2}</h2>
        <div style="display:flex;align-items:center;gap:14px">
          <span style="font-size:4rem;line-height:64px;font-weight:300">{ratingAvg ? ratingAvg.toLocaleString('pl-PL', { minimumFractionDigits: 1, maximumFractionDigits: 1 }) : '—'}</span>
          <div style="display:flex;flex-direction:column;gap:4px">
            <Stars value={ratingAvg || 5} size={16} label={`Średnia ocena ${ratingAvg || 5} na 5`} />
            <span style="font-size:14px;font-weight:300;color:var(--muted)">{ratingCount ? `na podstawie ${ratingCount} ${ratingCount === 1 ? 'opinii' : 'opinii'}` : 'opinie klientów'}</span>
          </div>
        </div>
      </div>
      <div class="home-split__main rv-grid">
        {reviewSlots.map((r) => r === 'cta' ? (
          <div style="border-radius:20px;padding:24px;background:var(--image);display:flex;flex-direction:column;justify-content:space-between;gap:24px">
            <span style="font-size:1.5rem;line-height:28px;font-weight:400">Kupiłeś Can-C? Podziel się wrażeniami.</span>
            <a href="/produkt/krople-can-c/#opinia" class="btn btn--outline btn--sm" style="align-self:flex-start">Napisz opinię</a>
          </div>
        ) : (
          <figure style="margin:0;background:var(--surface);border:1px solid var(--line);border-radius:20px;padding:24px;display:flex;flex-direction:column;gap:14px">
            <div style="display:flex;align-items:center;gap:14px">
              {r.slug
                ? <a href={`/produkt/${r.slug}/`} class="rv-thumb" title={r.productName} aria-label={`Opinia o produkcie: ${r.productName || r.slug}`}>
                    {r.image ? <img src={r.image} alt="" width="44" height="44" loading="lazy" /> : null}
                  </a>
                : <span class="rv-thumb" aria-hidden="true"></span>}
              <figcaption style="font-size:18px;line-height:27px;font-weight:500">{r.author}</figcaption>
            </div>
            <Icon name="quote" size={20} stroke={1.5} style="color:var(--accent)" />
            <blockquote style="margin:0;font-size:16px;line-height:24px;font-weight:300;color:var(--muted);text-align:left">{r.quote}</blockquote>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- K9 -->
  <section class="container home-split home-split--center sec-gap">
    <div class="k9-img">
      {k9.image_url
        ? <img src={k9.image_url} alt={k9.image_alt} style="width:100%;height:100%;object-fit:cover" />
        : <span style="font-size:14px;font-weight:300;color:var(--muted)">[zdjęcie: pies]</span>}
    </div>
    <div class="home-split__main">
      {k9.tag && <span class="tag tag--peach" style="align-self:flex-start">{k9.tag}</span>}
      <h2 class="h2">{k9.h2}</h2>
      {k9.lead && <p class="lead" style="text-align:left">{k9.lead}</p>}
      <div style="display:flex;align-items:center;gap:24px;margin-top:21px;flex-wrap:wrap">
        <a href={k9.cta_href} class="btn">
          {k9.cta_label}
          <Icon name="arrow-right" size={20} />
        </a>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="container home-split sec-gap">
    <div class="home-side">
      <h2 class="h2">Najczęstsze<br/>pytania</h2>
      <a href="/faq/" class="link-arrow">
        <Icon name="arrow-right" size={16} />
        Wszystkie pytania
      </a>
    </div>
    <div class="home-split__main" style="gap:14px">
      {faqList.map((f, i) => (
        <FaqItem cat={f.cat ? faqCatLabel[f.cat] : undefined} q={f.q} answer={escHtml(f.a)} open={i === 0} />
      ))}
    </div>
  </section>

  <!-- NEWSLETTER (zapis z obowiązkową zgodą i potwierdzeniem e-mailem) -->
  <section class="w sec-gap" id="newsletter" style="margin-bottom:90px">
    <div class="row cta-box">
      <div class="fl cta-box__l">
        <h2 class="h2">Rabaty i nowości<br/>na Twój e-mail</h2>
        <p class="p">Zapisz się na newsletter – jako pierwszy dowiesz się o promocjach i dostaniesz kody rabatowe dla subskrybentów. Bez spamu, wypisujesz się jednym kliknięciem.</p>
      </div>
      <div class="fl cta-box__r">
        <NewsletterForm variant="light" title="" lead="" />
      </div>
    </div>
  </section>
</Base>


<style>
  /* Hero: kształty w px pod kontener 1300 px; węższe ekrany – układ pionowy */
  .hero { overflow: hidden; }
  @media (max-width: 1380px) {
    .hero { height: auto !important; display: flex; flex-direction: column; }
    .hero > div.hero-shape, .hero > span.hero-shape, .hero > span[aria-hidden="true"] { display: none; }
    .hero > div[style*="position:absolute;left:0;top:0"] { position: static !important; }
