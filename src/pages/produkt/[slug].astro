---
import Icon from '../../components/Icon.astro';
// Karta produktu generowana z bazy przy każdym wejściu (zmiany z panelu widać od razu)
import Base from '../../layouts/Base.astro';
import AvailBadge from '../../components/AvailBadge.astro';
import ProductTags from '../../components/ProductTags.astro';
import Stars from '../../components/Stars.astro';
import { getEnv } from '../../lib/env';
import { getProductPage, AVAIL_LABEL, leadTimeText } from '../../lib/catalog';
import { applyPromotions, qtyOptions } from '../../lib/promotions';
import { getPromotions } from '../../lib/promotions-db';
import { markdown, plainText } from '../../lib/markdown';
import { getSite } from '../../lib/site-settings';
import { TURNSTILE_SITE_KEY } from '../../config';

export const prerender = false;

const env = await getEnv(Astro.locals);
const slug = Astro.params.slug || '';
const data = await getProductPage(env, slug).catch((e) => { console.error('Karta produktu: ' + (e instanceof Error ? e.message : String(e))); return null; });
if (!data) return new Response(null, { status: 404, statusText: 'Nie znaleziono' });
const { product: p, reviews, related, dist } = data;
const site = await getSite(env);

const pln = (g: number | null) => (g === null ? '-' : new Intl.NumberFormat('pl-PL', { style: 'currency', currency: 'PLN' }).format(g / 100));
const buyable = p.current !== null && p.avail !== 'out_of_stock';
// Termin realizacji: zdanie z produktu, a gdy puste - czas wysyłki z ustawień sklepu
const leadTime = p.lead_time ? leadTimeText(p.lead_time, site.shippingTime) : site.shippingTime;
// Opcje ilości i ceny z promocji ilościowych (panel: Kody rabatowe → Promocje)
const promos = await getPromotions(env);
const many = (n: number, one: string, few: string, lots: string) => (n === 1 ? one : n % 10 >= 2 && n % 10 <= 4 && (n % 100 < 12 || n % 100 > 14) ? few : lots);
const qtys = qtyOptions(p.id, promos);
const options = qtys.map((qty, i) => {
  const gross = p.current === null ? null : p.current * qty;
  const disc = gross === null ? 0 : applyPromotions([{ product_id: p.id, qty, unit_price: p.current! }], promos).total;
  const total = gross === null ? null : gross - disc;
  const rate = gross ? disc / gross : 0;
  return {
    qty, rate, total,
    label: p.bundles ? `${qty} ${many(qty, 'opakowanie', 'opakowania', 'opakowań')}` : `${qty} szt.`,
    sub: p.bundles ? `${qty} ${many(qty, 'miesiąc', 'miesiące', 'miesięcy')} kuracji` : (p.subtitle || ''),
    rec: p.bundles && i === 1 && disc > 0,
  };
});
const defaultQty = p.bundles && options[1] && options[1].rate > 0 ? options[1].qty : 1;
const def = options.find((o) => o.qty === defaultQty)!;
const salePct = p.onSale && p.price ? Math.round((1 - p.current! / p.price) * 100) : 0;
const images = p.images.length ? p.images : [];
const url = new URL(`/produkt/${p.id}/`, Astro.url.origin).toString();
const reviewsWord = (n: number) => (n === 1 ? 'opinia' : n % 10 >= 2 && n % 10 <= 4 && (n % 100 < 12 || n % 100 > 14) ? 'opinie' : 'opinii');
const navKey = p.id.includes('k9') ? 'k9' : p.id.startsWith('kapsulki') ? 'kapsulki' : 'krople';
const dateLabel = (iso: string) => new Date(iso).toLocaleDateString('pl-PL');

// Dane strukturalne Google: produkt, oferta, dostawa, zwroty, oceny
const gtin = (p.ean || '').replace(/\D/g, '');
const jsonLd: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: p.name,
  description: p.seo_description || p.short_description || plainText(p.description).slice(0, 500),
  sku: p.id,
  ...(gtin ? { [`gtin${gtin.length === 13 ? '13' : gtin.length === 8 ? '8' : gtin.length === 12 ? '12' : '14'}`]: gtin } : {}),
  ...(p.mpn ? { mpn: p.mpn } : {}),
  brand: { '@type': 'Brand', name: p.brand },
  ...(images.length ? { image: images.map((i) => i.url) } : {}),
  ...(p.current !== null && {
    offers: {
      '@type': 'Offer', url, priceCurrency: 'PLN', price: (p.current / 100).toFixed(2),
      ...(p.onSale && p.sale_end ? { priceValidUntil: p.sale_end.slice(0, 10) } : {}),
      itemCondition: `https://schema.org/${p.condition === 'new' ? 'NewCondition' : p.condition === 'used' ? 'UsedCondition' : 'RefurbishedCondition'}`,
      availability: `https://schema.org/${p.avail === 'in_stock' ? 'InStock' : p.avail === 'preorder' ? 'PreOrder' : p.avail === 'backorder' ? 'BackOrder' : 'OutOfStock'}`,
      shippingDetails: {
        '@type': 'OfferShippingDetails',
        shippingRate: { '@type': 'MonetaryAmount', value: '0', currency: 'PLN' },
        shippingDestination: { '@type': 'DefinedRegion', addressCountry: 'PL' },
        deliveryTime: { '@type': 'ShippingDeliveryTime', handlingTime: { '@type': 'QuantitativeValue', minValue: 0, maxValue: 1, unitCode: 'DAY' }, transitTime: { '@type': 'QuantitativeValue', minValue: 1, maxValue: 2, unitCode: 'DAY' } },
      },
      hasMerchantReturnPolicy: {
        '@type': 'MerchantReturnPolicy', applicableCountry: 'PL', returnPolicyCategory: 'https://schema.org/MerchantReturnFiniteReturnWindow',
        merchantReturnDays: 14, returnMethod: 'https://schema.org/ReturnByMail', returnFees: 'https://schema.org/ReturnFeesCustomerResponsibility',
      },
    },
  }),
  ...(p.rating.count ? {
    aggregateRating: { '@type': 'AggregateRating', ratingValue: p.rating.avg, reviewCount: p.rating.count, bestRating: 5, worstRating: 1 },
    review: reviews.slice(0, 5).map((r) => ({ '@type': 'Review', author: { '@type': 'Person', name: r.author_name }, datePublished: r.created_at.slice(0, 10), reviewRating: { '@type': 'Rating', ratingValue: r.rating, bestRating: 5 }, ...(r.title ? { name: r.title } : {}), reviewBody: r.body })),
  } : {}),
};
Astro.response.headers.set('Cache-Control', 'public, max-age=60');
---
<Base title={p.seo_title || `${p.name} | Can-C`} description={p.seo_description || p.short_description || p.name} nav={navKey} ogImage={images[0]?.url} ogType="product" crumbs={[{ name: 'Sklep', path: '/sklep/' }, { name: p.name, path: `/produkt/${p.id}/` }]}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  {TURNSTILE_SITE_KEY && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}

  <section class="w pr-top">
    <nav class="crumb" aria-label="Okruszki"><a href="/">Strona główna</a> / <a href="/sklep/">Sklep</a> / <span aria-current="page">{p.name}</span></nav>

    <div class="row pr-grid">
      <div class={`fl pr-gallery${p.avail === 'out_of_stock' ? ' is-out' : ''}`} data-gallery>
        <div class="notch pr-main">
          {images.length
            ? <img src={images[0].url} alt={images[0].alt || p.name} width="800" height="800" data-main fetchpriority="high" />
            : <span class="notch__ph">[Zdjęcie produktu - dodaj w panelu]</span>}
          {p.tags[0] && <span class="pr-flag">{p.tags[0].charAt(0).toUpperCase() + p.tags[0].slice(1)}</span>}
          <AvailBadge avail={p.avail} />
          {images.length > 0 && (
            <a href={images[0].url} class="notch__btn" aria-label="Powiększ zdjęcie" target="_blank" rel="noopener" data-zoom>
              <Icon name="arrow-up-right" size={48} stroke={2} />
            </a>
          )}
        </div>
        {images.length > 1 && (
          <div class="pr-thumbs">
            {images.slice(0, 8).map((im, i) => (
              <button type="button" class="pr-thumb" aria-label={`Zdjęcie ${i + 1}`} aria-pressed={i === 0 ? 'true' : 'false'} data-src={im.url} data-alt={im.alt || p.name}>
                <img src={im.url} alt="" width="160" height="160" loading="lazy" />
              </button>
            ))}
          </div>
        )}
      </div>

      <div class="fl pr-buy" data-product={p.id} data-name={p.name} data-price={p.current ?? 0}>
        {p.subtitle && <span class="k">{p.subtitle}</span>}
        <h1 class="h2 pr-title">{p.name}</h1>
        {p.tags.length > 0 && <div class="pr-tags"><ProductTags tags={p.tags} /></div>}
        {p.rating.count > 0 && (
          <a href="#opinie" class="pr-rating" aria-label={`Ocena ${p.rating.avg} na 5, ${p.rating.count} ${reviewsWord(p.rating.count)}`}>
            <Stars value={p.rating.avg} /> {p.rating.avg.toLocaleString('pl-PL', { minimumFractionDigits: 1 })} · {p.rating.count} {reviewsWord(p.rating.count)}
          </a>
        )}
        {p.short_description && <p class="p pr-lead">{p.short_description}</p>}

        <div class="pr-price">
          <div class="pr-price__row" aria-live="polite">
            <span class="pr-price__v" data-price>{pln(def.total)}</span>
            {p.onSale && <s class="pr-price__old" data-regular>{pln(p.price === null ? null : p.price * def.qty)}</s>}
            <span class="peach" data-save hidden={!def.rate && !salePct}>{salePct ? `−${salePct}%` : ''}{def.rate ? ` −${Math.round(def.rate * 100)}% rabatu` : ''}</span>
          </div>
          <span class="k"><span data-unit>{def.total !== null ? `${pln(Math.round(def.total / def.qty))} / szt.` : ''}</span>{p.unitPrice && <> · {p.unitPrice}</>}</span>
          {p.lowest30 !== null && <span class="k">{p.onSale ? 'Najniższa cena z 30 dni przed obniżką' : 'Najniższa cena z ostatnich 30 dni'}: {pln(p.lowest30)}</span>}
          <span class={`pr-avail pr-avail--${p.avail}`}><span class="dot" aria-hidden="true"></span>{AVAIL_LABEL[p.avail] || p.avail}{p.avail === 'in_stock' && <> · <span data-lead>{leadTime}</span></>}</span>
        </div>

        {buyable && (
          <fieldset class="pr-sets">
            <legend>{p.bundles ? 'Wybierz zestaw' : 'Ilość'}</legend>
            {options.map((o) => (
              <label class="opt">
                <input type="radio" name="qty" value={o.qty} checked={o.qty === defaultQty}
                  data-total={pln(o.total)} data-regular={p.onSale && p.price ? pln(p.price * o.qty) : ''}
                  data-unit={o.total !== null ? `${pln(Math.round(o.total / o.qty))} / szt.` : ''}
                  data-save={[salePct ? `−${salePct}%` : '', o.rate ? `−${Math.round(o.rate * 100)}% rabatu` : ''].filter(Boolean).join(' ')} />
                <span class="opt__txt">
                  <span class="opt__t">{o.label}{o.rec && <span class="peach peach--s">polecany</span>}</span>
                  {o.sub && <span class="opt__s">{o.sub}</span>}
                </span>
                <span class="opt__p">{pln(o.total)}</span>
              </label>
            ))}
          </fieldset>
        )}

        <button type="button" class="btn btn--wide pr-add" data-add disabled={!buyable}>{buyable ? 'Dodaj do koszyka' : AVAIL_LABEL[p.avail]}</button>
        <p class="k pr-added" data-added role="status" hidden>Dodano do koszyka. <a href="/koszyk/">Przejdź do koszyka</a></p>

        {p.avail === 'out_of_stock' && (
          <form class="pr-notify" data-notify novalidate>
            <span class="pr-notify__t">Powiadom mnie, gdy produkt będzie dostępny</span>
            <span class="k" style="color: var(--ink)">Wyślemy jeden e-mail, gdy produkt wróci do sprzedaży. Bez newslettera.</span>
            <label class="lbl" for="notify-email" style="margin:10px 0 0">E-mail</label>
            <span class="pr-notify__row">
              <input id="notify-email" class="fld" type="email" name="email" autocomplete="email" required placeholder="jan@przyklad.pl" />
              <button class="btn">Powiadom</button>
            </span>
            <label class="hp" aria-hidden="true">Strona www<input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
            {TURNSTILE_SITE_KEY && <div class="cf-turnstile" data-sitekey={TURNSTILE_SITE_KEY} data-language="pl" data-size="compact"></div>}
            <p class="msg" role="status" data-notify-msg></p>
          </form>
        )}

        {p.highlights.length > 0 && <ul class="checks pr-hl">{p.highlights.map((h) => <li>{h}</li>)}</ul>}

        <div class="pr-perks">
          <div class="trow"><span>InPost Paczkomat 24/7</span><span style="font-weight:400">Darmowa</span></div>
          <div class="trow"><span>Kurier DPD</span><span style="font-weight:400">Darmowa</span></div>
          <div class="trow"><span>Wysyłka</span><span class="pr-muted">{p.lead_time ? leadTime : <span data-site="shippingTime">{leadTime}</span>}</span></div>
          <div class="trow"><span>Zwrot</span><span class="pr-muted">14 dni (nieotwarte opakowanie)</span></div>
        </div>
      </div>
    </div>
  </section>

  <section class="pr-band">
    <div class="w row pr-band__in">
      <div class="fl pr-details">
        <nav class="pr-chips" aria-label="Sekcje produktu" data-chips>
          {p.description && <a href="#opis" class="chip">Opis</a>}
          {p.how_to_use && <a href="#stosowanie" class="chip">Stosowanie</a>}
          <a href="#specyfikacja" class="chip">Specyfikacja</a>
          <a href="#opinie" class="chip">Opinie ({p.rating.count})</a>
        </nav>

        {p.description && (
          <section id="opis" class="pr-sec">
            <h2 class="h3">Opis</h2>
            <div class="md" set:html={markdown(p.description)} />
          </section>
        )}
        {p.how_to_use && (
          <section id="stosowanie" class="pr-sec">
            <h2 class="h3">Stosowanie</h2>
            <div class="md md--checks" set:html={markdown(p.how_to_use)} />
            <a href="/stosowanie/" class="lnk"><Icon name="arrow-right" size={16} />Pełna instrukcja stosowania</a>
          </section>
        )}
        <section id="specyfikacja" class="pr-sec">
          <h2 class="h3">Specyfikacja</h2>
          <dl class="pr-spec">
            <div class="trow"><dt>Marka</dt><dd>{p.brand}</dd></div>
            {p.subtitle && <div class="trow"><dt>Opakowanie</dt><dd>{p.subtitle}</dd></div>}
            {p.unit_value && p.unit_measure && <div class="trow"><dt>Zawartość</dt><dd>{p.unit_value.toLocaleString('pl-PL')} {p.unit_measure === 'szt' ? 'szt.' : p.unit_measure}</dd></div>}
            {p.ean && <div class="trow"><dt>EAN</dt><dd>{p.ean}</dd></div>}
            {p.mpn && <div class="trow"><dt>Kod producenta</dt><dd>{p.mpn}</dd></div>}
            <div class="trow"><dt>Dostępność</dt><dd>{AVAIL_LABEL[p.avail]}</dd></div>
          </dl>
        </section>

        <section id="opinie" class="pr-sec">
          <h2 class="h3">Opinie klientów</h2>
          {p.rating.count > 0
            ? <div class="pr-rsum">
                <div class="pr-avg"><span class="pr-avg__v">{p.rating.avg.toLocaleString('pl-PL', { minimumFractionDigits: 1 })}</span><span class="k">na podstawie {p.rating.count} {p.rating.count === 1 ? 'opinii' : 'opinii'}</span></div>
                {/* Rozkład ocen 5★-1★ */}
                <ul class="pr-dist" aria-label="Rozkład ocen">
                  {dist.map((c: number, i: number) => {
                    const total = dist.reduce((a: number, b: number) => a + b, 0) || 1;
                    return <li><span class="pr-dist__l">{5 - i}<span aria-hidden="true"> ★</span><span class="sr-only"> gwiazdek</span></span><span class="pr-dist__bar" aria-hidden="true"><span style={`width:${Math.round((c / total) * 100)}%`}></span></span><span class="pr-dist__n">{c}</span></li>;
                  })}
                </ul>
              </div>
            : <p class="p">Ten produkt nie ma jeszcze opinii. Bądź pierwszą osobą, która ją doda.</p>}
          {p.rating.count > 1 && (
            <label class="pr-sort"><span class="k">Sortuj:</span>
              <select class="fld" data-reviews-sort aria-label="Sortuj opinie">
                <option value="new">Najnowsze</option>
                <option value="high">Najwyżej oceniane</option>
                <option value="low">Najniżej oceniane</option>
              </select>
            </label>
          )}
          <div class="pr-reviews" data-reviews data-product={p.id} data-offset={reviews.length} data-total={p.rating.count}>
          {reviews.map((r) => (
            <article class="pr-review">
              <div class="pr-review__head">
                <Stars value={r.rating} size={12} label={`Ocena ${r.rating} na 5`} />
                <span class="pr-review__name">{r.author_name}</span>
                {r.verified_purchase && <span class="peach peach--s">Zweryfikowany zakup</span>}
                <span class="k">{dateLabel(r.created_at)}</span>
              </div>
              {r.title && <h3 class="pr-review__title">{r.title}</h3>}
              <p class="p pr-review__body">{r.body}</p>
              {r.reply && <p class="pr-review__reply"><strong>Odpowiedź sklepu:</strong> {r.reply}</p>}
            </article>
          ))}
          </div>
          {p.rating.count > reviews.length && (
            <button type="button" class="btn btn-o btn-m pr-more" data-reviews-more data-left={p.rating.count - reviews.length}>
              Pokaż więcej opinii <span class="k" data-reviews-left>({p.rating.count - reviews.length})</span>
            </button>
          )}
          <p class="k">Opinie publikujemy po sprawdzeniu przez moderatora. Oznaczenie „Zweryfikowany zakup” mają opinie osób, które kupiły produkt w naszym sklepie.</p>

          <details class="pr-form" id="opinia">
            <summary class="btn btn-o btn-m">Napisz opinię</summary>
            <form data-review novalidate>
              <fieldset class="rate"><legend class="lbl">Twoja ocena</legend>
                {[5, 4, 3, 2, 1].map((n) => <><input type="radio" id={`r${n}`} name="rating" value={n} /><label for={`r${n}`} title={`${n} na 5`}><svg aria-hidden="true" width="28" height="28" viewBox="0 0 24 24"><path fill="currentColor" d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg><span class="sr-only">{n} na 5</span></label></>)}
              </fieldset>
              <div class="g2 pr-form__g">
                <div><label class="lbl" for="rv-name">Imię lub pseudonim (widoczne)</label><input id="rv-name" class="fld" name="name" maxlength="60" required /></div>
                <div><label class="lbl" for="rv-mail">E-mail (niewidoczny, do weryfikacji zakupu)</label><input id="rv-mail" class="fld" name="email" type="email" maxlength="200" /></div>
              </div>
              <div><label class="lbl" for="rv-title">Tytuł (opcjonalnie)</label><input id="rv-title" class="fld" name="title" maxlength="120" /></div>
              <div><label class="lbl" for="rv-body">Opinia</label><textarea id="rv-body" class="fld" name="body" rows="4" minlength="10" maxlength="3000" required></textarea></div>
              <label class="ck"><input type="checkbox" name="consent" required /><span>Akceptuję publikację opinii z podanym imieniem. Opinia trafi na stronę po moderacji. Zasady przetwarzania danych: <a href="/polityka-prywatnosci/">polityka prywatności</a>.</span></label>
              <input type="hidden" name="order" /><input type="hidden" name="orderToken" />
              <p class="peach peach--s" data-review-verified hidden style="align-self:flex-start">Ocena z linku w mailu - opinia dostanie oznaczenie „Zweryfikowany zakup”.</p>
              <label class="hp" aria-hidden="true">Strona www<input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
              {TURNSTILE_SITE_KEY && <div class="cf-turnstile" data-sitekey={TURNSTILE_SITE_KEY} data-language="pl"></div>}
              <button class="btn btn-m" style="align-self:flex-start">Wyślij opinię</button>
              <p class="msg" role="status" data-review-msg></p>
            </form>
          </details>
        </section>
      </div>

      {related.length > 0 && (
        <aside class="fl pr-also" aria-label="Często kupowane razem" data-related>
          <span class="pr-also__t">Często kupowane razem</span>
          {related.map((r) => (
            <a class="pr-also__i" href={`/produkt/${r.id}/`} data-slug={r.id} data-name={r.name} data-price={r.current ?? 0}>
              <span class={`pr-also__img${r.avail === 'out_of_stock' ? ' is-out' : ''}`}>
                {r.images[0] ? <img src={r.images[0].url} alt={r.images[0].alt || r.name} width="400" height="400" loading="lazy" /> : <span class="k">[zdjęcie produktu]</span>}
                <AvailBadge avail={r.avail} />
              </span>
              <span class="pr-also__n">{r.name}</span>
              <span class="pr-also__f"><span>{pln(r.current)}</span><span class="pr-also__go">Zobacz <Icon name="arrow-right" size={16} /></span></span>
            </a>
          ))}
        </aside>
      )}
    </div>
  </section>
  {/* Telefon: pasek z ceną i przyciskiem, gdy główny przycisk zniknie z ekranu */}
  {buyable && (
    <div class="pr-sticky" data-sticky aria-hidden="true" hidden>
      <div class="pr-sticky__info">
        <span class="pr-sticky__name">{p.name}</span>
        <span class="pr-sticky__price" data-sticky-price>{pln(def.total)}</span>
      </div>
      <button type="button" class="btn pr-sticky__btn" data-sticky-add tabindex="-1">Dodaj do koszyka</button>
    </div>
  )}
</Base>

<script>
  // „Pokaż więcej opinii”: kolejne 5 z /api/opinie, ten sam wygląd co opinie z serwera
  {
    const box = document.querySelector<HTMLElement>('[data-reviews]');
    const btn = document.querySelector<HTMLButtonElement>('[data-reviews-more]');
    // Zmiana sortowania: pierwsze 5 opinii od nowa w wybranej kolejności
    document.querySelector<HTMLSelectElement>('[data-reviews-sort]')?.addEventListener('change', async (e) => {
      if (!box) return;
      const sort = (e.target as HTMLSelectElement).value;
      box.dataset.sort = sort;
      box.setAttribute('aria-busy', 'true');
      try {
        const res = await fetch(`/api/opinie?product=${encodeURIComponent(box.dataset.product || '')}&offset=0&sort=${sort}`);
        const d = await res.json();
        if (!res.ok) throw new Error();
        box.innerHTML = d.reviews.map(card).join('');
        box.dataset.offset = String(d.reviews.length);
        if (btn) {
          const left = Math.max(0, Number(box.dataset.total || 0) - d.reviews.length);
          btn.dataset.left = String(left);
          const l = btn.querySelector('[data-reviews-left]'); if (l) l.textContent = `(${left})`;
          btn.hidden = !d.more;
        }
      } catch { /* zostaje poprzednia lista */ }
      box.removeAttribute('aria-busy');
    });
    const esc = (s: unknown) => String(s ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);
    const STAR = 'M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z';
    const stars = (n: number) => `<span class="stars" role="img" aria-label="Ocena ${n} na 5">${[1, 2, 3, 4, 5].map((i) => `<svg${i > n ? ' class="off"' : ''} width="12" height="12" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="${STAR}"/></svg>`).join('')}</span>`;
    const card = (r: any) => `<article class="pr-review">
      <div class="pr-review__head">${stars(Math.round(r.rating))}<span class="pr-review__name">${esc(r.author_name)}</span>${r.verified_purchase ? '<span class="peach peach--s">Zweryfikowany zakup</span>' : ''}<span class="k">${new Date(r.created_at).toLocaleDateString('pl-PL')}</span></div>
      ${r.title ? `<h3 class="pr-review__title">${esc(r.title)}</h3>` : ''}
      <p class="p pr-review__body">${esc(r.body)}</p>
      ${r.reply ? `<p class="pr-review__reply"><strong>Odpowiedź sklepu:</strong> ${esc(r.reply)}</p>` : ''}
    </article>`;
    btn?.addEventListener('click', async () => {
      if (!box) return;
      const label = btn.innerHTML;
      btn.disabled = true; btn.textContent = 'Wczytuję…';
      try {
        const res = await fetch(`/api/opinie?product=${encodeURIComponent(box.dataset.product || '')}&offset=${box.dataset.offset || 0}&sort=${box.dataset.sort || 'new'}`);
        const d = await res.json();
        if (!res.ok) throw new Error(d.error || 'Błąd');
        box.insertAdjacentHTML('beforeend', d.reviews.map(card).join(''));
        box.dataset.offset = String(Number(box.dataset.offset || 0) + d.reviews.length);
        const left = Math.max(0, Number(btn.dataset.left || 0) - d.reviews.length);
        btn.dataset.left = String(left);
        btn.innerHTML = label;
        const l = btn.querySelector('[data-reviews-left]'); if (l) l.textContent = `(${left})`;
        btn.hidden = !d.more || left === 0;
        // Fokus na pierwszej nowej opinii (czytniki ekranu, klawiatura)
        const first = box.children[box.children.length - d.reviews.length] as HTMLElement | undefined;
        if (first) { first.tabIndex = -1; first.focus({ preventScroll: true }); }
      } catch {
        btn.innerHTML = label;
        btn.insertAdjacentHTML('afterend', '<p class="k" role="status">Nie udało się wczytać opinii. Spróbuj ponownie.</p>');
      } finally { btn.disabled = false; }
    });
  }

  import { addItem } from '../../lib/cart';
  import { trackViewItem, trackAddToCart, trackSelectItem } from '../../lib/analytics';
  import { flyToCart, announceAdded } from '../../lib/cart-fx';

  // Galeria: miniatury podmieniają główne zdjęcie i link powiększenia
  const gallery = document.querySelector<HTMLElement>('[data-gallery]');
  const main = gallery?.querySelector<HTMLImageElement>('[data-main]');
  const zoom = gallery?.querySelector<HTMLAnchorElement>('[data-zoom]');
  gallery?.querySelectorAll<HTMLButtonElement>('.pr-thumb').forEach((t) => t.addEventListener('click', () => {
    if (!main) return;
    main.src = t.dataset.src!; main.alt = t.dataset.alt || '';
    if (zoom) zoom.href = t.dataset.src!;
    gallery.querySelectorAll('.pr-thumb').forEach((x) => x.setAttribute('aria-pressed', String(x === t)));
  }));

  const root = document.querySelector<HTMLElement>('[data-product]');
  const gaName = root?.dataset.name || document.title;
  const gaPrice = Number(root?.dataset.price || 0) / 100;
  if (root) {
    const slug = root.dataset.product!;
    const q = (s: string) => root.querySelector<HTMLElement>(s);

    // Wybór zestawu: cena, cena za sztukę, rabat (także z adresu ?zestaw=2)
    const radios = root.querySelectorAll<HTMLInputElement>('input[name="qty"]');
    const render = (r: HTMLInputElement) => {
      q('[data-price]')!.textContent = r.dataset.total ?? '';
      const sp = document.querySelector('[data-sticky-price]'); if (sp) sp.textContent = r.dataset.total ?? '';
      q('[data-unit]')!.textContent = r.dataset.unit ?? '';
      const reg = q('[data-regular]'); if (reg) reg.textContent = r.dataset.regular ?? '';
      const save = q('[data-save]')!; save.textContent = r.dataset.save ?? ''; save.hidden = !r.dataset.save;
    };
    const wanted = new URLSearchParams(location.search).get('zestaw');
    radios.forEach((r) => { if (wanted && r.value === wanted) r.checked = true; r.addEventListener('change', () => render(r)); });
    const checked = root.querySelector<HTMLInputElement>('input[name="qty"]:checked');
    if (checked) render(checked);

    trackViewItem({ item_id: slug, item_name: gaName, price: gaPrice, quantity: 1, item_brand: 'Can-C' });

    const addBtn = q('[data-add]') as HTMLButtonElement | null;
    let resetTimer = 0;
    addBtn?.addEventListener('click', () => {
      const qty = Number(root.querySelector<HTMLInputElement>('input[name="qty"]:checked')?.value ?? 1);
      addItem(slug, qty);
      q('[data-added]')!.hidden = false;
      addBtn.textContent = 'Dodano ✓';
      clearTimeout(resetTimer);
      resetTimer = window.setTimeout(() => { addBtn.textContent = 'Dodaj do koszyka'; }, 1800);
      const img = document.querySelector<HTMLImageElement>('[data-main]');
      flyToCart(img || addBtn, img?.src).then(() => announceAdded({ slug, qty }));
      trackAddToCart({ item_id: slug, item_name: gaName, price: gaPrice, quantity: qty, item_brand: 'Can-C' });
    });

    // Przyklejony pasek na telefonie: pokazuje się, gdy główny przycisk „Dodaj do koszyka” jest poza ekranem
    // (po przewinięciu w dół do opisu i opinii); kliknięcie wywołuje ten sam przycisk – ta sama ilość, GA4, animacja.
    const sticky = document.querySelector<HTMLElement>('[data-sticky]');
    if (sticky && addBtn && 'IntersectionObserver' in window) {
      const mq = window.matchMedia('(max-width: 900px)');
      let below = false;
      const sync = () => {
        const show = mq.matches && below;
        sticky.hidden = !show;
        sticky.setAttribute('aria-hidden', String(!show));
        sticky.querySelector<HTMLButtonElement>('[data-sticky-add]')!.tabIndex = show ? 0 : -1;
        document.body.classList.toggle('has-sticky-buy', show);
      };
      // Tylko gdy przycisk jest NAD ekranem (przewinięty w dół), nie przed dojściem do niego
      new IntersectionObserver(([e]) => { below = !e.isIntersecting && e.boundingClientRect.top < 0; sync(); }).observe(addBtn);
      mq.addEventListener?.('change', sync);
      const stickyBtn = sticky.querySelector<HTMLButtonElement>('[data-sticky-add]')!;
      stickyBtn.addEventListener('click', () => {
        addBtn.click();
        stickyBtn.textContent = 'Dodano ✓';
        window.setTimeout(() => { stickyBtn.textContent = 'Dodaj do koszyka'; }, 1800);
      });
    }
  }

  // GA4: select_item w „Często kupowane razem”
  document.querySelectorAll<HTMLAnchorElement>('[data-related] .pr-also__i').forEach((a) => a.addEventListener('click', () => {
    trackSelectItem({ item_id: a.dataset.slug!, item_name: a.dataset.name || '', price: Number(a.dataset.price || 0) / 100, quantity: 1 }, 'Często kupowane razem');
  }));

  // Zakładki sekcji: aktywna ta, która jest na ekranie
  const chips = [...document.querySelectorAll<HTMLAnchorElement>('[data-chips] a')];
  const setActive = (id: string) => chips.forEach((c) => c.setAttribute('aria-current', String(c.hash === '#' + id)));
  if (chips[0]) setActive(chips[0].hash.slice(1));
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) setActive(e.target.id); }), { rootMargin: '-30% 0px -60% 0px' });
    chips.forEach((c) => { const t = document.getElementById(c.hash.slice(1)); if (t) io.observe(t); });
  }
  if (location.hash === '#opinia') document.querySelector<HTMLDetailsElement>('#opinia')?.setAttribute('open', '');

  // Opinia
  const form = document.querySelector<HTMLFormElement>('[data-review]');
  // Wejście z maila „Oceń zakup”: ?o=<zamówienie>&t=<podpis>&ocena=1..5 → formularz otwarty, ocena zaznaczona, bez pola e-mail
  const qp = new URLSearchParams(location.search);
  const fromMail = Boolean(form && qp.get('o') && qp.get('t'));
  if (form && fromMail) {
    form.querySelector<HTMLInputElement>('[name="order"]')!.value = qp.get('o')!;
    form.querySelector<HTMLInputElement>('[name="orderToken"]')!.value = qp.get('t')!;
    const n = Number(qp.get('ocena'));
    if (n >= 1 && n <= 5) form.querySelector<HTMLInputElement>(`input[name="rating"][value="${n}"]`)!.checked = true;
    const mail = form.querySelector<HTMLElement>('#rv-mail')?.closest('div');
    if (mail) mail.hidden = true;
    form.querySelector<HTMLElement>('[data-review-verified]')!.hidden = false;
    const det = document.querySelector<HTMLDetailsElement>('#opinia');
    det?.setAttribute('open', '');
    setTimeout(() => { det?.scrollIntoView({ block: 'start' }); form.querySelector<HTMLInputElement>('#rv-name')?.focus({ preventScroll: true }); }, 50);
  }
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const msg = form.querySelector<HTMLElement>('[data-review-msg]')!;
    const fd = new FormData(form);
    const body = {
      product: root?.dataset.product, rating: Number(fd.get('rating')), name: fd.get('name'), email: fd.get('email'),
      title: fd.get('title'), body: fd.get('body'), consent: fd.get('consent') !== null, website: fd.get('website'),
      order: fd.get('order'), orderToken: fd.get('orderToken'),
      token: fd.get('cf-turnstile-response'),
    };
    msg.className = 'msg'; msg.textContent = 'Wysyłanie…';
    try {
      const res = await fetch('/api/opinie', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
      const d = await res.json().catch(() => ({}));
      if (!res.ok) throw new Error(d.error || 'Nie udało się wysłać opinii.');
      msg.className = 'msg msg--ok';
      msg.textContent = `Dziękujemy! Opinia pojawi się po moderacji.${d.verified ? ' Potwierdziliśmy zakup - dostanie oznaczenie „Zweryfikowany zakup”.' : ''}`;
      form.reset();
      if (fromMail) { form.querySelector<HTMLInputElement>('[name="order"]')!.value = ''; form.querySelector<HTMLInputElement>('[name="orderToken"]')!.value = ''; }
    } catch (err) { msg.className = 'msg msg--err'; msg.textContent = (err as Error).message; }
    (window as any).turnstile?.reset();
  });

  // Powiadomienie o dostępności
  const notify = document.querySelector<HTMLFormElement>('[data-notify]');
  notify?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const msg = notify.querySelector<HTMLElement>('[data-notify-msg]')!;
    const fd = new FormData(notify);
    msg.className = 'msg'; msg.textContent = 'Zapisywanie…';
    try {
      const res = await fetch('/api/powiadom', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ product: root?.dataset.product, email: fd.get('email'), website: fd.get('website'), token: fd.get('cf-turnstile-response') }) });
      const d = await res.json().catch(() => ({}));
      if (!res.ok) throw new Error(d.error || 'Nie udało się zapisać.');
      msg.className = 'msg msg--ok'; msg.textContent = 'Gotowe - napiszemy, gdy produkt wróci.'; notify.reset();
    } catch (err) { msg.className = 'msg msg--err'; msg.textContent = (err as Error).message; }
    (window as any).turnstile?.reset();
  });
</script>

<style>
  .pr-top { margin-top: 45px; }
  .pr-grid { display: flex; align-items: flex-start; gap: 45px; margin-top: 24px; }
  .pr-gallery { width: 636px; flex-shrink: 0; display: flex; flex-direction: column; gap: 14px; }
  .pr-main { --n: 160px; --r: 50px; height: 600px; }
  .pr-main :global(.p-badge) { left: 24px; bottom: 24px; }
  .pr-flag { position: absolute; z-index: 2; left: 24px; top: 24px; display: inline-flex; align-items: center; height: 32px; padding: 0 14px; border-radius: var(--r-pill); background: var(--surface); font-size: 14px; font-weight: 400; }
  .pr-thumbs { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 14px; }
  .pr-thumb { height: 120px; padding: 0; border: 2px solid transparent; border-radius: var(--r-md); background: var(--image); cursor: pointer; overflow: hidden; }
  .pr-thumb img { width: 100%; height: 100%; object-fit: cover; }
  .pr-thumb[aria-pressed='true'] { border-color: var(--primary); }

  /* Przyklejony pasek zakupu (telefon) */
  .pr-sticky {
    position: fixed; z-index: 40; left: 0; right: 0; bottom: 0;
    display: flex; align-items: center; justify-content: space-between; gap: 14px;
    padding: 12px var(--page-px) calc(12px + env(safe-area-inset-bottom, 0px));
    background: var(--surface); border-top: 1px solid var(--line); box-shadow: 0 -12px 32px rgba(20, 28, 43, .08);
    animation: pr-sticky-in .2s ease-out;
  }
  .pr-sticky[hidden] { display: none; }
  .pr-sticky__info { min-width: 0; display: flex; flex-direction: column; }
  .pr-sticky__name { font-size: 14px; line-height: 20px; font-weight: 300; color: var(--muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .pr-sticky__price { font-size: 20px; line-height: 28px; font-weight: 500; }
  .pr-sticky__btn { flex-shrink: 0; height: 50px; padding: 0 22px; font-size: 16px; }
  :global(body.has-sticky-buy) { padding-bottom: 80px; }
  @keyframes pr-sticky-in { from { transform: translateY(100%); } to { transform: none; } }
  @media (prefers-reduced-motion: reduce) { .pr-sticky { animation: none; } }
  .pr-buy { flex: 1; min-width: 0; display: flex; flex-direction: column; }
  .pr-title { margin-top: 10px; }
  .pr-tags { margin-top: 24px; }
  .pr-rating { display: flex; align-items: center; gap: 10px; margin-top: 14px; font-size: 14px; line-height: 21px; font-weight: 300; color: var(--muted); text-decoration: none; }
  .pr-lead { margin-top: 24px; }
  /* Teksty opisowe karty produktu: 18/28 (opis, wyróżniki, Opis, Stosowanie, Specyfikacja, opinie) */
  .pr-lead, .pr-hl, .pr-spec .trow, :global(.pr-review__body) { font-size: 18px; line-height: 28px; }
  .pr-price { margin-top: 24px; padding-top: 24px; border-top: 1px solid var(--line); display: flex; flex-direction: column; gap: 6px; }
  .pr-price__row { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; }
  .pr-price__v { font-size: 48px; line-height: 72px; font-weight: 300; }
  .pr-price__old { font-size: 18px; color: var(--muted); }
  .pr-avail { display: flex; align-items: center; gap: 8px; font-size: 14px; line-height: 21px; font-weight: 400; }
  .pr-avail--out_of_stock { color: var(--muted); }
  .pr-sets { margin: 24px 0 0; padding: 0; border: none; display: flex; flex-direction: column; gap: 14px; }
  .pr-sets legend { padding: 0; margin-bottom: 14px; font-size: 18px; line-height: 27px; font-weight: 400; }
  .pr-add { margin-top: 24px; }
  .pr-added { margin-top: 10px; color: var(--ink); }
  .pr-notify { margin-top: 24px; background: var(--peach); border-radius: var(--r-md); padding: 23px; display: flex; flex-direction: column; gap: 6px; }
  .pr-notify__t { font-size: 18px; line-height: 27px; font-weight: 400; }
  .pr-notify__row { display: flex; gap: 10px; }
  .pr-notify__row .fld { flex: 1; min-width: 0; }
  .pr-hl { margin-top: 24px; }
  .pr-perks { margin-top: 24px; border-bottom: 1px solid var(--line); }
  .pr-muted { color: var(--muted); }

  .pr-band { margin-top: 90px; background: var(--band); }
  .pr-band__in { padding-top: 90px; padding-bottom: 90px; display: flex; align-items: flex-start; gap: 45px; }
  .pr-details { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 45px; }
  .pr-chips { display: flex; gap: 10px; flex-wrap: wrap; position: sticky; top: 14px; z-index: 5; }
  .pr-sec { display: flex; flex-direction: column; gap: 24px; padding-top: 45px; border-top: 1px solid var(--image); scroll-margin-top: 90px; }
  .pr-chips + .pr-sec { padding-top: 0; border-top: none; }
  .md :global(p), .md :global(li) { font-size: 18px; line-height: 28px; font-weight: 300; color: var(--muted); text-align: left; }
  .md :global(p + p) { margin-top: 24px; }
  .md :global(h2), .md :global(h3) { font-size: 24px; line-height: 28px; font-weight: 400; margin: 24px 0 10px; }
  .md :global(strong) { font-weight: 500; color: var(--ink); }
  .md :global(ul), .md :global(ol) { margin: 0; padding-left: 22px; display: flex; flex-direction: column; gap: 10px; }
  .md :global(ul) { list-style: none; padding: 0; }
  .md :global(ul li) { position: relative; padding-left: 22px; text-align: left; }
  .md--checks :global(ul li) { color: var(--ink); }
  .md :global(ul li)::before {
    content: ''; position: absolute; left: 0; top: 8px; top: calc(0.5lh - 4px);
    width: 8px; height: 8px; border-radius: 50%; background: var(--accent);
  }
  .pr-spec { margin: 0; background: var(--surface); border-radius: var(--r-md); padding: 10px 24px; }
  .pr-spec .trow:first-child { border-top: none; }
  .pr-spec dt { color: var(--muted); }
  .pr-spec dd { margin: 0; }
  .pr-avg { display: flex; align-items: center; gap: 14px; }
  .pr-avg__v { font-size: 64px; line-height: 64px; font-weight: 300; }
  @media (max-width: 600px) {
    .pr-lead, .pr-hl, .pr-spec .trow, :global(.pr-review__body), .md :global(p), .md :global(li) { font-size: 16px; line-height: 26px; }
  }
  .pr-rsum { display: flex; align-items: center; gap: 32px 45px; flex-wrap: wrap; }
  .pr-dist { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 6px; min-width: 240px; flex: 1; max-width: 420px; }
  .pr-dist li { display: grid; grid-template-columns: 36px 1fr 32px; align-items: center; gap: 10px; font-size: 14px; line-height: 20px; }
  .pr-dist__l { color: var(--muted); white-space: nowrap; }
  .pr-dist__l span[aria-hidden] { color: var(--star); }
  .pr-dist__bar { height: 8px; border-radius: 4px; background: var(--line); overflow: hidden; }
  .pr-dist__bar span { display: block; height: 100%; background: var(--star); border-radius: 4px; }
  .pr-dist__n { text-align: right; color: var(--muted); }
  .pr-sort { display: inline-flex; align-items: center; gap: 10px; align-self: flex-end; }
  .pr-sort .fld { height: 44px; width: auto; padding-right: 36px; }
  .pr-reviews[aria-busy='true'] { opacity: .5; }
  .pr-reviews { display: flex; flex-direction: column; gap: 14px; }
  .pr-more { align-self: flex-start; gap: 8px; }
  .pr-more[hidden] { display: none; }
  :global(.pr-review) { background: var(--surface); border: 1px solid var(--line); border-radius: var(--r-md); padding: 24px; display: flex; flex-direction: column; gap: 10px; }
  :global(.pr-review__head) { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; }
  :global(.pr-review__name) { font-size: 18px; line-height: 27px; font-weight: 500; }
  :global(.pr-review__title) { font-size: 18px; line-height: 28px; font-weight: 400; }
  :global(.pr-review__reply) { padding: 14px 18px; border-radius: 14px; background: var(--band); font-size: 14px; line-height: 21px; font-weight: 300; }
  .pr-form > summary { list-style: none; display: inline-flex; }
  .pr-form > summary::-webkit-details-marker { display: none; }
  .pr-form form { margin-top: 24px; background: var(--surface); border-radius: var(--r-lg); padding: 32px; display: flex; flex-direction: column; gap: 14px; }
  .pr-form__g { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; }
  .rate { margin: 0; padding: 0; border: 0; display: inline-flex; flex-direction: row-reverse; justify-content: flex-end; gap: 4px; flex-wrap: wrap; }
  .rate legend { width: 100%; }
  .rate input { position: absolute; opacity: 0; }
  .rate label { color: var(--line); cursor: pointer; line-height: 0; }
  .rate input:checked ~ label, .rate label:hover, .rate label:hover ~ label { color: var(--star); }
  .rate input:focus-visible + label { outline: 2px solid var(--primary); outline-offset: 2px; border-radius: 4px; }

  .pr-also { width: 436px; background: var(--surface); border-radius: var(--r-lg); padding: 24px; display: flex; flex-direction: column; gap: 24px; position: sticky; top: 14px; }
  .pr-also__t { font-size: 18px; line-height: 27px; font-weight: 400; }
  .pr-also__i { display: flex; flex-direction: column; gap: 14px; text-decoration: none; color: var(--ink); }
  .pr-also__img { position: relative; aspect-ratio: 1 / 1; /* kwadratowy kadr - produkt widoczny w całości */ border-radius: var(--r-md); background: var(--image); display: flex; align-items: center; justify-content: center; overflow: hidden; }
  .pr-also__img img { width: 100%; height: 100%; object-fit: cover; }
  .pr-also__n { font-size: 22px; line-height: 30px; font-weight: 500; }
  .pr-also__f { display: flex; align-items: center; justify-content: space-between; font-size: 18px; line-height: 27px; }
  .pr-also__go { display: inline-flex; align-items: center; gap: 10px; font-weight: 500; }
  .pr-also__go :global(svg) { color: var(--accent); }
  .pr-also__i:hover .pr-also__go { color: var(--accent-text); }

  @media (max-width: 1000px) {
    .pr-main { height: auto; aspect-ratio: 1 / 1; --n: 110px; --r: 36px; }
    .pr-chips { position: static; }
    .pr-also { position: static; }
    .pr-form__g { grid-template-columns: minmax(0, 1fr); }
    .pr-price__v { font-size: 40px; line-height: 56px; }
  }
</style>
