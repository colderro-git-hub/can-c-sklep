---
// Karta produktu generowana z bazy przy każdym wejściu (zmiany z panelu widać od razu)
import Base from '../../layouts/Base.astro';
import Arrow from '../../components/Arrow.astro';
import AvailBadge from '../../components/AvailBadge.astro';
import ProductTags from '../../components/ProductTags.astro';
import { getEnv } from '../../lib/env';
import { getProductPage, AVAIL_LABEL, leadTimeText } from '../../lib/catalog';
import { discountRate } from '../../lib/pricing';
import { markdown, plainText } from '../../lib/markdown';
import { getSite } from '../../lib/site-settings';
import { TURNSTILE_SITE_KEY } from '../../config';

export const prerender = false;

const env = await getEnv(Astro.locals);
const slug = Astro.params.slug || '';
const data = await getProductPage(env, slug).catch((e) => { console.error('Karta produktu: ' + (e instanceof Error ? e.message : String(e))); return null; });
if (!data) return new Response(null, { status: 404, statusText: 'Nie znaleziono' });
const { product: p, reviews, related } = data;
const site = await getSite(env);

const pln = (g: number | null) => (g === null ? '—' : new Intl.NumberFormat('pl-PL', { style: 'currency', currency: 'PLN' }).format(g / 100));
const buyable = p.current !== null && p.avail !== 'out_of_stock';
// Termin realizacji: zdanie z produktu, a gdy puste – czas wysyłki z ustawień sklepu
const leadTime = p.lead_time ? leadTimeText(p.lead_time, site.shippingTime) : site.shippingTime;
const options = (p.bundles ? [1, 2, 4] : [1, 2, 3]).map((qty) => {
  const rate = discountRate(qty, p.bundles);
  const total = p.current === null ? null : Math.round(p.current * qty * (1 - rate));
  return {
    qty, rate, total,
    label: p.bundles ? (qty === 1 ? '1 opakowanie' : `${qty} opakowania`) : `${qty} szt.`,
    sub: p.bundles ? `${qty} ${qty === 1 ? 'miesiąc' : 'miesiące'} kuracji${qty === 2 ? ' · polecany' : ''}` : (p.subtitle || ''),
  };
});
const defaultQty = p.bundles ? 2 : 1;
const def = options.find((o) => o.qty === defaultQty)!;
const salePct = p.onSale && p.price ? Math.round((1 - p.current! / p.price) * 100) : 0;
const images = p.images.length ? p.images : [];
const url = new URL(`/produkt/${p.id}/`, Astro.url.origin).toString();
const stars = (n: number) => '★★★★★'.slice(0, Math.round(n)) + '☆☆☆☆☆'.slice(0, 5 - Math.round(n));

// Dane strukturalne Google: produkt, oferta, dostawa, zwroty, oceny
const gtin = (p.ean || '').replace(/\D/g, '');
const jsonLd: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: p.name,
  description: p.seo_description || p.short_description || plainText(p.description).slice(0, 500),
  sku: p.id,
  ...(gtin ? { [`gtin${gtin.length === 13 ? '13' : gtin.length === 8 ? '8' : gtin.length === 12 ? '12' : '14'}`]: gtin } : {}),
  ...(p.mpn ? { mpn: p.mpn } : {}),
  brand: { '@type': 'Brand', name: p.brand },
  ...(images.length ? { image: images.map((i) => i.url) } : {}),
  ...(p.current !== null && {
    offers: {
      '@type': 'Offer', url, priceCurrency: 'PLN', price: (p.current / 100).toFixed(2),
      ...(p.onSale && p.sale_end ? { priceValidUntil: p.sale_end.slice(0, 10) } : {}),
      itemCondition: `https://schema.org/${p.condition === 'new' ? 'NewCondition' : p.condition === 'used' ? 'UsedCondition' : 'RefurbishedCondition'}`,
      availability: `https://schema.org/${p.avail === 'in_stock' ? 'InStock' : p.avail === 'preorder' ? 'PreOrder' : p.avail === 'backorder' ? 'BackOrder' : 'OutOfStock'}`,
      shippingDetails: {
        '@type': 'OfferShippingDetails',
        shippingRate: { '@type': 'MonetaryAmount', value: '0', currency: 'PLN' },
        shippingDestination: { '@type': 'DefinedRegion', addressCountry: 'PL' },
        deliveryTime: { '@type': 'ShippingDeliveryTime', handlingTime: { '@type': 'QuantitativeValue', minValue: 0, maxValue: 1, unitCode: 'DAY' }, transitTime: { '@type': 'QuantitativeValue', minValue: 1, maxValue: 2, unitCode: 'DAY' } },
      },
      hasMerchantReturnPolicy: {
        '@type': 'MerchantReturnPolicy', applicableCountry: 'PL', returnPolicyCategory: 'https://schema.org/MerchantReturnFiniteReturnWindow',
        merchantReturnDays: 14, returnMethod: 'https://schema.org/ReturnByMail', returnFees: 'https://schema.org/ReturnFeesCustomerResponsibility',
      },
    },
  }),
  ...(p.rating.count ? {
    aggregateRating: { '@type': 'AggregateRating', ratingValue: p.rating.avg, reviewCount: p.rating.count, bestRating: 5, worstRating: 1 },
    review: reviews.slice(0, 5).map((r) => ({ '@type': 'Review', author: { '@type': 'Person', name: r.author_name }, datePublished: r.created_at.slice(0, 10), reviewRating: { '@type': 'Rating', ratingValue: r.rating, bestRating: 5 }, ...(r.title ? { name: r.title } : {}), reviewBody: r.body })),
  } : {}),
};
Astro.response.headers.set('Cache-Control', 'public, max-age=60');
---
<Base title={p.seo_title || `${p.name} | Can-C`} description={p.seo_description || p.short_description || p.name}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  {TURNSTILE_SITE_KEY && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}

  <nav class="container crumbs" aria-label="Ścieżka">
    <a href="/">Strona główna</a> / <a href="/sklep/">Sklep</a> / <span aria-current="page">{p.name}</span>
  </nav>

  <section class="section product-top">
    <div class="container product">
      <div class="gallery" data-gallery>
        <div class={`media media--${p.avail}`}>
          {images.length
            ? <img src={images[0].url} alt={images[0].alt || p.name} width="800" height="800" class="gallery__main" data-main fetchpriority="high" />
            : <div class="ph gallery__main">[Zdjęcie produktu – dodaj w panelu]</div>}
          <AvailBadge avail={p.avail} />
        </div>
        {images.length > 1 && (
          <div class="gallery__thumbs">
            {images.map((im, i) => (
              <button type="button" class="thumb" aria-label={`Zdjęcie ${i + 1}`} aria-pressed={i === 0 ? 'true' : 'false'} data-src={im.url} data-alt={im.alt || p.name}>
                <img src={im.url} alt="" width="160" height="160" loading="lazy" />
              </button>
            ))}
          </div>
        )}
      </div>

      <div class="buy" data-product={p.id} data-name={p.name} data-price={p.current ?? 0}>
        {p.subtitle && <span class="tag">{p.subtitle}</span>}
        <h1>{p.name}</h1>
        <ProductTags tags={p.tags} />
        {p.rating.count > 0 && (
          <a href="#opinie" class="rating-link" aria-label={`Ocena ${p.rating.avg} na 5, ${p.rating.count} opinii`}>
            <span class="stars" aria-hidden="true">{stars(p.rating.avg)}</span> {p.rating.avg.toLocaleString('pl-PL')} · {p.rating.count} {p.rating.count === 1 ? 'opinia' : p.rating.count < 5 ? 'opinie' : 'opinii'}
          </a>
        )}
        {p.short_description && <p class="lead">{p.short_description}</p>}

        <div class="price-box">
          <div class="price-row" aria-live="polite">
            <span class="price" data-price>{pln(def.total)}</span>
            {p.onSale && <s class="muted regular" data-regular>{pln(p.price === null ? null : p.price * def.qty)}</s>}
            <span class="save" data-save hidden={!def.rate && !salePct}>{salePct ? `−${salePct}%` : ''}{def.rate ? ` −${Math.round(def.rate * 100)}% za zestaw` : ''}</span>
          </div>
          <p class="price-meta">
            <span data-unit>{def.total !== null ? `${pln(Math.round(def.total / def.qty))} / szt.` : ''}</span>
            {p.unitPrice && <span> · cena za jednostkę: {p.unitPrice}</span>}
          </p>
          {p.lowest30 !== null && (
            <p class="price-meta">{p.onSale ? 'Najniższa cena z 30 dni przed obniżką' : 'Najniższa cena z ostatnich 30 dni'}: {pln(p.lowest30)}</p>
          )}
          <p class={`avail avail--${p.avail}`}>{AVAIL_LABEL[p.avail] || p.avail}</p>
        </div>

        {buyable && (
          <fieldset class="options">
            <legend>{p.bundles ? 'Wybierz zestaw' : 'Ilość'}</legend>
            {options.map((o) => (
              <label class="option">
                <input type="radio" name="qty" value={o.qty} checked={o.qty === defaultQty}
                  data-total={pln(o.total)} data-regular={p.onSale && p.price ? pln(p.price * o.qty) : ''}
                  data-unit={o.total !== null ? `${pln(Math.round(o.total / o.qty))} / szt.` : ''}
                  data-save={[salePct ? `−${salePct}%` : '', o.rate ? `−${Math.round(o.rate * 100)}% za zestaw` : ''].filter(Boolean).join(' ')} />
                <span class="option__text"><span class="option__label">{o.label}</span><span class="muted option__sub">{o.sub}</span></span>
                <span class="option__total">{pln(o.total)}</span>
              </label>
            ))}
          </fieldset>
        )}

        <div class="buy__cta">
          <button type="button" class="btn btn--lg" data-add disabled={!buyable}>{buyable ? 'Dodaj do koszyka' : AVAIL_LABEL[p.avail]}</button>
          <p class="added" data-added role="status" hidden>Dodano do koszyka. <a href="/koszyk/">Przejdź do koszyka</a></p>
        </div>

        {p.avail === 'out_of_stock' && (
          <form class="notify" data-notify novalidate>
            <p class="notify__title">Powiadom mnie, gdy produkt będzie dostępny</p>
            <p class="small muted">Wyślemy jeden e-mail, gdy produkt wróci do sprzedaży. Bez newslettera.</p>
            <span class="notify__row">
              <label class="sr-only" for="notify-email">E-mail</label>
              <input id="notify-email" class="input" type="email" name="email" autocomplete="email" required placeholder="jan@przyklad.pl" />
              <button class="btn">Powiadom mnie</button>
            </span>
            <label class="hp" aria-hidden="true">Strona www<input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
            {TURNSTILE_SITE_KEY && <div class="cf-turnstile" data-sitekey={TURNSTILE_SITE_KEY} data-language="pl" data-size="compact"></div>}
            <p class="msg small" role="status" data-notify-msg></p>
          </form>
        )}

        {p.highlights.length > 0 && <ul class="highlights">{p.highlights.map((h) => <li>{h}</li>)}</ul>}

        <ul class="perks">
          <li><span>InPost Paczkomat 24/7</span><span class="ok">Darmowa</span></li>
          <li><span>Kurier DPD</span><span class="ok">Darmowa</span></li>
          <li><span>Wysyłka</span>{p.lead_time ? <span>{leadTime}</span> : <span data-site="shippingTime">{leadTime}</span>}</li>
          <li><span>Zwrot</span><span>14 dni (nieotwarte opakowanie)</span></li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section section--tint">
    <div class="container details">
      <nav class="pills" aria-label="Sekcje opisu">
        {p.description && <a href="#opis">Opis</a>}{p.how_to_use && <a href="#stosowanie">Stosowanie</a>}<a href="#specyfikacja">Specyfikacja</a><a href="#opinie">Opinie ({p.rating.count})</a>
      </nav>
      <div class="details__body">
        <article class="details__text">
          {p.description && <section id="opis" class="md" set:html={markdown(p.description)} />}
          {p.how_to_use && (
            <section id="stosowanie" class="usage">
              <h2>Stosowanie</h2>
              <div class="md" set:html={markdown(p.how_to_use)} />
            </section>
          )}
          <section id="specyfikacja">
            <h2>Specyfikacja</h2>
            <dl class="spec">
              <div><dt>Marka</dt><dd>{p.brand}</dd></div>
              {p.subtitle && <div><dt>Opakowanie</dt><dd>{p.subtitle}</dd></div>}
              {p.unit_value && p.unit_measure && <div><dt>Zawartość</dt><dd>{p.unit_value.toLocaleString('pl-PL')} {p.unit_measure === 'szt' ? 'szt.' : p.unit_measure}</dd></div>}
              {p.ean && <div><dt>EAN</dt><dd>{p.ean}</dd></div>}
              {p.mpn && <div><dt>Kod producenta</dt><dd>{p.mpn}</dd></div>}
              <div><dt>Dostępność</dt><dd>{AVAIL_LABEL[p.avail]}</dd></div>
            </dl>
          </section>

          <section id="opinie" class="reviews">
            <h2>Opinie klientów</h2>
            {p.rating.count > 0 ? (
              <div class="summary"><span class="summary__avg">{p.rating.avg.toLocaleString('pl-PL')}</span><span class="stars stars--lg" aria-hidden="true">{stars(p.rating.avg)}</span><span class="muted">na podstawie {p.rating.count} {p.rating.count === 1 ? 'opinii' : 'opinii'}</span></div>
            ) : <p class="muted">Ten produkt nie ma jeszcze opinii. Bądź pierwszą osobą, która ją doda.</p>}
            <ul class="review-list">
              {reviews.map((r) => (
                <li class="review">
                  <div class="review__head"><span class="stars" aria-label={`${r.rating} na 5`}>{stars(r.rating)}</span><strong>{r.author_name}</strong>{r.verified_purchase && <span class="badge-ok">Zweryfikowany zakup</span>}<span class="muted small">{new Date(r.created_at).toLocaleDateString('pl-PL')}</span></div>
                  {r.title && <p class="review__title">{r.title}</p>}
                  <p>{r.body}</p>
                  {r.reply && <p class="review__reply"><strong>Odpowiedź sklepu:</strong> {r.reply}</p>}
                </li>
              ))}
            </ul>
            <p class="small muted">Opinie publikujemy po sprawdzeniu przez moderatora. Oznaczenie „Zweryfikowany zakup” mają opinie osób, które kupiły produkt w naszym sklepie (sprawdzamy to po adresie e-mail).</p>

            <details class="review-form-wrap">
              <summary class="btn btn--ghost">Napisz opinię</summary>
              <form class="review-form" data-review novalidate>
                <fieldset class="rate"><legend>Twoja ocena</legend>
                  {[5, 4, 3, 2, 1].map((n) => <><input type="radio" id={`r${n}`} name="rating" value={n} /><label for={`r${n}`} title={`${n} na 5`}>★</label></>)}
                </fieldset>
                <div class="grid2">
                  <label class="field">Imię lub pseudonim (widoczne)<input class="input" name="name" maxlength="60" required /></label>
                  <label class="field">E-mail (niewidoczny, do weryfikacji zakupu)<input class="input" name="email" type="email" maxlength="200" /></label>
                </div>
                <label class="field">Tytuł (opcjonalnie)<input class="input" name="title" maxlength="120" /></label>
                <label class="field">Opinia<textarea class="input textarea" name="body" rows="4" minlength="10" maxlength="3000" required></textarea></label>
                <label class="check"><input type="checkbox" name="consent" required /> <span>Akceptuję publikację opinii z podanym imieniem. Opinia trafi na stronę po moderacji. Zasady przetwarzania danych: <a href="/polityka-prywatnosci/">polityka prywatności</a>.</span></label>
                <label class="hp" aria-hidden="true">Strona www<input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
                {TURNSTILE_SITE_KEY && <div class="cf-turnstile" data-sitekey={TURNSTILE_SITE_KEY} data-language="pl"></div>}
                <button class="btn">Wyślij opinię</button>
                <p class="msg" role="status" data-review-msg></p>
              </form>
            </details>
          </section>
        </article>

        {related.length > 0 && (
          <aside class="related">
            <span class="tag">Często kupowane razem</span>
            {related.map((r) => (
              <a class="related__item" href={`/produkt/${r.id}/`}>
                <span class={`media media--${r.avail}`}>
                  {r.images[0] ? <img src={r.images[0].url} alt={r.images[0].alt || r.name} width="400" height="300" loading="lazy" /> : <span class="ph related__img">[{r.name}]</span>}
                  <AvailBadge avail={r.avail} />
                </span>
                <span class="related__name">{r.name}</span>
                <span class="related__foot"><span>{pln(r.current)}</span><span class="link-arrow">Zobacz <Arrow /></span></span>
              </a>
            ))}
          </aside>
        )}
      </div>
    </div>
  </section>
</Base>

<script>
  import { addItem } from '../../lib/cart';
  import { trackViewItem, trackAddToCart, trackSelectItem } from '../../lib/analytics';
  import { flyToCart, announceAdded } from '../../lib/cart-fx';

  // Galeria
  const gallery = document.querySelector<HTMLElement>('[data-gallery]');
  const main = gallery?.querySelector<HTMLImageElement>('[data-main]');
  gallery?.querySelectorAll<HTMLButtonElement>('.thumb').forEach((t) => t.addEventListener('click', () => {
    if (!main) return;
    main.src = t.dataset.src!; main.alt = t.dataset.alt || '';
    gallery.querySelectorAll('.thumb').forEach((x) => x.setAttribute('aria-pressed', String(x === t)));
  }));

  // Wybór zestawu i koszyk
  const root = document.querySelector<HTMLElement>('[data-product]');
  if (root) {
    const slug = root.dataset.product!;
    const radios = root.querySelectorAll<HTMLInputElement>('input[name="qty"]');
    const q = (s: string) => root.querySelector<HTMLElement>(s);
    const render = (r: HTMLInputElement) => {
      q('[data-price]')!.textContent = r.dataset.total ?? '';
      q('[data-unit]')!.textContent = r.dataset.unit ?? '';
      const reg = q('[data-regular]'); if (reg) reg.textContent = r.dataset.regular ?? '';
      const save = q('[data-save]')!; save.textContent = r.dataset.save ?? ''; save.hidden = !r.dataset.save;
    };
    const wanted = new URLSearchParams(location.search).get('zestaw');
    radios.forEach((r) => { if (wanted && r.value === wanted) r.checked = true; r.addEventListener('change', () => render(r)); });
    const checked = root.querySelector<HTMLInputElement>('input[name="qty"]:checked');
    if (checked) render(checked);
    // GA4: view_item po załadowaniu strony
  const _gaEl = document.querySelector<HTMLElement>('[data-product]');
  const _gaSlug = _gaEl?.dataset.product || '';
  const _gaName = _gaEl?.dataset.name || document.title;
  const _gaPrice = Number(_gaEl?.dataset.price || 0) / 100;
  if (_gaSlug) trackViewItem({ item_id: _gaSlug, item_name: _gaName, price: _gaPrice, quantity: 1, item_brand: 'Can-C' });

  // GA4: select_item dla powiązanych produktów
  root.querySelectorAll<HTMLAnchorElement>('.related__item').forEach((a) => {
    a.addEventListener('click', () => {
      const rSlug = (new URL(a.href)).pathname.split('/').filter(Boolean)[1] || '';
      const rName = a.querySelector('.related__name')?.textContent || '';
      const rPriceEl = a.querySelector<HTMLElement>('.related__foot span:first-child');
      const rPrice = rPriceEl ? parseFloat(rPriceEl.textContent?.replace(/[^0-9,]/g,'').replace(',','.') || '0') : 0;
      if (rSlug) trackSelectItem({ item_id: rSlug, item_name: rName, price: rPrice, quantity: 1 }, 'Często kupowane razem');
    });
  });

  const addBtn = root.querySelector<HTMLButtonElement>('[data-add]');
    let resetTimer = 0;
    addBtn?.addEventListener('click', () => {
      const cur = root.querySelector<HTMLInputElement>('input[name="qty"]:checked');
      const qty = Number(cur?.value ?? 1);
      addItem(slug, qty);
      q('[data-added]')!.hidden = false;
      // Potwierdzenie na przycisku + miniatura leci do koszyka, potem nagłówek pokazuje zawartość koszyka
      const label = 'Dodaj do koszyka';
      addBtn.textContent = 'Dodano ✓'; addBtn.classList.add('is-added');
      clearTimeout(resetTimer);
      resetTimer = window.setTimeout(() => { addBtn.textContent = label; addBtn.classList.remove('is-added'); }, 1800);
      const img = document.querySelector<HTMLImageElement>('[data-main]');
      flyToCart(img || addBtn, img?.src).then(() => announceAdded({ slug, qty }));
      trackAddToCart({ item_id: slug, item_name: _gaName, price: _gaPrice, quantity: qty, item_brand: 'Can-C' });
    });
  }

  // Opinia
  const form = document.querySelector<HTMLFormElement>('[data-review]');
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const msg = form.querySelector<HTMLElement>('[data-review-msg]')!;
    const fd = new FormData(form);
    const body = {
      product: root?.dataset.product, rating: Number(fd.get('rating')), name: fd.get('name'), email: fd.get('email'),
      title: fd.get('title'), body: fd.get('body'), consent: fd.get('consent') !== null, website: fd.get('website'),
      token: fd.get('cf-turnstile-response'),
    };
    msg.className = 'msg'; msg.textContent = 'Wysyłanie…';
    try {
      const res = await fetch('/api/opinie', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
      const d = await res.json().catch(() => ({}));
      if (!res.ok) throw new Error(d.error || 'Nie udało się wysłać opinii.');
      msg.className = 'msg msg--ok';
      msg.textContent = `Dziękujemy! Opinia pojawi się po moderacji.${d.verified ? ' Potwierdziliśmy zakup – dostanie oznaczenie „Zweryfikowany zakup”.' : ''}`;
      form.reset();
    } catch (err) { msg.className = 'msg msg--err'; msg.textContent = (err as Error).message; }
    (window as any).turnstile?.reset();
  });

  // Powiadomienie o dostępności
  const notify = document.querySelector<HTMLFormElement>('[data-notify]');
  if (notify) {
    notify.addEventListener('submit', async (e) => {
      e.preventDefault();
      const msg = notify.querySelector<HTMLElement>('[data-notify-msg]')!;
      const fd = new FormData(notify);
      msg.textContent = 'Zapisywanie…';
      try {
        const res = await fetch('/api/powiadom', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ product: document.querySelector<HTMLElement>('[data-product]')?.dataset.product, email: fd.get('email'), website: fd.get('website'), token: fd.get('cf-turnstile-response') }) });
        const d = await res.json().catch(() => ({}));
        if (!res.ok) throw new Error(d.error || 'Nie udało się zapisać.');
        msg.textContent = 'Gotowe – napiszemy, gdy produkt wróci.'; notify.reset();
      } catch (err) { msg.textContent = (err as Error).message; }
      (window as any).turnstile?.reset();
    });
  }
</script>

<style>
  .crumbs { padding-top: var(--s-2); font-size: var(--fs-small); color: var(--c-ink-70); }
  .crumbs a { color: var(--c-ink-75); }
  .product-top { padding-top: var(--s-3); }
  .product { display: flex; flex-wrap: wrap; gap: var(--s-6); align-items: flex-start; }
  .small { font-size: var(--fs-small); }

