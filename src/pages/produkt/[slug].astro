---
import Base from '../../layouts/Base.astro';
import Arrow from '../../components/Arrow.astro';
import { products, discountFor, lineTotal, formatPrice, reviews } from '../../data/shop';
import { CONTENT_DEFAULTS } from '../../lib/site-settings';

export function getStaticPaths() {
  return products.map((product) => ({ params: { slug: product.slug }, props: { product } }));
}

const { product } = Astro.props;
const related = product.related ? products.find((p) => p.slug === product.related) : undefined;

// Warianty wyboru: zestawy dla kropli, zwykła liczba sztuk dla pozostałych
const options = product.bundles
  ? [1, 2, 4].map((qty) => ({
      qty,
      label: qty === 1 ? '1 opakowanie' : `${qty} opakowania`,
      sub: `${qty} ${qty === 1 ? 'miesiąc' : 'miesiące'} kuracji${qty === 2 ? ' · polecany' : ''}`,
      total: lineTotal(product, qty),
      discount: discountFor(qty, product),
    }))
  : [1, 2, 3].map((qty) => ({
      qty,
      label: `${qty} szt.`,
      sub: product.size,
      total: lineTotal(product, qty),
      discount: 0,
    }));

const defaultQty = product.bundles ? 2 : 1;
const def = options.find((o) => o.qty === defaultQty)!;

// Dane strukturalne dla Google (wyniki z ceną, Merchant Center)
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: product.name,
  description: product.desc,
  brand: { '@type': 'Brand', name: 'Can-C' },
  sku: product.slug,
  ...(product.price !== null && {
    offers: {
      '@type': 'Offer',
      price: product.price.toFixed(2),
      priceCurrency: 'PLN',
      availability: 'https://schema.org/InStock',
      url: `https://can-c.pl/produkt/${product.slug}/`,
      shippingDetails: {
        '@type': 'OfferShippingDetails',
        shippingRate: { '@type': 'MonetaryAmount', value: '0', currency: 'PLN' },
        shippingDestination: { '@type': 'DefinedRegion', addressCountry: 'PL' },
      },
    },
  }),
};
---
<Base title={`${product.name} | Can-C`} description={product.desc}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <nav class="container crumbs" aria-label="Ścieżka">
    <a href="/">Strona główna</a> / <a href="/#produkty">Sklep</a> / <span aria-current="page">{product.name}</span>
  </nav>

  <section class="section product-top">
    <div class="container product">
      <div class="gallery">
        {product.image
          ? <img src={product.image} alt={product.name} width="800" height="800" class="gallery__main" />
          : <div class="ph gallery__main">[Zdjęcie główne: {product.name}]</div>}
        <div class="gallery__thumbs" aria-hidden="true">
          <div class="ph">Przód</div><div class="ph">Tył</div><div class="ph">Ulotka</div><div class="ph">Znak IVP</div>
        </div>
      </div>

      <div class="buy" data-product={product.slug}>
        <span class="tag">{product.tag} · {product.size}</span>
        <h1>{product.name}</h1>
        <p class="lead">{product.desc}</p>

        <div class="price-row" aria-live="polite">
          <span class="price" data-price>{formatPrice(def.total)}</span>
          <span class="muted" data-unit>{def.total !== null ? `${formatPrice(def.total / def.qty)} / szt.` : ''}</span>
          <span class="save" data-save hidden={!def.discount}>−{Math.round(def.discount * 100)}%</span>
        </div>

        <fieldset class="options">
          <legend>{product.bundles ? 'Wybierz zestaw' : 'Ilość'}</legend>
          {options.map((o) => (
            <label class="option">
              <input
                type="radio" name="qty" value={o.qty} checked={o.qty === defaultQty}
                data-total={formatPrice(o.total)}
                data-unit={o.total !== null ? `${formatPrice(o.total / o.qty)} / szt.` : ''}
                data-save={o.discount ? `−${Math.round(o.discount * 100)}%` : ''}
              />
              <span class="option__text"><span class="option__label">{o.label}</span><span class="muted option__sub">{o.sub}</span></span>
              <span class="option__total">{formatPrice(o.total)}</span>
            </label>
          ))}
        </fieldset>

        <div class="buy__cta">
          <button type="button" class="btn btn--lg" data-add disabled={product.price === null}>Dodaj do koszyka</button>
          <p class="added" data-added role="status" hidden>
            Dodano do koszyka. <a href="/koszyk/">Przejdź do koszyka</a>
          </p>
        </div>

        <ul class="perks">
          <li><span>InPost Paczkomat 24/7</span><span class="ok">Darmowa</span></li>
          <li><span>Kurier DPD</span><span class="ok">Darmowa</span></li>
          <li><span>Wysyłka</span><span data-site="shippingTime">{CONTENT_DEFAULTS.shippingTime}</span></li>
          <li><span>Zwrot</span><span>14 dni na odstąpienie</span></li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section section--tint">
    <div class="container details">
      <nav class="pills" aria-label="Sekcje opisu">
        <a href="#opis">Opis</a><a href="#stosowanie">Stosowanie</a><a href="#sklad">Skład</a><a href="#opinie">Opinie</a>
      </nav>
      <div class="details__body">
        <article class="details__text">
          <section id="opis"><h2>O produkcie</h2><p>{product.about}</p></section>
          <section id="stosowanie"><h2>Jak stosować</h2><p>{product.usage}</p></section>
          <section id="sklad"><h2>Skład</h2><p>{product.ingredients}</p></section>
          <section id="opinie">
            <h2>Opinie klientów</h2>
            {reviews.slice(0, 2).map((r) => <blockquote><p>„{r.quote}”</p><footer class="muted">{r.author}</footer></blockquote>)}
          </section>
        </article>

        {related && (
          <aside class="related">
            <span class="tag">Często kupowane razem</span>
            <div class="ph related__img">[Packshot: {related.name}]</div>
            <h3>{related.name}</h3>
            <div class="related__foot">
              <span class="price-sm">{formatPrice(related.price)}</span>
              <a href={`/produkt/${related.slug}/`} class="link-arrow">Zobacz <Arrow /></a>
            </div>
          </aside>
        )}
      </div>
    </div>
  </section>
</Base>

<script>
  import { addItem } from '../../lib/cart';

  const root = document.querySelector<HTMLElement>('[data-product]');
  if (root) {
    const slug = root.dataset.product!;
    const radios = root.querySelectorAll<HTMLInputElement>('input[name="qty"]');
    const price = root.querySelector<HTMLElement>('[data-price]')!;
    const unit = root.querySelector<HTMLElement>('[data-unit]')!;
    const save = root.querySelector<HTMLElement>('[data-save]')!;
    const added = root.querySelector<HTMLElement>('[data-added]')!;

    const render = (r: HTMLInputElement) => {
      price.textContent = r.dataset.total ?? '';
      unit.textContent = r.dataset.unit ?? '';
      save.textContent = r.dataset.save ?? '';
      save.hidden = !r.dataset.save;
    };

    // Link ze strony głównej: /produkt/krople-can-c/?zestaw=4
    const wanted = new URLSearchParams(location.search).get('zestaw');
    radios.forEach((r) => {
      if (wanted && r.value === wanted) r.checked = true;
      r.addEventListener('change', () => render(r));
    });
    const checked = root.querySelector<HTMLInputElement>('input[name="qty"]:checked');
    if (checked) render(checked);

    root.querySelector('[data-add]')?.addEventListener('click', () => {
      const current = root.querySelector<HTMLInputElement>('input[name="qty"]:checked');
      addItem(slug, Number(current?.value ?? 1));
      added.hidden = false;
    });
  }
</script>

<style>
  .crumbs { padding-top: var(--s-2); font-size: var(--fs-small); color: var(--c-ink-70); }
  .crumbs a { color: rgba(1, 8, 15, 0.75); }
  .product-top { padding-top: var(--s-3); }
  .product { display: flex; flex-wrap: wrap; gap: var(--s-6); align-items: flex-start; }

  .gallery { flex: 1 1 480px; min-width: 0; display: flex; flex-direction: column; gap: var(--s-1); }
  .gallery__main { aspect-ratio: 1 / 1; width: 100%; object-fit: cover; background: var(--c-gray-200); }
  .gallery__thumbs { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--s-1); }
  .gallery__thumbs .ph { aspect-ratio: 1 / 1; padding: 4px; background: var(--c-gray-200); font-size: 0.75rem; }

  .buy { flex: 1 1 420px; min-width: 0; display: flex; flex-direction: column; gap: var(--s-2); }
  .buy h1 { font-size: var(--fs-h2); }
  .tag { font-size: 0.8125rem; letter-spacing: 0.08em; color: var(--c-ink-70); }

  .price-row { display: flex; flex-wrap: wrap; align-items: baseline; gap: 16px; padding-block: var(--s-2); border-block: 1px solid var(--c-ink-10); }
  .price { font-size: 2.5rem; font-weight: 300; line-height: 1.15; }
  .save { font-size: 0.8125rem; padding: 6px 14px; border-radius: var(--r-pill); background: var(--c-tint); }

  .options { margin: 0; padding: 0; border: 0; display: flex; flex-direction: column; gap: var(--s-1); }
  .options legend { padding-bottom: var(--s-1); }
  .option { min-height: 72px; padding: 16px 24px; border-radius: var(--r-field); box-shadow: inset 0 0 0 1px var(--c-gray-300); display: flex; align-items: center; gap: 16px; cursor: pointer; }
  .option:has(input:checked) { box-shadow: inset 0 0 0 1px var(--c-ink); background: var(--c-gray-100); }
  .option:has(input:focus-visible) { outline: 2px solid var(--c-link); outline-offset: 3px; }
  .option input { width: 20px; height: 20px; margin: 0; accent-color: var(--c-ink); flex-shrink: 0; }
  .option__text { display: flex; flex-direction: column; gap: 2px; flex: 1; }
  .option__label, .option__total { font-size: 1.125rem; }
  .option__sub { font-size: var(--fs-small); }

  .buy__cta { display: flex; flex-direction: column; gap: var(--s-1); }
  .buy__cta .btn { width: 100%; }
  .buy__cta .btn:disabled { opacity: 0.4; cursor: not-allowed; }
  .added { font-size: var(--fs-small); }

  .perks { list-style: none; margin: 0; padding: 0; }
  .perks li { display: flex; justify-content: space-between; gap: 12px; padding: 16px 0; border-bottom: 1px solid var(--c-ink-10); }
  .perks li:last-child { border-bottom: 0; }
  .ok { color: var(--c-ok); }

  .details { display: flex; flex-direction: column; gap: var(--s-4); }
  .pills { display: flex; flex-wrap: wrap; gap: 10px; }
  .pills a { min-height: 44px; padding: 0 24px; border-radius: var(--r-pill); box-shadow: inset 0 0 0 1px var(--c-ink); display: inline-flex; align-items: center; color: var(--c-ink); text-decoration: none; }
  .details__body { display: flex; flex-wrap: wrap; gap: var(--s-4) var(--s-6); align-items: flex-start; }
  .details__text { flex: 2 1 520px; max-width: 720px; display: flex; flex-direction: column; gap: var(--s-4); }
  .details__text section { display: flex; flex-direction: column; gap: var(--s-1); scroll-margin-top: 100px; }
  .details__text h2 { font-size: 2.125rem; }
  .details__text p { font-size: 1.125rem; color: rgba(1, 8, 15, 0.75); }
  .details__text blockquote { margin: 0; display: flex; flex-direction: column; gap: 4px; }

  .related { flex: 1 1 280px; background: var(--c-white); padding: var(--s-3); display: flex; flex-direction: column; gap: 16px; box-shadow: inset 0 0 0 1px var(--c-gray-400); }
  .related__img { aspect-ratio: 4 / 3; background: var(--c-gray-200); }
  .related__foot { display: flex; justify-content: space-between; align-items: center; }
  .price-sm { font-size: 1.25rem; }
</style>
