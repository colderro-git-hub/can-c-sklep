---
import Icon from '../components/Icon.astro';
// Strona „Nie znaleziono” - adres trafia do dziennika 404 w panelu (SEO → Przekierowania)
import Base from '../layouts/Base.astro';
import { langOf, href } from '../lib/i18n';
import { t } from '../i18n/ui';
export const prerender = false;
Astro.response.status = 404;
const lang = langOf(Astro.locals);
const links = [
  { href: href(lang, '/') + '#produkty', label: t(lang, 'nf.products'), text: t(lang, 'nf.productsText') },
  { href: href(lang, '/stosowanie/'), label: t(lang, 'nf.howto'), text: t(lang, 'nf.howtoText') },
  { href: href(lang, '/faq/'), label: 'FAQ', text: t(lang, 'nf.faqText') },
  { href: href(lang, '/kontakt/'), label: t(lang, 'nf.contact'), text: t(lang, 'nf.contactText') },
];
---
<Base title={t(lang, 'nf.metaTitle')} description={t(lang, 'nf.metaDesc')} noindex>
  <section class="w nf">
    <div class="nf__head">
      <span class="nf__code">404</span>
      <h1 class="h1">{t(lang, 'nf.title1')}<br />{t(lang, 'nf.title2')}</h1>
      <p class="p p--lg">{t(lang, 'nf.lead')}</p>
    </div>
    <div class="g4 nf__grid">
      {links.map((l) => (
        <a href={l.href} class="nf__card">
          <span class="nf__t">{l.label}</span>
          <span class="k">{l.text}</span>
          <Icon name="arrow-right" size={20} />
        </a>
      ))}
    </div>
    <a href={href(lang, '/')} class="btn" style="margin-top:45px">{t(lang, 'common.home')}</a>
  </section>
</Base>

<style>
  .nf { margin-top: 90px; margin-bottom: 90px; }
  .nf__head { display: flex; flex-direction: column; gap: 24px; max-width: 819px; }
  .nf__code { font-size: 88px; line-height: 88px; font-weight: 200; color: var(--accent); }
  .nf__grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 14px; margin-top: 45px; }
  .nf__card { display: flex; flex-direction: column; gap: 6px; padding: 32px; border: 1px solid var(--line); border-radius: var(--r-lg); text-decoration: none; color: var(--ink); }
  .nf__card:hover { border-color: var(--accent); }
  .nf__card :global(svg) { margin-top: 14px; color: var(--accent); }
  .nf__t { font-size: 24px; line-height: 28px; font-weight: 400; }
</style>
