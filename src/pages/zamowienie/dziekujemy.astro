---
import Icon from '../../components/Icon.astro';
// Potwierdzenie zamówienia wg „S9 · Potwierdzenie” (Laluna). Dane z /api/zamowienie/status.
import Base from '../../layouts/Base.astro';
---
<Base title="Dziękujemy za zamówienie | Can-C" description="Potwierdzenie zamówienia w sklepie Can-C." noindex noReferrer>
  <section class="w ty" data-thanks>
    <ol class="steps" aria-label="Etapy zamówienia">
      <li class="steps__i steps__i--done"><span class="steps__n"><Icon name="check" size={14} stroke={2.5} /></span>Koszyk</li>
      <li class="steps__sep steps__sep--done" aria-hidden="true"></li>
      <li class="steps__i steps__i--done"><span class="steps__n"><Icon name="check" size={14} stroke={2.5} /></span>Dostawa i płatność</li>
      <li class="steps__sep steps__sep--done" aria-hidden="true"></li>
      <li class="steps__i steps__i--now" aria-current="step"><span class="steps__n">3</span>Potwierdzenie</li>
    </ol>

    <div class="row ty__hero">
      <div class="ty__head">
        <div class="ty__state" data-state="checking">
          <h1 class="h1">Sprawdzamy płatność…</h1>
          <p class="p p--lg">To zwykle trwa kilka sekund. Nie zamykaj tej strony.</p>
        </div>
        <div class="ty__state" data-state="paid" hidden>
          <span class="peach ty__badge"><span class="dot" aria-hidden="true"></span>Płatność przyjęta</span>
          <h1 class="h1">Dziękujemy<br />za zamówienie</h1>
          <p class="p p--lg ty__lead">Zamówienie nr <strong data-number></strong> jest opłacone. Potwierdzenie wysłaliśmy na <strong data-email>Twój e-mail</strong>. Gdy paczka zostanie nadana, wyślemy numer przesyłki.</p>
        </div>
        <div class="ty__state" data-state="pending" hidden>
          <span class="peach ty__badge"><span class="dot" aria-hidden="true"></span>Czekamy na płatność</span>
          <h1 class="h1" data-pending-title></h1>
          <div class="p p--lg ty__lead" data-pending-body></div>
        </div>
        <div class="ty__state" data-state="error" hidden>
          <h1 class="h1">Nie znaleźliśmy<br />zamówienia</h1>
          <p class="p p--lg">Jeśli płatność została pobrana, <a href="/kontakt/">napisz do nas</a> - wyjaśnimy to od razu.</p>
        </div>
      </div>
      <div class="fl ty__leaf" aria-hidden="true"></div>
    </div>

    <p class="ty__notice" data-notice-box hidden role="status"></p>

    <ol class="g4 ty__track" aria-label="Status zamówienia" data-track hidden></ol>

    <div class="row ty__grid" data-order hidden>
      <div class="ty__main">
        <div class="ty__mhead">
          <h2 class="ty__h2">Twoje zamówienie</h2>
          <span class="k" data-meta></span>
        </div>
        <div class="ty__items" data-items role="list" aria-label="Zamówione produkty"></div>
        <div class="ty__sum" data-totals></div>
        <div class="ty__foot">
          <span>Masz pytanie albo widzisz błąd w danych? Napisz na <a data-contact-mail href="/kontakt/">adres sklepu</a> i podaj numer zamówienia.</span>
          <span class="ty__muted">Możesz odstąpić od umowy w ciągu 14 dni od otrzymania paczki. <a href="/odstapienie-od-umowy/">Jak zwrócić produkt</a></span>
        </div>
        <div class="ty__actions" data-actions-in></div>
      </div>

      <aside class="fl ty__side">
        <div class="ty__dark" data-bank-box hidden>
          <h2 class="ty__ct">Dane do przelewu</h2>
          <span class="ty__soft">Przelew bankowy · czeka na potwierdzenie</span>
          <div data-bank-rows></div>
          <span class="ty__soft" style="padding-top:10px">Przelej dokładną kwotę na powyższy numer. Zamówienie przekażemy do realizacji po zaksięgowaniu wpłaty.</span>
        </div>
        <div class="ty__card" data-pay-box>
          <h2 class="ty__ct">Płatność</h2>
          <div data-payment></div>
        </div>
        <div class="ty__card">
          <h2 class="ty__ct">Dostawa</h2>
          <div data-delivery></div>
        </div>
        <div class="ty__card" data-invoice-box hidden>
          <h2 class="ty__ct">Dane do faktury</h2>
          <div data-invoice></div>
        </div>
        <div class="ty__card" data-note-box hidden>
          <h2 class="ty__ct">Uwagi do zamówienia</h2>
          <p class="ty__pre" data-note></p>
        </div>
      </aside>
    </div>

    <p class="p" data-no-details hidden style="margin-top:45px">Szczegóły zamówienia znajdziesz w e-mailu z potwierdzeniem i na <a href="/konto/">koncie w sklepie</a>.</p>

    <div class="ty__actions" data-actions hidden>
      <a href="/" class="btn" data-act="shop">Wróć do sklepu</a>
      <a href="/konto/" class="btn btn-o" data-act="account">Moje zamówienia</a>
      <a href="/koszyk/" class="btn btn-o" data-act="cart" hidden>Wróć do koszyka</a>
    </div>
  </section>
</Base>

<script>
  import { clearCart } from '../../lib/cart';
  import { trackPurchase, calcTax } from '../../lib/analytics';
  import { typoSafe } from '../../lib/typography';
  import { icon as lucide } from '../../lib/icons';

  type Line = { slug: string; name: string; qty: number; unitPrice: number; discount: number; total: number; image: string | null; leadTime: string };
  type Details = {
    createdAt: string; paidAt: string | null; email: string; items: Line[];
    subtotal: number; bundleDiscount: number; promotions?: { name: string; amount: number }[]; gaServer?: boolean; code: string | null; codeAmount: number; shipping: number;
    delivery: { method: string; point: string | null; pointName: string | null; name: string | null; phone: string | null; street: string | null; postcode: string | null; city: string | null };
    invoice: { company: string; nip: string; street: string; postcode: string; city: string } | null;
    note: string | null; payment: { provider: string; method: string | null; bank: { account: string; title: string; amount: number } | null };
    shippingTime: string | null; notice: string | null; contact: { email: string; phone: string | null };
  };
  type Status = { number: number; status: string; total: number; details: Details | null };

  const root = document.querySelector<HTMLElement>('[data-thanks]')!;
  const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
  const pln = new Intl.NumberFormat('pl-PL', { style: 'currency', currency: 'PLN' });
  const zl = (g: number) => pln.format(g / 100);
  const esc = (v: unknown) => String(v ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);
  const when = (iso: string) => new Date(iso).toLocaleString('pl-PL', { day: 'numeric', month: 'long', year: 'numeric', hour: '2-digit', minute: '2-digit' });
  const phone = (p: string) => p.replace(/^\+?48/, '').replace(/(\d{3})(\d{3})(\d{3})/, '$1 $2 $3');

  function renderDetails(o: Status, paid: boolean) {
    const d = o.details;
    q('[data-no-details]').hidden = Boolean(d) || !paid;
    q('[data-order]').hidden = !d;
    if (!d) return;
    if (d.email) root.querySelectorAll('[data-email]').forEach((el) => { el.textContent = d.email; });

    q('[data-meta]').textContent = `Nr ${o.number} · złożone ${when(d.createdAt)}`;

    q('[data-items]').innerHTML = d.items.map((i) => `
      <div class="ty__item" role="listitem">
        <a class="ty__img" href="/produkt/${esc(i.slug)}/" tabindex="-1" aria-hidden="true">${i.image ? `<img src="${esc(i.image)}" alt="" width="66" height="66" loading="lazy" />` : ''}</a>
        <span class="ty__info">
          <a class="ty__name" href="/produkt/${esc(i.slug)}/">${typoSafe(i.name)}</a>
          <span class="k">${i.qty} × ${zl(i.unitPrice)}${i.discount ? ` · rabat −${zl(i.discount)}` : ''}</span>
          ${d.shippingTime ? '' : `<span class="k">${esc(i.leadTime)}</span>`}
        </span>
        <span class="ty__itotal">${zl(i.total)}</span>
      </div>`).join('');

    const rows: [string, string, string?][] = [['Produkty', zl(d.subtotal)]];
    // Promocje po nazwie; starsze zamówienia (bez zapisanych promocji) - jedna suma
    const promos = d.promotions || [];
    if (promos.length) promos.forEach((p) => rows.push([p.name, `−${zl(p.amount)}`]));
    else if (d.bundleDiscount) rows.push(['Rabat', `−${zl(d.bundleDiscount)}`]);
    if (d.code && d.codeAmount) rows.push([`Kod rabatowy ${d.code}`, `−${zl(d.codeAmount)}`]);
    rows.push(['Dostawa', d.shipping ? zl(d.shipping) : 'Bezpłatna', d.shipping ? '' : 'b']);
    q('[data-totals]').innerHTML = rows.map(([k, v, c]) => `<div class="srow"><span>${esc(k)}</span><span${c ? ' style="font-weight:400"' : ''}>${esc(v)}</span></div>`).join('')
      + `<div class="total-row" style="margin-top:4px;border-color:var(--image)"><span>Razem${paid ? ' zapłacono' : ' do zapłaty'}</span><span>${zl(o.total)}</span></div>`
      + '<span class="k">Ceny zawierają podatek VAT.</span>';

    const dv = d.delivery;
    const who = [dv.name, dv.phone ? `tel. ${phone(dv.phone)}` : ''].filter(Boolean).map(esc).join('<br>');
    q('[data-delivery]').innerHTML = dv.method === 'inpost_locker'
      ? `<span class="ty__strong">Paczkomat InPost ${esc(dv.point || '')}</span>${dv.pointName ? `<span>${esc(dv.pointName)}</span>` : ''}<span>${who}</span>`
      : `<span class="ty__strong">Kurier DPD</span><span>${[dv.name, dv.street, [dv.postcode, dv.city].filter(Boolean).join(' ')].filter(Boolean).map(esc).join('<br>')}${dv.phone ? `<br>tel. ${esc(phone(dv.phone))}` : ''}</span>`;
    if (d.shippingTime) q('[data-delivery]').insertAdjacentHTML('beforeend', `<span class="k">${esc(d.shippingTime)}${paid ? '' : ' Termin liczymy od zaksięgowania płatności.'}</span>`);

    const bankData = d.payment.bank;
    // Przelew nieopłacony: ciemna karta z danymi do skopiowania; w pozostałych przypadkach zwykła karta płatności
    const showBank = Boolean(bankData) && !paid;
    q('[data-bank-box]').hidden = !showBank;
    q('[data-pay-box]').hidden = showBank;
    if (showBank && bankData) {
      const rowsB: [string, string][] = [['Numer rachunku', bankData.account], ['Tytuł przelewu', bankData.title], ['Kwota', zl(bankData.amount)]];
      q('[data-bank-rows]').innerHTML = rowsB.map(([k, v]) => `
        <div class="ty__brow"><span class="ty__soft">${esc(k)}</span>
          <div class="ty__copy"><span class="ty__bval">${esc(v)}</span><button type="button" class="ty__cb" data-copy="${esc(v)}" aria-label="Kopiuj: ${esc(k)}">Kopiuj</button></div>
        </div>`).join('');
    }
    q('[data-payment]').innerHTML = `<span class="ty__strong">${esc(d.payment.provider)}</span>${d.payment.method ? `<span>${esc(d.payment.method)}</span>` : ''}`
      + `<span class="${paid ? 'ty__ok' : ''}">${paid ? `Opłacone${d.paidAt ? ` ${esc(when(d.paidAt))}` : ''}` : 'Czeka na potwierdzenie'}</span>`;

    // Oś statusu
    const stepNo = paid ? (['shipped', 'completed'].includes(o.status) ? (o.status === 'completed' ? 4 : 3) : 2) : 1;
    const ship = dv.method === 'inpost_locker' ? 'InPost Paczkomat' : 'Kurier DPD';
    const steps: [string, string][] = [
      ['Przyjęte', when(d.createdAt)],
      ['Opłacone', paid ? (d.paidAt ? when(d.paidAt) : 'opłacone') : (bankData ? 'czekamy na przelew' : 'czekamy na potwierdzenie')],
      ['Wysłane', stepNo >= 3 ? 'w drodze' : (bankData && !paid ? '1 dzień roboczy po wpłacie' : (d.shippingTime || 'wkrótce'))],
      ['Dostarczone', ship],
    ];
    const track = q('[data-track]');
    track.hidden = false;
    track.innerHTML = steps.map(([t, sub], i) => {
      const n = i + 1;
      const done = n <= stepNo;
      const now = n === stepNo + 1 || (stepNo === 4 && n === 4);
      const icon = done
        ? `<span class="ty__tn ty__tn--done" aria-hidden="true">${lucide('check', 16, { stroke: 2.5 })}</span>`
        : `<span class="ty__tn${now ? ' ty__tn--now' : ''}" aria-hidden="true">${n}</span>`;
      return `<li class="ty__t${done || now ? '' : ' ty__t--off'}"${now && !done ? ' aria-current="step"' : ''}>${icon}<span class="ty__tt"><span class="ty__tl">${esc(t)}</span><span class="k">${esc(sub)}</span></span></li>`;
    }).join('');

    q('[data-invoice-box]').hidden = !d.invoice;
    if (d.invoice) q('[data-invoice]').innerHTML = `<p>${esc(d.invoice.company)}<br>NIP ${esc(d.invoice.nip)}<br>${esc(d.invoice.street)}<br>${esc(d.invoice.postcode)} ${esc(d.invoice.city)}</p><p class="muted small">Fakturę wyślemy e-mailem.</p>`;
    q('[data-note-box]').hidden = !d.note;
    if (d.note) q('[data-note]').textContent = d.note;

    const box = q('[data-notice-box]');
    box.hidden = !d.notice; if (d.notice) box.textContent = d.notice;

    // Przyciski pod zamówieniem (jak w projekcie)
    const acts = q('[data-actions]');
    q('[data-actions-in]').append(...[...acts.children]);
    const mail = q<HTMLAnchorElement>('[data-contact-mail]');
    mail.textContent = d.contact.email; mail.href = `mailto:${d.contact.email}?subject=${encodeURIComponent(`Zamówienie nr ${o.number}`)}`;
  }

  const fillPending = (o: Status | undefined, el: HTMLElement, bodyEl: HTMLElement) => {
    const bank = !!(o?.details?.payment?.bank);
    if (bank) {
      el.innerHTML = 'Zamówienie przyjęte -<br>czekamy na przelew';
      bodyEl.innerHTML = `Zamówienie nr <strong>${o?.number}</strong> zostało przyjęte. Wyślemy je po zaksięgowaniu przelewu. Dane do przelewu wysłaliśmy e-mailem - sprawdź też folder spam.`;
    } else {
      el.innerHTML = 'Zamówienie jest<br>zapisane';
      bodyEl.innerHTML = `Zamówienie nr <strong>${o?.number}</strong> czeka na potwierdzenie płatności z Przelewy24. Gdy wpłata dotrze, wyślemy e-mail z potwierdzeniem.<br><br>Jeśli płatność została przerwana, wróć do koszyka i złóż zamówienie ponownie albo <a href="/kontakt/">napisz do nas</a>. Nieopłacone zamówienie anulujemy automatycznie po 24 godzinach.`;
    }
  };

  const show = (state: string, o?: Status) => {
    root.querySelectorAll<HTMLElement>('[data-state]').forEach((el) => { el.hidden = el.dataset.state !== state; });
    if (o) root.querySelectorAll('[data-number]').forEach((el) => { el.textContent = String(o.number); });
    const ok = state === 'paid' || state === 'pending';
    q('[data-actions]').hidden = !ok;
    root.querySelector<HTMLElement>('[data-act="cart"]')!.hidden = state !== 'pending';
    root.querySelector<HTMLElement>('[data-act="account"]')!.hidden = state !== 'paid';
    if (o && ok) renderDetails(o, state === 'paid');
    const pendingTitle = document.querySelector<HTMLElement>('[data-pending-title]');
    const pendingBody = document.querySelector<HTMLElement>('[data-pending-body]');
    if (state === 'pending' && pendingTitle && pendingBody) fillPending(o, pendingTitle, pendingBody);
    else if (state !== 'paid') { q('[data-order]').hidden = true; q('[data-no-details]').hidden = true; q('[data-track]').hidden = true; }
  };

  // Kopiowanie danych do przelewu
  root.addEventListener('click', async (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-copy]');
    if (!b) return;
    try { await navigator.clipboard.writeText(b.dataset.copy!.replace(/\s+zł$/, '')); } catch { /* brak uprawnień */ }
    root.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((x) => { x.textContent = x === b ? 'Skopiowano' : 'Kopiuj'; });
  });

  const id = new URLSearchParams(location.search).get('id');
  let tries = 0;

  async function check() {
    if (!id) return show('error');
    try {
      const res = await fetch(`/api/zamowienie/status?id=${encodeURIComponent(id)}`, { cache: 'no-store' });
      if (!res.ok) return show('error');
      const o: Status = await res.json();
      // Płatność potwierdzona → wyczyść koszyk i pokaż podsumowanie
      if (['paid', 'packing', 'shipped', 'completed'].includes(o.status)) {
        clearCart();
        // GA4 purchase - wysyłamy tylko raz (tries === 1 = pierwsze udane sprawdzenie)
        if (tries <= 1 && o.details && !o.details.gaServer) {
          const totalGross = o.total / 100;
          const shippingGross = (o.details.shipping || 0) / 100;
          const productGross = totalGross - shippingGross;
          trackPurchase({
            transactionId: id!,
            value: totalGross,
            shipping: shippingGross,
            tax: calcTax(productGross, 23), // VAT 23% wg stawki produktu
            coupon: o.details.code || undefined,
            items: (o.details.items || []).map((i: any) => ({
              item_id: i.slug, item_name: i.name, price: i.unitPrice / 100, quantity: i.qty,
              item_brand: 'Can-C', discount: i.discount ? i.discount / 100 : undefined,
            })),
          });
        }
        return show('paid', o);
      }
      // Przelew bankowy: status zawsze pending_payment → od razu pokaż stronę, nie czekaj 30 s na P24
      if (o.details?.payment?.bank) { clearCart(); return show('pending', o); }
      // P24: powiadomienie może przyjść kilka sekund po powrocie klienta → sprawdzamy przez ok. 30 s
      if (++tries < 10) return setTimeout(check, 3000);
      show('pending', o);
    } catch {
      if (++tries < 10) setTimeout(check, 3000); else show('error');
    }
  }
  check();
</script>

<style>
  [hidden] { display: none !important; }
  .ty { margin-top: 45px; margin-bottom: 90px; }
  .ty__hero { display: flex; align-items: flex-end; justify-content: space-between; gap: 45px; margin-top: 45px; }
  .ty__state { display: flex; flex-direction: column; gap: 24px; }
  .ty__badge { align-self: flex-start; height: 36px; padding: 0 16px; font-size: 16px; }
  .ty__lead { max-width: 737px; }
  .ty__lead :global(strong), .ty__state strong { font-weight: 500; color: var(--ink); }
  .ty__leaf { width: 269px; height: 169px; flex-shrink: 0; background: var(--image); border-radius: 20px 500px 20px 20px; }
  .ty__notice { margin-top: 24px; padding: 14px 18px; border-radius: var(--r-md); background: var(--peach); font-size: 14px; }
  .ty__track { list-style: none; margin: 45px 0 0; padding: 24px 0; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 14px; }
  :global(.ty__t) { display: flex; align-items: center; gap: 14px; }
  :global(.ty__t--off) { color: var(--muted); }
  :global(.ty__tn) { width: 42px; height: 42px; flex-shrink: 0; border-radius: 50%; border: 1px solid var(--line); display: flex; align-items: center; justify-content: center; font-size: 16px; font-weight: 400; }
  :global(.ty__tn--done) { background: var(--primary); border-color: var(--primary); color: var(--surface); }
  :global(.ty__tn--now) { background: var(--peach); border-color: var(--primary); color: var(--ink); }
  :global(.ty__tt) { display: flex; flex-direction: column; }
  :global(.ty__tl) { font-size: 18px; line-height: 28px; font-weight: 400; }
  .ty__grid { display: flex; align-items: flex-start; gap: 45px; margin-top: 45px; }
  .ty__main { flex-grow: 1; min-width: 0; display: flex; flex-direction: column; gap: 14px; }
  .ty__mhead { display: flex; flex-direction: column; gap: 4px; margin-bottom: 10px; }
  .ty__h2 { font-size: 28px; line-height: 32px; font-weight: 400; }
  .ty__items { display: flex; flex-direction: column; gap: 14px; }
  :global(.ty__item) { border: 1px solid var(--line); border-radius: var(--r-md); padding: 24px; display: flex; align-items: center; gap: 24px; }
  :global(.ty__img) { width: 66px; height: 66px; flex-shrink: 0; border-radius: 14px; background: var(--image); overflow: hidden; }
  :global(.ty__img img) { width: 100%; height: 100%; object-fit: cover; }
  :global(.ty__info) { flex-grow: 1; min-width: 0; display: flex; flex-direction: column; }
  :global(.ty__name) { font-size: 18px; line-height: 27px; font-weight: 400; color: var(--ink); text-decoration: none; }
  :global(.ty__itotal) { font-size: 18px; line-height: 27px; font-weight: 500; white-space: nowrap; }
  .ty__sum { background: var(--band); border-radius: var(--r-lg); padding: 32px; display: flex; flex-direction: column; gap: 10px; }
  .ty__foot { margin-top: 31px; padding-top: 24px; border-top: 1px solid var(--line); display: flex; flex-direction: column; gap: 6px; font-size: 16px; line-height: 24px; font-weight: 300; }
  .ty__muted { color: var(--muted); }
  .ty__actions { display: flex; gap: 14px; flex-wrap: wrap; margin-top: 21px; }
  .ty__side { width: 436px; flex-shrink: 0; display: flex; flex-direction: column; gap: 14px; }
  .ty__dark { background: var(--primary); color: #FFFFFF; border-radius: var(--r-lg); padding: 32px; display: flex; flex-direction: column; gap: 10px; font-size: 16px; line-height: 24px; font-weight: 300; }
  .ty__soft { color: var(--on-dark-soft); font-size: 14px; line-height: 21px; }
  :global(.ty__brow) { display: flex; flex-direction: column; gap: 2px; padding-top: 10px; margin-top: 10px; border-top: 1px solid var(--on-dark-line); }
  :global(.ty__copy) { display: flex; align-items: center; justify-content: space-between; gap: 14px; }
  :global(.ty__bval) { font-size: 18px; line-height: 27px; font-weight: 400; letter-spacing: 0; word-break: break-word; }
