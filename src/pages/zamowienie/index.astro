---
import Icon from '../../components/Icon.astro';
import Base from '../../layouts/Base.astro';
import { products } from '../../data/shop';
import { FURGONETKA_MAP_KEY } from '../../config';

const catalog = products.map(({ slug, name, price, bundles, size }) => ({ slug, name, price, bundles: !!bundles, size }));
---
<Base title="Dostawa i płatność | Can-C" description="Złóż zamówienie w sklepie Can-C." noindex>
  <section class="co">
    <div class="w co__in">
      <ol class="steps" aria-label="Etapy zamówienia">
        <li class="steps__i steps__i--done"><a href="/koszyk/"><span class="steps__n"><Icon name="check" size={14} stroke={2.5} /></span>Koszyk</a></li>
        <li class="steps__sep steps__sep--done" aria-hidden="true"></li>
        <li class="steps__i steps__i--now" aria-current="step"><span class="steps__n">2</span>Dostawa i płatność</li>
        <li class="steps__sep" aria-hidden="true"></li>
        <li class="steps__i"><span class="steps__n">3</span>Potwierdzenie</li>
      </ol>

      <div data-empty hidden class="empty co__empty">
        <h1 class="co__emptyt">Koszyk jest pusty</h1>
        <a href="/#produkty" class="btn">Przejdź do produktów</a>
      </div>

      <form class="co__form" data-checkout novalidate hidden>
        <h1 class="h2 co__title">Dostawa i płatność</h1>
        <p class="co__notice" data-notice hidden role="status"><span data-site="noticeText"></span></p>

        <div class="row co__grid">
          <div class="co__main">
            <fieldset class="co__card">
              <legend class="co__ct">1. Twoje dane</legend>
              <div class="g2 co__g2">
                <div><label class="lbl" for="c-mail">E-mail</label><input id="c-mail" class="fld" type="email" name="email" autocomplete="email" required /></div>
                <div><label class="lbl" for="c-tel">Telefon (do powiadomień o paczce)</label><input id="c-tel" class="fld" type="tel" name="phone" autocomplete="tel" inputmode="tel" required placeholder="np. 600 100 200" /></div>
                <div><label class="lbl" for="c-fn">Imię</label><input id="c-fn" class="fld" type="text" name="firstName" autocomplete="given-name" required /></div>
                <div><label class="lbl" for="c-ln">Nazwisko</label><input id="c-ln" class="fld" type="text" name="lastName" autocomplete="family-name" required /></div>
              </div>
            </fieldset>

            <fieldset class="co__card">
              <legend class="co__ct">2. Dostawa</legend>
              <label class="opt"><input type="radio" name="shippingMethod" value="inpost_locker" checked />
                <span class="opt__txt"><span class="opt__t">InPost Paczkomat 24/7</span><span class="opt__s">Odbiór o dowolnej porze</span></span><span class="opt__p">0,00 zł</span></label>
              <label class="opt"><input type="radio" name="shippingMethod" value="dpd" />
                <span class="opt__txt"><span class="opt__t">Kurier DPD</span><span class="opt__s">Dostawa pod wskazany adres</span></span><span class="opt__p">0,00 zł</span></label>

              <div class="co__sub" data-locker data-map-key={FURGONETKA_MAP_KEY}>
                <div class="co__pick" data-map-wrap hidden>
                  <div class="co__pickinfo">
                    <span data-locker-label>Nie wybrano Paczkomatu</span>
                    <span class="k" data-locker-name></span>
                  </div>
                  <button type="button" class="btn btn-m" data-map-open>Wybierz Paczkomat na mapie</button>
                </div>
                <div data-locker-manual><label class="lbl" for="c-pk">Kod Paczkomatu</label><input id="c-pk" class="fld" type="text" name="locker" placeholder="np. WRO01M" autocapitalize="characters" maxlength="15" /></div>
                <input type="hidden" name="lockerName" />
                <a href="https://inpost.pl/znajdz-paczkomat" target="_blank" rel="noopener" class="co__link" data-locker-link>Znajdź Paczkomat na mapie InPost</a>
              </div>
              <div class="co__sub co__addr" data-address hidden>
                <div><label class="lbl" for="c-st">Ulica i numer</label><input id="c-st" class="fld" type="text" name="street" autocomplete="street-address" /></div>
                <div><label class="lbl" for="c-zip">Kod pocztowy</label><input id="c-zip" class="fld" type="text" name="postcode" autocomplete="postal-code" placeholder="00-000" maxlength="6" /></div>
                <div><label class="lbl" for="c-city">Miejscowość</label><input id="c-city" class="fld" type="text" name="city" autocomplete="address-level2" /></div>
              </div>
            </fieldset>

            <fieldset class="co__card">
              <legend class="co__ct">3. Płatność</legend>
              <label class="opt"><input type="radio" name="paymentMethod" value="p24" checked />
                <span class="opt__txt"><span class="opt__t">Przelewy24</span><span class="opt__s">BLIK, karta, przelew online - ponad 150 metod</span></span></label>
              <label class="opt"><input type="radio" name="paymentMethod" value="bank_transfer" />
                <span class="opt__txt"><span class="opt__t">Przelew bankowy</span><span class="opt__s">Realizacja po zaksięgowaniu wpłaty</span></span></label>
              <div class="co__sub" data-bank hidden>
                <span class="co__banktxt">Wpłać na nasze konto i podaj numer zamówienia w tytule. Zamówienie przekażemy do realizacji po zaksięgowaniu wpłaty. Pełne dane do przelewu pokażemy po złożeniu zamówienia i wyślemy e-mailem.</span>
                <span class="k" style="color: var(--ink)">Numer rachunku</span>
                <span class="co__banknr" data-bank-nr></span>
              </div>
            </fieldset>

            <fieldset class="co__card">
              <legend class="co__ct">4. Faktura i uwagi</legend>
              <label class="ck" style="font-size:16px;line-height:24px"><input type="checkbox" name="invoice" data-invoice-toggle />Chcę fakturę na firmę</label>
              <div class="co__sub co__inv" data-invoice hidden>
                <div><label class="lbl" for="c-co">Nazwa firmy</label><input id="c-co" class="fld" type="text" name="company" autocomplete="organization" /></div>
                <div><label class="lbl" for="c-nip">NIP</label><input id="c-nip" class="fld" type="text" name="nip" inputmode="numeric" maxlength="13" /></div>
                <div><label class="lbl" for="c-ist">Ulica i numer</label><input id="c-ist" class="fld" type="text" name="invStreet" /></div>
                <div><label class="lbl" for="c-izip">Kod pocztowy</label><input id="c-izip" class="fld" type="text" name="invPostcode" placeholder="00-000" maxlength="6" /></div>
                <div><label class="lbl" for="c-icity">Miejscowość</label><input id="c-icity" class="fld" type="text" name="invCity" /></div>
              </div>
              <div style="margin-top:10px"><label class="lbl" for="c-note">Uwagi do zamówienia (opcjonalnie)</label><textarea id="c-note" class="fld" name="note" rows="3" maxlength="500"></textarea></div>
            </fieldset>
            <label class="hp" aria-hidden="true">Strona www<input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
          </div>

          <aside class="fl co__card co__side">
            <h2 class="co__ct">Podsumowanie</h2>
            <ul class="co__lines" data-lines></ul>
            <div>
              <label class="lbl" for="c-code">Kod rabatowy</label>
              <div class="co__code">
                <input id="c-code" class="fld" type="text" name="discountCode" autocomplete="off" maxlength="30" />
                <button type="button" class="btn btn-o co__codebtn" data-apply-code>Użyj</button>
              </div>
              <p class="msg k" role="status" data-code-msg style="margin-top:6px"></p>
            </div>
            <div class="co__sums">
              <div class="srow"><span>Produkty</span><span data-subtotal></span></div>
              <div data-promos></div>
              <div class="srow" data-code-line hidden><span data-code-name>Kod rabatowy</span><span data-code-amount></span></div>
              <div class="srow"><span>Dostawa · <span data-ship-name>InPost</span></span><span style="font-weight:400">Darmowa</span></div>
            </div>
            <div class="total-row"><span>Razem</span><span data-total></span></div>
            <label class="ck"><input type="checkbox" name="terms" required /><span>Akceptuję <a href="/regulamin/" target="_blank">Regulamin</a> i zapoznałem się z <a href="/polityka-prywatnosci/" target="_blank">Polityką prywatności</a>.</span></label>
            <label class="ck"><input type="checkbox" name="marketing" /><span>Chcę otrzymywać informacje o promocjach (opcjonalnie).</span></label>
            <button type="submit" class="btn btn--wide" style="margin-top:10px" data-submit>Zamawiam i płacę</button>
            <p class="msg msg--err" role="alert" data-error></p>
            <span class="k" data-pay-note>Płatność BLIK, przelewem lub kartą w serwisie Przelewy24. Nie przechowujemy danych kart.</span>
          </aside>
        </div>
      </form>
    </div>
  </section>
</Base>

<script define:vars={{ catalog }}>
  // Dane z chwili budowania jako zapas; aktualne ceny i dostępność z bazy
  window.__CANC_CATALOG__ = catalog;
  window.__CANC_READY__ = fetch('/api/produkty')
    .then((r) => (r.ok ? r.json() : null))
    // API podaje ceny w groszach, a ta strona liczy w złotych; niedostępne produkty bez ceny
    .then((list) => { if (Array.isArray(list) && list.length) window.__CANC_CATALOG__ = list.map((p) => ({ ...p, price: p.price === null || p.avail === 'out_of_stock' ? null : p.price / 100 })); })
    .catch(() => {});
  window.__CANC_PROMOS__ = fetch('/api/promocje').then((r) => (r.ok ? r.json() : [])).catch(() => []);
</script>

<script>
  import { getCart } from '../../lib/cart';
  import { trackBeginCheckout, trackAddShippingInfo, trackAddPaymentInfo, trackFormStart, trackFormFieldClick, trackFormFieldError, trackFormSubmit } from '../../lib/analytics';
  import { BANK_ACCOUNT, BANK_PROVIDER } from '../../lib/bank-transfer';
  import { typoSafe } from '../../lib/typography';
  import { imgUrl } from '../../lib/img';
  import { applyPromotions, normalizePromotion } from '../../lib/promotions';

  (async () => {
  await (window as any).__CANC_READY__;

  type P = { slug: string; name: string; price: number | null; bundles: boolean };
  const catalog: P[] = (window as any).__CANC_CATALOG__ ?? [];
  const pln = new Intl.NumberFormat('pl-PL', { style: 'currency', currency: 'PLN' });
  const promos = (((await (window as any).__CANC_PROMOS__) || []) as any[]).map(normalizePromotion);
  const escHtml = (t: string) => t.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);

  const form = document.querySelector<HTMLFormElement>('[data-checkout]')!;
  const items = getCart().filter((i) => catalog.some((p) => p.slug === i.slug && p.price !== null));

  if (!items.length) {
    document.querySelector<HTMLElement>('[data-empty]')!.hidden = false;
  } else {
    form.hidden = false;

    // Podgląd sumy (ostateczną kwotę liczy serwer)
    let subtotal = 0, discount = 0;
    const ul = form.querySelector('[data-lines]')!;
    const promo = applyPromotions(items.map((it) => ({ product_id: it.slug, qty: it.qty, unit_price: Math.round((catalog.find((c) => c.slug === it.slug)!.price ?? 0) * 100) })), promos);
    for (const it of items) {
      const p = catalog.find((c) => c.slug === it.slug)!;
      const gross = (p.price ?? 0) * it.qty;
      const d = (promo.discounts[p.slug] ?? 0) / 100;
      subtotal += gross; discount += d;
      const li = document.createElement('li');
      const img = (p as any).image as string | undefined;
      li.innerHTML = (img ? '<img class="co__thumb" alt="" width="54" height="54" loading="lazy">' : '<span class="co__thumb"></span>') + '<span class="co__lname"></span><span class="co__lprice"></span>';
      if (img) li.querySelector('img')!.src = imgUrl(img, 160);
      li.querySelector('.co__lname')!.innerHTML = `${typoSafe(p.name)} × ${it.qty}`;
      li.querySelector('.co__lprice')!.textContent = pln.format(gross - d);
      ul.append(li);
    }
    form.querySelector('[data-subtotal]')!.textContent = pln.format(subtotal);
    form.querySelector('[data-promos]')!.innerHTML = promo.applied.map((a) => `<div class="srow"><span>${escHtml(a.label)}</span><span>−${pln.format(a.amount / 100)}</span></div>`).join('');
    form.querySelector('[data-total]')!.textContent = pln.format(subtotal - discount);

    // ---------- Kod rabatowy (podgląd liczy serwer) ----------
    let appliedCode = '';
    const codeInput = form.querySelector<HTMLInputElement>('input[name="discountCode"]')!;
    const codeMsg = form.querySelector<HTMLElement>('[data-code-msg]')!;
    const codeLine = form.querySelector<HTMLElement>('[data-code-line]')!;
    const resetCode = () => { appliedCode = ''; codeLine.hidden = true; form.querySelector('[data-total]')!.textContent = pln.format(subtotal - discount); };
    form.querySelector('[data-apply-code]')!.addEventListener('click', async () => {
      const code = codeInput.value.trim();
      if (!code) { resetCode(); codeMsg.textContent = ''; return; }
      codeMsg.textContent = 'Sprawdzanie…';
      try {
        const res = await fetch('/api/rabat', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ code, email: String(new FormData(form).get('email') || ''), items }) });
        const d = await res.json();
        if (!res.ok) { resetCode(); codeMsg.textContent = d.error || 'Nie udało się sprawdzić kodu.'; return; }
        appliedCode = d.code;
        codeLine.hidden = false;
        form.querySelector('[data-code-name]')!.textContent = d.promo ? `${d.promo} (kod ${d.code})` : `Kod ${d.code}`;
        form.querySelector('[data-code-amount]')!.textContent = `−${pln.format(d.amount / 100)}`;
        form.querySelector('[data-total]')!.textContent = pln.format(d.total / 100);
        codeMsg.textContent = 'Kod dodany.';
      } catch { codeMsg.textContent = 'Nie udało się sprawdzić kodu.'; }
    });
    codeInput.addEventListener('input', () => { if (appliedCode && codeInput.value.trim().toUpperCase() !== appliedCode) { resetCode(); codeMsg.textContent = ''; } });
    (window as any).__cancCode = () => appliedCode;
    // Kod z linku „Zamów ponownie” (mail o końcu kuracji): wpisany automatycznie; kody imienne sprawdzamy po podaniu e-maila
    let pendingCode = '';
    try { pendingCode = sessionStorage.getItem('canc-reorder-code') || ''; } catch { /* brak */ }
    const applyPending = () => {
      if (!pendingCode || appliedCode) return;
      codeInput.value = pendingCode;
      form.querySelector<HTMLButtonElement>('[data-apply-code]')!.click();
    };
    if (pendingCode) {
      applyPending();
      form.querySelector<HTMLInputElement>('input[name="email"]')?.addEventListener('change', () => { if (!appliedCode) applyPending(); });
      // Po złożeniu zamówienia kod nie wraca przy kolejnych zakupach
      form.addEventListener('submit', () => { try { sessionStorage.removeItem('canc-reorder-code'); } catch { /* brak */ } });
    }

    // ---------- Uzupełnienie danych zalogowanego klienta ----------
    (async () => {
      try {
        const { sb } = await import('../../lib/sb-client');
        const { data } = await sb().auth.getSession();
        const session = data.session;
        if (!session) return;
        const res = await fetch('/api/konto/profil', { headers: { Authorization: `Bearer ${session.access_token}` } });
        if (!res.ok) return;
        const p = await res.json();
        const fill = (n: string, v: unknown) => { const el = form.elements.namedItem(n) as HTMLInputElement | null; if (el && !el.value && v) el.value = String(v); };
        fill('email', session.user.email); fill('phone', p.phone); fill('firstName', p.first_name); fill('lastName', p.last_name);
        fill('locker', p.default_locker); fill('street', p.default_address?.street); fill('postcode', p.default_address?.postcode); fill('city', p.default_address?.city);
        if (p.default_locker) {
          const label = form.querySelector('[data-locker-label]'); if (label) label.textContent = `Paczkomat ${p.default_locker}`;
        }
        if (p.billing?.nip) {
          const t = form.querySelector<HTMLInputElement>('[data-invoice-toggle]')!; t.checked = true; t.dispatchEvent(new Event('change'));
          fill('company', p.billing.company); fill('nip', p.billing.nip); fill('invStreet', p.billing.street); fill('invPostcode', p.billing.postcode); fill('invCity', p.billing.city);
        }
      } catch { /* niezalogowany albo brak konfiguracji - formularz działa normalnie */ }
    })();

    // GA4 form_start - przy pierwszym focusie na dowolnym polu
    let _fmStarted = false;
    form.addEventListener('focusin', () => { if (_fmStarted) return; _fmStarted = true; trackFormStart('checkout_form'); }, { once: false });

    // GA4 form_field_click - śledzimy nazwę pola, NIE wartość
    const FIELD_MAP: Record<string, string> = {
      email: 'email', phone: 'phone', firstName: 'first_name', lastName: 'last_name',
      street: 'street', postcode: 'postal_code', city: 'city',
      company: 'company_name', nip: 'nip', invStreet: 'invoice_street',
      invPostcode: 'invoice_postal_code', invCity: 'invoice_city', note: 'note',
      locker: 'locker_id', lockerName: 'locker_name',
    };
    form.querySelectorAll<HTMLElement>('input, textarea, select').forEach((el) => {
      const name = (el as HTMLInputElement).name;
      const mapped = FIELD_MAP[name] || name;
      el.addEventListener('focus', () => { if (name) trackFormFieldClick('checkout_form', mapped); });
    });

    // Pola zależne od wyboru
    const locker = form.querySelector<HTMLElement>('[data-locker]')!;
    const address = form.querySelector<HTMLElement>('[data-address]')!;
    form.querySelectorAll<HTMLInputElement>('input[name="shippingMethod"]').forEach((r) =>
      r.addEventListener('change', () => {
        locker.hidden = r.value !== 'inpost_locker'; address.hidden = r.value !== 'dpd';
        form.querySelector('[data-ship-name]')!.textContent = r.value === 'dpd' ? 'DPD' : 'InPost';
      }),
    );

    const submit = form.querySelector<HTMLButtonElement>('[data-submit]')!;
    // Przelew bankowy: pokaż numer konta, zmień opis przycisku i noty
    const bankPanel = form.querySelector<HTMLElement>('[data-bank]')!;
    const bankNr = form.querySelector<HTMLElement>('[data-bank-nr]')!;
    bankNr.textContent = BANK_ACCOUNT;
    const payNote = form.querySelector<HTMLElement>('[data-pay-note]')!;
    form.querySelectorAll<HTMLInputElement>('input[name="paymentMethod"]').forEach((r) =>
      r.addEventListener('change', () => {
        const bank = r.value === 'bank_transfer';
        bankPanel.hidden = !bank;
        submit.textContent = 'Zamawiam i płacę';
        payNote.textContent = bank
          ? 'Po złożeniu zamówienia wyślemy e-mail z numerem konta i kwotą do przelania. Realizacja po zaksięgowaniu wpłaty.'
          : 'Płatność BLIK, przelewem lub kartą w serwisie Przelewy24. Nie przechowujemy danych kart.';
      }),
    );
    const invoice = form.querySelector<HTMLElement>('[data-invoice]')!;
    form.querySelector<HTMLInputElement>('[data-invoice-toggle]')!.addEventListener('change', (e) => {
      invoice.hidden = !(e.target as HTMLInputElement).checked;
    });

    const errorEl = form.querySelector<HTMLElement>('[data-error]')!;
    // Mapa punktów Furgonetki (furgonetka.pl/js/dist/map/map.js, dokumentacja „Furgonetka - Mapa 2.0”).
    // Mapa nie wymaga klucza API - wcześniej działała tylko przy ustawionym FURGONETKA_MAP_KEY, stąd „nie działała”.
    // Skrypt ładujemy dopiero przy pierwszym kliknięciu; pole ręczne zostaje jako zapas, gdy mapa się nie wczyta.
    const mapKey = locker.dataset.mapKey || '';
    let mapLoad: Promise<any> | null = null;
    const loadMap = () => (mapLoad ??= new Promise((resolve) => {
      const w = window as any;
      if (w.Furgonetka?.Map) return resolve(w.Furgonetka);
      const sc = document.createElement('script');
      sc.src = 'https://furgonetka.pl/js/dist/map/map.js';
      sc.async = true;
      sc.onload = () => resolve(w.Furgonetka ?? null);
      sc.onerror = () => { mapLoad = null; resolve(null); };
      document.head.append(sc);
      setTimeout(() => resolve(w.Furgonetka ?? null), 10000);
    }));
    {
      const wrap = locker.querySelector<HTMLElement>('[data-map-wrap]')!;
      const manual = locker.querySelector<HTMLElement>('[data-locker-manual]')!;
      const codeInput = form.querySelector<HTMLInputElement>('input[name="locker"]')!;
      const nameInput = form.querySelector<HTMLInputElement>('input[name="lockerName"]')!;
      wrap.hidden = false;
      manual.hidden = true;
      locker.querySelector<HTMLElement>('[data-locker-link]')!.hidden = true;
      const openBtn = locker.querySelector<HTMLButtonElement>('[data-map-open]')!;
      openBtn.addEventListener('click', async () => {
        const label = openBtn.textContent;
        openBtn.disabled = true; openBtn.textContent = 'Wczytuję mapę…';
        const F = await loadMap();
        openBtn.disabled = false; openBtn.textContent = label;
        if (!F?.Map) {
          manual.hidden = false;
          locker.querySelector<HTMLElement>('[data-locker-link]')!.hidden = false;
          errorEl.textContent = 'Mapa nie wczytała się. Wpisz kod Paczkomatu ręcznie (znajdziesz go na mapie InPost).';
          return;
        }
        new F.Map({
          ...(mapKey ? { apiKey: mapKey } : {}),
          courierServices: ['inpost'],
          courierServicesFilter: ['inpost'],
          city: String(new FormData(form).get('city') || ''),
          zoom: 14,
          callback: (params: any) => {
            if (!params?.point?.code) return;
            errorEl.textContent = '';
            codeInput.value = params.point.code;
            nameInput.value = params.point.name || '';
            locker.querySelector('[data-locker-label]')!.textContent = `Paczkomat ${params.point.code}`;
            locker.querySelector('[data-locker-name]')!.textContent = params.point.name || '';
            locker.querySelector('[data-map-open]')!.textContent = 'Zmień Paczkomat';
          },
        }).show();
      });
    }

    const error = errorEl;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      error.textContent = '';
      const fd = new FormData(form);
      const val = (k: string) => String(fd.get(k) ?? '');
      if (!fd.get('terms')) { error.textContent = 'Zaakceptuj regulamin, aby złożyć zamówienie.'; return; }

      // GA4 events
      const list: any[] = (window as any).__CANC_CATALOG__ || [];
      const gaItems = items.flatMap((it: any) => {
        const cp = list.find((x: any) => x.slug === it.slug);
        return (cp && cp.price !== null) ? [{ item_id: it.slug, item_name: cp.name, price: cp.price, quantity: it.qty, item_brand: 'Can-C' }] : [];
      });
      const gaValue = gaItems.reduce((s: number, i: any) => s + i.price * i.quantity, 0);
      const gaCode = (window as any).__cancCode?.() || undefined;
      trackFormSubmit('checkout_form');
      // item_variant = rozmiar/pakiet z pola subtitle katalogu
      const gaItemsWithVariant = gaItems.map((it: any) => {
        const cp = (window as any).__CANC_CATALOG__?.find((x: any) => x.slug === it.item_id);
        return cp?.size ? { ...it, item_variant: cp.size } : it;
      });
      trackBeginCheckout(gaItemsWithVariant, gaValue, gaCode);
      trackAddShippingInfo(gaItemsWithVariant, gaValue, val('shippingMethod') === 'inpost_locker' ? 'InPost Paczkomat' : 'Kurier DPD');
      trackAddPaymentInfo(gaItemsWithVariant, gaValue, val('paymentMethod') === 'bank_transfer' ? 'Przelew bankowy' : 'Przelewy24');

      const paymentMethod = val('paymentMethod') === 'bank_transfer' ? BANK_PROVIDER : 'p24';
      submit.disabled = true;
      submit.textContent = paymentMethod === BANK_PROVIDER ? 'Składanie zamówienia…' : 'Przekierowanie do płatności…';
      try {
        const res = await fetch('/api/zamowienie', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            items,
            email: val('email'), phone: val('phone'), firstName: val('firstName'), lastName: val('lastName'),
            shippingMethod: val('shippingMethod'), locker: val('locker'), lockerName: val('lockerName'),
            street: val('street'), postcode: val('postcode'), city: val('city'),
            invoice: fd.get('invoice') !== null,
            company: val('company'), nip: val('nip'), invStreet: val('invStreet'), invPostcode: val('invPostcode'), invCity: val('invCity'),
            note: val('note'), terms: true, marketing: fd.get('marketing') !== null, website: val('website'),
            discountCode: (window as any).__cancCode?.() || '',
            paymentMethod,
          }),
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok) {
          // GA4 form_field_error - próbujemy wykryć pole z błędu (uproszczone)
          const errMsg: string = data.error || '';
          const fieldHint = errMsg.toLowerCase().includes('email') ? 'email'
            : errMsg.toLowerCase().includes('telefon') ? 'phone'
            : errMsg.toLowerCase().includes('nip') ? 'nip'
            : errMsg.toLowerCase().includes('kod pocztowy') ? 'postal_code'
            : errMsg.toLowerCase().includes('paczkomat') ? 'locker_id'
            : 'unknown';
          trackFormFieldError('checkout_form', fieldHint, errMsg.slice(0, 100));
          throw new Error(errMsg || 'Nie udało się złożyć zamówienia. Spróbuj ponownie.');
        }
        if (paymentMethod === BANK_PROVIDER) {
          // Przelew bankowy: bez przekierowania do P24 → prosto na stronę podziękowania
          location.href = `/zamowienie/dziekujemy/?id=${encodeURIComponent(data.id)}`;
        } else {
          if (!data.redirect) throw new Error(data.error || 'Nie udało się złożyć zamówienia. Spróbuj ponownie.');
          location.href = data.redirect;
        }
      } catch (err) {
        error.textContent = (err as Error).message;
        submit.disabled = false;
        submit.textContent = 'Zamawiam i płacę';
      }
    });
  }
  })();
</script>

