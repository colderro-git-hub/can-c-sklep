---
import Base from '../../layouts/Base.astro';
import { products } from '../../data/shop';

const catalog = products.map(({ slug, name, price, bundles, size }) => ({ slug, name, price, bundles: !!bundles, size }));
---
<Base title="Dostawa i płatność | Can-C" description="Złóż zamówienie w sklepie Can-C.">
  <section class="section checkout-wrap">
    <div class="container">
      <ol class="steps" aria-label="Etapy zamówienia">
        <li><a href="/koszyk/">1. Koszyk</a></li><li aria-current="step">2. Dostawa i płatność</li><li>3. Potwierdzenie</li>
      </ol>

      <div data-empty hidden class="empty">
        <h1>Koszyk jest pusty</h1>
        <a href="/#produkty" class="btn">Przejdź do produktów</a>
      </div>

      <form class="checkout" data-checkout novalidate hidden>
        <div class="checkout__main">
          <h1 class="title">Dostawa i płatność</h1>

          <fieldset class="box">
            <legend>1. Twoje dane</legend>
            <div class="grid2">
              <label class="field">E-mail<input class="input" type="email" name="email" autocomplete="email" required /></label>
              <label class="field">Telefon (do powiadomień o paczce)<input class="input" type="tel" name="phone" autocomplete="tel" inputmode="tel" required placeholder="np. 600 100 200" /></label>
              <label class="field">Imię<input class="input" type="text" name="firstName" autocomplete="given-name" required /></label>
              <label class="field">Nazwisko<input class="input" type="text" name="lastName" autocomplete="family-name" required /></label>
            </div>
          </fieldset>

          <fieldset class="box">
            <legend>2. Dostawa</legend>
            <label class="choice"><input type="radio" name="shippingMethod" value="inpost_locker" checked />
              <span class="choice__text"><span>InPost Paczkomat 24/7</span><span class="muted">Odbiór o dowolnej porze</span></span><span class="ok">0,00 zł</span></label>
            <label class="choice"><input type="radio" name="shippingMethod" value="dpd" />
              <span class="choice__text"><span>Kurier DPD</span><span class="muted">Dostawa pod wskazany adres</span></span><span class="ok">0,00 zł</span></label>

            <div class="sub" data-locker>
              <label class="field">Kod Paczkomatu<input class="input" type="text" name="locker" placeholder="np. WRO01M" autocapitalize="characters" maxlength="15" /></label>
              <a href="https://inpost.pl/znajdz-paczkomat" target="_blank" rel="noopener">Znajdź Paczkomat na mapie InPost</a>
            </div>
            <div class="sub grid3" data-address hidden>
              <label class="field">Ulica i numer<input class="input" type="text" name="street" autocomplete="street-address" /></label>
              <label class="field">Kod pocztowy<input class="input" type="text" name="postcode" autocomplete="postal-code" placeholder="00-000" maxlength="6" /></label>
              <label class="field">Miejscowość<input class="input" type="text" name="city" autocomplete="address-level2" /></label>
            </div>
          </fieldset>

          <fieldset class="box">
            <legend>3. Faktura i uwagi</legend>
            <label class="check"><input type="checkbox" name="invoice" data-invoice-toggle /> Chcę fakturę na firmę</label>
            <div class="sub grid2" data-invoice hidden>
              <label class="field">Nazwa firmy<input class="input" type="text" name="company" autocomplete="organization" /></label>
              <label class="field">NIP<input class="input" type="text" name="nip" inputmode="numeric" maxlength="13" /></label>
              <label class="field">Ulica i numer<input class="input" type="text" name="invStreet" /></label>
              <label class="field">Kod pocztowy<input class="input" type="text" name="invPostcode" placeholder="00-000" maxlength="6" /></label>
              <label class="field">Miejscowość<input class="input" type="text" name="invCity" /></label>
            </div>
            <label class="field">Uwagi do zamówienia (opcjonalnie)<textarea class="input textarea" name="note" rows="3" maxlength="500"></textarea></label>
          </fieldset>
          <label class="hp" aria-hidden="true">Strona www<input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
        </div>

        <aside class="summary">
          <h2>Podsumowanie</h2>
          <ul class="lines" data-lines></ul>
          <dl>
            <div><dt>Produkty</dt><dd data-subtotal></dd></div>
            <div><dt>Rabat za zestaw</dt><dd data-discount></dd></div>
            <div><dt>Dostawa</dt><dd class="ok">0,00 zł</dd></div>
            <div class="total"><dt>Razem</dt><dd data-total></dd></div>
          </dl>
          <label class="check small"><input type="checkbox" name="terms" required /> <span>Akceptuję <a href="/regulamin/" target="_blank">Regulamin</a> i zapoznałem się z <a href="/polityka-prywatnosci/" target="_blank">Polityką prywatności</a>.</span></label>
          <label class="check small"><input type="checkbox" name="marketing" /> <span>Chcę otrzymywać informacje o promocjach (opcjonalnie).</span></label>
          <button type="submit" class="btn btn--lg" data-submit>Zamawiam i płacę</button>
          <p class="error" role="alert" data-error></p>
          <p class="muted note">Płatność BLIK, przelewem lub kartą w serwisie Przelewy24. Nie przechowujemy danych kart.</p>
        </aside>
      </form>
    </div>
  </section>
</Base>

<script define:vars={{ catalog }}>
  window.__CANC_CATALOG__ = catalog;
</script>

<script>
  import { getCart } from '../../lib/cart';

  type P = { slug: string; name: string; price: number | null; bundles: boolean };
  const catalog: P[] = (window as any).__CANC_CATALOG__ ?? [];
  const pln = new Intl.NumberFormat('pl-PL', { style: 'currency', currency: 'PLN' });
  const rate = (q: number, b: boolean) => (!b ? 0 : q >= 4 ? 0.1 : q >= 2 ? 0.08 : 0);

  const form = document.querySelector<HTMLFormElement>('[data-checkout]')!;
  const items = getCart().filter((i) => catalog.some((p) => p.slug === i.slug && p.price !== null));

  if (!items.length) {
    document.querySelector<HTMLElement>('[data-empty]')!.hidden = false;
  } else {
    form.hidden = false;

    // Podgląd sumy (ostateczną kwotę liczy serwer)
    let subtotal = 0, discount = 0;
    const ul = form.querySelector('[data-lines]')!;
    for (const it of items) {
      const p = catalog.find((c) => c.slug === it.slug)!;
      const gross = (p.price ?? 0) * it.qty;
      const d = gross * rate(it.qty, p.bundles);
      subtotal += gross; discount += d;
      const li = document.createElement('li');
      li.innerHTML = '<span></span><span></span>';
      li.children[0].textContent = `${p.name} × ${it.qty}`;
      li.children[1].textContent = pln.format(gross - d);
      ul.append(li);
    }
    form.querySelector('[data-subtotal]')!.textContent = pln.format(subtotal);
    form.querySelector('[data-discount]')!.textContent = discount ? `−${pln.format(discount)}` : pln.format(0);
    form.querySelector('[data-total]')!.textContent = pln.format(subtotal - discount);

    // Pola zależne od wyboru
    const locker = form.querySelector<HTMLElement>('[data-locker]')!;
    const address = form.querySelector<HTMLElement>('[data-address]')!;
    form.querySelectorAll<HTMLInputElement>('input[name="shippingMethod"]').forEach((r) =>
      r.addEventListener('change', () => { locker.hidden = r.value !== 'inpost_locker'; address.hidden = r.value !== 'dpd'; }),
    );
    const invoice = form.querySelector<HTMLElement>('[data-invoice]')!;
    form.querySelector<HTMLInputElement>('[data-invoice-toggle]')!.addEventListener('change', (e) => {
      invoice.hidden = !(e.target as HTMLInputElement).checked;
    });

    const error = form.querySelector<HTMLElement>('[data-error]')!;
    const submit = form.querySelector<HTMLButtonElement>('[data-submit]')!;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      error.textContent = '';
      const fd = new FormData(form);
      const val = (k: string) => String(fd.get(k) ?? '');
      if (!fd.get('terms')) { error.textContent = 'Zaakceptuj regulamin, aby złożyć zamówienie.'; return; }

      submit.disabled = true;
      submit.textContent = 'Przekierowanie do płatności…';
      try {
        const res = await fetch('/api/zamowienie', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            items,
            email: val('email'), phone: val('phone'), firstName: val('firstName'), lastName: val('lastName'),
            shippingMethod: val('shippingMethod'), locker: val('locker'),
            street: val('street'), postcode: val('postcode'), city: val('city'),
            invoice: fd.get('invoice') !== null,
            company: val('company'), nip: val('nip'), invStreet: val('invStreet'), invPostcode: val('invPostcode'), invCity: val('invCity'),
            note: val('note'), terms: true, marketing: fd.get('marketing') !== null, website: val('website'),
          }),
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok || !data.redirect) throw new Error(data.error || 'Nie udało się złożyć zamówienia. Spróbuj ponownie.');
        location.href = data.redirect;
      } catch (err) {
        error.textContent = (err as Error).message;
        submit.disabled = false;
        submit.textContent = 'Zamawiam i płacę';
      }
    });
  }
</script>

<style>
  .checkout-wrap { background: var(--c-gray-100); padding-top: var(--s-3); }
  .steps { list-style: none; margin: 0 0 var(--s-3); padding: 0; display: flex; flex-wrap: wrap; gap: 8px 24px; font-size: var(--fs-small); color: var(--c-ink-70); }
  .steps [aria-current] { color: var(--c-ink); }
  .steps a { color: inherit; }
  .empty { display: flex; flex-direction: column; align-items: flex-start; gap: var(--s-2); }
  .empty[hidden], .checkout[hidden] { display: none; }
  .title { font-size: var(--fs-h3); margin-bottom: var(--s-1); }

  .checkout { display: flex; flex-wrap: wrap; gap: var(--s-3); align-items: flex-start; }
  .checkout__main { flex: 999 1 560px; min-width: 0; display: flex; flex-direction: column; gap: var(--s-2); }
  .box { margin: 0; border: 0; background: var(--c-white); padding: var(--s-3); display: flex; flex-direction: column; gap: 16px; }
  .box legend { float: left; width: 100%; font-size: var(--fs-h4); padding: 0 0 8px; }
  .grid2 { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 16px; }
  .grid3 { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 16px; }
  .sub { padding: var(--s-2); background: var(--c-tint); display: flex; flex-direction: column; gap: 12px; }
  .sub.grid2, .sub.grid3 { display: grid; }
  .sub[hidden] { display: none !important; }
  .choice { min-height: 72px; padding: 16px 24px; border-radius: var(--r-field); box-shadow: inset 0 0 0 1px var(--c-gray-300); display: flex; align-items: center; gap: 16px; cursor: pointer; }
  .choice:has(input:checked) { box-shadow: inset 0 0 0 1px var(--c-ink); }
  .choice input { width: 20px; height: 20px; margin: 0; accent-color: var(--c-ink); }
  .choice__text { flex: 1; display: flex; flex-direction: column; gap: 2px; font-size: 1.125rem; }
  .choice__text .muted { font-size: var(--fs-small); }
  .ok { color: var(--c-ok); }
  .check { display: flex; gap: 12px; align-items: flex-start; }
  .check input { width: 18px; height: 18px; margin: 3px 0 0; accent-color: var(--c-ink); flex-shrink: 0; }
  .small { font-size: var(--fs-small); line-height: 24px; color: rgba(1, 8, 15, 0.75); }
  .textarea { height: auto; padding: 12px 16px; resize: vertical; }
  .hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }

  .summary { flex: 1 1 340px; position: sticky; top: 90px; background: var(--c-white); padding: var(--s-3); display: flex; flex-direction: column; gap: var(--s-2); }
  .summary h2 { font-size: var(--fs-h4); font-weight: 400; }
  .lines { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 8px; }
  :global(.lines li) { display: flex; justify-content: space-between; gap: 12px; }
  .summary dl { margin: 0; display: flex; flex-direction: column; gap: 12px; padding-top: var(--s-2); border-top: 1px solid var(--c-ink-10); }
  .summary dl div { display: flex; justify-content: space-between; }
  .summary dd { margin: 0; }
  .summary .total { padding-top: 12px; border-top: 1px solid var(--c-ink-10); font-size: var(--fs-h4); }
  .summary .btn:disabled { opacity: 0.5; cursor: wait; }
  .error { color: #D32300; }
  .error:empty { display: none; }
  .note { font-size: 0.8125rem; }
</style>
