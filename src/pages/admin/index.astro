  .field { display: flex; flex-direction: column; gap: 6px; font-size: 12px; color: var(--ink-40); }
  .input { height: 44px; padding: 0 14px; border: 0; border-radius: var(--r-md); box-shadow: inset 0 0 0 1px var(--field); font: 400 14px var(--font); color: var(--ink-100); background: #fff; width: 100%; }
  .input:focus { outline: none; box-shadow: inset 0 0 0 1px var(--primary); background: rgba(233,236,248,.5); }
  .input.sm { height: 38px; width: 120px; }
  textarea.input { height: auto; padding: 10px 14px; resize: vertical; }
  .check { display: flex; gap: 10px; align-items: center; font-size: 13px; color: var(--ink-50); }
  .check input, .table input[type='checkbox'] { width: 18px; height: 18px; accent-color: var(--primary); }
  .drawer.drawer--wide { width: min(900px, calc(100vw - 24px)); }
  .thumb-sm { width: 48px; height: 48px; object-fit: cover; border-radius: var(--r-md); background: var(--line-soft); display: block; }
  .thumb-sm--empty { box-shadow: inset 0 0 0 1px var(--line); }
  .clickrow { cursor: pointer; }
  .clickrow:hover td { background: #FAFAFD; }
  .badge-inline { display: inline-block; padding: 2px 8px; border-radius: var(--r-pill); background: var(--amber-bg); color: var(--amber-ink); font-size: 11px; }
  .badge-inline--ok { background: var(--success-a12); color: var(--success-ink); }
  .stars-cell { color: #D9A100; letter-spacing: 1px; }
