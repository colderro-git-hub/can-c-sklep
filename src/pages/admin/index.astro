        catch (err) { toast((err as Error).message, true); }
      });
      body.querySelector<HTMLFormElement>('[data-cnote]')!.addEventListener('submit', async (ev) => {
        ev.preventDefault();
        try { await api('/api/admin/klienci', { id, note: new FormData(ev.target as HTMLFormElement).get('note') }); toast('Zapisano notatkę.'); loadCustomers(); }
        catch (err) { toast((err as Error).message, true); }
      });
      body.querySelector<HTMLFormElement>('[data-pcode]')!.addEventListener('submit', async (ev) => {
        ev.preventDefault();
        const fd = new FormData(ev.target as HTMLFormElement);
        try {
          const r = await api('/api/admin/kody', { action: 'personal', customer_id: id, type: fd.get('type'), value: fd.get('value'), days: fd.get('days'), min_total: fd.get('min_total'), message: fd.get('message'), notify: fd.get('notify') !== null });
          toast(`Utworzono kod ${r.code}${r.mailed ? ' i wysłano e-mail' : fd.get('notify') !== null ? ' (e-mail NIE został wysłany)' : ''}.`, fd.get('notify') !== null && !r.mailed);
          openCustomer(id, false);
        } catch (err) { toast((err as Error).message, true); }
      });
    } catch (e) { body.innerHTML = `<p class="err">${esc((e as Error).message)}</p>`; }
  }
  $('[data-c-search]').addEventListener('submit', (e) => { e.preventDefault(); cState.q = $<HTMLInputElement>('#cq').value.trim(); cState.page = 1; loadCustomers(); });
  let cTimer = 0;
  $<HTMLInputElement>('#cq').addEventListener('input', () => { clearTimeout(cTimer); cTimer = window.setTimeout(() => { cState.q = $<HTMLInputElement>('#cq').value.trim(); cState.page = 1; loadCustomers(); }, 400); });
  $<HTMLInputElement>('[data-c-buyers]').addEventListener('change', (e) => { cState.buyers = (e.target as HTMLInputElement).checked; cState.page = 1; loadCustomers(); });
  $<HTMLSelectElement>('[data-c-size]').addEventListener('change', (e) => { cState.size = Number((e.target as HTMLSelectElement).value); cState.page = 1; loadCustomers(); });
  document.querySelectorAll<HTMLElement>('[data-c-head] th[data-sort]').forEach((th) => {
    th.tabIndex = 0;
    const go = () => {
      const col = th.dataset.sort!;
      if (cState.sort === col) cState.dir = cState.dir === 'asc' ? 'desc' : 'asc';
      else { cState.sort = col; cState.dir = TEXT_COLS.has(col) ? 'asc' : 'desc'; }
      cState.page = 1; loadCustomers();
    };
    th.addEventListener('click', go);
    th.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); go(); } });
  });
  document.querySelectorAll<HTMLButtonElement>('[data-seg]').forEach((b) => b.addEventListener('click', () => {
    document.querySelectorAll('[data-seg]').forEach((x) => x.setAttribute('aria-pressed', 'false'));
    b.setAttribute('aria-pressed', 'true');
    cState.segment = b.dataset.seg || '';
    if (cState.segment === 'treatment') { cState.sort = 'last_active'; cState.dir = 'desc'; }
    cState.page = 1; loadCustomers();
  }));
  $('[data-c-prev]').addEventListener('click', () => { cState.page--; loadCustomers(); });
  $('[data-c-next]').addEventListener('click', () => { cState.page++; loadCustomers(); });
  const cRowOpen = (e: Event) => { const t = e.target as HTMLElement; if (t.closest('[data-stop]')) return; const tr = t.closest('tr[data-cid]') as HTMLElement | null; if (tr) openCustomer(tr.dataset.cid!); };
  $('[data-c-rows]').addEventListener('click', cRowOpen);
  $('[data-c-rows]').addEventListener('keydown', (e) => { if ((e as KeyboardEvent).key === 'Enter') cRowOpen(e); });

  // ---------- Przejścia między widokami ----------
  function switchTab(tab: string) { (document.querySelector(`[data-tab="${tab}"]`) as HTMLButtonElement)?.click(); }
  function bindLinks(root: HTMLElement) {
    root.querySelectorAll<HTMLButtonElement>('[data-open-customer]').forEach((b) => b.addEventListener('click', () => openCustomer(b.dataset.openCustomer!)));
    root.querySelectorAll<HTMLButtonElement>('[data-open-product]').forEach((b) => b.addEventListener('click', () => openProduct(b.dataset.openProduct!)));
  }

  // ---------- Nowe zamówienie (ręcznie) ----------
  let productCache: any[] = [];
  async function openNewOrder() {
    $('[data-drawer]').classList.toggle('drawer--wide', false);
    openDrawer(true); drawerNav(openNewOrder, false);
    $('[data-d-title]').textContent = 'Nowe zamówienie';
    const body = $('[data-d-body]');
    body.innerHTML = '<p class="muted">Ładowanie…</p>';
    try { productCache = (await api('/api/admin/products')).rows.filter((p: any) => p.active && p.price !== null); }
    catch (e) { body.innerHTML = `<p class="err">${esc((e as Error).message)}</p>`; return; }
    const opts = productCache.map((p) => `<option value="${esc(p.id)}">${esc(p.name)} – ${pln(p.price)}</option>`).join('');
    body.innerHTML = `
      <form class="sec" data-no>
        <div class="sec"><h3 class="sec__t">Klient</h3>
          <label class="field">Szukaj istniejącego klienta<input class="input" data-no-find placeholder="imię, e-mail, telefon" autocomplete="off" /></label>
          <ul class="items picks" data-no-picks></ul>
          <div class="row2"><label class="field">Imię<input class="input" name="firstName" required /></label><label class="field">Nazwisko<input class="input" name="lastName" required /></label></div>
          <div class="row2"><label class="field">E-mail<input class="input" name="email" type="email" required /></label><label class="field">Telefon<input class="input" name="phone" /></label></div>
        </div>
        <div class="sec"><h3 class="sec__t">Produkty</h3>
          <div data-no-lines></div>
          <button type="button" class="btn btn--outline btn--sm" data-no-add>+ Dodaj produkt</button>
        </div>
        <div class="sec"><h3 class="sec__t">Dostawa</h3>
          <label class="field">Sposób<select class="input" name="shippingMethod" data-no-method><option value="inpost_locker">InPost Paczkomat</option><option value="dpd">Kurier DPD</option></select></label>
          <label class="field" data-no-locker>Kod Paczkomatu<input class="input" name="locker" /></label>
          <div data-no-addr hidden><label class="field">Ulica i numer<input class="input" name="street" /></label>
            <div class="row2"><label class="field">Kod pocztowy<input class="input" name="postcode" placeholder="00-000" /></label><label class="field">Miejscowość<input class="input" name="city" /></label></div></div>
        </div>
        <details class="sec manual"><summary>Faktura na firmę</summary>
          <label class="check"><input type="checkbox" name="invoice" /> Wystaw fakturę</label>
          <div class="row2"><label class="field">Firma<input class="input" name="company" /></label><label class="field">NIP<input class="input" name="nip" /></label></div>
          <label class="field">Adres firmy<input class="input" name="invStreet" /></label>
          <div class="row2"><label class="field">Kod<input class="input" name="invPostcode" /></label><label class="field">Miejscowość<input class="input" name="invCity" /></label></div>
        </details>
        <div class="sec"><h3 class="sec__t">Płatność</h3>
          <label class="check"><input type="radio" name="payment" value="link" checked /> Wyślij klientowi link do płatności (BLIK, przelew, karta) – ważny 7 dni</label>
          <label class="check"><input type="radio" name="payment" value="paid" /> Opłacone poza sklepem (przelew, gotówka)</label>
          <label class="field" data-no-pnote hidden>Jak zapłacono<input class="input" name="paymentNote" placeholder="np. przelew 12.11" /></label>
          <label class="check"><input type="radio" name="payment" value="pending" /> Czeka na płatność (bez wysyłania linku)</label>
          <label class="field">Dodatkowy rabat (zł)<input class="input" name="extraDiscount" inputmode="decimal" placeholder="0" /></label>
          <label class="field">Uwagi<textarea class="input" name="note" rows="2" maxlength="500"></textarea></label>
          <label class="check"><input type="checkbox" name="notify" checked /> Wyślij klientowi e-mail (link do płatności albo potwierdzenie)</label>
        </div>
        <ul class="items"><li><span>Produkty</span><span data-no-sub></span></li><li><span>Rabaty</span><span data-no-disc></span></li><li class="sum"><span>Razem</span><span data-no-total></span></li></ul>
        <div class="actions"><button class="btn">Utwórz zamówienie</button></div>
      </form>`;
    const f = body.querySelector<HTMLFormElement>('[data-no]')!;
    const linesEl = f.querySelector<HTMLElement>('[data-no-lines]')!;
    const addLine = (slug = productCache[0]?.id, qty = 1) => {
      const row = document.createElement('div'); row.className = 'row3';
      row.innerHTML = `<select class="input" data-l-slug>${opts}</select><input class="input" data-l-qty type="number" min="1" max="100" value="${qty}" aria-label="Ilość" /><button type="button" class="icon-btn" data-l-del aria-label="Usuń"><svg viewBox="0 0 24 24"><path d="M6 6l12 12M18 6 6 18" /></svg></button>`;
      (row.querySelector('[data-l-slug]') as HTMLSelectElement).value = slug;
      row.querySelector('[data-l-del]')!.addEventListener('click', () => { row.remove(); recalc(); });
      row.querySelectorAll('select,input').forEach((el) => el.addEventListener('input', recalc));
      linesEl.append(row); recalc();
    };
    const items = () => [...linesEl.querySelectorAll('.row3')].map((r) => ({ slug: (r.querySelector('[data-l-slug]') as HTMLSelectElement).value, qty: Number((r.querySelector('[data-l-qty]') as HTMLInputElement).value) || 0 })).filter((i) => i.qty > 0);
    function recalc() {
      const per: Record<string, number> = {};
      for (const i of items()) per[i.slug] = (per[i.slug] || 0) + i.qty;
      let sub = 0, disc = 0;
      for (const [slug, qty] of Object.entries(per)) {
        const p = productCache.find((x) => x.id === slug); if (!p) continue;
        const gross = p.price * qty; sub += gross;
        disc += Math.round(gross * (!p.bundles ? 0 : qty >= 4 ? 0.1 : qty >= 2 ? 0.08 : 0));
      }
      const extra = Math.round(Number(String((f.elements.namedItem('extraDiscount') as HTMLInputElement).value || 0).replace(',', '.')) * 100) || 0;
      f.querySelector('[data-no-sub]')!.textContent = pln(sub);
      f.querySelector('[data-no-disc]')!.textContent = disc + extra ? `−${pln(disc + extra)}` : pln(0);
      f.querySelector('[data-no-total]')!.textContent = pln(Math.max(0, sub - disc - extra));
    }
    f.querySelector('[data-no-add]')!.addEventListener('click', () => addLine());
    (f.elements.namedItem('extraDiscount') as HTMLInputElement).addEventListener('input', recalc);
    addLine();
    const syncShip = () => { const dpd = (f.elements.namedItem('shippingMethod') as HTMLSelectElement).value === 'dpd'; (f.querySelector('[data-no-locker]') as HTMLElement).hidden = dpd; (f.querySelector('[data-no-addr]') as HTMLElement).hidden = !dpd; };
    f.querySelector('[data-no-method]')!.addEventListener('change', syncShip);
    f.querySelectorAll<HTMLInputElement>('input[name="payment"]').forEach((r) => r.addEventListener('change', () => { (f.querySelector('[data-no-pnote]') as HTMLElement).hidden = r.value !== 'paid' || !r.checked; }));
    // Wyszukiwanie klienta
    let t = 0;
    const picks = f.querySelector<HTMLElement>('[data-no-picks]')!;
    f.querySelector<HTMLInputElement>('[data-no-find]')!.addEventListener('input', (e) => {
      clearTimeout(t);
      const q = (e.target as HTMLInputElement).value.trim();
      if (q.length < 2) { picks.innerHTML = ''; return; }
      t = window.setTimeout(async () => {
        try {
          const d = await api(`/api/admin/klienci?q=${encodeURIComponent(q)}&size=50&sort=last_active`);
          picks.innerHTML = d.rows.slice(0, 6).map((c: any) => `<li class="clickable" data-pick='${esc(JSON.stringify(c.id))}'><span><strong>${esc(c.full_name || '—')}</strong><br><span class="muted">${esc(c.email)}${c.phone ? ` · ${esc(c.phone)}` : ''}</span></span><span>${c.orders_count} zam.</span></li>`).join('') || '<li class="muted">Brak – wpisz dane nowego klienta poniżej.</li>';
          picks.querySelectorAll<HTMLElement>('[data-pick]').forEach((li) => li.addEventListener('click', async () => {
            const { customer: c } = await api(`/api/admin/klienci?id=${JSON.parse(li.dataset.pick!)}`);
            const set = (n: string, v: unknown) => { const el = f.elements.namedItem(n) as HTMLInputElement | null; if (el) el.value = String(v ?? ''); };
            set('firstName', c.first_name); set('lastName', c.last_name); set('email', c.email); set('phone', c.phone); set('locker', c.default_locker);
            set('street', c.default_address?.street); set('postcode', c.default_address?.postcode); set('city', c.default_address?.city);
            if (c.billing?.nip) { (f.elements.namedItem('invoice') as HTMLInputElement).checked = true; set('company', c.billing.company); set('nip', c.billing.nip); set('invStreet', c.billing.street); set('invPostcode', c.billing.postcode); set('invCity', c.billing.city); }
            if (!c.default_locker && c.default_address?.street) { (f.elements.namedItem('shippingMethod') as HTMLSelectElement).value = 'dpd'; syncShip(); }
            picks.innerHTML = `<li class="muted">Wybrano: ${esc(c.full_name || c.email)}</li>`;
          }));
        } catch { /* bez podpowiedzi */ }
      }, 300);
    });
    f.addEventListener('submit', async (e) => {
      e.preventDefault();
      const fd = new FormData(f);
      const p: Record<string, unknown> = Object.fromEntries([...fd.entries()].map(([k, v]) => [k, String(v)]));
      p.items = items(); p.invoice = fd.get('invoice') !== null; p.notify = fd.get('notify') !== null;
      const btn = f.querySelector<HTMLButtonElement>('button:not([type])')!; btn.disabled = true;
      try {
        const r = await api('/api/admin/order-create', p);
        toast(`Utworzono zamówienie ${r.number}${r.mailed ? ' i wysłano e-mail' : ''}.`);
        loadOrders();
        await openOrder(r.id, false);
        if (r.paymentUrl) {
          const box = document.createElement('div'); box.className = 'box box--blue';
          box.innerHTML = `<strong>Link do płatności</strong><input class="input" readonly value="${esc(r.paymentUrl)}" /><div class="actions"><button type="button" class="btn btn--sm" data-copy>Kopiuj link</button></div>`;
          box.querySelector('[data-copy]')!.addEventListener('click', () => navigator.clipboard.writeText(r.paymentUrl).then(() => toast('Skopiowano link.')));
          $('[data-d-body]').prepend(box);
        }
      } catch (err) { toast((err as Error).message, true); btn.disabled = false; }
    });
  }
  $('[data-new-order]').addEventListener('click', openNewOrder);

  // ---------- Automaty ----------
  const autoForm = $<HTMLFormElement>('[data-auto-form]');
  async function loadAutomations() {
    try {
      const d = await api('/api/admin/automaty');
      for (const [k, v] of Object.entries(d.settings)) { const el = autoForm.elements.namedItem(k) as HTMLInputElement | null; if (!el) continue; if (el.type === 'checkbox') el.checked = Boolean(v); else el.value = String(v); }
      const st = $('[data-auto-state]');
      st.textContent = d.settings.enabled ? 'Włączony' : 'Wyłączony';
      st.className = `st ${d.settings.enabled ? 'st--shipped' : 'st--pending_payment'}`;
      const warn = $('[data-auto-warn]');
      warn.hidden = d.cronReady;
      warn.textContent = 'Brak sekretu CRON_SECRET w Workerze – automat i linki „wypisz się” nie zadziałają. Instrukcja w opisie wdrożenia.';
      $('[data-auto-count]').textContent = `(${d.total})`;
      const pct = d.settings.regularCodePercent;
      $('[data-auto-list]').innerHTML = d.candidates.length ? d.candidates.map((c: any) => `<tr><td><button type="button" class="link" data-open-customer="${c.id}">${esc(c.first_name || '—')}</button></td><td>${esc(c.email)}</td><td class="r">${c.orders_count}</td><td class="r">${c.last_order_packs}</td><td>${dnum(c.treatment_end_at)}</td><td>${pct && c.orders_count >= 2 ? `−${pct}%` : '—'}</td></tr>`).join('') : '<tr><td colspan="6" class="empty">Dziś nikt nie spełnia warunków.</td></tr>';
      $('[data-auto-hist]').innerHTML = d.history.length ? d.history.map((h: any) => `<tr><td>${date(h.sent_at)}</td><td>${esc([h.customers?.first_name, h.customers?.last_name].filter(Boolean).join(' ') || h.customers?.email || '')}</td><td>${esc(h.code || '—')}</td></tr>`).join('') : '<tr><td colspan="3" class="empty">Jeszcze nic nie wysłano.</td></tr>';
      bindLinks($('[data-auto-list]').closest('table') as HTMLElement);
    } catch (e) { toast((e as Error).message, true); }
  }
  autoForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    const fd = new FormData(autoForm);
    const p: Record<string, unknown> = Object.fromEntries([...fd.entries()].map(([k, v]) => [k, String(v)]));
    p.enabled = fd.get('enabled') !== null;
    try { await api('/api/admin/automaty', { action: 'save', ...p }); toast('Zapisano.'); loadAutomations(); } catch (err) { toast((err as Error).message, true); }
  });
  $('[data-auto-run]').addEventListener('click', async () => {
    if (!confirm('Wysłać przypomnienia teraz do osób z listy?')) return;
    try { const r = await api('/api/admin/automaty', { action: 'run' }); toast(`Wysłano ${r.sent} z ${r.candidates}${r.errors ? ` (błędy: ${r.errors})` : ''}.`, Boolean(r.errors)); loadAutomations(); }
    catch (err) { toast((err as Error).message, true); }
  });

  // ---------- Ustawienia sklepu ----------
  const settingsForm = $<HTMLFormElement>('[data-settings-form]');
  async function loadSettings() {
    try {
      const { site, robots } = await api('/api/admin/ustawienia');
      if (robots) fillRobots(robots);
      const local = (iso: string) => { if (!iso) return ''; const d = new Date(iso); return new Date(d.getTime() - d.getTimezoneOffset() * 60000).toISOString().slice(0, 16); };
      for (const [k, v] of Object.entries(site)) {
        const el = settingsForm.elements.namedItem(k) as HTMLInputElement | null;
        if (!el) continue;
        if (el.type === 'checkbox') el.checked = v === 'true';
        else if (el.type === 'datetime-local') el.value = local(String(v || ''));
        else el.value = String(v ?? '');
      }
      const st = $('[data-notice-state]');
      st.textContent = site.noticeActive ? 'Widoczny teraz' : 'Niewidoczny';
      st.className = `st ${site.noticeActive ? 'st--on_hold' : 'st--pending_payment'}`;
    } catch (e) { toast((e as Error).message, true); }
  }
  // robots.txt
  const robotsForm = $<HTMLFormElement>('[data-robots-form]');
  const robotsText = $<HTMLTextAreaElement>('[data-robots-text]');
  let robotsDefault = '';
  const robotsWarn = () => {
    // Ostrzeżenie: „Disallow: /” (cała strona) w grupie dla wszystkich robotów
    const lines = robotsText.value.split('\n').map((l) => l.replace(/#.*/, '').trim().toLowerCase());
    let all = false, blocked = false;
    for (const l of lines) {
      if (l.startsWith('user-agent:')) all = l.replace('user-agent:', '').trim() === '*';
      else if (all && /^disallow:\s*\/\s*$/.test(l)) blocked = true;
    }
    $('[data-robots-warn]').hidden = !blocked;
  };
  const fillRobots = (r: any) => {
    robotsDefault = r.default; robotsText.value = r.text; robotsText.placeholder = r.default;
    $('[data-robots-preview]').textContent = r.preview; robotsWarn();
  };
  robotsText.addEventListener('input', robotsWarn);
  $('[data-robots-default]').addEventListener('click', () => { robotsText.value = robotsDefault; robotsWarn(); });
  robotsForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    try { const r = await api('/api/admin/ustawienia', { action: 'robots', text: robotsText.value }); fillRobots(r.robots); toast('Zapisano robots.txt. Google pobierze go przy najbliższej wizycie.'); }
    catch (err) { toast((err as Error).message, true); }
  });

  settingsForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    const fd = new FormData(settingsForm);
    const body: Record<string, unknown> = Object.fromEntries([...fd.entries()].map(([k, v]) => [k, String(v)]));
    body.noticeEnabled = fd.get('noticeEnabled') !== null;
    for (const k of ['noticeFrom', 'noticeTo']) if (body[k]) body[k] = new Date(String(body[k])).toISOString();
    try { await api('/api/admin/ustawienia', body); toast('Zapisano ustawienia.'); loadSettings(); }
    catch (err) { toast((err as Error).message, true); }
  });

  // ---------- Zdarzenia interfejsu ----------
  const TITLES: Record<string, string> = { reviews: 'Opinie', automations: 'Automaty', orders: 'Zamówienia', customers: 'Klienci', products: 'Produkty', codes: 'Kody rabatowe', settings: 'Ustawienia sklepu' };
  document.querySelectorAll<HTMLButtonElement>('[data-tab]').forEach((b) => b.addEventListener('click', () => {
    document.querySelectorAll('[data-tab]').forEach((x) => x.removeAttribute('aria-current'));
    b.setAttribute('aria-current', 'page');
    document.querySelectorAll<HTMLElement>('[data-view]').forEach((v) => (v.hidden = v.dataset.view !== b.dataset.tab));
    $('[data-title]').textContent = TITLES[b.dataset.tab!]; $('[data-crumb]').textContent = TITLES[b.dataset.tab!];
    if (b.dataset.tab === 'products') loadProducts();
    if (b.dataset.tab === 'codes') loadCodes();
    if (b.dataset.tab === 'customers') loadCustomers();
    if (b.dataset.tab === 'automations') loadAutomations();
    if (b.dataset.tab === 'reviews') loadReviews();
    if (b.dataset.tab === 'settings') loadSettings();
  }));
  document.querySelectorAll<HTMLButtonElement>('[data-status]').forEach((b) => b.addEventListener('click', () => {
    document.querySelectorAll('[data-status]').forEach((x) => x.setAttribute('aria-pressed', 'false'));
    b.setAttribute('aria-pressed', 'true');
    state.status = b.dataset.status || ''; state.page = 1; loadOrders();
  }));
  $('[data-search]').addEventListener('submit', (e) => {
    e.preventDefault();
    state.q = $<HTMLInputElement>('#q').value.trim(); state.page = 1;
    if (state.q) { state.status = ''; document.querySelectorAll('[data-status]').forEach((x) => x.setAttribute('aria-pressed', String((x as HTMLElement).dataset.status === ''))); }
    loadOrders();
  });
  $('[data-prev]').addEventListener('click', () => { state.page--; loadOrders(); });
  $('[data-next]').addEventListener('click', () => { state.page++; loadOrders(); });
  const rowOpen = (e: Event) => {
    const t = e.target as HTMLElement;
    if (t.closest('[data-stop]')) return;
    const tr = t.closest('tr[data-id]') as HTMLElement | null;
    if (tr) openOrder(tr.dataset.id!);
  };
  $('[data-rows]').addEventListener('click', rowOpen);
  $('[data-rows]').addEventListener('keydown', (e) => { if ((e as KeyboardEvent).key === 'Enter') rowOpen(e); });
  $('[data-close]').addEventListener('click', () => openDrawer(false));
  $('[data-back]').addEventListener('click', () => { const prev = dHistory.pop(); if (prev) { dCurrent = null; prev(); $('[data-back]').hidden = dHistory.length === 0; } });
  $('[data-scrim]').addEventListener('click', () => openDrawer(false));
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') openDrawer(false); });

  loadOrders();
</script>
