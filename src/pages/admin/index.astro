  tr.flash td { background: var(--primary-a16) !important; transition: background .3s; }
  .c-tools { display: flex; flex-wrap: wrap; align-items: flex-end; gap: 12px 20px; }
  .search--wide { flex: 1 1 360px; }
  .search--wide input { width: 100%; }
  .field--inline { flex-direction: row; align-items: center; gap: 8px; }
  .field--inline .input.sm { width: auto; }
  .table tr[data-cid] { cursor: pointer; }
