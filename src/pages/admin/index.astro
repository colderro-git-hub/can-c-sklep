    const f = body.querySelector<HTMLFormElement>('[data-pe]')!;
    const imgsEl = f.querySelector<HTMLElement>('[data-imgs]')!;
    const renderImgs = () => {
      imgsEl.innerHTML = images.map((im, i) => `
        <div class="img-item">
          <img src="${esc(im.url)}" alt="" />
          <input class="input sm" data-alt="${i}" value="${esc(im.alt)}" placeholder="opis zdjęcia (alt)" />
          <div class="img-item__btns">
            <button type="button" class="icon-btn" data-up="${i}" aria-label="W górę" ${i === 0 ? 'disabled' : ''}><svg viewBox="0 0 24 24"><path d="m6 14 6-6 6 6" /></svg></button>
            <button type="button" class="icon-btn" data-down="${i}" aria-label="W dół" ${i === images.length - 1 ? 'disabled' : ''}><svg viewBox="0 0 24 24"><path d="m6 10 6 6 6-6" /></svg></button>
            <button type="button" class="icon-btn" data-del="${i}" aria-label="Usuń"><svg viewBox="0 0 24 24"><path d="M6 6l12 12M18 6 6 18" /></svg></button>
          </div>
          <button type="button" class="btn btn--outline btn--sm" data-nobg="${i}" title="Zamienia białe tło na przezroczyste - zdjęcie dobrze wygląda w trybie ciemnym">Usuń białe tło</button>
          ${i === 0 ? '<span class="badge-inline">główne</span>' : ''}
        </div>`).join('') || '<p class="muted">Brak zdjęć.</p>';
      imgsEl.querySelectorAll<HTMLInputElement>('[data-alt]').forEach((el) => el.addEventListener('input', () => { images[Number(el.dataset.alt)].alt = el.value; }));
      imgsEl.querySelectorAll<HTMLButtonElement>('[data-up]').forEach((b) => b.addEventListener('click', () => { const i = Number(b.dataset.up); [images[i - 1], images[i]] = [images[i], images[i - 1]]; renderImgs(); }));
      imgsEl.querySelectorAll<HTMLButtonElement>('[data-down]').forEach((b) => b.addEventListener('click', () => { const i = Number(b.dataset.down); [images[i + 1], images[i]] = [images[i], images[i + 1]]; renderImgs(); }));
      imgsEl.querySelectorAll<HTMLButtonElement>('[data-del]').forEach((b) => b.addEventListener('click', () => { images.splice(Number(b.dataset.del), 1); renderImgs(); }));
      imgsEl.querySelectorAll<HTMLButtonElement>('[data-nobg]').forEach((b) => b.addEventListener('click', () => removeBg([Number(b.dataset.nobg)])));
    };
    // Nowa wersja zdjęcia trafia do Storage obok starej; w produkcie podmieniamy adres (stary plik zostaje - można wrócić)
    const removeBg = async (idx: number[]) => {
      const slug = (f.elements.namedItem('id') as HTMLInputElement).value || 'produkt';
      let ok = 0;
      for (const i of idx) {
        try {
          toast(`Usuwanie tła ze zdjęcia ${i + 1}…`);
          const fd = new FormData(); fd.append('file', fileFrom(await removeLightBackground(images[i].url))); fd.append('product', slug);
          const r = await fetch('/api/admin/upload', { method: 'POST', body: fd });
          const d = await r.json().catch(() => ({}));
          if (!r.ok) throw new Error(d.error || 'Błąd wysyłania zdjęcia.');
          images[i] = { ...images[i], url: d.url }; ok++;
          renderImgs();
        } catch (err) { toast(`Zdjęcie ${i + 1}: ${(err as Error).message}`, true); }
      }
      if (ok) toast(`Gotowe (${ok}). Sprawdź podgląd i zapisz produkt.`);
    };
    f.querySelector('[data-nobg-all]')?.addEventListener('click', () => removeBg(images.map((_, i) => i)));
    renderImgs();
    f.querySelector<HTMLInputElement>('[data-upload]')!.addEventListener('change', async (e) => {
      const files = [...((e.target as HTMLInputElement).files || [])];
      const slug = (f.elements.namedItem('id') as HTMLInputElement).value || 'produkt';
      for (const file of files) {
        try {
          toast(`Wysyłanie ${file.name}…`);
          const fd = new FormData(); fd.append('file', fileFrom(await shrink(file))); fd.append('product', slug);
          const res = await fetch('/api/admin/upload', { method: 'POST', body: fd });
          const d = await res.json().catch(() => ({}));
          if (!res.ok) throw new Error(d.error || 'Błąd wysyłania zdjęcia.');
          images.push({ url: d.url, alt: (f.elements.namedItem('name') as HTMLInputElement).value });
          renderImgs();
        } catch (err) { toast((err as Error).message, true); }
      }
      toast('Zdjęcia dodane - pamiętaj o zapisaniu produktu.');
      (e.target as HTMLInputElement).value = '';
    });

    // Liczniki SEO i podgląd w Google
    const seo = () => {
      const t = (f.elements.namedItem('seo_title') as HTMLInputElement).value || `${(f.elements.namedItem('name') as HTMLInputElement).value} | Can-C`;
      const d = (f.elements.namedItem('seo_description') as HTMLTextAreaElement).value || (f.elements.namedItem('short_description') as HTMLTextAreaElement).value;
      f.querySelector('[data-serp-t]')!.textContent = t; f.querySelector('[data-serp-d]')!.textContent = d;
      const c1 = f.querySelector('[data-cnt="seo_title"]')!, c2 = f.querySelector('[data-cnt="seo_description"]')!;
      const l1 = (f.elements.namedItem('seo_title') as HTMLInputElement).value.length, l2 = (f.elements.namedItem('seo_description') as HTMLTextAreaElement).value.length;
      c1.textContent = `${l1}/60`; c1.classList.toggle('err', l1 > 60); c2.textContent = `${l2}/155`; c2.classList.toggle('err', l2 > 155);
    };
    ['seo_title', 'seo_description', 'name', 'short_description'].forEach((n) => (f.elements.namedItem(n) as HTMLElement).addEventListener('input', seo));
    seo();

    f.querySelector('[data-dup]')?.addEventListener('click', async () => {
      try { const r = await api('/api/admin/products', { action: 'duplicate', id: p.id }); toast('Utworzono kopię (ukrytą).'); loadProducts(); openProduct(r.id); }
      catch (err) { toast((err as Error).message, true); }
    });
    f.addEventListener('submit', async (e) => {
      e.preventDefault();
      const fd = new FormData(f);
      const v = (n: string) => String(fd.get(n) ?? '');
      const toIso = (x: string) => (x ? new Date(x).toISOString() : '');
      const payload = {
        action: 'save', isNew: !id, id: v('id'), name: v('name'), subtitle: v('subtitle'), active: fd.get('active') !== null, tags: v('tags'), sort_order: v('sort_order'),
        price: v('price'), vat_rate: Number(v('vat_rate')), bundles: fd.get('bundles') !== null, sale_price: v('sale_price'), sale_start: toIso(v('sale_start')), sale_end: toIso(v('sale_end')),
        unit_value: v('unit_value'), unit_measure: v('unit_measure'), short_description: v('short_description'), highlights: v('highlights').split('\n'), description: v('description'),
        how_to_use: v('how_to_use'), lead_time: v('lead_time'),
        seo_title: v('seo_title'), seo_description: v('seo_description'), stock: Number(v('stock')), low_stock_alert: v('low_stock_alert'), weight_g: v('weight_g'), availability: v('availability'),
        ean: v('ean'), mpn: v('mpn'), brand: v('brand'), condition: v('condition'), google_category: v('google_category'),
        related_ids: fd.getAll('related').map(String), images,
      };
      try { const r = await api('/api/admin/products', payload); toast(r.notified ? `Zapisano produkt i wysłano ${r.notified} powiadomień o dostępności.` : 'Zapisano produkt.'); loadProducts(); openProduct(r.id, false); }
      catch (err) { toast((err as Error).message, true); }
    });
  }
  $('[data-new-product]').addEventListener('click', () => openProduct(null));

  // ---------- Opinie ----------
  let rStatus = 'pending';
  const starsTxt = (n: number) => '★★★★★'.slice(0, n) + '☆☆☆☆☆'.slice(0, 5 - n);
  const RST: Record<string, string> = { pending: 'Do moderacji', approved: 'Opublikowana', rejected: 'Odrzucona' };
  async function loadReviews() {
    const tbody = $('[data-reviews]');
    tbody.innerHTML = '<tr><td colspan="7" class="empty">Ładowanie…</td></tr>';
    try {
      const d = await api(`/api/admin/opinie?status=${rStatus}`);
      $('[data-rcount]').textContent = d.pending ? String(d.pending) : '';
      $('[data-count-reviews]').textContent = d.pending ? String(d.pending) : '';
      tbody.innerHTML = d.rows.length ? d.rows.map((r: any) => `
        <tr data-rid="${r.id}" class="clickrow">
          <td class="nowrap">${dnum(r.created_at)}</td>
          <td>${esc(r.products?.name || r.product_id)}</td>
          <td>${esc(r.author_name)}${r.verified_purchase ? '<br><span class="badge-inline badge-inline--ok">zakup</span>' : ''}</td>
          <td class="nowrap stars-cell">${starsTxt(r.rating)}</td>
          <td>${r.title ? `<strong>${esc(r.title)}</strong><br>` : ''}<span class="muted">${esc(r.body.slice(0, 140))}${r.body.length > 140 ? '…' : ''}</span></td>
          <td><span class="st ${r.status === 'approved' ? 'st--shipped' : r.status === 'rejected' ? 'st--cancelled' : 'st--on_hold'}">${RST[r.status]}</span></td>
          <td class="nowrap" data-stop>${r.status !== 'approved' ? `<button type="button" class="btn btn--sm" data-ra="approve" data-id="${r.id}">Publikuj</button>` : ''} ${r.status !== 'rejected' ? `<button type="button" class="btn btn--outline btn--sm" data-ra="reject" data-id="${r.id}">Odrzuć</button>` : ''}</td>
        </tr>`).join('') : '<tr><td colspan="7" class="empty">Brak opinii w tym widoku.</td></tr>';
      tbody.querySelectorAll<HTMLButtonElement>('[data-ra]').forEach((b) => b.addEventListener('click', async (e) => {
        e.stopPropagation();
        try { await api('/api/admin/opinie', { action: b.dataset.ra, id: b.dataset.id }); toast(b.dataset.ra === 'approve' ? 'Opublikowano.' : 'Odrzucono.'); loadReviews(); }
        catch (err) { toast((err as Error).message, true); }
      }));
      tbody.querySelectorAll<HTMLElement>('tr[data-rid]').forEach((tr) => tr.addEventListener('click', (e) => {
        if ((e.target as HTMLElement).closest('[data-stop]')) return;
        const r = d.rows.find((x: any) => x.id === tr.dataset.rid); if (r) openReview(r);
      }));
    } catch (e) { tbody.innerHTML = `<tr><td colspan="7" class="empty err">${esc((e as Error).message)}</td></tr>`; }
  }
  function openReview(r: any) {
    openDrawer(true); drawerNav(() => openReview(r), false);
    const locked = r.source === 'shop'; // ocenę i datę zmienia tylko opinia dodana w panelu
    $('[data-d-title]').textContent = `Opinia: ${r.products?.name || r.product_id}`;
    const body = $('[data-d-body]');
    body.innerHTML = `
      <div class="meta"><span class="st ${r.status === 'approved' ? 'st--shipped' : r.status === 'rejected' ? 'st--cancelled' : 'st--on_hold'}">${RST[r.status]}</span><span>${date(r.created_at)}</span>${r.verified_purchase ? '<span class="badge-inline badge-inline--ok">Zweryfikowany zakup</span>' : ''}${r.source === 'import' ? '<span class="wc">dodana w panelu</span>' : ''}</div>
      <p class="stars-cell big">${starsTxt(r.rating)}</p>
      <dl class="kv"><dt>Autor</dt><dd>${esc(r.author_name)}</dd>${r.email ? `<dt>E-mail</dt><dd>${esc(r.email)}</dd>` : ''}${r.customer_id ? `<dt>Klient</dt><dd><button type="button" class="link" data-open-customer="${r.customer_id}">karta klienta</button></dd>` : ''}<dt>Produkt</dt><dd><button type="button" class="link" data-open-product="${esc(r.product_id)}">${esc(r.products?.name || r.product_id)}</button></dd></dl>
      ${r.title ? `<h3 class="sec__t">${esc(r.title)}</h3>` : ''}<p class="note">${esc(r.body)}</p>
      ${r.edited_at ? `<p class="muted small">Edytowana ${date(r.edited_at)}${r.edited_by ? ` przez ${esc(r.edited_by)}` : ''}${r.original_body ? ' · oryginalna treść zachowana' : ''}</p>` : ''}
      <details class="sec manual">
        <summary>Edytuj opinię</summary>
        <form class="sec" data-redit>
          <div class="row2">
            <label class="field">Autor<input class="input" name="author_name" value="${esc(r.author_name)}" maxlength="60" /></label>
            <label class="field">Ocena<select class="input" name="rating" ${locked ? 'disabled' : ''}>${[5, 4, 3, 2, 1].map((n) => `<option value="${n}" ${n === r.rating ? 'selected' : ''}>${'★'.repeat(n)}${'☆'.repeat(5 - n)} (${n})</option>`).join('')}</select></label>
          </div>
          <label class="field">Tytuł<input class="input" name="title" value="${esc(r.title || '')}" maxlength="120" /></label>
          <label class="field">Treść<textarea class="input" name="body" rows="5" maxlength="3000">${esc(r.body)}</textarea></label>
          <div class="row2">
            <label class="field">Data opinii<input class="input" name="created_at" type="date" value="${String(r.created_at).slice(0, 10)}" ${locked ? 'disabled' : ''} /></label>
            <label class="field">Produkt<select class="input" name="product_id" data-redit-products><option value="${esc(r.product_id)}">${esc(r.products?.name || r.product_id)}</option></select></label>
          </div>
          <label class="check"><input type="checkbox" name="verified_purchase" ${r.verified_purchase ? 'checked' : ''} /> Zweryfikowany zakup</label>
          ${r.original_body ? `<details class="manual"><summary>Pokaż oryginalną treść</summary><p class="note">${esc(r.original_body)}</p></details>` : ''}
          <p class="muted small">${locked ? 'Opinia klienta ze sklepu: ocena i data są zablokowane. ' : ''}Poprawiaj tylko literówki i dane (np. imię). Nie zmieniaj sensu ani oceny wystawionej przez klienta - to wprowadzałoby w błąd (Omnibus, zasady Google).</p>
          <div class="actions"><button class="btn btn--sm">Zapisz opinię</button></div>
        </form>
      </details>
      <form class="sec" data-reply><label class="field">Odpowiedź sklepu (publiczna)<textarea class="input" name="reply" rows="3" maxlength="1500">${esc(r.reply || '')}</textarea></label><div class="actions"><button class="btn btn--outline btn--sm">Zapisz odpowiedź</button></div></form>
      <div class="actions">
        ${r.status !== 'approved' ? '<button type="button" class="btn btn--sm" data-act-r="approve">Publikuj</button>' : ''}
        ${r.status !== 'rejected' ? '<button type="button" class="btn btn--outline btn--sm" data-act-r="reject">Odrzuć</button>' : ''}
        <button type="button" class="btn btn--danger btn--sm" data-act-r="delete">Usuń</button>
      </div>
      <p class="muted small">Zgodnie z dyrektywą Omnibus i zasadami Google publikuj opinie rzetelnie - także krytyczne - a odrzucaj tylko spam, treści obraźliwe albo niezwiązane z produktem.</p>`;
    bindLinks(body);
    // Lista produktów do przeniesienia opinii (np. gdy dodano ją do złego produktu)
    api('/api/admin/products').then(({ rows }) => {
      const sel = body.querySelector<HTMLSelectElement>('[data-redit-products]'); if (!sel) return;
      sel.innerHTML = rows.map((p: any) => `<option value="${esc(p.id)}" ${p.id === r.product_id ? 'selected' : ''}>${esc(p.name)}</option>`).join('');
    }).catch(() => {});
    body.querySelector<HTMLFormElement>('[data-redit]')!.addEventListener('submit', async (e) => {
      e.preventDefault();
      const fd = new FormData(e.target as HTMLFormElement);
      const p: Record<string, unknown> = Object.fromEntries([...fd.entries()].map(([k, v]) => [k, String(v)]));
      p.verified_purchase = fd.get('verified_purchase') !== null;
      try {
        await api('/api/admin/opinie', { action: 'update', id: r.id, ...p });
        toast('Zapisano opinię.');
        Object.assign(r, { ...p, rating: locked ? r.rating : Number(p.rating), created_at: locked ? r.created_at : (p.created_at || r.created_at), edited_at: new Date().toISOString(), original_body: r.original_body || (p.body !== r.body ? r.body : null) });
        openReview(r); loadReviews();
      } catch (err) { toast((err as Error).message, true); }
    });
    body.querySelector<HTMLFormElement>('[data-reply]')!.addEventListener('submit', async (e) => {
      e.preventDefault();
      try { await api('/api/admin/opinie', { action: 'reply', id: r.id, reply: new FormData(e.target as HTMLFormElement).get('reply') }); toast('Zapisano odpowiedź.'); loadReviews(); }
      catch (err) { toast((err as Error).message, true); }
    });
    body.querySelectorAll<HTMLButtonElement>('[data-act-r]').forEach((b) => b.addEventListener('click', async () => {
      if (b.dataset.actR === 'delete' && !confirm('Usunąć opinię na stałe?')) return;
      try { await api('/api/admin/opinie', { action: b.dataset.actR, id: r.id }); toast('Zapisano.'); openDrawer(false); loadReviews(); }
      catch (err) { toast((err as Error).message, true); }
    }));
  }
  async function newReview() {
    openDrawer(true); drawerNav(newReview, false);
    $('[data-d-title]').textContent = 'Dodaj opinię';
    if (!productsList.length) { try { productsList = (await api('/api/admin/products')).rows; } catch { /* */ } }
    const body = $('[data-d-body]');
    body.innerHTML = `<form class="sec" data-nr>
      <p class="muted">Np. przeniesienie prawdziwych opinii z poprzedniego sklepu albo opinia przekazana mailowo. Publikuje się od razu.</p>
      <label class="field">Produkt<select class="input" name="product_id">${productsList.map((x) => `<option value="${esc(x.id)}">${esc(x.name)}</option>`).join('')}</select></label>
      <div class="row2"><label class="field">Autor<input class="input" name="author_name" required /></label><label class="field">Ocena<select class="input" name="rating">${[5, 4, 3, 2, 1].map((n) => `<option value="${n}">${starsTxt(n)} (${n})</option>`).join('')}</select></label></div>
      <label class="field">Data opinii<input class="input" name="created_at" type="date" /></label>
      <label class="field">Tytuł<input class="input" name="title" /></label>
      <label class="field">Treść<textarea class="input" name="body" rows="4" required></textarea></label>
      <label class="check"><input type="checkbox" name="verified_purchase" /> Zweryfikowany zakup (autor kupił produkt)</label>
      <div class="actions"><button class="btn btn--sm">Dodaj opinię</button></div></form>`;
    body.querySelector<HTMLFormElement>('[data-nr]')!.addEventListener('submit', async (e) => {
      e.preventDefault();
      const fd = new FormData(e.target as HTMLFormElement);
      try {
        await api('/api/admin/opinie', { action: 'create', product_id: fd.get('product_id'), author_name: fd.get('author_name'), rating: Number(fd.get('rating')), created_at: fd.get('created_at'), title: fd.get('title'), body: fd.get('body'), verified_purchase: fd.get('verified_purchase') !== null });
        toast('Dodano opinię.'); openDrawer(false); rStatus = 'approved'; document.querySelectorAll<HTMLElement>('[data-rstatus]').forEach((x) => x.setAttribute('aria-pressed', String(x.dataset.rstatus === 'approved'))); loadReviews();
      } catch (err) { toast((err as Error).message, true); }
    });
  }
  document.querySelectorAll<HTMLButtonElement>('[data-rstatus]').forEach((b) => b.addEventListener('click', () => {
    document.querySelectorAll('[data-rstatus]').forEach((x) => x.setAttribute('aria-pressed', 'false'));
    b.setAttribute('aria-pressed', 'true'); rStatus = b.dataset.rstatus || ''; loadReviews();
  }));
  $('[data-new-review]').addEventListener('click', newReview);

  // ---------- Podpis w korespondencji (podgląd jak w mailu) ----------
  let sigSite: Record<string, string> = {};
  function drawSig() {
    const f = $<HTMLFormElement>('[data-sig-form]');
    const text = (f.elements.namedItem('text') as HTMLTextAreaElement).value;
    const withLogo = (f.elements.namedItem('logo') as HTMLInputElement).checked;
    const logo = [sigSite.mailLogo, sigSite.logoHeader].find((u) => u && /\.(png|jpe?g|gif)$/i.test(u)) || '';
    const lines = text.replace(/\{email\}/g, sigSite.email || '').replace(/\{company\}/g, sigSite.company || '').split('\n').map((l) => esc(l)
      .replace(/\*\*(.+?)\*\*/g, '<strong style="font-weight:600;color:#141C2B">$1</strong>')
      .replace(/\[([^\]]+)\]\((https?:[^)\s]+)\)/g, '<a href="#" style="color:#107571;text-decoration:none">$1</a>'));
    $('[data-sig-prev]').innerHTML = `<p style="margin:0 0 12px">Dzień dobry,</p><p style="margin:0">dziękujemy za wiadomość…</p>
      <table style="margin-top:20px;border-collapse:collapse"><tr>${withLogo && logo ? `<td style="padding:2px 14px 0 0;vertical-align:top"><img src="${esc(logo)}" alt="" style="height:28px;width:auto;display:block"></td>` : ''}
      <td style="font-size:13px;line-height:1.55;color:#545D6E;vertical-align:top;${withLogo && logo ? 'padding-left:14px;border-left:1px solid #DCE2EC' : ''}">${lines.join('<br>')}</td></tr></table>
      ${withLogo && !logo ? '<p class="muted small" style="margin-top:10px">Logo nie pojawi się - wgraj poniżej „Logo do maili” (PNG/JPG).</p>' : ''}`;
  }
  $('[data-sig-form]').addEventListener('input', drawSig);
  $('[data-sig-form]').addEventListener('submit', async (e) => {
    e.preventDefault();
    const f = e.target as HTMLFormElement;
    try {
      await api('/api/admin/ustawienia', { action: 'signature', text: (f.elements.namedItem('text') as HTMLTextAreaElement).value, logo: (f.elements.namedItem('logo') as HTMLInputElement).checked });
      toast('Zapisano podpis.');
    } catch (err) { toast((err as Error).message, true); }
  });

  // ---------- Korespondencja ----------
  const mb = { folder: 'inbox', q: '', page: 1, current: '' as string };
  const mbDate = (iso: string) => {
    const d = new Date(iso), now = new Date();
    return d.toDateString() === now.toDateString() ? d.toLocaleTimeString('pl-PL', { hour: '2-digit', minute: '2-digit' })
      : d.toLocaleDateString('pl-PL', { day: 'numeric', month: 'short', ...(d.getFullYear() !== now.getFullYear() ? { year: 'numeric' } : {}) });
  };
  const fmtSize = (n: number | null) => (!n ? '' : n > 1048576 ? `${(n / 1048576).toFixed(1)} MB` : `${Math.max(1, Math.round(n / 1024))} kB`);
  function setMailBadge(n: number) { const el = $('[data-count-mail]'); el.textContent = n ? String(n) : ''; }

  async function loadMail(keepThread = true) {
    const list = $('[data-mb-list]');
    try {
      const p = new URLSearchParams({ folder: mb.folder, page: String(mb.page), ...(mb.q ? { q: mb.q } : {}) });
      const d = await api(`/api/admin/poczta?${p}`);
      $('[data-mb-warn]').hidden = !d.fromWarning;
      for (const [k, v] of Object.entries(d.counts as Record<string, number>)) { const el = document.querySelector(`[data-mb-count="${k}"]`); if (el) el.textContent = v ? String(v) : ''; }
      setMailBadge(d.counts.inbox || 0);
      list.innerHTML = (d.threads.length ? d.threads.map((t: any) => `<button type="button" class="mb__item${t.unread ? ' is-unread' : ''}" data-mb-id="${t.id}" aria-current="${t.id === mb.current}">
          <span class="mb__who">${esc(t.contact_name || t.contact_email)}</span><span class="mb__date">${mbDate(t.last_message_at)}</span>
          <span class="mb__subj">${esc(t.subject)}</span>
          <span class="mb__snip">${esc(t.snippet || '')}</span>
          <span class="mb__tags">${t.message_count > 1 ? `<span class="mb__tag">${t.message_count}</span>` : ''}${t.last_direction === 'out' ? '<span class="mb__tag mb__tag--out">odpowiedziano</span>' : ''}${t.order_number ? `<span class="mb__tag">zam. ${t.order_number}</span>` : ''}${t.customer_id ? '<span class="mb__tag">klient</span>' : ''}</span>
        </button>`).join('') : `<p class="muted" style="padding:20px">${mb.q ? 'Nic nie znaleziono.' : 'Brak wiadomości w tym folderze.'}</p>`)
        + (d.pages > 1 ? `<div class="mb__pager"><button type="button" class="btn btn--outline btn--sm" data-mb-page="-1" ${d.page <= 1 ? 'disabled' : ''}>←</button><span>${d.page} / ${d.pages}</span><button type="button" class="btn btn--outline btn--sm" data-mb-page="1" ${d.page >= d.pages ? 'disabled' : ''}>→</button></div>` : '');
      if (!keepThread) mb.current = '';
    } catch (e) { list.innerHTML = `<p class="err" style="padding:16px">${esc((e as Error).message)}</p>`; }
  }
  $('[data-mb-list]').addEventListener('click', (e) => {
    const pg = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-mb-page]');
    if (pg) { mb.page += Number(pg.dataset.mbPage); loadMail(); return; }
    const it = (e.target as HTMLElement).closest<HTMLElement>('[data-mb-id]');
    if (it) openThread(it.dataset.mbId!);
  });
  document.querySelectorAll<HTMLButtonElement>('[data-mb-folder]').forEach((b) => b.addEventListener('click', () => {
    document.querySelectorAll('[data-mb-folder]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    mb.folder = b.dataset.mbFolder!; mb.page = 1; mb.q = ''; ($('[data-mb-search]') as HTMLFormElement).reset(); loadMail();
  }));
  $('[data-mb-search]').addEventListener('submit', (e) => { e.preventDefault(); mb.q = String(new FormData(e.target as HTMLFormElement).get('q') || '').trim(); mb.page = 1; loadMail(); });
  $('[data-mb-refresh]').addEventListener('click', () => { loadMail(); if (mb.current) openThread(mb.current, false); });

  // HTML wiadomości w odizolowanej ramce: bez skryptów, zdalne obrazy dopiero po kliknięciu (śledzenie otwarć)
  function mailFrame(html: string, remote: boolean) {
    const csp = `default-src 'none'; style-src 'unsafe-inline'; font-src data:; img-src data: ${remote ? 'https: http:' : location.protocol === 'https:' ? `${new URL(location.href).origin} https://*.supabase.co` : '*'};`;
    return `<!doctype html><html><head><meta charset="utf-8"><meta http-equiv="Content-Security-Policy" content="${csp}"><base target="_blank"><style>body{margin:0;font-family:Arial,Helvetica,sans-serif;font-size:14px;line-height:1.5;color:#141C2B;word-break:break-word}img{max-width:100%;height:auto}blockquote{margin:0 0 0 8px;padding-left:10px;border-left:3px solid #DCE2EC;color:#545D6E}</style></head><body>${html}</body></html>`;
  }
  const fitFrame = (f: HTMLIFrameElement) => { try { const h = f.contentDocument?.documentElement.scrollHeight; if (h) f.style.height = `${Math.min(h + 8, 4000)}px`; } catch { f.style.height = '420px'; } };

  async function openThread(id: string, markRead = true) {
    mb.current = id;
    const box = $('[data-mb-thread]');
    $('[data-view="mail"]').classList.add('is-reading');
    document.querySelectorAll('[data-mb-id]').forEach((x) => x.setAttribute('aria-current', String((x as HTMLElement).dataset.mbId === id)));
    box.innerHTML = '<p class="muted">Ładowanie…</p>';
    let d: any;
    try { d = await api(`/api/admin/poczta?id=${encodeURIComponent(id)}`); } catch (e) { box.innerHTML = `<p class="err">${esc((e as Error).message)}</p>`; return; }
    const t = d.thread;
    if (markRead && t.unread) { api('/api/admin/poczta', { action: 'read', id }).then(() => loadMail()).catch(() => {}); }
    history.replaceState(null, '', `#korespondencja/${id}`);
    const many = d.messages.length > 3;
    const orderHit = t.order_number ? d.orders.find((o: any) => o.number === t.order_number) : null;
    box.innerHTML = `
      <button type="button" class="link mb__back" data-mb-back>← Wróć do listy</button>
      <div class="mb__head">
        <h2 class="mb__title">${esc(t.subject)}</h2>
        <div class="mb__actions">
          ${t.status === 'open' ? '<button type="button" class="btn btn--outline btn--sm" data-mb-st="closed">Zamknij</button>' : '<button type="button" class="btn btn--outline btn--sm" data-mb-st="open">Otwórz ponownie</button>'}
          ${t.status === 'spam' ? '<button type="button" class="btn btn--outline btn--sm" data-mb-st="open">To nie spam</button>' : '<button type="button" class="btn btn--outline btn--sm" data-mb-st="spam">Spam</button>'}
          ${t.category !== 'customer' ? '<button type="button" class="btn btn--outline btn--sm" data-mb-cat="customer">Do odebranych</button>' : '<button type="button" class="btn btn--outline btn--sm" data-mb-cat="system">Do systemowych</button>'}
          <button type="button" class="btn btn--outline btn--sm" data-mb-unread>Nieprzeczytane</button>
        </div>
      </div>
      <div class="mb__ctx">
        <span><strong>${esc(t.contact_name || '')}</strong> ${esc(t.contact_email)}</span>
        ${d.customer ? `<span>Klient: ${d.customer.orders_count} zam. · ${pln(d.customer.total_spent)} <button type="button" class="link" data-open-customer="${d.customer.id}">karta klienta</button></span>` : '<span class="muted">nie ma konta klienta</span>'}
        ${d.orders.length ? `<span>Zamówienia: ${d.orders.map((o: any) => `<button type="button" class="link" data-mb-order="${o.id}" title="${esc(STATUS[o.status] || o.status)} · ${pln(o.total)}">${o.number}${o.id === orderHit?.id ? ' ★' : ''}</button>`).join(', ')}</span>` : t.order_number ? `<span>W treści: zamówienie ${t.order_number}</span>` : ''}
      </div>
      <div class="mb__msgs">${d.messages.map((m: any, i: number) => {
        const atts = (m.attachments || []).filter((a: any) => !a.inline || !a.cid);
        const authBad = m.auth && (m.auth.dmarc === 'fail' || (m.auth.spf === 'fail' && m.auth.dkim === 'fail'));
        return `<article class="mb__msg${m.direction === 'out' ? ' mb__msg--out' : ''}${many && i < d.messages.length - 2 ? ' is-collapsed' : ''}" data-mb-msg="${i}">
          <div class="mb__mhead" data-mb-toggle><span><strong>${esc(m.direction === 'out' ? `Can-C${m.sent_by ? ` (${m.sent_by})` : ''}` : m.from_name || m.from_email)}</strong>${m.direction === 'in' && m.from_name ? ` <span class="muted">${esc(m.from_email)}</span>` : ''}${m.source === 'form' ? ' <span class="mb__tag">formularz</span>' : ''}${authBad ? ' <span class="mb__tag" style="background:#FDE8E8;color:#B3261E">nadawca niepotwierdzony</span>' : ''}</span><span class="muted">${date(m.sent_at)}</span></div>
          <div class="mb__body">${m.html_body ? `<iframe class="mb__frame" sandbox="allow-same-origin allow-popups allow-popups-to-escape-sandbox" data-mb-frame="${i}" title="Treść wiadomości"></iframe>${/<img[^>]+src=["']?https?:/i.test(m.html_body) ? `<button type="button" class="link small" data-mb-imgs="${i}">Pokaż obrazy z internetu</button>` : ''}` : `<pre class="mb__text">${esc(m.text_body || '')}</pre>`}</div>
          ${atts.length ? `<div class="mb__atts">${atts.map((a: any) => `<a class="mb__att" href="/api/admin/poczta?att=${m.id}&i=${m.attachments.indexOf(a)}" target="_blank" rel="noopener">📎 ${esc(a.name)} <span class="muted">${fmtSize(a.size)}</span></a>`).join('')}</div>` : ''}
        </article>`;
      }).join('')}</div>
      ${t.status === 'spam' ? '' : `<form class="mb__reply" data-mb-reply>
        <label class="field">Odpowiedź do ${esc(t.contact_email)}<textarea class="input" name="text" required>Dzień dobry,

</textarea></label>
        <div class="mb__sig"><span class="muted small">Podpis (Ustawienia sklepu → Podpis w korespondencji):</span>${d.signature || ''}</div>
        <div class="mb__files" data-mb-files></div>
        <div class="actions" style="justify-content:space-between">
          <span class="actions"><label class="btn btn--outline btn--sm">Załącz pliki<input type="file" multiple hidden data-mb-file /></label>
          <label class="check"><input type="checkbox" name="close" ${t.category === 'customer' ? 'checked' : ''} /> Zamknij wątek po wysłaniu</label></span>
          <button class="btn btn--sm">Wyślij odpowiedź</button>
        </div>
      </form>`}`;

    // Ramki HTML: wstawienie treści i dopasowanie wysokości
    box.querySelectorAll<HTMLIFrameElement>('[data-mb-frame]').forEach((f) => {
      const m = d.messages[Number(f.dataset.mbFrame)];
      f.addEventListener('load', () => fitFrame(f));
      f.srcdoc = mailFrame(m.html_body, false);
    });
    box.querySelectorAll<HTMLButtonElement>('[data-mb-imgs]').forEach((b) => b.addEventListener('click', () => {
      const f = box.querySelector<HTMLIFrameElement>(`[data-mb-frame="${b.dataset.mbImgs}"]`);
      if (f) f.srcdoc = mailFrame(d.messages[Number(b.dataset.mbImgs)].html_body, true);
      b.remove();
    }));
    box.querySelectorAll<HTMLElement>('[data-mb-toggle]').forEach((h) => h.addEventListener('click', () => {
      const a = h.closest('.mb__msg')!; a.classList.toggle('is-collapsed');
      a.querySelectorAll<HTMLIFrameElement>('iframe').forEach(fitFrame);
    }));
    bindLinks(box);
    box.querySelectorAll<HTMLButtonElement>('[data-mb-order]').forEach((b) => b.addEventListener('click', () => openOrder(b.dataset.mbOrder!)));
    box.querySelector('[data-mb-back]')?.addEventListener('click', () => { $('[data-view="mail"]').classList.remove('is-reading'); mb.current = ''; history.replaceState(null, '', '#korespondencja'); loadMail(); });
    const act = async (body: Record<string, unknown>, msg: string) => {
      try { await api('/api/admin/poczta', { id, ...body }); toast(msg); loadMail(); openThread(id, false); } catch (e) { toast((e as Error).message, true); }
    };
    box.querySelectorAll<HTMLButtonElement>('[data-mb-st]').forEach((b) => b.addEventListener('click', () => act({ action: 'status', status: b.dataset.mbSt }, b.dataset.mbSt === 'spam' ? 'Przeniesiono do spamu.' : b.dataset.mbSt === 'closed' ? 'Wątek zamknięty.' : 'Wątek otwarty.')));
    box.querySelectorAll<HTMLButtonElement>('[data-mb-cat]').forEach((b) => b.addEventListener('click', () => act({ action: 'category', category: b.dataset.mbCat }, 'Przeniesiono.')));
    box.querySelector('[data-mb-unread]')?.addEventListener('click', async () => { try { await api('/api/admin/poczta', { action: 'read', id, unread: true }); toast('Oznaczono jako nieprzeczytane.'); loadMail(); } catch (e) { toast((e as Error).message, true); } });

    // Odpowiedź z załącznikami (base64, łącznie do 10 MB)
    const form = box.querySelector<HTMLFormElement>('[data-mb-reply]');
    if (!form) return;
    const files: { name: string; type: string; data: string; size: number }[] = [];
    const drawFiles = () => {
      box.querySelector('[data-mb-files]')!.innerHTML = files.map((f, i) => `<span class="mb__att">📎 ${esc(f.name)} <span class="muted">${fmtSize(f.size)}</span> <button type="button" class="link" data-mb-unfile="${i}" aria-label="Usuń załącznik">×</button></span>`).join('');
    };
    box.querySelector('[data-mb-files]')!.addEventListener('click', (e) => { const x = (e.target as HTMLElement).closest<HTMLElement>('[data-mb-unfile]'); if (x) { files.splice(Number(x.dataset.mbUnfile), 1); drawFiles(); } });
    box.querySelector<HTMLInputElement>('[data-mb-file]')!.addEventListener('change', async (e) => {
      const input = e.target as HTMLInputElement;
      for (const f of [...(input.files || [])]) {
        if (files.reduce((s, x) => s + x.size, 0) + f.size > 10 * 1024 * 1024) { toast('Załączniki mogą mieć łącznie do 10 MB.', true); break; }
        const data = await new Promise<string>((res, rej) => { const r = new FileReader(); r.onload = () => res(String(r.result).split(',')[1] || ''); r.onerror = () => rej(r.error); r.readAsDataURL(f); });
        files.push({ name: f.name, type: f.type || 'application/octet-stream', data, size: f.size });
      }
      input.value = ''; drawFiles();
    });
    const ta = form.querySelector('textarea')!;
    ta.setSelectionRange(14, 14);
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const fd = new FormData(form);
      const btn = form.querySelector<HTMLButtonElement>('button:not([type])')!;
      btn.disabled = true; btn.textContent = 'Wysyłanie…';
      try {
        await api('/api/admin/poczta', { action: 'reply', id, text: fd.get('text'), close: fd.get('close') !== null, attachments: files.map(({ name, type, data }) => ({ name, type, data })) });
        toast('Odpowiedź wysłana.');
        loadMail(); openThread(id, false);
      } catch (err) { toast((err as Error).message, true); btn.disabled = false; btn.textContent = 'Wyślij odpowiedź'; }
    });
  }

  // Licznik nieprzeczytanych przy menu (start panelu) i wejście z linku w powiadomieniu (#korespondencja/<id>)
  api('/api/admin/poczta?folder=inbox').then((d) => setMailBadge(d.counts?.inbox || 0)).catch(() => {});
  if (location.hash.startsWith('#korespondencja')) {
    const tid = location.hash.split('/')[1];
    setTimeout(() => { document.querySelector<HTMLButtonElement>('[data-tab="mail"]')?.click(); if (tid && /^[0-9a-f-]{36}$/i.test(tid)) openThread(tid); }, 0);
  }

  // ---------- Prośba o opinię: zapis i ręczne uruchomienie ----------
  $('[data-rr-form]').addEventListener('submit', async (e) => {
    e.preventDefault();
    const f = e.target as HTMLFormElement;
    const v = (n: string) => f.elements.namedItem(n) as HTMLInputElement;
    try {
      await api('/api/admin/automaty', { action: 'reviews_save', enabled: v('enabled').checked, daysAfter: Number(v('daysAfter').value), maxPerRun: Number(v('maxPerRun').value), consentOnly: v('consentOnly').checked });
      toast('Zapisano ustawienia prośby o opinię.'); loadAutomations();
    } catch (err) { toast((err as Error).message, true); }
  });
  $('[data-rr-run]').addEventListener('click', async () => {
    if (!confirm('Wysłać teraz prośby o opinię do osób z listy?')) return;
    try { const r = await api('/api/admin/automaty', { action: 'reviews_run' }); toast(r.skipped || `Wysłano: ${r.sent} z ${r.candidates}${r.errors ? ` · błędy: ${r.errors}` : ''}`, Boolean(r.errors)); loadAutomations(); }
    catch (err) { toast((err as Error).message, true); }
  });

  // ---------- Automaty: podzakładki ----------
  let autoTab = 'reminders';
  document.querySelectorAll<HTMLButtonElement>('[data-auto-tab]').forEach((b) => b.addEventListener('click', () => {
    autoTab = b.dataset.autoTab!;
    document.querySelectorAll('[data-auto-tab]').forEach((x) => x.setAttribute('aria-selected', String(x === b)));
    document.querySelectorAll<HTMLElement>('[data-auto-pane]').forEach((p) => { p.hidden = p.dataset.autoPane !== autoTab; });
    if (autoTab === 'newsletter') loadNewsletter();
  }));

  // ---------- Newsletter: kampanie ----------
  const NL_STATUS: Record<string, [string, string]> = { draft: ['Szkic', 'st--pending_payment'], sending: ['Wysyłanie…', 'st--on_hold'], sent: ['Wysłana', 'st--shipped'] };
  let nlMeta: { products: { id: string; name: string; active: boolean }[]; audiences: Record<string, string> } = { products: [], audiences: {} };
  async function loadNewsletter() {
    const tbody = $('[data-nl-list]');
    tbody.innerHTML = '<tr><td colspan="5" class="empty">Ładowanie…</td></tr>';
    try {
      const d = await api('/api/admin/newsletter');
      nlMeta = { products: d.products, audiences: d.audiences };
      for (const [k, v] of Object.entries(d.stats)) { const el = document.querySelector(`[data-nl-k="${k}"]`); if (el) el.textContent = String(v); }
      const warn = $('[data-nl-warn]'); warn.hidden = !d.fromWarning; warn.textContent = d.fromWarning || '';
      tbody.innerHTML = d.campaigns.length ? d.campaigns.map((c: any) => `<tr data-nlid="${c.id}" tabindex="0" class="clickrow">
          <td><strong>${esc(c.name)}</strong><br><span class="muted">${esc(c.subject || '(bez tematu)')}</span></td>
          <td>${esc(d.audiences[c.audience] || c.audience)}</td>
          <td><span class="st ${NL_STATUS[c.status]?.[1] || ''}">${NL_STATUS[c.status]?.[0] || esc(c.status)}</span></td>
          <td class="r">${c.status === 'draft' ? '-' : `${c.sent_count} / ${c.recipients}${c.failed_count ? `<br><span class="err">błędy: ${c.failed_count}</span>` : ''}`}</td>
          <td class="nowrap">${date(c.sent_at || c.started_at || c.created_at)}</td>
        </tr>`).join('') : '<tr><td colspan="5" class="empty">Brak kampanii. Utwórz pierwszą.</td></tr>';
      tbody.querySelectorAll<HTMLElement>('tr[data-nlid]').forEach((tr) => {
        const go = () => openCampaign(tr.dataset.nlid!);
        tr.addEventListener('click', go); tr.addEventListener('keydown', (e) => { if ((e as KeyboardEvent).key === 'Enter') go(); });
      });
    } catch (e) { tbody.innerHTML = `<tr><td colspan="5" class="empty err">${esc((e as Error).message)}</td></tr>`; }
  }
  $('[data-nl-new]').addEventListener('click', () => openCampaign(null));

  const BLOCK_LABEL: Record<string, string> = { heading: 'Nagłówek', text: 'Tekst', image: 'Obraz', button: 'Przycisk', products: 'Produkty', code: 'Kod rabatowy', divider: 'Linia' };
  const newBlock = (type: string): any => ({
    heading: { type, text: '' }, text: { type, text: '' }, image: { type, url: '', alt: '', href: '' }, button: { type, label: 'Przejdź do sklepu', url: '/sklep/' },
    products: { type, ids: [] }, code: { type, code: '', caption: 'Wpisz kod przy zamówieniu' }, divider: { type },
  } as any)[type];

  async function openCampaign(id: string | null, push = true) {
    openDrawer(true); drawerNav(() => openCampaign(id, false), push);
    $('[data-drawer]').classList.add('drawer--wide');
    const body = $('[data-d-body]');
    body.innerHTML = '<p class="muted">Ładowanie…</p>';
    let c: any, failed: any[] = [];
    try {
      if (!nlMeta.products.length) { const d = await api('/api/admin/newsletter'); nlMeta = { products: d.products, audiences: d.audiences }; }
      if (id) { const d = await api(`/api/admin/newsletter?id=${encodeURIComponent(id)}`); c = d.campaign; failed = d.failed; }
    } catch (e) { body.innerHTML = `<p class="err">${esc((e as Error).message)}</p>`; return; }
    c ??= { name: '', subject: '', preheader: '', audience: 'all', status: 'draft', blocks: [
      { type: 'heading', text: 'Dzień dobry {imie}!' },
      { type: 'text', text: 'Mamy dla Ciebie coś specjalnego…' },
      { type: 'button', label: 'Przejdź do sklepu', url: '/sklep/' },
    ] };
    let campaignId: string | null = id;
    const blocks: any[] = JSON.parse(JSON.stringify(c.blocks || []));
    const editable = c.status === 'draft';
    $('[data-d-title]').textContent = id ? c.name : 'Nowa kampania';

    body.innerHTML = `
      ${c.status !== 'draft' ? `<div class="meta"><span class="st ${NL_STATUS[c.status][1]}">${NL_STATUS[c.status][0]}</span><span>Wysłane: ${c.sent_count} / ${c.recipients}</span>${c.failed_count ? `<span class="err">Błędy: ${c.failed_count}</span>` : ''}${c.sent_at ? `<span>${date(c.sent_at)}</span>` : ''}</div>` : ''}
      ${failed.length ? `<div class="box box--amber"><strong>Nie wysłano</strong>${failed.slice(0, 10).map((f) => `<span class="small">${esc(f.email)} - ${esc(f.error || '')}</span>`).join('')}</div>` : ''}
      <div class="nl-ed">
        <form class="nl-ed__form" data-nl-form novalidate>
          <fieldset ${editable ? '' : 'disabled'} class="nl-ed__fs">
            <div class="code-form">
              <label class="field">Nazwa kampanii (wewnętrzna, utm_campaign)<input class="input" name="name" value="${esc(c.name)}" maxlength="100" placeholder="np. Black Friday 2026" /></label>
              <label class="field">Odbiorcy<select class="input" name="audience">${Object.entries(nlMeta.audiences).map(([k, v]) => `<option value="${k}" ${c.audience === k ? 'selected' : ''}>${esc(v)}</option>`).join('')}</select><span class="muted small" data-nl-count></span></label>
              <label class="field code-form__wide">Temat wiadomości<input class="input" name="subject" value="${esc(c.subject)}" maxlength="150" placeholder="np. −20% na krople Can-C tylko do niedzieli" /></label>
              <label class="field code-form__wide">Zajawka (tekst obok tematu w skrzynce)<input class="input" name="preheader" value="${esc(c.preheader)}" maxlength="200" /></label>
            </div>
            <h3 class="sec__t">Treść</h3>
            <p class="muted small">W tekście: <code>**pogrubienie**</code>, <code>*kursywa*</code>, <code>[link](https://…)</code>, lista „- ”, pusty wiersz = nowy akapit. <code>{imie}</code> wstawia imię odbiorcy (bez imienia znika).</p>
            <div class="nl-blocks" data-nl-blocks></div>
            ${editable ? `<div class="actions nl-add">${Object.entries(BLOCK_LABEL).map(([k, v]) => `<button type="button" class="btn btn--outline btn--sm" data-nl-add="${k}">+ ${v}</button>`).join('')}</div>` : ''}
          </fieldset>
          <div class="actions">
            ${editable ? '<button type="button" class="btn btn--outline btn--sm" data-nl-save>Zapisz szkic</button><button type="button" class="btn btn--outline btn--sm" data-nl-test>Wyślij test</button><button type="button" class="btn btn--sm" data-nl-send>Wyślij kampanię</button>' : ''}
            ${c.status === 'sending' ? '<button type="button" class="btn btn--sm" data-nl-resume>Wznów wysyłkę</button>' : ''}
            ${id ? '<button type="button" class="btn btn--outline btn--sm" data-nl-dup>Duplikuj</button>' : ''}
            ${id && editable ? '<button type="button" class="btn btn--danger btn--sm" data-nl-del>Usuń szkic</button>' : ''}
          </div>
          <div class="nl-progress" data-nl-progress hidden><div class="nl-progress__bar"><span data-nl-bar></span></div><span class="small" data-nl-ptext></span></div>
        </form>
        <div class="nl-ed__preview">
          <div class="nl-ed__ph"><strong>Podgląd</strong><span class="muted small">imię w podglądzie: Anna</span></div>
          <iframe title="Podgląd wiadomości" data-nl-frame sandbox=""></iframe>
        </div>
      </div>`;

    const form = body.querySelector<HTMLFormElement>('[data-nl-form]')!;
    const list = body.querySelector<HTMLElement>('[data-nl-blocks]')!;
    const frame = body.querySelector<HTMLIFrameElement>('[data-nl-frame]')!;
    const fields = () => {
      const fd = new FormData(form);
      return { name: String(fd.get('name') ?? c.name), subject: String(fd.get('subject') ?? c.subject), preheader: String(fd.get('preheader') ?? c.preheader), audience: String(fd.get('audience') ?? c.audience), blocks };
    };

    const blockHtml = (b: any, i: number) => {
      const head = `<div class="nl-block__h"><strong>${BLOCK_LABEL[b.type]}</strong>${editable ? `<span class="nl-block__tools">
        <button type="button" class="icon-btn" data-mv="${i}:-1" aria-label="W górę" ${i === 0 ? 'disabled' : ''}><svg viewBox="0 0 24 24"><path d="m6 15 6-6 6 6" /></svg></button>
        <button type="button" class="icon-btn" data-mv="${i}:1" aria-label="W dół" ${i === blocks.length - 1 ? 'disabled' : ''}><svg viewBox="0 0 24 24"><path d="m6 9 6 6 6-6" /></svg></button>
        <button type="button" class="icon-btn" data-rm="${i}" aria-label="Usuń blok"><svg viewBox="0 0 24 24"><path d="M6 6l12 12M18 6 6 18" /></svg></button></span>` : ''}</div>`;
      const f = (k: string, label: string, v: string, attrs = '') => `<label class="field">${label}<input class="input" data-b="${i}" data-k="${k}" value="${esc(v ?? '')}" ${attrs} /></label>`;
      let inner = '';
      if (b.type === 'heading') inner = f('text', 'Tekst nagłówka', b.text, 'maxlength="150"');
      if (b.type === 'text') inner = `<label class="field">Tekst<textarea class="input" rows="5" data-b="${i}" data-k="text" maxlength="4000">${esc(b.text)}</textarea></label>`;
      if (b.type === 'image') inner = `<div class="nl-img">${b.url ? `<img src="${esc(b.url)}" alt="" />` : '<span class="muted small">brak obrazu</span>'}<label class="btn btn--outline btn--sm">${b.url ? 'Zmień' : 'Wgraj'} obraz<input type="file" accept="image/png,image/jpeg,image/webp" data-img="${i}" hidden /></label></div>
        ${f('alt', 'Opis obrazu (alt)', b.alt, 'maxlength="150"')}${f('href', 'Link po kliknięciu (opcjonalnie)', b.href || '', 'placeholder="/produkt/krople-can-c/"')}`;
      if (b.type === 'button') inner = `<div class="row2">${f('label', 'Tekst przycisku', b.label, 'maxlength="60"')}${f('url', 'Adres', b.url, 'placeholder="/sklep/ albo https://…"')}</div>`;
      if (b.type === 'products') inner = `<div class="pm-prods">${nlMeta.products.map((p) => `<label class="check"><input type="checkbox" data-prod="${i}" value="${esc(p.id)}" ${b.ids.includes(p.id) ? 'checked' : ''} /> ${esc(p.name)}${p.active ? '' : ' <span class="muted">(nieaktywny)</span>'}</label>`).join('')}</div>`;
      if (b.type === 'code') inner = `<div class="row2">${f('code', 'Kod', b.code, 'maxlength="30" style="text-transform:uppercase" placeholder="np. NEWSLETTER10"')}${f('caption', 'Podpis', b.caption || '', 'maxlength="150"')}</div><p class="muted small">Utwórz kod w Kody rabatowe (albo promocję z kodem) - tu tylko go pokazujesz.</p>`;
      return `<div class="nl-block">${head}${inner}</div>`;
    };
    const renderBlocks = () => { list.innerHTML = blocks.length ? blocks.map(blockHtml).join('') : '<p class="muted">Dodaj bloki treści przyciskami poniżej.</p>'; };

    let pvT = 0;
    const preview = () => {
      clearTimeout(pvT);
      pvT = window.setTimeout(async () => {
        try { const d = await api('/api/admin/newsletter', { action: 'preview', ...fields() }); frame.srcdoc = d.html; }
        catch (e) { frame.srcdoc = `<p style="font-family:sans-serif;color:#B3261E;padding:20px">${esc((e as Error).message)}</p>`; }
      }, 500);
    };
    const countAudience = async () => {
      const el = body.querySelector('[data-nl-count]')!;
      el.textContent = '…';
      try { const d = await api(`/api/admin/newsletter?audience=${encodeURIComponent(fields().audience)}`); el.textContent = `${d.count} odbiorców teraz`; } catch { el.textContent = ''; }
    };

    list.addEventListener('input', (e) => {
      const t = e.target as HTMLInputElement;
      if (t.dataset.b !== undefined) { blocks[Number(t.dataset.b)][t.dataset.k!] = t.value; preview(); }
    });
    list.addEventListener('change', async (e) => {
      const t = e.target as HTMLInputElement;
      if (t.dataset.prod !== undefined) {
        const b = blocks[Number(t.dataset.prod)];
        b.ids = t.checked ? [...new Set([...b.ids, t.value])] : b.ids.filter((x: string) => x !== t.value);
        preview();
      }
      if (t.dataset.img !== undefined) {
        const file = t.files?.[0]; if (!file) return;
        try {
          toast('Wysyłanie obrazu…');
          // Do maili JPG (Outlook nie wyświetla WebP), szerokość maks. 1200 px
          const bmp = await createImageBitmap(file);
          const scale = Math.min(1, 1200 / bmp.width);
          const cv = document.createElement('canvas'); cv.width = Math.round(bmp.width * scale); cv.height = Math.round(bmp.height * scale);
          const ctx = cv.getContext('2d')!; ctx.fillStyle = '#FFFFFF'; ctx.fillRect(0, 0, cv.width, cv.height); ctx.drawImage(bmp, 0, 0, cv.width, cv.height);
          const blob = await new Promise<Blob>((res, rej) => cv.toBlob((x) => (x ? res(x) : rej(new Error('Nie udało się przygotować obrazu.'))), 'image/jpeg', 0.86));
          const fd = new FormData(); fd.append('file', new File([blob], 'newsletter.jpg', { type: 'image/jpeg' })); fd.append('product', 'newsletter');
          const res = await fetch('/api/admin/upload', { method: 'POST', body: fd });
          const d = await res.json().catch(() => ({}));
          if (!res.ok) throw new Error(d.error || 'Błąd wysyłania obrazu.');
          blocks[Number(t.dataset.img)].url = d.url; renderBlocks(); preview(); toast('Obraz dodany.');
        } catch (err) { toast((err as Error).message, true); }
      }
    });
    list.addEventListener('click', (e) => {
      const t = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-mv],[data-rm]');
      if (!t) return;
      if (t.dataset.rm !== undefined) blocks.splice(Number(t.dataset.rm), 1);
      else { const [i, d] = t.dataset.mv!.split(':').map(Number); const j = i + d; if (j < 0 || j >= blocks.length) return; [blocks[i], blocks[j]] = [blocks[j], blocks[i]]; }
      renderBlocks(); preview();
    });
    body.querySelectorAll<HTMLButtonElement>('[data-nl-add]').forEach((b) => b.addEventListener('click', () => { blocks.push(newBlock(b.dataset.nlAdd!)); renderBlocks(); preview(); }));
    form.addEventListener('input', (e) => { if (!(e.target as HTMLElement).dataset.b) preview(); });
    form.querySelector('[name="audience"]')?.addEventListener('change', countAudience);

    const save = async () => {
      const d = await api('/api/admin/newsletter', { action: 'save', ...(campaignId ? { id: campaignId } : {}), ...fields() });
      campaignId = d.id;
      return d.id as string;
    };
    const runSending = async (cid: string) => {
      const prog = body.querySelector<HTMLElement>('[data-nl-progress]')!;
      const bar = body.querySelector<HTMLElement>('[data-nl-bar]')!;
      const txt = body.querySelector<HTMLElement>('[data-nl-ptext]')!;
      prog.hidden = false;
      body.querySelectorAll<HTMLButtonElement>('.actions button').forEach((x) => (x.disabled = true));
      let errors = 0;
      for (let guard = 0; guard < 1000; guard++) {
        let d: any;
        try { d = await api('/api/admin/newsletter', { action: 'batch', id: cid }); }
        catch (e) { txt.textContent = `Przerwano: ${(e as Error).message}. Kliknij „Wznów wysyłkę”.`; break; }
        if (d.error) errors++;
        bar.style.width = `${d.recipients ? Math.round(((d.sent + d.failed) / d.recipients) * 100) : 100}%`;
        txt.textContent = `Wysłano ${d.sent} z ${d.recipients}${d.failed ? ` · błędy: ${d.failed}` : ''} - nie zamykaj tego okna.`;
        if (d.done) { txt.textContent = `Gotowe: wysłano ${d.sent} z ${d.recipients}${d.failed ? ` · błędy: ${d.failed}` : ''}.`; toast('Kampania wysłana.'); break; }
        if (errors >= 3) { txt.textContent = 'Kilka paczek zakończyło się błędem - sprawdź konfigurację Resend i kliknij „Wznów wysyłkę”.'; break; }
      }
      loadNewsletter();
      openCampaign(cid, false);
    };

    body.querySelector('[data-nl-save]')?.addEventListener('click', async () => {
      try { const nid = await save(); toast('Zapisano szkic.'); loadNewsletter(); if (!id) openCampaign(nid, false); } catch (e) { toast((e as Error).message, true); }
    });
    body.querySelector('[data-nl-test]')?.addEventListener('click', async () => {
      const to = prompt('Adres do wiadomości testowej (puste = Twój adres z logowania do panelu):', '') ?? null;
      if (to === null) return;
      try { const d = await api('/api/admin/newsletter', { action: 'test', to, ...fields() }); toast(`Wysłano test na: ${d.to.join(', ')}`); } catch (e) { toast((e as Error).message, true); }
    });
    body.querySelector('[data-nl-send]')?.addEventListener('click', async () => {
      try {
        const cid = await save();
        const n = await api(`/api/admin/newsletter?audience=${encodeURIComponent(fields().audience)}`);
        if (!confirm(`Wysłać kampanię „${fields().subject}” do ${n.count} odbiorców? Tej operacji nie można cofnąć.`)) return;
        await api('/api/admin/newsletter', { action: 'start', id: cid });
        await runSending(cid);
      } catch (e) { toast((e as Error).message, true); }
    });
    body.querySelector('[data-nl-resume]')?.addEventListener('click', () => runSending(id!));
    body.querySelector('[data-nl-dup]')?.addEventListener('click', async () => {
      try { const d = await api('/api/admin/newsletter', { action: 'duplicate', id }); toast('Utworzono kopię.'); loadNewsletter(); openCampaign(d.id, false); } catch (e) { toast((e as Error).message, true); }
    });
    body.querySelector('[data-nl-del]')?.addEventListener('click', async () => {
      if (!confirm('Usunąć szkic kampanii?')) return;
      try { await api('/api/admin/newsletter', { action: 'delete', id }); toast('Usunięto.'); loadNewsletter(); openDrawer(false); } catch (e) { toast((e as Error).message, true); }
    });

    renderBlocks();
    preview();
    if (editable) countAudience();
  }

  // ---------- Promocje automatyczne ----------
  let promoProducts: { id: string; name: string; price: number | null; active: boolean }[] = [];
  const zlInput = (g: number) => (g / 100).toFixed(2).replace('.', ',').replace(',00', '');
  const pName = (id: string) => promoProducts.find((x) => x.id === id)?.name || id;
  const promoSummary = (p: any) => p.kind === 'bundle'
    ? `${p.items.map((i: any) => `${esc(pName(i.product_id))}${i.qty > 1 ? ` × ${i.qty}` : ''}`).join(' + ')}<br><strong>${describeDiscount(p.type, p.value)}</strong> za komplet${p.max_sets ? ` · maks. ${p.max_sets} w zamówieniu` : ''}`
    : `${p.product_ids.map((id: string) => esc(pName(id))).join(', ')}${p.combined ? ' <span class="muted">(sztuki sumowane)</span>' : ''}<br>${p.tiers.map((t: any) => `od ${t.min} szt. <strong>${describeDiscount(t.type, t.value, true)}</strong>`).join(' · ')}`;

  async function loadPromos() {
    const tbody = $('[data-promos]');
    tbody.innerHTML = '<tr><td colspan="9" class="empty">Ładowanie…</td></tr>';
    try {
      const { rows, products } = await api('/api/admin/promocje');
      promoProducts = products;
      const d = (x: string | null) => (x ? new Date(x).toLocaleDateString('pl-PL') : '');
      const now = Date.now();
      tbody.innerHTML = rows.length ? rows.map((p: any) => {
        const future = p.starts_at && new Date(p.starts_at).getTime() > now;
        const past = p.ends_at && new Date(p.ends_at).getTime() < now;
        return `<tr data-pmid="${p.id}" tabindex="0" class="clickrow" title="Edytuj promocję i zobacz, kto z niej skorzystał">
          <td><strong>${esc(p.name)}</strong><br><span class="muted">${p.kind === 'bundle' ? 'Zestaw' : 'Rabat ilościowy'}${p.label && p.label !== p.name ? ` · klient widzi: „${esc(p.label)}”` : ''}</span>${p.code ? `<br><span class="wc" style="margin-left:0">kod ${esc(p.code)}</span>` : ''}</td>
          <td>${promoSummary(p)}</td>
          <td class="nowrap">${p.starts_at || p.ends_at ? `${d(p.starts_at) || '…'} - ${d(p.ends_at) || '…'}` : 'bezterminowo'}${future ? '<br><span class="muted">zaplanowana</span>' : past ? '<br><span class="err">zakończona</span>' : ''}</td>
          <td class="r">${p.stats.orders}${p.stats.last ? `<br><span class="muted">ost. ${new Date(p.stats.last).toLocaleDateString('pl-PL')}</span>` : ''}</td>
          <td class="r">${p.stats.customers}</td>
          <td class="r nowrap"><strong>${pln(p.stats.revenue)}</strong>${p.stats.orders ? `<br><span class="muted">śr. ${pln(Math.round(p.stats.revenue / p.stats.orders))}</span>` : ''}</td>
          <td class="r nowrap">${pln(p.stats.discount)}</td>
          <td>${p.with_codes ? 'łączy się' : '<span class="err">bez kodów</span>'}</td>
          <td data-stop><input type="checkbox" data-ptoggle="${p.id}" ${p.active ? 'checked' : ''} aria-label="Aktywna" /></td>
        </tr>`;
      }).join('') : '<tr><td colspan="9" class="empty">Brak promocji. Dodaj rabat ilościowy albo zestaw.</td></tr>';
      tbody.querySelectorAll<HTMLInputElement>('[data-ptoggle]').forEach((cb) => cb.addEventListener('change', async () => {
        try { await api('/api/admin/promocje', { action: 'toggle', id: cb.dataset.ptoggle, active: cb.checked }); toast(cb.checked ? 'Promocja włączona.' : 'Promocja wyłączona.'); }
        catch (e) { cb.checked = !cb.checked; toast((e as Error).message, true); }
      }));
      tbody.querySelectorAll<HTMLElement>('tr[data-pmid]').forEach((tr) => {
        const go = (e: Event) => { if ((e.target as HTMLElement).closest('[data-stop]')) return; openPromo(tr.dataset.pmid!); };
        tr.addEventListener('click', go); tr.addEventListener('keydown', (e) => { if ((e as KeyboardEvent).key === 'Enter') go(e); });
      });
    } catch (e) {
      tbody.innerHTML = `<tr><td colspan="9" class="empty err">${esc((e as Error).message)}</td></tr>`;
    }
  }
  document.querySelectorAll<HTMLButtonElement>('[data-promo-new]').forEach((b) => b.addEventListener('click', () => openPromo(null, true, b.dataset.promoNew as 'quantity' | 'bundle')));

  const productOpts = (sel = '') => promoProducts.map((x) => `<option value="${esc(x.id)}" ${x.id === sel ? 'selected' : ''}>${esc(x.name)}${x.active ? '' : ' (nieaktywny)'}</option>`).join('');
  const tierRow = (t: any = { min: '', type: 'percent', value: '' }) => `<div class="pm-row" data-tier>
      <label class="field">Od (szt.)<input class="input" data-t-min type="number" min="2" max="100" value="${esc(t.min)}" /></label>
      <label class="field">Rodzaj<select class="input" data-t-type><option value="percent" ${t.type !== 'amount' ? 'selected' : ''}>Procent (%)</option><option value="amount" ${t.type === 'amount' ? 'selected' : ''}>Kwota za sztukę (zł)</option></select></label>
      <label class="field">Rabat<input class="input" data-t-value inputmode="decimal" value="${t.value === '' ? '' : esc(t.type === 'amount' ? zlInput(t.value) : t.value)}" /></label>
      <button type="button" class="icon-btn" data-row-del aria-label="Usuń próg"><svg viewBox="0 0 24 24"><path d="M6 6l12 12M18 6 6 18" /></svg></button></div>`;
  const itemRow = (it: any = { product_id: '', qty: 1 }) => `<div class="pm-row pm-row--item" data-item>
      <label class="field">Produkt<select class="input" data-i-prod><option value="">- wybierz -</option>${productOpts(it.product_id)}</select></label>
      <label class="field">Sztuk<input class="input" data-i-qty type="number" min="1" max="20" value="${esc(it.qty)}" /></label>
      <button type="button" class="icon-btn" data-row-del aria-label="Usuń produkt"><svg viewBox="0 0 24 24"><path d="M6 6l12 12M18 6 6 18" /></svg></button></div>`;

  // Szczegóły promocji: formularz (nowa / edycja) + lista zamówień
  async function openPromo(id: string | null, push = true, newKind: 'quantity' | 'bundle' = 'quantity') {
    openDrawer(true); drawerNav(() => openPromo(id, false, newKind), push);
    $('[data-drawer]').classList.add('drawer--wide');
    const body = $('[data-d-body]');
    body.innerHTML = '<p class="muted">Ładowanie…</p>';
    let p: any, uses: any[] = [];
    try {
      if (!promoProducts.length) promoProducts = (await api('/api/admin/promocje')).products;
      if (id) { const d = await api(`/api/admin/promocje?uses=${encodeURIComponent(id)}`); p = d.promo; uses = d.uses; }
    } catch (e) { body.innerHTML = `<p class="err">${esc((e as Error).message)}</p>`; return; }
    const kind: 'quantity' | 'bundle' = p ? p.kind : newKind;
    p ??= kind === 'quantity'
      ? { name: '', label: '', kind, product_ids: [], combined: false, tiers: [{ min: 2, type: 'percent', value: 5 }], with_codes: true, sort_order: 20, active: true }
      : { name: '', label: '', kind, items: [{ product_id: '', qty: 1 }, { product_id: '', qty: 1 }], type: 'percent', value: 10, max_sets: null, with_codes: true, sort_order: 5, active: true };
    $('[data-d-title]').textContent = id ? p.name : kind === 'bundle' ? 'Nowy zestaw' : 'Nowy rabat ilościowy';
    const day = (iso: string | null) => (iso ? new Date(new Date(iso).getTime() - new Date(iso).getTimezoneOffset() * 60000).toISOString().slice(0, 10) : '');
    const paidSt = new Set(['paid', 'packing', 'shipped', 'completed']);
    const paidUses = uses.filter((u) => paidSt.has(u.status));
    const custs = new Set(paidUses.map((u) => u.customer_id || u.email)).size;

    body.innerHTML = `
      ${id ? `<div class="meta"><span class="st ${p.active ? 'st--shipped' : 'st--pending_payment'}">${p.active ? 'Aktywna' : 'Wyłączona'}</span><span>Opłacone zamówienia: ${paidUses.length}</span><span>Klienci: ${custs}</span><span>Przychód: ${pln(paidUses.reduce((a, u) => a + u.total, 0))}</span><span>Udzielony rabat: ${pln(paidUses.reduce((a, u) => a + (u.amount || 0), 0))}</span></div>` : ''}
      <form class="sec" data-promo-form novalidate>
        <div class="code-form">
          <label class="field">Nazwa w panelu<input class="input" name="name" value="${esc(p.name)}" maxlength="100" placeholder="${kind === 'bundle' ? 'np. Krople + kapsułki' : 'np. Rabat za zestaw'}" required /></label>
          <label class="field">Nazwa dla klienta<input class="input" name="label" value="${esc(p.label || '')}" maxlength="60" placeholder="puste = jak w panelu" /></label>
          <label class="field">Ważna od<input class="input" name="starts_at" type="date" value="${day(p.starts_at)}" /></label>
          <label class="field">Ważna do<input class="input" name="ends_at" type="date" value="${day(p.ends_at)}" /></label>
          <label class="field">Kod uruchamiający (opcjonalnie)<input class="input" name="code" value="${esc(p.code || '')}" maxlength="30" placeholder="puste = działa automatycznie" style="text-transform:uppercase" /></label>
        </div>
        <p class="muted small">Z kodem promocja jest ukryta: nie pokazuje się w koszyku ani na stronie produktu i działa dopiero po wpisaniu kodu w zamówieniu (np. na kampanię lub newsletter).</p>
        ${kind === 'quantity' ? `
          <h3 class="sec__t">Produkty</h3>
          <div class="pm-prods">${promoProducts.map((x) => `<label class="check"><input type="checkbox" name="product_ids" value="${esc(x.id)}" ${p.product_ids.includes(x.id) ? 'checked' : ''} /> ${esc(x.name)}${x.active ? '' : ' <span class="muted">(nieaktywny)</span>'}</label>`).join('')}</div>
          <label class="check"><input type="checkbox" name="combined" ${p.combined ? 'checked' : ''} /> Sumuj sztuki różnych produktów z listy (np. 1 × krople + 1 × kapsułki = 2 szt.)</label>
          <h3 class="sec__t">Progi rabatu</h3>
          <p class="muted small">Rabat obejmuje wszystkie sztuki produktu od osiągniętego progu. Kwota jest odejmowana od każdej sztuki.</p>
          <div data-tiers>${p.tiers.map(tierRow).join('')}</div>
          <button type="button" class="btn btn--outline btn--sm" data-add-tier>+ Dodaj próg</button>`
        : `
          <h3 class="sec__t">Skład zestawu</h3>
          <div data-items>${p.items.map(itemRow).join('')}</div>
          <button type="button" class="btn btn--outline btn--sm" data-add-item>+ Dodaj produkt</button>
          <div class="code-form" style="margin-top:14px">
            <label class="field">Rodzaj rabatu<select class="input" name="type"><option value="percent" ${p.type !== 'amount' ? 'selected' : ''}>Procent od wartości zestawu (%)</option><option value="amount" ${p.type === 'amount' ? 'selected' : ''}>Kwota za każdy zestaw (zł)</option></select></label>
            <label class="field">Rabat<input class="input" name="value" inputmode="decimal" value="${esc(p.type === 'amount' ? zlInput(p.value) : p.value)}" /></label>
            <label class="field">Maks. zestawów w zamówieniu<input class="input" name="max_sets" type="number" min="1" max="100" value="${p.max_sets ?? ''}" placeholder="bez limitu" /></label>
          </div>`}
        <div class="code-form" style="margin-top:14px">
          <label class="field">Kolejność<input class="input" name="sort_order" type="number" min="0" max="9999" value="${esc(p.sort_order ?? 0)}" title="Niższa liczba = sprawdzana wcześniej (ważne przy kilku zestawach z tym samym produktem)" /></label>
          <label class="field code-form__wide">Notatka wewnętrzna<input class="input" name="description" value="${esc(p.description || '')}" maxlength="300" /></label>
          <label class="check code-form__wide"><input type="checkbox" name="with_codes" ${p.with_codes ? 'checked' : ''} /> Łączy się z kodami rabatowymi</label>
          ${id ? '' : '<label class="check code-form__wide"><input type="checkbox" name="active" checked /> Aktywna od razu</label>'}
        </div>
        <div class="box box--blue" data-pm-preview></div>
        <div class="actions">
          <button class="btn btn--sm">${id ? 'Zapisz promocję' : 'Utwórz promocję'}</button>
          ${id && !uses.length ? '<button type="button" class="btn btn--danger btn--sm" data-pm-del>Usuń</button>' : ''}
        </div>
        <p class="muted small">Zmiany działają na nowe zamówienia w ciągu minuty. Zamówienia złożone wcześniej zachowują naliczony rabat.</p>
      </form>
      ${id ? `<div class="sec">
        <h3 class="sec__t">Kto skorzystał <span class="muted">(${uses.length})</span></h3>
        ${uses.length ? `<div class="table-wrap"><table class="table">
          <thead><tr><th>Zamówienie</th><th>Data</th><th>Klient</th><th class="r">Rabat</th><th class="r">Kwota</th><th>Status</th></tr></thead>
          <tbody>${uses.map((u) => `<tr data-uo="${u.id}" class="clickrow" tabindex="0">
            <td class="nowrap"><strong>${u.number}</strong>${u.source === 'admin' ? '<span class="wc">panel</span>' : ''}</td>
            <td class="nowrap">${date(u.created_at)}</td>
            <td>${u.name ? `<strong>${esc(u.name)}</strong><br>` : ''}${u.customer_id ? `<button type="button" class="link" data-open-customer="${u.customer_id}" data-stop>${esc(u.email)}</button>` : esc(u.email)}</td>
            <td class="r nowrap">${pln(u.amount)}</td>
            <td class="r nowrap">${pln(u.total)}</td>
            <td><span class="st st--${u.status}">${STATUS[u.status] || esc(u.status)}</span></td>
          </tr>`).join('')}</tbody></table></div>
          <p class="muted small">Statystyki liczą tylko zamówienia opłacone, wysłane i zrealizowane. Na liście są też nieopłacone i anulowane - patrz status.</p>`
        : '<p class="muted">Nikt jeszcze nie skorzystał z tej promocji.</p>'}
      </div>` : ''}`;

    bindLinks(body);
    body.querySelectorAll<HTMLElement>('tr[data-uo]').forEach((tr) => {
      const go = (e: Event) => { if ((e.target as HTMLElement).closest('[data-stop]')) return; openOrder(tr.dataset.uo!); };
      tr.addEventListener('click', go); tr.addEventListener('keydown', (e) => { if ((e as KeyboardEvent).key === 'Enter') go(e); });
    });
    const form = body.querySelector<HTMLFormElement>('[data-promo-form]')!;
    const money = (x: string) => Math.round(Number(x.replace(/\s/g, '').replace(',', '.')) * 100);

    // Odczyt formularza → dane do API i do podglądu (kwoty w groszach dla podglądu)
    const collect = () => {
      const fd = new FormData(form);
      const out: Record<string, any> = {
        kind, name: String(fd.get('name') || ''), label: String(fd.get('label') || ''),
        starts_at: fd.get('starts_at') ? `${fd.get('starts_at')}T00:00:00` : '', ends_at: fd.get('ends_at') ? `${fd.get('ends_at')}T23:59:59` : '',
        sort_order: Number(fd.get('sort_order') || 0), description: String(fd.get('description') || ''),
        with_codes: fd.get('with_codes') !== null, active: id ? p.active : fd.get('active') !== null,
        code: String(fd.get('code') || '').trim().toUpperCase(),
      };
      if (kind === 'quantity') {
        out.product_ids = fd.getAll('product_ids').map(String);
        out.combined = fd.get('combined') !== null;
        out.tiers = [...form.querySelectorAll<HTMLElement>('[data-tier]')].map((r) => ({
          min: (r.querySelector('[data-t-min]') as HTMLInputElement).value,
          type: (r.querySelector('[data-t-type]') as HTMLSelectElement).value,
          value: (r.querySelector('[data-t-value]') as HTMLInputElement).value,
        }));
      } else {
        out.items = [...form.querySelectorAll<HTMLElement>('[data-item]')].map((r) => ({
          product_id: (r.querySelector('[data-i-prod]') as HTMLSelectElement).value,
          qty: Number((r.querySelector('[data-i-qty]') as HTMLInputElement).value) || 1,
        })).filter((i) => i.product_id);
        out.type = String(fd.get('type')); out.value = String(fd.get('value') || ''); out.max_sets = String(fd.get('max_sets') || '');
      }
      return out;
    };
    // Podgląd: przykładowy koszyk policzony tym samym silnikiem co sklep
    const preview = () => {
      const c = collect();
      const box = form.querySelector<HTMLElement>('[data-pm-preview]')!;
      const price = (pid: string) => promoProducts.find((x) => x.id === pid)?.price ?? 0;
      const promo = normalizePromotion({
        id: 'podglad', name: c.name || 'Promocja', kind, active: true, product_ids: c.product_ids, combined: c.combined,
        tiers: (c.tiers || []).map((t: any) => ({ min: Number(t.min), type: t.type, value: t.type === 'amount' ? money(String(t.value)) : Number(String(t.value).replace(',', '.')) })),
        items: c.items, type: c.type, value: c.type === 'amount' ? money(String(c.value || '')) : Number(String(c.value || '').replace(',', '.')), max_sets: c.max_sets || null, with_codes: true,
      });
      promo.code = null; // podgląd zawsze bez kodu
      let lines: { product_id: string; qty: number; unit_price: number }[][] = [];
      if (kind === 'quantity') {
        const pid = promo.product_ids.find((x) => price(x) > 0);
        if (pid) lines = promo.tiers.filter((t) => t.min >= 2 && t.value > 0).map((t) => [{ product_id: pid, qty: t.min, unit_price: price(pid) }]);
      } else if (promo.items.length >= 2 && promo.items.every((i) => price(i.product_id) > 0)) {
        lines = [promo.items.map((i) => ({ product_id: i.product_id, qty: i.qty, unit_price: price(i.product_id) }))];
      }
      if (!lines.length) { box.innerHTML = '<span class="muted">Podgląd pojawi się po wybraniu produktów z ceną i ustawieniu rabatu.</span>'; return; }
      box.innerHTML = '<strong>Przykład (ceny regularne, bez innych promocji)</strong>' + lines.map((l) => {
        const gross = l.reduce((a, x) => a + x.unit_price * x.qty, 0);
        const disc = applyPromotions(l, [promo]).total;
        return `<span>${l.map((x) => `${esc(pName(x.product_id))} × ${x.qty}`).join(' + ')}: ${pln(gross)} → <strong>${pln(gross - disc)}</strong>${disc ? ` <span class="muted">(−${pln(disc)})</span>` : ''}</span>`;
      }).join('');
    };
    form.addEventListener('input', preview);
    form.addEventListener('change', preview);
    form.addEventListener('click', (e) => {
      const t = e.target as HTMLElement;
      const del = t.closest('[data-row-del]');
      if (del) { del.closest('.pm-row')!.remove(); preview(); return; }
      if (t.closest('[data-add-tier]')) { form.querySelector('[data-tiers]')!.insertAdjacentHTML('beforeend', tierRow()); return; }
      if (t.closest('[data-add-item]')) { form.querySelector('[data-items]')!.insertAdjacentHTML('beforeend', itemRow()); return; }
    });
    preview();
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      try {
        const r = await api('/api/admin/promocje', { action: id ? 'update' : 'create', ...(id ? { id } : {}), ...collect() });
        toast(id ? 'Zapisano promocję.' : 'Promocja utworzona.');
        loadPromos();
        openPromo(id || r.row.id, false);
      } catch (err) { toast((err as Error).message, true); }
    });
    form.querySelector('[data-pm-del]')?.addEventListener('click', async () => {
      if (!confirm('Usunąć promocję? Tej operacji nie można cofnąć.')) return;
      try { await api('/api/admin/promocje', { action: 'delete', id }); toast('Usunięto promocję.'); loadPromos(); openDrawer(false); }
      catch (err) { toast((err as Error).message, true); }
    });
  }

  // ---------- Kody rabatowe ----------
  async function loadCodes() {
    const tbody = $('[data-codes]');
    tbody.innerHTML = '<tr><td colspan="7" class="empty">Ładowanie…</td></tr>';
    try {
      const { rows } = await api('/api/admin/kody');
      const d = (s: string | null) => (s ? new Date(s).toLocaleDateString('pl-PL') : '');
      tbody.innerHTML = rows.length ? rows.map((c: any) => `
        <tr data-cid="${c.id}" tabindex="0" class="clickrow" title="Edytuj kod i zobacz, kto go użył">
          <td><strong>${esc(c.code)}</strong>${c.description ? `<br><span class="muted">${esc(c.description)}</span>` : ''}</td>
          <td class="nowrap">${c.type === 'percent' ? `${c.value}%` : pln(c.value)}</td>
          <td>${c.min_total ? `od ${pln(c.min_total)}` : '-'}${c.once_per_customer ? '<br><span class="muted">1× na klienta</span>' : ''}</td>
          <td class="nowrap">${c.starts_at || c.ends_at ? `${d(c.starts_at) || '…'} - ${d(c.ends_at) || '…'}` : 'bezterminowo'}</td>
          <td>${c.used_count}${c.max_uses ? ` / ${c.max_uses}` : ''}</td>
          <td class="r">${c.stats.orders}${c.stats.last ? `<br><span class="muted">ost. ${new Date(c.stats.last).toLocaleDateString('pl-PL')}</span>` : ''}</td>
          <td class="r nowrap"><strong>${pln(c.stats.revenue)}</strong>${c.stats.orders ? `<br><span class="muted">śr. ${pln(Math.round(c.stats.revenue / c.stats.orders))}</span>` : ''}</td>
          <td class="r nowrap">${pln(c.stats.discount)}</td>
          <td>${c.customers?.email ? esc(c.customers.email) : 'wszyscy'}</td>
          <td data-stop><input type="checkbox" data-toggle="${c.id}" ${c.active ? 'checked' : ''} aria-label="Aktywny" /></td>
        </tr>`).join('') : '<tr><td colspan="10" class="empty">Brak kodów. Utwórz pierwszy powyżej.</td></tr>';
      tbody.querySelectorAll<HTMLInputElement>('[data-toggle]').forEach((cb) => cb.addEventListener('change', async () => {
        try { await api('/api/admin/kody', { action: 'toggle', id: cb.dataset.toggle, active: cb.checked }); toast(cb.checked ? 'Kod włączony.' : 'Kod wyłączony.'); }
        catch (e) { cb.checked = !cb.checked; toast((e as Error).message, true); }
      }));
      tbody.querySelectorAll<HTMLElement>('tr[data-cid]').forEach((tr) => {
        const go = (e: Event) => { if ((e.target as HTMLElement).closest('[data-stop]')) return; openCode(tr.dataset.cid!); };
        tr.addEventListener('click', go); tr.addEventListener('keydown', (e) => { if ((e as KeyboardEvent).key === 'Enter') go(e); });
      });
    } catch (e) {
      tbody.innerHTML = `<tr><td colspan="7" class="empty err">${esc((e as Error).message)}</td></tr>`;
    }
  }
  // Szczegóły kodu: edycja + lista zamówień, w których go użyto
  async function openCode(id: string, push = true) {
    $('[data-drawer]').classList.toggle('drawer--wide', true);
    openDrawer(true); drawerNav(() => openCode(id, false), push);
    $('[data-drawer]').classList.add('drawer--wide');
    const body = $('[data-d-body]');
    body.innerHTML = '<p class="muted">Ładowanie…</p>';
    let d: any;
    try { d = await api(`/api/admin/kody?uses=${encodeURIComponent(id)}`); }
    catch (e) { body.innerHTML = `<p class="err">${esc((e as Error).message)}</p>`; return; }
    const c = d.code;
    const uses: any[] = d.uses;
    $('[data-d-title]').textContent = `Kod ${c.code}`;
    const day = (iso: string | null) => (iso ? new Date(new Date(iso).getTime() - new Date(iso).getTimezoneOffset() * 60000).toISOString().slice(0, 10) : '');
    const val = c.type === 'percent' ? String(c.value) : (c.value / 100).toFixed(2).replace('.', ',');
    const paidSt = new Set(['paid', 'packing', 'shipped', 'completed']);
    const paidUses = uses.filter((u) => paidSt.has(u.status));
    const nameLocked = c.used_count > 0 || uses.length > 0;
    body.innerHTML = `
      <div class="meta"><span class="st ${c.active ? 'st--shipped' : 'st--pending_payment'}">${c.active ? 'Aktywny' : 'Wyłączony'}</span><span>Użycia: ${c.used_count}${c.max_uses ? ` / ${c.max_uses}` : ''}</span><span>Opłacone zamówienia: ${paidUses.length}</span><span>Udzielony rabat: ${pln(paidUses.reduce((s2, u) => s2 + (u.amount || 0), 0))}</span></div>
      <form class="sec" data-code-edit novalidate>
        <h3 class="sec__t">Ustawienia kodu</h3>
        <div class="code-form">
          <label class="field">Kod<input class="input" name="code" value="${esc(c.code)}" maxlength="30" style="text-transform:uppercase" ${nameLocked ? 'readonly title="Kod był użyty - nazwy nie można zmienić"' : ''} /></label>
          <label class="field">Rodzaj<select class="input" name="type"><option value="percent" ${c.type === 'percent' ? 'selected' : ''}>Procent (%)</option><option value="amount" ${c.type === 'amount' ? 'selected' : ''}>Kwota (zł)</option></select></label>
          <label class="field">Wartość<input class="input" name="value" value="${esc(val)}" inputmode="decimal" /></label>
          <label class="field">Minimalna kwota (zł)<input class="input" name="min_total" value="${c.min_total ? (c.min_total / 100).toFixed(2).replace('.', ',') : ''}" inputmode="decimal" placeholder="0" /></label>
          <label class="field">Ważny od<input class="input" name="starts_at" type="date" value="${day(c.starts_at)}" /></label>
          <label class="field">Ważny do<input class="input" name="ends_at" type="date" value="${day(c.ends_at)}" /></label>
          <label class="field">Limit użyć (łącznie)<input class="input" name="max_uses" type="number" min="${Math.max(1, c.used_count)}" value="${c.max_uses ?? ''}" placeholder="bez limitu" /></label>
          <label class="field">Tylko dla klienta (e-mail)<input class="input" name="email" type="email" value="${esc(c.customers?.email || '')}" placeholder="puste = dla wszystkich" /></label>
          <label class="field code-form__wide">Opis widoczny na koncie klienta<input class="input" name="description" value="${esc(c.description || '')}" maxlength="200" placeholder="puste = kod nie jest pokazywany na kontach" /></label>
          <label class="check code-form__wide"><input type="checkbox" name="once_per_customer" ${c.once_per_customer ? 'checked' : ''} /> Jeden raz na klienta</label>
        </div>
        <p class="muted small">${nameLocked ? 'Kod był już użyty, więc jego nazwa jest zablokowana. ' : ''}Zmiany działają na nowe zamówienia. Zamówienia złożone wcześniej zachowują naliczony rabat.</p>
        <div class="actions"><button class="btn btn--sm">Zapisz kod</button></div>
      </form>
      <div class="sec">
        <h3 class="sec__t">Kto użył kodu <span class="muted">(${uses.length})</span></h3>
        ${uses.length ? `<div class="table-wrap"><table class="table">
          <thead><tr><th>Zamówienie</th><th>Data</th><th>Klient</th><th class="r">Rabat</th><th class="r">Kwota</th><th>Status</th></tr></thead>
          <tbody>${uses.map((u) => `<tr data-uo="${u.id}" class="clickrow" tabindex="0">
            <td class="nowrap"><strong>${u.number}</strong>${u.source === 'woocommerce' ? '<span class="wc">WC</span>' : u.source === 'admin' ? '<span class="wc">panel</span>' : ''}</td>
            <td class="nowrap">${date(u.created_at)}</td>
            <td>${u.name ? `<strong>${esc(u.name)}</strong><br>` : ''}${u.customer_id ? `<button type="button" class="link" data-open-customer="${u.customer_id}" data-stop>${esc(u.email)}</button>` : esc(u.email)}</td>
            <td class="r nowrap">${pln(u.amount)}</td>
            <td class="r nowrap">${pln(u.total)}</td>
            <td><span class="st st--${u.status}">${STATUS[u.status] || esc(u.status)}</span></td>
          </tr>`).join('')}</tbody></table></div>
          <p class="muted small">Licznik „Użycia” rośnie dopiero po opłaceniu zamówienia. Na liście są też zamówienia nieopłacone i anulowane - patrz status.</p>`
        : '<p class="muted">Nikt jeszcze nie użył tego kodu.</p>'}
      </div>`;
    bindLinks(body);
    body.querySelectorAll<HTMLElement>('tr[data-uo]').forEach((tr) => {
      const go = (e: Event) => { if ((e.target as HTMLElement).closest('[data-stop]')) return; openOrder(tr.dataset.uo!); };
      tr.addEventListener('click', go); tr.addEventListener('keydown', (e) => { if ((e as KeyboardEvent).key === 'Enter') go(e); });
    });
    body.querySelector<HTMLFormElement>('[data-code-edit]')!.addEventListener('submit', async (e) => {
      e.preventDefault();
      const fd = new FormData(e.target as HTMLFormElement);
      const p: Record<string, unknown> = Object.fromEntries([...fd.entries()].map(([k, v]) => [k, String(v)]));
      p.once_per_customer = fd.get('once_per_customer') !== null;
      if (p.starts_at) p.starts_at = `${p.starts_at}T00:00:00`;
      if (p.ends_at) p.ends_at = `${p.ends_at}T23:59:59`;
      try { await api('/api/admin/kody', { action: 'update', id, ...p }); toast('Zapisano kod.'); loadCodes(); openCode(id, false); }
      catch (err) { toast((err as Error).message, true); }
    });
  }

  $<HTMLFormElement>('[data-code-form]').addEventListener('submit', async (e) => {
    e.preventDefault();
    const f = e.target as HTMLFormElement;
    const fd = new FormData(f);
    const body: Record<string, unknown> = Object.fromEntries([...fd.entries()].map(([k, v]) => [k, String(v)]));
    body.action = 'create';
    body.once_per_customer = fd.get('once_per_customer') !== null;
