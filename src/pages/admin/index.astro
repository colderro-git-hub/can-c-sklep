---
// Panel admina - styl z „Can - Design System” (Metrix). Niezależny od stylów sklepu.
import { FURGONETKA_PANEL_URL } from '../../config';
import '../../styles/admin.css';
---
<!doctype html>
<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Panel Can-C</title>
    <link rel="icon" href="/favicon/light" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Poppins:wght@400;500&display=swap" rel="stylesheet" />
  </head>
  <body data-furgonetka={FURGONETKA_PANEL_URL}>
    <div class="app">
      <aside class="side" aria-label="Nawigacja panelu">
        <a href="/admin/" class="logo" aria-label="Panel Can-C">
          <span class="logo__mark" aria-hidden="true">C</span><span class="logo__text">Can-C</span>
        </a>
        <nav class="nav">
          <button type="button" class="nav__item" data-tab="dashboard" aria-current="page">
            <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="7" height="9" rx="1.5" /><rect x="14" y="3" width="7" height="5" rx="1.5" /><rect x="14" y="12" width="7" height="9" rx="1.5" /><rect x="3" y="16" width="7" height="5" rx="1.5" /></svg>
            <span>Pulpit</span><span class="badge" data-count-todo></span>
          </button>
          <button type="button" class="nav__item" data-tab="orders">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7.5 7.7V6.6a4.5 4.5 0 0 1 9 0v1.1M5.2 21h13.6a1.4 1.4 0 0 0 1.4-1.6L19 9a1.4 1.4 0 0 0-1.4-1.3H6.4A1.4 1.4 0 0 0 5 9L3.8 19.4A1.4 1.4 0 0 0 5.2 21Z" /></svg>
            <span>Zamówienia</span><span class="badge" data-count-paid></span>
          </button>
          <button type="button" class="nav__item" data-tab="mail">
            <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3.5 6.5 8.5 6 8.5-6" /></svg>
            <span>Korespondencja</span><span class="badge" data-count-mail></span>
          </button>
          <button type="button" class="nav__item" data-tab="customers">
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="9" cy="8" r="3.5" /><path d="M2.5 20c.6-3.4 3.3-5.5 6.5-5.5s5.9 2.1 6.5 5.5M16 4.8a3.5 3.5 0 0 1 0 6.4M18.5 14.8c1.6.8 2.7 2.6 3 5.2" /></svg>
            <span>Klienci</span>
          </button>
          <button type="button" class="nav__item" data-tab="products">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3.5 7.5 12 3l8.5 4.5v9L12 21l-8.5-4.5v-9ZM3.5 7.5 12 12m0 0 8.5-4.5M12 12v9" /></svg>
            <span>Produkty</span>
          </button>
          <button type="button" class="nav__item" data-tab="reviews">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m12 3 2.6 5.6 6 .7-4.5 4.1 1.2 6L12 16.4 6.7 19.4l1.2-6L3.4 9.3l6-.7L12 3Z" /></svg>
            <span>Opinie</span><span class="badge" data-count-reviews></span>
          </button>
          <button type="button" class="nav__item" data-tab="codes">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3.5 12.6V5a1.5 1.5 0 0 1 1.5-1.5h7.6l8 8a1.5 1.5 0 0 1 0 2.1l-7.4 7.4a1.5 1.5 0 0 1-2.1 0l-7.6-7.6Z" /><circle cx="8" cy="8" r="1.4" /></svg>
            <span>Kody rabatowe</span>
          </button>
          <button type="button" class="nav__item" data-tab="automations">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 7v5l3 2M21 12a9 9 0 1 1-3-6.7M21 4v4h-4" /></svg>
            <span>Automaty</span>
          </button>
          <button type="button" class="nav__item" data-tab="analytics">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 20h18M7 20V10M11 20V4M15 20v-7M19 20v-4"/></svg>
            <span>Analityka</span>
          </button>
          <button type="button" class="nav__item" data-tab="pages">
            <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2" /><path d="M7 8h10M7 12h6M7 16h4" /></svg>
            <span>Strony</span>
          </button>
          <button type="button" class="nav__item" data-tab="seo">
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" /><path d="M15.5 15.5 21 21M8 10.5h5M10.5 8v5" /></svg>
            <span>SEO</span>
          </button>
          <button type="button" class="nav__item" data-tab="settings">
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="3" /><path d="M19.4 15a1.6 1.6 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.6 1.6 0 0 0-1.8-.3 1.6 1.6 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.6 1.6 0 0 0-1-1.5 1.6 1.6 0 0 0-1.8.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.6 1.6 0 0 0 .3-1.8 1.6 1.6 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1a1.6 1.6 0 0 0 1.5-1 1.6 1.6 0 0 0-.3-1.8l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.6 1.6 0 0 0 1.8.3H9a1.6 1.6 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.6 1.6 0 0 0 1 1.5 1.6 1.6 0 0 0 1.8-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.6 1.6 0 0 0-.3 1.8V9a1.6 1.6 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.6 1.6 0 0 0-1.5 1Z" /></svg>
            <span>Ustawienia sklepu</span>
          </button>
        </nav>
        <div class="side__foot">
          <a href="/" class="nav__item nav__item--muted" target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 10.5 12 4l8 6.5V20a1 1 0 0 1-1 1h-4.5v-6h-5v6H5a1 1 0 0 1-1-1v-9.5Z" /></svg>
            <span>Otwórz sklep</span>
          </a>
          <a href="/cdn-cgi/access/logout" class="nav__item nav__item--danger">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 12H4m0 0 3.5-3.5M4 12l3.5 3.5M10 7V5.5A1.5 1.5 0 0 1 11.5 4h7A1.5 1.5 0 0 1 20 5.5v13a1.5 1.5 0 0 1-1.5 1.5h-7a1.5 1.5 0 0 1-1.5-1.5V17" /></svg>
            <span>Wyloguj</span>
          </a>
        </div>
      </aside>

      <div class="main">
        <header class="top">
          <div class="top__row">
            <h1 class="top__title" data-title>Pulpit</h1>
            <span class="top__user">Can-C · sklep</span>
          </div>
          <div class="crumbs"><span>Panel</span><span>/</span><span data-crumb>Pulpit</span></div>
        </header>

        <div class="content">
          <!-- ZAMÓWIENIA -->
          <section data-view="dashboard" class="stack">
            <div class="dash__today muted" data-dash-today></div>
            <div class="dash" data-dash><p class="muted">Ładowanie…</p></div>
          </section>

          <section data-view="orders" class="stack" hidden>
            <div class="kpis">
              <div class="kpi">
                <span class="kpi__icon kpi__icon--amber" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M7.5 7.7V6.6a4.5 4.5 0 0 1 9 0v1.1M5.2 21h13.6a1.4 1.4 0 0 0 1.4-1.6L19 9a1.4 1.4 0 0 0-1.4-1.3H6.4A1.4 1.4 0 0 0 5 9L3.8 19.4A1.4 1.4 0 0 0 5.2 21Z" /></svg></span>
                <div class="kpi__row">
                  <div class="kpi__m"><span class="kpi__label">Do wysłania</span><span class="kpi__value" data-k="paid">-</span></div>
                  <div class="kpi__m"><span class="kpi__label">Wstrzymane</span><span class="kpi__value" data-k="on_hold">-</span></div>
                  <div class="kpi__m"><span class="kpi__label">W drodze</span><span class="kpi__value" data-k="shipped">-</span></div>
                </div>
              </div>
              <div class="kpi">
                <span class="kpi__icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 19V5m0 14h16M8 15v-3m4 3V9m4 6V7" /></svg></span>
                <div class="kpi__row">
                  <div class="kpi__m"><span class="kpi__label">Sprzedaż dziś</span><span class="kpi__value" data-k="revenueToday">-</span></div>
                  <div class="kpi__m"><span class="kpi__label">Zamówienia dziś</span><span class="kpi__value" data-k="ordersToday">-</span></div>
                </div>
              </div>
              <div class="kpi">
                <span class="kpi__icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M7 3v3m10-3v3M4 9h16M5 5h14a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1Z" /></svg></span>
                <div class="kpi__row">
                  <div class="kpi__m"><span class="kpi__label">Sprzedaż 30 dni</span><span class="kpi__value" data-k="revenue30">-</span></div>
                  <div class="kpi__m"><span class="kpi__label">Zamówienia</span><span class="kpi__value" data-k="orders30">-</span></div>
                  <div class="kpi__m"><span class="kpi__label">Średnio</span><span class="kpi__value" data-k="avg30">-</span></div>
                </div>
              </div>
            </div>

            <div class="card">
              <div class="card__head">
                <h2 class="card__title">Zamówienia klientów</h2>
                <button type="button" class="btn btn--sm" data-new-order>+ Nowe zamówienie</button>
                <form class="search" data-search role="search">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5" /><path d="m20 20-4.2-4.2" /></svg>
                  <label class="sr-only" for="q">Szukaj</label>
                  <input id="q" name="q" type="search" placeholder="Numer lub e-mail" />
                </form>
              </div>
              <div class="tabs" role="tablist" aria-label="Status">
                <button type="button" class="tab" data-status="paid" aria-pressed="true">Do wysłania <span data-count="paid"></span></button>
                <button type="button" class="tab" data-status="packing" aria-pressed="false">Kompletowanie <span data-count="packing"></span></button>
                <button type="button" class="tab" data-status="on_hold" aria-pressed="false">Wstrzymane <span data-count="on_hold"></span></button>
                <button type="button" class="tab" data-status="shipped" aria-pressed="false">Wysłane</button>
                <button type="button" class="tab" data-status="pending_payment" aria-pressed="false">Czekają na płatność <span data-count="pending_payment"></span></button>
                <button type="button" class="tab" data-status="completed" aria-pressed="false">Zrealizowane</button>
                <button type="button" class="tab" data-status="cancelled" aria-pressed="false">Anulowane</button>
                <button type="button" class="tab" data-status="refunded" aria-pressed="false">Zwrócone</button>
                <button type="button" class="tab" data-status="" aria-pressed="false">Wszystkie</button>
              </div>
              <div class="bulk" data-bulk hidden>
                <strong data-bulk-count></strong>
                <select class="input" data-bulk-to aria-label="Zmień status zaznaczonych">
                  <option value="pack">→ Kompletowanie (mail do klienta)</option>
                  <option value="complete">→ Zrealizowane</option>
                  <option value="hold">→ Wstrzymane</option>
                  <option value="unhold">→ Przywróć do wysłania</option>
                  <option value="cancel">→ Anuluj</option>
                </select>
                <label class="check" data-bulk-notify-wrap><input type="checkbox" data-bulk-notify checked /> Wyślij e-maile</label>
                <button type="button" class="btn btn--sm" data-bulk-go>Zmień status</button>
                <button type="button" class="link" data-bulk-clear>Odznacz</button>
              </div>
              <div class="table-wrap">
                <table class="table">
                  <thead><tr><th class="cb" data-stop><input type="checkbox" data-sel-all aria-label="Zaznacz wszystkie na stronie" /></th><th>Nr</th><th>Data</th><th>Klient</th><th>Produkty</th><th>Dostawa</th><th class="r">Kwota</th><th>Status</th></tr></thead>
                  <tbody data-rows></tbody>
                </table>
              </div>
              <div class="pager">
                <span class="muted" data-page></span>
                <div class="pager__btns">
                  <button type="button" class="icon-btn" data-prev aria-label="Poprzednia strona"><svg viewBox="0 0 24 24"><path d="m14.5 6-6 6 6 6" /></svg></button>
                  <button type="button" class="icon-btn" data-next aria-label="Następna strona"><svg viewBox="0 0 24 24"><path d="m9.5 6 6 6-6 6" /></svg></button>
                </div>
              </div>
            </div>
          </section>

          <!-- KLIENCI -->
          <section data-view="mail" class="mb" hidden>
            <p class="notice" data-mb-warn hidden>Nadawca to onboarding@resend.dev - do czasu weryfikacji domeny can-c.pl w Resend odpowiedzi dojdą tylko na adres właściciela konta Resend.</p>
            <div class="mb__bar">
              <div class="tabs mb__folders" role="group" aria-label="Foldery">
                <button type="button" class="tab" data-mb-folder="inbox" aria-pressed="true">Odebrane <span data-mb-count="inbox"></span></button>
                <button type="button" class="tab" data-mb-folder="closed" aria-pressed="false">Zamknięte</button>
                <button type="button" class="tab" data-mb-folder="system" aria-pressed="false">Systemowe <span data-mb-count="system"></span></button>
                <button type="button" class="tab" data-mb-folder="other" aria-pressed="false">Inne adresy <span data-mb-count="other"></span></button>
                <button type="button" class="tab" data-mb-folder="spam" aria-pressed="false">Spam</button>
              </div>
              <form class="mb__search" data-mb-search role="search">
                <input class="input" type="search" name="q" placeholder="Szukaj: temat, e-mail, imię, treść" aria-label="Szukaj w korespondencji" />
                <button type="button" class="icon-btn" data-mb-refresh aria-label="Odśwież"><svg viewBox="0 0 24 24"><path d="M20 11a8 8 0 1 0-2.3 5.7M20 4v7h-7" /></svg></button>
              </form>
            </div>
            <div class="mb__grid">
              <div class="mb__list card" data-mb-list><p class="muted">Ładowanie…</p></div>
              <div class="mb__thread card" data-mb-thread>
                <div class="mb__empty"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3.5 6.5 8.5 6 8.5-6" /></svg><p class="muted">Wybierz wątek z listy.</p></div>
              </div>
            </div>
          </section>

          <section data-view="customers" class="stack" hidden>
            <div class="card">
              <div class="card__head">
                <h2 class="card__title">Klienci <span class="muted" data-c-total></span></h2>
                <div class="actions">
                  <a class="btn btn--outline btn--sm" data-c-csv href="/api/admin/klienci?format=csv">Pobierz CSV</a>
                  <a class="btn btn--outline btn--sm" data-c-match href="/api/admin/klienci?format=match" title="Lista do Google Ads / Meta - tylko osoby ze zgodą marketingową">Eksport Customer Match</a>
                </div>
              </div>
              <div class="tabs" role="tablist" aria-label="Segmenty klientów">
                <button type="button" class="tab" data-seg="" aria-pressed="true">Wszyscy</button>
                <button type="button" class="tab" data-seg="treatment" aria-pressed="false" title="Koniec kuracji w ciągu 3 tygodni albo w ostatnich 2 tygodniach">Kończy się kuracja</button>
                <button type="button" class="tab" data-seg="regular" aria-pressed="false" title="2 i więcej opłaconych zamówień">Stali klienci</button>
                <button type="button" class="tab" data-seg="winback" aria-pressed="false" title="2+ zamówienia, ostatnie ponad 60 dni temu">Do odzyskania</button>
                <button type="button" class="tab" data-seg="one_time" aria-pressed="false" title="1 zamówienie ponad 60 dni temu">Jeden zakup, nie wrócili</button>
                <button type="button" class="tab" data-seg="new" aria-pressed="false">Nowi (30 dni)</button>
                <button type="button" class="tab" data-seg="consent" aria-pressed="false">Ze zgodą marketingową</button>
                <button type="button" class="tab" data-seg="no_orders" aria-pressed="false">Bez zakupów</button>
              </div>
              <form class="c-tools" data-c-search role="search">
                <span class="search search--wide">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5" /><path d="m20 20-4.2-4.2" /></svg>
                  <label class="sr-only" for="cq">Szukaj klienta</label>
                  <input id="cq" type="search" placeholder="Imię i nazwisko, e-mail, telefon, miejscowość" />
                </span>
                <label class="check"><input type="checkbox" data-c-buyers /> Tylko kupujący</label>
              </form>
              <div class="table-wrap">
                <table class="table">
                  <thead><tr data-c-head>
                    <th data-sort="name">Imię i nazwisko</th><th data-sort="last_active">Ostatnio aktywny</th><th data-sort="created">Data rejestracji</th><th data-sort="email">E-mail</th>
                    <th data-sort="orders" class="r">Zamówienia</th><th data-sort="spent" class="r">Suma wydatków</th><th data-sort="avg" class="r">Średnia wartość</th>
                    <th data-sort="country">Kraj</th><th data-sort="city">Miejscowość</th><th data-sort="postcode">Kod pocztowy</th><th data-sort="phone">Telefon</th>
                  </tr></thead>
                  <tbody data-c-rows></tbody>
                </table>
              </div>
              <div class="pager">
                <span class="muted" data-c-page></span>
                <div class="pager__btns">
                  <label class="field field--inline">Wierszy na stronie
                    <select class="input sm" data-c-size><option>50</option><option>100</option><option>200</option><option>500</option></select>
                  </label>
                  <button type="button" class="icon-btn" data-c-prev aria-label="Poprzednia strona"><svg viewBox="0 0 24 24"><path d="m14.5 6-6 6 6 6" /></svg></button>
                  <button type="button" class="icon-btn" data-c-next aria-label="Następna strona"><svg viewBox="0 0 24 24"><path d="m9.5 6 6 6-6 6" /></svg></button>
                </div>
              </div>
            </div>
          </section>

          <!-- PRODUKTY -->
          <section data-view="products" class="stack" hidden>
            <div class="card">
              <div class="card__head">
                <h2 class="card__title">Produkty</h2>
                <div class="actions">
                  <a class="btn btn--outline btn--sm" href="/feed/google.xml" target="_blank" rel="noopener">Feed Google Merchant</a>
                  <button type="button" class="btn btn--sm" data-new-product>+ Nowy produkt</button>
                </div>
              </div>
              <div class="table-wrap">
                <table class="table">
                  <thead><tr><th></th><th>Produkt</th><th class="r">Cena</th><th class="r">Stan</th><th>Dostępność</th><th>Opinie</th><th>Status</th></tr></thead>
                  <tbody data-products></tbody>
                </table>
              </div>
            </div>
          </section>

          <!-- OPINIE -->
          <section data-view="reviews" class="stack" hidden>
            <div class="card">
              <div class="card__head">
                <h2 class="card__title">Opinie o produktach</h2>
                <div class="actions">
                  <a class="btn btn--outline btn--sm" href="/feed/opinie.xml" target="_blank" rel="noopener">Feed opinii Google</a>
                  <button type="button" class="btn btn--sm" data-new-review>+ Dodaj opinię</button>
                </div>
              </div>
              <div class="tabs" role="tablist" aria-label="Status opinii">
                <button type="button" class="tab" data-rstatus="pending" aria-pressed="true">Do moderacji <span data-rcount></span></button>
                <button type="button" class="tab" data-rstatus="approved" aria-pressed="false">Opublikowane</button>
                <button type="button" class="tab" data-rstatus="rejected" aria-pressed="false">Odrzucone</button>
                <button type="button" class="tab" data-rstatus="" aria-pressed="false">Wszystkie</button>
              </div>
              <div class="table-wrap">
                <table class="table">
                  <thead><tr><th>Data</th><th>Produkt</th><th>Autor</th><th>Ocena</th><th>Treść</th><th>Status</th><th></th></tr></thead>
                  <tbody data-reviews></tbody>
                </table>
              </div>
            </div>
          </section>
          <!-- AUTOMATY -->
          <section data-view="automations" class="stack" hidden>
            <div class="seo-tabs" role="tablist" aria-label="Automaty">
              <button type="button" role="tab" class="seo-tab" aria-selected="true" data-auto-tab="reminders">Przypomnienia o kuracji</button>
              <button type="button" role="tab" class="seo-tab" aria-selected="false" data-auto-tab="reviews">Prośba o opinię</button>
              <button type="button" role="tab" class="seo-tab" aria-selected="false" data-auto-tab="newsletter">Newsletter</button>
            </div>
            <div data-auto-pane="reviews" class="stack" hidden>
              <div class="card">
                <div class="card__head"><h2 class="card__title">Prośba o opinię po wysyłce</h2><span class="st" data-rr-state></span></div>
                <p class="muted">Kilka dni po wysyłce klient dostaje maila z produktami z zamówienia i gwiazdkami 1-5. Kliknięcie otwiera formularz opinii z wybraną oceną; opinia dostaje „Zweryfikowany zakup” i trafia do moderacji (Opinie). Wysyłka raz na zamówienie, tylko produkty, których klient jeszcze nie ocenił. Działa w tym samym codziennym cronie co przypomnienia o kuracji.</p>
                <form class="code-form" data-rr-form novalidate>
                  <label class="check code-form__wide"><input type="checkbox" name="enabled" /> Automat włączony</label>
