  .pager { display: flex; justify-content: space-between; align-items: center; gap: 12px; padding-top: 4px; font-size: 13px; }
  .pager__btns { display: flex; gap: 8px; }
  .icon-btn { width: 36px; height: 36px; border: 0; border-radius: var(--r-md); background: var(--muted-bg); color: var(--ink-100); display: grid; place-items: center; cursor: pointer; }
  .icon-btn svg { width: 18px; height: 18px; }
  .icon-btn:disabled { opacity: .35; cursor: default; }

  /* Przyciski i pola */
  .btn { border: 0; cursor: pointer; height: 44px; padding: 0 20px; border-radius: var(--r-lg); background: var(--primary); color: #fff; font: 400 14px var(--font); display: inline-flex; align-items: center; justify-content: center; gap: 8px; text-decoration: none; }
  .btn:hover { background: var(--primary-pressed); color: #fff; }
  .btn--outline { background: transparent; color: var(--primary); box-shadow: inset 0 0 0 2px var(--primary); }
  .btn--outline:hover { background: var(--primary-a08); color: var(--primary); }
  .btn--danger { background: transparent; color: var(--danger-ink); box-shadow: inset 0 0 0 2px var(--danger); }
  .btn--danger:hover { background: var(--danger-a16); color: var(--danger-ink); }
