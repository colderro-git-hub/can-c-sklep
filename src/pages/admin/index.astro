---
// Panel admina – styl z „Can - Design System” (Metrix). Niezależny od stylów sklepu.
import { FURGONETKA_PANEL_URL } from '../../config';
---
<!doctype html>
<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Panel Can-C</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Poppins:wght@400;500&display=swap" rel="stylesheet" />
  </head>
  <body data-furgonetka={FURGONETKA_PANEL_URL}>
    <div class="app">
      <aside class="side" aria-label="Nawigacja panelu">
        <a href="/admin/" class="logo" aria-label="Panel Can-C">
          <span class="logo__mark" aria-hidden="true">C</span><span class="logo__text">Can-C</span>
        </a>
        <nav class="nav">
          <button type="button" class="nav__item" data-tab="orders" aria-current="page">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7.5 7.7V6.6a4.5 4.5 0 0 1 9 0v1.1M5.2 21h13.6a1.4 1.4 0 0 0 1.4-1.6L19 9a1.4 1.4 0 0 0-1.4-1.3H6.4A1.4 1.4 0 0 0 5 9L3.8 19.4A1.4 1.4 0 0 0 5.2 21Z" /></svg>
            <span>Zamówienia</span><span class="badge" data-count-paid></span>
          </button>
          <button type="button" class="nav__item" data-tab="customers">
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="9" cy="8" r="3.5" /><path d="M2.5 20c.6-3.4 3.3-5.5 6.5-5.5s5.9 2.1 6.5 5.5M16 4.8a3.5 3.5 0 0 1 0 6.4M18.5 14.8c1.6.8 2.7 2.6 3 5.2" /></svg>
            <span>Klienci</span>
          </button>
          <button type="button" class="nav__item" data-tab="products">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3.5 7.5 12 3l8.5 4.5v9L12 21l-8.5-4.5v-9ZM3.5 7.5 12 12m0 0 8.5-4.5M12 12v9" /></svg>
            <span>Produkty</span>
          </button>
          <button type="button" class="nav__item" data-tab="reviews">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m12 3 2.6 5.6 6 .7-4.5 4.1 1.2 6L12 16.4 6.7 19.4l1.2-6L3.4 9.3l6-.7L12 3Z" /></svg>
            <span>Opinie</span><span class="badge" data-count-reviews></span>
          </button>
          <button type="button" class="nav__item" data-tab="codes">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3.5 12.6V5a1.5 1.5 0 0 1 1.5-1.5h7.6l8 8a1.5 1.5 0 0 1 0 2.1l-7.4 7.4a1.5 1.5 0 0 1-2.1 0l-7.6-7.6Z" /><circle cx="8" cy="8" r="1.4" /></svg>
            <span>Kody rabatowe</span>
          </button>
          <button type="button" class="nav__item" data-tab="automations">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 7v5l3 2M21 12a9 9 0 1 1-3-6.7M21 4v4h-4" /></svg>
            <span>Automaty</span>
          </button>
          <button type="button" class="nav__item" data-tab="settings">
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="3" /><path d="M19.4 15a1.6 1.6 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.6 1.6 0 0 0-1.8-.3 1.6 1.6 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.6 1.6 0 0 0-1-1.5 1.6 1.6 0 0 0-1.8.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.6 1.6 0 0 0 .3-1.8 1.6 1.6 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1a1.6 1.6 0 0 0 1.5-1 1.6 1.6 0 0 0-.3-1.8l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.6 1.6 0 0 0 1.8.3H9a1.6 1.6 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.6 1.6 0 0 0 1 1.5 1.6 1.6 0 0 0 1.8-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.6 1.6 0 0 0-.3 1.8V9a1.6 1.6 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.6 1.6 0 0 0-1.5 1Z" /></svg>
            <span>Ustawienia sklepu</span>
          </button>
        </nav>
        <div class="side__foot">
          <a href="/" class="nav__item nav__item--muted" target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 10.5 12 4l8 6.5V20a1 1 0 0 1-1 1h-4.5v-6h-5v6H5a1 1 0 0 1-1-1v-9.5Z" /></svg>
            <span>Otwórz sklep</span>
          </a>
          <a href="/cdn-cgi/access/logout" class="nav__item nav__item--danger">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 12H4m0 0 3.5-3.5M4 12l3.5 3.5M10 7V5.5A1.5 1.5 0 0 1 11.5 4h7A1.5 1.5 0 0 1 20 5.5v13a1.5 1.5 0 0 1-1.5 1.5h-7a1.5 1.5 0 0 1-1.5-1.5V17" /></svg>
            <span>Wyloguj</span>
          </a>
        </div>
      </aside>

      <div class="main">
        <header class="top">
          <div class="top__row">
            <h1 class="top__title" data-title>Zamówienia</h1>
            <span class="top__user">Can-C · sklep</span>
          </div>
          <div class="crumbs"><span>Panel</span><span>/</span><span data-crumb>Zamówienia</span></div>
        </header>

        <div class="content">
          <!-- ZAMÓWIENIA -->
          <section data-view="orders" class="stack">
            <div class="kpis">
              <div class="kpi">
                <span class="kpi__icon kpi__icon--amber" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M7.5 7.7V6.6a4.5 4.5 0 0 1 9 0v1.1M5.2 21h13.6a1.4 1.4 0 0 0 1.4-1.6L19 9a1.4 1.4 0 0 0-1.4-1.3H6.4A1.4 1.4 0 0 0 5 9L3.8 19.4A1.4 1.4 0 0 0 5.2 21Z" /></svg></span>
                <div class="kpi__row">
                  <div class="kpi__m"><span class="kpi__label">Do wysłania</span><span class="kpi__value" data-k="paid">–</span></div>
                  <div class="kpi__m"><span class="kpi__label">Wstrzymane</span><span class="kpi__value" data-k="on_hold">–</span></div>
                  <div class="kpi__m"><span class="kpi__label">W drodze</span><span class="kpi__value" data-k="shipped">–</span></div>
                </div>
              </div>
              <div class="kpi">
                <span class="kpi__icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 19V5m0 14h16M8 15v-3m4 3V9m4 6V7" /></svg></span>
                <div class="kpi__row">
                  <div class="kpi__m"><span class="kpi__label">Sprzedaż dziś</span><span class="kpi__value" data-k="revenueToday">–</span></div>
                  <div class="kpi__m"><span class="kpi__label">Zamówienia dziś</span><span class="kpi__value" data-k="ordersToday">–</span></div>
                </div>
              </div>
              <div class="kpi">
                <span class="kpi__icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M7 3v3m10-3v3M4 9h16M5 5h14a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1Z" /></svg></span>
                <div class="kpi__row">
                  <div class="kpi__m"><span class="kpi__label">Sprzedaż 30 dni</span><span class="kpi__value" data-k="revenue30">–</span></div>
                  <div class="kpi__m"><span class="kpi__label">Zamówienia</span><span class="kpi__value" data-k="orders30">–</span></div>
                  <div class="kpi__m"><span class="kpi__label">Średnio</span><span class="kpi__value" data-k="avg30">–</span></div>
                </div>
              </div>
            </div>

            <div class="card">
              <div class="card__head">
                <h2 class="card__title">Zamówienia klientów</h2>
                <button type="button" class="btn btn--sm" data-new-order>+ Nowe zamówienie</button>
                <form class="search" data-search role="search">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5" /><path d="m20 20-4.2-4.2" /></svg>
                  <label class="sr-only" for="q">Szukaj</label>
                  <input id="q" name="q" type="search" placeholder="Numer lub e-mail" />
                </form>
              </div>
              <div class="tabs" role="tablist" aria-label="Status">
                <button type="button" class="tab" data-status="paid" aria-pressed="true">Do wysłania <span data-count="paid"></span></button>
                <button type="button" class="tab" data-status="on_hold" aria-pressed="false">Wstrzymane <span data-count="on_hold"></span></button>
                <button type="button" class="tab" data-status="shipped" aria-pressed="false">Wysłane</button>
                <button type="button" class="tab" data-status="pending_payment" aria-pressed="false">Czekają na płatność <span data-count="pending_payment"></span></button>
                <button type="button" class="tab" data-status="completed" aria-pressed="false">Zrealizowane</button>
                <button type="button" class="tab" data-status="cancelled" aria-pressed="false">Anulowane</button>
                <button type="button" class="tab" data-status="" aria-pressed="false">Wszystkie</button>
              </div>
              <div class="table-wrap">
                <table class="table">
                  <thead><tr><th>Nr</th><th>Data</th><th>Klient</th><th>Produkty</th><th>Dostawa</th><th class="r">Kwota</th><th>Status</th></tr></thead>
                  <tbody data-rows></tbody>
                </table>
              </div>
              <div class="pager">
                <span class="muted" data-page></span>
                <div class="pager__btns">
                  <button type="button" class="icon-btn" data-prev aria-label="Poprzednia strona"><svg viewBox="0 0 24 24"><path d="m14.5 6-6 6 6 6" /></svg></button>
                  <button type="button" class="icon-btn" data-next aria-label="Następna strona"><svg viewBox="0 0 24 24"><path d="m9.5 6 6 6-6 6" /></svg></button>
                </div>
              </div>
            </div>
          </section>

          <!-- KLIENCI -->
          <section data-view="customers" class="stack" hidden>
            <div class="card">
              <div class="card__head">
                <h2 class="card__title">Klienci <span class="muted" data-c-total></span></h2>
                <div class="actions">
                  <a class="btn btn--outline btn--sm" data-c-csv href="/api/admin/klienci?format=csv">Pobierz CSV</a>
                  <a class="btn btn--outline btn--sm" data-c-match href="/api/admin/klienci?format=match" title="Lista do Google Ads / Meta – tylko osoby ze zgodą marketingową">Eksport Customer Match</a>
                </div>
              </div>
              <div class="tabs" role="tablist" aria-label="Segmenty klientów">
                <button type="button" class="tab" data-seg="" aria-pressed="true">Wszyscy</button>
                <button type="button" class="tab" data-seg="treatment" aria-pressed="false" title="Koniec kuracji w ciągu 3 tygodni albo w ostatnich 2 tygodniach">Kończy się kuracja</button>
                <button type="button" class="tab" data-seg="regular" aria-pressed="false" title="2 i więcej opłaconych zamówień">Stali klienci</button>
                <button type="button" class="tab" data-seg="winback" aria-pressed="false" title="2+ zamówienia, ostatnie ponad 60 dni temu">Do odzyskania</button>
                <button type="button" class="tab" data-seg="one_time" aria-pressed="false" title="1 zamówienie ponad 60 dni temu">Jeden zakup, nie wrócili</button>
                <button type="button" class="tab" data-seg="new" aria-pressed="false">Nowi (30 dni)</button>
                <button type="button" class="tab" data-seg="consent" aria-pressed="false">Ze zgodą marketingową</button>
                <button type="button" class="tab" data-seg="no_orders" aria-pressed="false">Bez zakupów</button>
              </div>
              <form class="c-tools" data-c-search role="search">
                <span class="search search--wide">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5" /><path d="m20 20-4.2-4.2" /></svg>
                  <label class="sr-only" for="cq">Szukaj klienta</label>
                  <input id="cq" type="search" placeholder="Imię i nazwisko, e-mail, telefon, miejscowość" />
                </span>
                <label class="check"><input type="checkbox" data-c-buyers /> Tylko kupujący</label>
              </form>
              <div class="table-wrap">
                <table class="table">
                  <thead><tr data-c-head>
                    <th data-sort="name">Imię i nazwisko</th><th data-sort="last_active">Ostatnio aktywny</th><th data-sort="created">Data rejestracji</th><th data-sort="email">E-mail</th>
                    <th data-sort="orders" class="r">Zamówienia</th><th data-sort="spent" class="r">Suma wydatków</th><th data-sort="avg" class="r">Średnia wartość</th>
                    <th data-sort="country">Kraj</th><th data-sort="city">Miejscowość</th><th data-sort="postcode">Kod pocztowy</th><th data-sort="phone">Telefon</th>
                  </tr></thead>
                  <tbody data-c-rows></tbody>
                </table>
              </div>
              <div class="pager">
                <span class="muted" data-c-page></span>
                <div class="pager__btns">
                  <label class="field field--inline">Wierszy na stronie
                    <select class="input sm" data-c-size><option>50</option><option>100</option><option>200</option><option>500</option></select>
                  </label>
                  <button type="button" class="icon-btn" data-c-prev aria-label="Poprzednia strona"><svg viewBox="0 0 24 24"><path d="m14.5 6-6 6 6 6" /></svg></button>
                  <button type="button" class="icon-btn" data-c-next aria-label="Następna strona"><svg viewBox="0 0 24 24"><path d="m9.5 6 6 6-6 6" /></svg></button>
                </div>
              </div>
            </div>
          </section>

          <!-- PRODUKTY -->
          <section data-view="products" class="stack" hidden>
            <div class="card">
              <div class="card__head">
                <h2 class="card__title">Produkty</h2>
                <div class="actions">
                  <a class="btn btn--outline btn--sm" href="/feed/google.xml" target="_blank" rel="noopener">Feed Google Merchant</a>
                  <button type="button" class="btn btn--sm" data-new-product>+ Nowy produkt</button>
                </div>
              </div>
              <div class="table-wrap">
                <table class="table">
                  <thead><tr><th></th><th>Produkt</th><th class="r">Cena</th><th class="r">Stan</th><th>Dostępność</th><th>Opinie</th><th>Status</th></tr></thead>
                  <tbody data-products></tbody>
                </table>
              </div>
            </div>
          </section>

          <!-- OPINIE -->
          <section data-view="reviews" class="stack" hidden>
            <div class="card">
              <div class="card__head">
                <h2 class="card__title">Opinie o produktach</h2>
                <div class="actions">
                  <a class="btn btn--outline btn--sm" href="/feed/opinie.xml" target="_blank" rel="noopener">Feed opinii Google</a>
                  <button type="button" class="btn btn--sm" data-new-review>+ Dodaj opinię</button>
                </div>
              </div>
              <div class="tabs" role="tablist" aria-label="Status opinii">
                <button type="button" class="tab" data-rstatus="pending" aria-pressed="true">Do moderacji <span data-rcount></span></button>
                <button type="button" class="tab" data-rstatus="approved" aria-pressed="false">Opublikowane</button>
                <button type="button" class="tab" data-rstatus="rejected" aria-pressed="false">Odrzucone</button>
                <button type="button" class="tab" data-rstatus="" aria-pressed="false">Wszystkie</button>
              </div>
              <div class="table-wrap">
                <table class="table">
                  <thead><tr><th>Data</th><th>Produkt</th><th>Autor</th><th>Ocena</th><th>Treść</th><th>Status</th><th></th></tr></thead>
                  <tbody data-reviews></tbody>
                </table>
              </div>
            </div>
          </section>
          <!-- AUTOMATY -->
          <section data-view="automations" class="stack" hidden>
            <div class="card">
              <div class="card__head"><h2 class="card__title">Przypomnienie o końcu kuracji</h2><span class="st" data-auto-state></span></div>
              <p class="muted">Codziennie o 8:00 sklep wysyła klientom ze zgodą marketingową e-mail „Kończy Ci się zapas kropli” z przyciskiem „Zamów ponownie”. Stali klienci (2+ zamówienia) dostają dodatkowo jednorazowy kod rabatowy. Każdy klient dostaje jedno przypomnienie na zamówienie. W mailu jest link „wypisz się”.</p>
              <p class="notice" data-auto-warn hidden></p>
              <form class="code-form" data-auto-form novalidate>
                <label class="check code-form__wide"><input type="checkbox" name="enabled" /> Automat włączony</label>
                <label class="field">Wyślij na ile dni przed końcem zapasu<input class="input" name="daysBefore" type="number" min="1" max="30" /></label>
                <label class="field">Rabat dla stałych klientów (%; 0 = bez kodu)<input class="input" name="regularCodePercent" type="number" min="0" max="50" /></label>
                <label class="field">Ważność kodu (dni)<input class="input" name="codeValidDays" type="number" min="1" max="90" /></label>
                <label class="field">Maks. maili dziennie<input class="input" name="maxPerRun" type="number" min="1" max="200" /></label>
                <div class="actions code-form__wide">
                  <button class="btn">Zapisz</button>
                  <button type="button" class="btn btn--outline" data-auto-run>Wyślij teraz do osób z listy poniżej</button>
                </div>
              </form>
            </div>
            <div class="card">
              <div class="card__head"><h2 class="card__title">Dziś dostaliby przypomnienie <span class="muted" data-auto-count></span></h2></div>
              <div class="table-wrap"><table class="table"><thead><tr><th>Klient</th><th>E-mail</th><th class="r">Zamówienia</th><th class="r">Ostatnio opakowań</th><th>Koniec zapasu</th><th>Kod rabatowy</th></tr></thead><tbody data-auto-list></tbody></table></div>
            </div>
            <div class="card">
              <div class="card__head"><h2 class="card__title">Ostatnio wysłane</h2></div>
              <div class="table-wrap"><table class="table"><thead><tr><th>Data</th><th>Klient</th><th>Kod</th></tr></thead><tbody data-auto-hist></tbody></table></div>
            </div>
          </section>

          <!-- USTAWIENIA SKLEPU -->
          <section data-view="settings" class="stack" hidden>
            <p class="notice">Dane pojawiają się w stopce, na stronach Kontakt, O nas, w regulaminie, polityce prywatności i w e-mailach. Po zapisaniu na stronie zobaczysz je w ciągu kilku minut. W wyszukiwarce Google i na stronach wygenerowanych wcześniej zaktualizują się przy najbliższym wdrożeniu sklepu.</p>
            <form class="stack" data-settings-form novalidate>
            <div class="card">
              <div class="card__head"><h2 class="card__title">Komunikat na stronie</h2><span class="st" data-notice-state></span></div>
              <p class="muted">Pasek nad nagłówkiem na wszystkich stronach oraz informacja w koszyku, przy zamówieniu i w mailu z potwierdzeniem. Np. „Urlop do 15 sierpnia – zamówienia wysyłamy od 16 sierpnia.”</p>
              <div class="code-form">
                <label class="check code-form__wide"><input type="checkbox" name="noticeEnabled" /> Pokazuj komunikat</label>
                <label class="field code-form__wide">Treść<input class="input" name="noticeText" maxlength="300" /></label>
                <label class="field">Pokazuj od (opcjonalnie)<input class="input" name="noticeFrom" type="datetime-local" /></label>
                <label class="field">Pokazuj do (opcjonalnie)<input class="input" name="noticeTo" type="datetime-local" /></label>
              </div>
            </div>
            <div class="card">
              <div class="card__head"><h2 class="card__title">Pasek promocji i wysyłka</h2></div>
              <div class="code-form">
                <label class="field">Pasek – tekst 1<input class="input" name="promo1" maxlength="80" /></label>
                <label class="field">Pasek – tekst 2<input class="input" name="promo2" maxlength="80" /></label>
                <label class="field">Pasek – tekst 3<input class="input" name="promo3" maxlength="80" /></label>
                <label class="field">Czas wysyłki<input class="input" name="shippingTime" maxlength="80" placeholder="w ciągu 1 dnia roboczego" /></label>
                <p class="muted code-form__wide">Puste pole paska = tekst się nie pokazuje. Czas wysyłki wstawiamy do zdania „Zamówienia wysyłamy …” w FAQ, formach dostawy, regulaminie, na karcie produktu i w mailu.</p>
              </div>
            </div>
            <div class="card">
              <div class="card__head"><h2 class="card__title">Kontakt</h2><span class="muted" data-settings-info></span></div>
              <div class="code-form">
                <label class="field">E-mail sklepu<input class="input" name="email" type="email" required /></label>
                <label class="field">Telefon<input class="input" name="phone" type="tel" placeholder="puste = nie pokazuj" /></label>
                <label class="field">Godziny obsługi<input class="input" name="hours" placeholder="pon.–pt., 9:00–17:00" /></label>
                <label class="field">Czas odpowiedzi<input class="input" name="replyTime" placeholder="w ciągu 24 h" /></label>
                <label class="field code-form__wide">Facebook<input class="input" name="facebook" type="url" placeholder="https://www.facebook.com/..." /></label>
                <h3 class="card__title code-form__wide">Dane firmy</h3>
                <label class="field code-form__wide">Nazwa firmy<input class="input" name="company" required /></label>
                <label class="field code-form__wide">Adres<input class="input" name="address" required /></label>
                <label class="field">NIP<input class="input" name="nip" inputmode="numeric" /></label>
                <label class="field">REGON<input class="input" name="regon" inputmode="numeric" /></label>
                <label class="field code-form__wide">Link do szybkich zwrotów (Furgonetka)<input class="input" name="returnsUrl" type="url" /></label>
              </div>
            </div>
            <div class="actions"><button class="btn">Zapisz ustawienia</button></div>
            </form>
            <form class="card" data-robots-form novalidate>
              <div class="card__head"><h2 class="card__title">robots.txt</h2><a class="btn btn--outline btn--sm" href="/robots.txt" target="_blank" rel="noopener">Otwórz robots.txt</a></div>
              <p class="muted">Instrukcje dla robotów wyszukiwarek na can-c.pl. Puste pole = treść domyślna. Linię „Sitemap:” dopisujemy automatycznie, jeśli jej nie ma. Staging zawsze blokuje indeksowanie, niezależnie od tej treści.</p>
              <label class="field">Treść<textarea class="input mono" name="robots" rows="10" maxlength="5000" spellcheck="false" data-robots-text></textarea></label>
              <p class="notice" data-robots-warn hidden>Ta treść blokuje całą stronę dla wszystkich robotów („Disallow: /”). Po starcie sklepu zniknie on z Google.</p>
              <details class="manual"><summary>Co zobaczy Google</summary><pre class="note mono" data-robots-preview></pre></details>
              <div class="actions"><button class="btn">Zapisz robots.txt</button><button type="button" class="btn btn--outline" data-robots-default>Wstaw treść domyślną</button></div>
            </form>
          </section>

          <!-- KODY RABATOWE -->
          <section data-view="codes" class="stack" hidden>
            <div class="card">
              <div class="card__head"><h2 class="card__title">Nowy kod</h2></div>
              <form class="code-form" data-code-form novalidate>
                <label class="field">Kod<input class="input" name="code" required maxlength="30" placeholder="np. WIOSNA10" style="text-transform:uppercase" /></label>
                <label class="field">Rodzaj<select class="input" name="type"><option value="percent">Procent (%)</option><option value="amount">Kwota (zł)</option></select></label>
                <label class="field">Wartość<input class="input" name="value" required inputmode="decimal" placeholder="10" /></label>
                <label class="field">Minimalna kwota (zł)<input class="input" name="min_total" inputmode="decimal" placeholder="0" /></label>
                <label class="field">Ważny od<input class="input" name="starts_at" type="date" /></label>
                <label class="field">Ważny do<input class="input" name="ends_at" type="date" /></label>
                <label class="field">Limit użyć (łącznie)<input class="input" name="max_uses" type="number" min="1" placeholder="bez limitu" /></label>
                <label class="field">Tylko dla klienta (e-mail)<input class="input" name="email" type="email" placeholder="puste = dla wszystkich" /></label>
                <label class="field code-form__wide">Opis widoczny na koncie klienta<input class="input" name="description" maxlength="200" placeholder="puste = kod nie jest pokazywany na kontach" /></label>
                <label class="check code-form__wide"><input type="checkbox" name="once_per_customer" checked /> Jeden raz na klienta</label>
                <div class="actions code-form__wide"><button class="btn">Utwórz kod</button></div>
              </form>
            </div>
            <div class="card">
              <div class="card__head"><h2 class="card__title">Kody</h2></div>
              <div class="table-wrap">
                <table class="table table--form">
                  <thead><tr><th>Kod</th><th>Rabat</th><th>Warunki</th><th>Ważność</th><th>Użycia</th><th class="r">Zamówienia</th><th class="r">Przychód</th><th class="r">Udzielony rabat</th><th>Dla</th><th>Aktywny</th></tr></thead>
                  <tbody data-codes></tbody>
                </table>
              </div>
            </div>
          </section>
        </div>
      </div>
    </div>

    <!-- SZCZEGÓŁY ZAMÓWIENIA -->
    <div class="scrim" data-scrim hidden></div>
    <aside class="drawer" data-drawer hidden aria-label="Szczegóły zamówienia">
      <div class="drawer__head">
        <button type="button" class="icon-btn" data-back aria-label="Wstecz" hidden><svg viewBox="0 0 24 24"><path d="m14.5 6-6 6 6 6" /></svg></button>
        <h2 data-d-title></h2>
        <button type="button" class="icon-btn" data-close aria-label="Zamknij"><svg viewBox="0 0 24 24"><path d="M6 6l12 12M18 6 6 18" /></svg></button>
      </div>
      <div class="drawer__body" data-d-body></div>
    </aside>
    <p class="toast" role="status" data-toast hidden></p>
  </body>
</html>

<style is:global>
  :root {
    --primary: #5570F1; --primary-ink: #3E55C9; --primary-pressed: #5B6EC6; --primary-a16: rgba(85,112,241,.16); --primary-a08: rgba(85,112,241,.08);
    --amber: #FFCC91; --amber-bg: #FFF2E2; --amber-ink: #8A5300;
    --success: #32936F; --success-ink: #2A7A5C; --success-a12: rgba(50,147,111,.12); --success-a24: rgba(50,147,111,.24);
    --danger: #F57E77; --danger-ink: #B8483F; --danger-a16: rgba(245,126,119,.16);
    --ink-100: #1C1D22; --ink-80: #2C2D33; --ink-60: #45464E; --ink-50: #53545C; --ink-40: #5E6366; --ink-30: #6E7079; --ink-10: #8B8D97; --grey-60: #A6A8B1; --grey-50: #ABAFB1;
    --line: #E1E2E9; --line-soft: #F1F3F9; --field: #CFD3D4; --muted-bg: rgba(94,99,102,.08);
    --bg: #F4F5FA; --card: #FFFFFF;
    --font: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Arial, sans-serif;
    --display: "Poppins", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Arial, sans-serif;
    --r-sm: 4px; --r-md: 8px; --r-lg: 12px; --r-xl: 16px; --r-pill: 500px;
    --shadow-pop: 0 4px 32px rgba(61,70,112,.08);
  }
  *, *::before, *::after { box-sizing: border-box; }
  body { margin: 0; background: var(--bg); color: var(--ink-100); font: 400 14px/1.4 var(--font); }
  a { color: var(--primary); text-decoration: none; }
  a:hover { color: var(--primary-pressed); }
  :focus-visible { outline: 2px solid var(--primary); outline-offset: 2px; }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .muted { color: var(--ink-10); }
  svg { width: 24px; height: 24px; fill: none; stroke: currentColor; stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; flex-shrink: 0; }

  .app { display: flex; min-height: 100vh; }

  /* Pasek boczny */
  .side { width: 248px; flex-shrink: 0; background: var(--card); display: flex; flex-direction: column; padding: 20px 20px 28px; position: sticky; top: 0; height: 100vh; }
