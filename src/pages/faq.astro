---
import FaqItem from '../components/FaqItem.astro';
import Base from '../layouts/Base.astro';
import { getEnv } from '../lib/env';
import { site } from '../config';
import { getPageContent, getSections, applyTokens } from '../lib/page-content';
import { getSite } from '../lib/site-settings';

export const prerender = false;

const env = await getEnv(Astro.locals);
const [faqRows, siteDb] = await Promise.all([
  getPageContent(env, 'faq').catch(() => []),
  getSite(env).catch(() => null),
]);
const tokens = { shippingTime: siteDb?.shippingTime ?? '' };
const slugify = (t: string) => t.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/ł/g, 'l').replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '').slice(0, 60);
const faqItems = getSections<{ cat: string; home: boolean; q: string; a: string }>(faqRows, 'item').map((f) => ({ ...f, id: slugify(f.q) }));
const faqCategories = [
  { id: 'produkt', label: 'Produkt' }, { id: 'stosowanie', label: 'Stosowanie' },
  { id: 'zamowienia', label: 'Zamówienia i dostawa' }, { id: 'zwroty', label: 'Płatności i zwroty' },
];
const escHtml = (t: string) => t.replace(/[&<>"]/g, (c) => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'})[c]!);
const withTokens = (t: string) => {
  const escaped = escHtml(applyTokens(t, tokens));
  return escaped.replace(escHtml('{shippingTime}'), `<span data-site="shippingTime">${tokens.shippingTime}</span>`);
};
const catLabel = Object.fromEntries(faqCategories.map((c) => [c.id, c.label]));
const counts = Object.fromEntries(faqCategories.map((c) => [c.id, faqItems.filter((f) => f.cat === c.id).length]));
const jsonLd = {
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: faqItems.map((f) => ({
    '@type': 'Question', name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: applyTokens(f.a.replace(/\n\n/g,' '), tokens) },
  })),
};
---
<Base title="FAQ: najczęstsze pytania o krople Can-C" description="Skład, dawkowanie, soczewki kontaktowe, dostawa, płatności i zwroty. Odpowiedzi na najczęstsze pytania o krople Can-C." nav="faq">
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <section class="w fq-top">
    <div class="row fq-head">
      <div class="fq-head__l">
        <nav class="crumb" aria-label="Okruszki"><a href="/">Strona główna</a> / FAQ</nav>
        <h1 class="h1">Najczęstsze pytania</h1>
        <p class="p p--lg">O produkcie, stosowaniu, zamówieniach i zwrotach.</p>
      </div>
      <div class="fl fq-search">
        <label for="faq-search" class="fq-search__l">Szukaj w pytaniach</label>
        <div class="fq-search__box">
          <svg aria-hidden="true" width="20" height="20" viewBox="0 0 20 20" fill="none"><circle cx="8.5" cy="8.5" r="6" stroke="currentColor" stroke-width="1.4"/><path d="M13 13l5 5" stroke="currentColor" stroke-width="1.4"/></svg>
          <input id="faq-search" class="fld" type="search" placeholder="np. soczewki, zwrot, faktura" data-search />
        </div>
      </div>
    </div>
    <div role="group" aria-label="Kategorie" class="fq-cats" data-cats>
      <button type="button" class="chip" aria-pressed="true" data-cat="all">Wszystkie <span class="fq-n">{faqItems.length}</span></button>
      {faqCategories.filter((c) => counts[c.id]).map((c) => (
        <button type="button" class="chip" aria-pressed="false" data-cat={c.id}>{c.label} <span class="fq-n">{counts[c.id]}</span></button>
      ))}
    </div>
  </section>

  <section class="w row fq-body">
    <div class="fq-list" data-list>
      {faqItems.map((f, i) => (
        <FaqItem id={f.id} data-cat={f.cat} text={`${f.q} ${f.a}`.toLowerCase()} cat={catLabel[f.cat]} q={f.q} answer={f.a.split('\n\n').map(withTokens).join('\n\n')} open={i === 0} />
      ))}
      <p class="p" data-empty hidden>Brak pytań pasujących do wyszukiwania. <a href="/kontakt/">Zapytaj nas bezpośrednio</a>.</p>
    </div>

    <aside class="fl fq-side">
      <div class="fq-help">
        <span class="fq-side__t">Nie znalazłeś odpowiedzi?</span>
        <p>Napisz do nas. Odpowiadamy w dni robocze <span data-site="replyTime">{site.replyTime}</span>.</p>
        <a href="/kontakt/" class="btn btn--white" style="align-self:flex-start;margin-top:10px">Napisz do nas</a>
      </div>
      <div class="fq-comp">
        <span class="fq-side__t">Skład kropli</span>
        <div style="border-bottom:1px solid var(--line)">
          <div class="trow"><span>N-acetylokarnozyna</span><span style="font-weight:400">1,0%</span></div>
          <div class="trow"><span>Gliceryna</span><span style="font-weight:400">1,0%</span></div>
          <div class="trow"><span>Karboksymetyloceluloza sodowa</span><span style="font-weight:400">0,3%</span></div>
        </div>
        <a href="/stosowanie/" class="lnk"><svg aria-hidden="true" width="10" height="10" viewBox="0 0 10 10"><path d="M0 5h9M5 1l4 4-4 4" fill="none" stroke="currentColor" stroke-width="2"/></svg>Jak stosować krople</a>
      </div>
      <div class="fq-leaf" aria-hidden="true"></div>
    </aside>
  </section>
</Base>

<script>
  const list = document.querySelector<HTMLElement>('[data-list]');
  const search = document.querySelector<HTMLInputElement>('[data-search]');
  const empty = document.querySelector<HTMLElement>('[data-empty]');
  if (list && search && empty) {
    const items = Array.from(list.querySelectorAll<HTMLDetailsElement>('details'));
    const chips = document.querySelectorAll<HTMLButtonElement>('[data-cats] .chip');
    let cat = 'all';
    const apply = () => {
      const term = search.value.trim().toLowerCase();
      let shown = 0;
      for (const el of items) {
        const ok = (cat === 'all' || el.dataset.cat === cat) && (!term || el.dataset.text!.includes(term));
        el.hidden = !ok;
        if (ok) shown++;
        if (term && ok) el.open = true;
      }
      empty.hidden = shown > 0;
    };
    chips.forEach((b) => b.addEventListener('click', () => {
      cat = b.dataset.cat!;
      chips.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      apply();
    }));
    search.addEventListener('input', apply);
    // Link do konkretnego pytania, np. /faq/#czy-moge-stosowac-krople-przy-soczewkach-kontaktowych
    const target = location.hash && document.getElementById(decodeURIComponent(location.hash.slice(1)));
    if (target instanceof HTMLDetailsElement) { items.forEach((d) => { d.open = d === target; }); target.scrollIntoView(); }
  }
</script>

<style>
  .fq-top { margin-top: 45px; }
  .fq-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 45px; }
  .fq-head__l { display: flex; flex-direction: column; gap: 24px; }
  .fq-search { width: 436px; }
  .fq-search__l { display: block; font-size: 18px; line-height: 27px; font-weight: 400; margin-bottom: 7px; }
  .fq-search__box { position: relative; }
  .fq-search__box svg { position: absolute; left: 22px; top: 50%; transform: translateY(-50%); color: var(--muted); }
  .fq-search__box .fld { padding-left: 54px; }
  .fq-cats { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 45px; }
  .fq-n { opacity: 0.6; }
  .fq-body { margin-top: 45px; margin-bottom: 90px; display: flex; align-items: flex-start; gap: 45px; }
  .fq-list { flex-grow: 1; min-width: 0; display: flex; flex-direction: column; gap: 14px; }
  .fq-list [hidden] { display: none; }
  .fq-side { width: 436px; flex-shrink: 0; display: flex; flex-direction: column; gap: 14px; }
  .fq-side__t { font-size: 28px; line-height: 32px; font-weight: 400; }
  .fq-help { background: var(--primary); color: #FFFFFF; border-radius: var(--r-lg); padding: 32px; display: flex; flex-direction: column; gap: 14px; }
  .fq-help p { font-size: 16px; line-height: 24px; font-weight: 300; color: var(--on-dark-soft); }
  .fq-comp { border: 1px solid var(--line); border-radius: var(--r-lg); padding: 32px; display: flex; flex-direction: column; gap: 14px; }
  .fq-leaf { height: 182px; background: var(--image); border-radius: 500px 20px 20px 20px; }
  @media (max-width: 1000px) {
    .fq-leaf { display: none; }
  }
</style>
