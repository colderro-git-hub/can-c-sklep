---
import Base from '../layouts/Base.astro';
import { faqItems, faqCategories } from '../data/faq';
import { site } from '../config';

const catLabel = Object.fromEntries(faqCategories.map((c) => [c.id, c.label]));
const counts = Object.fromEntries(faqCategories.map((c) => [c.id, faqItems.filter((f) => f.cat === c.id).length]));

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a.replace(/\n\n/g, ' ') },
  })),
};
---
<Base title="FAQ: najczęstsze pytania o krople Can-C" description="Skład, dawkowanie, soczewki kontaktowe, dostawa, płatności i zwroty. Odpowiedzi na najczęstsze pytania o krople Can-C.">
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <section class="page-hero">
    <div class="container page-hero__inner">
      <nav class="crumbs" aria-label="Ścieżka"><a href="/">Strona główna</a> / FAQ</nav>
      <div class="head">
        <div class="head__text">
          <h1>Najczęstsze pytania</h1>
          <p class="lead">O produkcie, stosowaniu, zamówieniach i zwrotach.</p>
        </div>
        <label class="field search">Szukaj w pytaniach
          <span class="search__box">
            <svg width="18" height="18" viewBox="0 0 20 20" fill="none" aria-hidden="true"><circle cx="8.5" cy="8.5" r="6" stroke="currentColor" stroke-width="1.2" /><path d="M13 13l5 5" stroke="currentColor" stroke-width="1.2" /></svg>
            <input type="search" class="input" placeholder="np. soczewki, zwrot, faktura" data-search />
          </span>
        </label>
      </div>
      <fieldset class="filters">
        <legend class="sr-only">Kategorie pytań</legend>
        <div class="pill-group">
          <label class="pill"><input type="radio" name="cat" value="all" checked /> Wszystkie <span class="count">{faqItems.length}</span></label>
          {faqCategories.map((c) => (
            <label class="pill"><input type="radio" name="cat" value={c.id} /> {c.label} <span class="count">{counts[c.id]}</span></label>
          ))}
        </div>
      </fieldset>
    </div>
  </section>

  <section class="section faq-section">
    <div class="container layout">
      <div class="list" data-list>
        {faqItems.map((f, i) => (
          <details class="acc" id={f.id} data-cat={f.cat} data-text={`${f.q} ${f.a}`.toLowerCase()} open={i === 0}>
            <summary><span class="q"><span class="q__cat">{catLabel[f.cat]}</span>{f.q}</span></summary>
            <div class="acc__body">{f.a.split('\n\n').map((p) => <p>{p}</p>)}</div>
          </details>
        ))}
        <p class="empty muted" data-empty hidden>Brak pytań pasujących do wyszukiwania. <a href="/kontakt/">Zapytaj nas bezpośrednio</a>.</p>
      </div>

      <aside class="aside">
        <div class="help">
          <h2>Nie znalazłeś odpowiedzi?</h2>
          <p>Napisz do nas. Odpowiadamy w dni robocze <span data-site="replyTime">{site.replyTime}</span>.</p>
          <a href="/kontakt/" class="btn btn--accent">Napisz do nas</a>
        </div>
        <div class="composition">
          <h2>Skład kropli</h2>
          <dl>
            <div><dt>N-acetylokarnozyna</dt><dd>1,0%</dd></div>
            <div><dt>Gliceryna</dt><dd>1,0%</dd></div>
            <div><dt>Karboksymetyloceluloza sodowa</dt><dd>0,3%</dd></div>
          </dl>
          <a href="/stosowanie/">Jak stosować krople</a>
        </div>
      </aside>
    </div>
  </section>
</Base>

<script>
  const list = document.querySelector<HTMLElement>('[data-list]');
  const search = document.querySelector<HTMLInputElement>('[data-search]');
  const empty = document.querySelector<HTMLElement>('[data-empty]');
  if (list && search && empty) {
    const items = Array.from(list.querySelectorAll<HTMLDetailsElement>('details'));
    const radios = document.querySelectorAll<HTMLInputElement>('input[name="cat"]');

    const apply = () => {
      const cat = document.querySelector<HTMLInputElement>('input[name="cat"]:checked')?.value ?? 'all';
      const term = search.value.trim().toLowerCase();
      let shown = 0;
      for (const el of items) {
        const ok = (cat === 'all' || el.dataset.cat === cat) && (!term || el.dataset.text!.includes(term));
        el.hidden = !ok;
        if (ok) shown++;
        if (term && ok) el.open = true;
      }
      empty.hidden = shown > 0;
    };

    radios.forEach((r) => r.addEventListener('change', apply));
    search.addEventListener('input', apply);

    // Link do konkretnego pytania, np. /faq/#soczewki
    const target = location.hash && document.getElementById(location.hash.slice(1));
    if (target instanceof HTMLDetailsElement) target.open = true;
  }
</script>

<style>
  .head { display: flex; flex-wrap: wrap; gap: var(--s-3) var(--s-6); align-items: flex-end; justify-content: space-between; }
  .head__text { flex: 1 1 520px; display: flex; flex-direction: column; gap: var(--s-2); }
  .search { flex: 0 1 380px; }
  .search__box { position: relative; display: flex; }
  .search__box svg { position: absolute; left: 16px; top: 17px; }
  .search__box .input { width: 100%; height: 52px; padding-left: 44px; border-radius: var(--r-search); }
  .filters { margin: var(--s-1) 0 0; padding: 0; border: 0; }
  .count { opacity: 0.7; }

  .faq-section { padding-top: var(--s-2); }
  .layout { display: flex; flex-wrap: wrap; gap: var(--s-4) var(--s-6); align-items: flex-start; }
  .list { flex: 2 1 640px; min-width: 0; display: flex; flex-direction: column; gap: var(--s-1); }
  .list details { scroll-margin-top: 100px; }
  .q { display: flex; flex-direction: column; gap: 6px; }
  .q__cat { font-size: 0.8125rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--c-ink-70); }

  .aside { flex: 1 1 300px; display: flex; flex-direction: column; gap: var(--s-2); }
  .aside h2 { font-size: var(--fs-h4); font-weight: 400; line-height: 1.3; }
  .help { background: var(--c-ink); color: var(--c-white); padding: var(--s-3); display: flex; flex-direction: column; gap: 16px; }
  .help p { color: var(--c-white-70); }
  .help .btn { align-self: flex-start; }
  .composition { padding: var(--s-3); box-shadow: inset 0 0 0 1px var(--c-gray-400); display: flex; flex-direction: column; gap: var(--s-1); }
  .composition dl { margin: 0; display: flex; flex-direction: column; gap: 10px; }
  .composition dl div { display: flex; justify-content: space-between; gap: 12px; padding-bottom: 10px; border-bottom: 1px solid var(--c-ink-10); }
  .composition dl div:last-child { border-bottom: 0; padding-bottom: 0; }
  .composition dd { margin: 0; }
</style>
