---
import { langOf, href as hrefL } from '../lib/i18n';
import { t } from '../i18n/ui';
const lang = langOf(Astro.locals);
const T = (k: Parameters<typeof t>[1]) => t(lang, k);
const L = (x: string) => hrefL(lang, x);
// Renderowane przy żądaniu: stopka i dane sklepu z panelu (/admin → Strony) zawsze aktualne
export const prerender = false;
// Strona newslettera: zapis (gdy ktoś trafi z linku) i wynik potwierdzenia z maila (?status=ok|blad)
import Base from '../layouts/Base.astro';
import NewsletterForm from '../components/NewsletterForm.astro';
---
<Base title={T('nlp.metaTitle')} description={T('nlp.metaDesc')} noindex>
  <section class="w nlp">
    <div class="nlp__state" data-st="ok" hidden>
      <h1 class="h1">{T('nlp.thanks')}</h1>
      <p class="lead">{T('nlp.thanksP')}</p>
      <a href={L('/sklep/')} class="btn">{T('nlp.toShop')}</a>
    </div>
    <div class="nlp__state" data-st="blad" hidden>
      <h1 class="h1">{T('nlp.expired')}</h1>
      <p class="lead">{T('nlp.expiredP')}</p>
    </div>
    <div class="nlp__state" data-st="form">
      <h1 class="h1" data-form-title>{T('nlp.formTitle')}</h1>
      <NewsletterForm variant="light" title="" lead={T('nlp.formLead')} />
    </div>
  </section>
</Base>

<style>
  .nlp { margin-top: 45px; margin-bottom: 90px; max-width: 760px; display: flex; flex-direction: column; gap: 45px; }
  .nlp__state { display: flex; flex-direction: column; gap: 24px; align-items: flex-start; }
  .nlp__state[hidden] { display: none; }
</style>

<script>
  import { t as tt } from '../i18n/ui';
  const LANG = document.documentElement.lang === 'en' ? 'en' : 'pl';
  const st = new URLSearchParams(location.search).get('status');
  if (st === 'ok') {
    document.querySelector<HTMLElement>('[data-st="ok"]')!.hidden = false;
    document.querySelector<HTMLElement>('[data-st="form"]')!.hidden = true;
  } else if (st === 'blad') {
    document.querySelector<HTMLElement>('[data-st="blad"]')!.hidden = false;
    document.querySelector('[data-form-title]')!.textContent = tt(LANG, 'nlp.again');
  }
</script>
