---
import Base from '../layouts/Base.astro';
import Arrow from '../components/Arrow.astro';
import { site, TURNSTILE_SITE_KEY } from '../config';

const topics = [
  { value: 'produkt', label: 'Pytanie o produkt', order: false },
  { value: 'zamowienie', label: 'Moje zamówienie', order: true },
  { value: 'zwrot', label: 'Zwrot lub reklamacja', order: true },
  { value: 'wspolpraca', label: 'Współpraca', order: false },
];
const quick = [
  { href: '/konto/', title: 'Gdzie jest moja paczka?', text: 'Status i numer przesyłki znajdziesz w swoim koncie i w e-mailu z potwierdzeniem wysyłki.', cta: 'Sprawdź zamówienie' },
  { href: site.returnsUrl, title: 'Chcę zwrócić produkt', text: 'Masz 14 dni. Zgłoś zwrot online, wydrukuj etykietę i nadaj paczkę.', cta: 'Zgłoś zwrot' },
  { href: '/faq/', title: 'Jak stosować krople?', text: 'Dawkowanie, czas kuracji i soczewki kontaktowe w najczęstszych pytaniach.', cta: 'Zobacz FAQ' },
];
---
<Base title="Kontakt | Can-C" description="Kontakt z obsługą klienta sklepu Can-C: pytania o produkty, zamówienia, zwroty i współpracę.">
  <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>

  <section class="page-hero">
    <div class="container page-hero__inner">
      <nav class="crumbs" aria-label="Ścieżka"><a href="/">Strona główna</a> / Kontakt</nav>
      <h1>Kontakt</h1>
      <p class="lead">Pytania o produkty, zamówienia i zwroty. Odpowiadamy w dni robocze <span data-site="replyTime">{site.replyTime}</span>.</p>
    </div>
  </section>

  <section class="quick-wrap">
    <div class="container quick">
      {quick.map((q) => (
        <a href={q.href} class="quick__card">
          <span class="quick__title">{q.title}</span>
          <span class="muted">{q.text}</span>
          <span class="quick__cta">{q.cta} <Arrow /></span>
        </a>
      ))}
    </div>
  </section>

  <section class="section section--tint">
    <div class="container layout">
      <div class="info">
        <h2 class="h3">Obsługa klienta</h2>
        <dl>
          <div><dt>E-mail</dt><dd><a href={`mailto:${site.email}`} data-site-href="mailto:{email}"><span data-site="email">{site.email}</span></a></dd></div>
          <div><dt>Telefon</dt><dd><a href={`tel:${site.phone.replace(/\s/g, '')}`} data-site-href="tel:{phone}"><span data-site="phone">{site.phone}</span></a></dd></div>
          <div><dt>Godziny</dt><dd><span data-site="hours">{site.hours}</span></dd></div>
          <div><dt>Facebook</dt><dd><a href={site.facebook} data-site-href="{facebook}">krople.canc</a></dd></div>
          <div><dt>Sprzedawca</dt><dd class="small"><span data-site="company">{site.company}</span><br /><span data-site="address">{site.address}</span><br />NIP <span data-site="nip">{site.nip}</span> · REGON <span data-site="regon">{site.regon}</span></dd></div>
        </dl>
      </div>

      <form class="form" method="post" action="/api/kontakt" data-contact novalidate>
        <h2>Napisz do nas</h2>

        <fieldset>
          <legend>Czego dotyczy wiadomość?</legend>
          <div class="pill-group">
            {topics.map((t, i) => (
              <label class="pill"><input type="radio" name="topic" value={t.value} checked={i === 0} data-order={t.order ? '1' : ''} /> {t.label}</label>
            ))}
          </div>
        </fieldset>

        <div class="grid2">
          <label class="field">Imię i nazwisko
            <input class="input" type="text" name="name" autocomplete="name" required maxlength="100" />
          </label>
          <label class="field">E-mail
            <input class="input" type="email" name="email" autocomplete="email" required maxlength="200" placeholder="jan@przyklad.pl" />
          </label>
        </div>

        <label class="field order" data-order-field hidden>Numer zamówienia
          <input class="input" type="text" name="order" inputmode="numeric" maxlength="20" placeholder="np. 10482" />
        </label>

        <label class="field">Wiadomość
          <textarea class="input textarea" name="message" rows="6" required minlength="10" maxlength="5000"></textarea>
        </label>

        <!-- Pułapka na boty: pole niewidoczne dla ludzi -->
        <label class="hp" aria-hidden="true">Strona www<input type="text" name="website" tabindex="-1" autocomplete="off" /></label>

        <p class="small muted">Administratorem danych jest <span data-site="company">{site.company}</span>. Dane z formularza wykorzystamy tylko do odpowiedzi na Twoją wiadomość. Szczegóły w <a href="/polityka-prywatnosci/">Polityce prywatności</a>.</p>
        <label class="consent"><input type="checkbox" name="marketing" value="1" /> <span>Chcę też otrzymywać informacje o promocjach (opcjonalnie).</span></label>

        <div class="cf-turnstile" data-sitekey={TURNSTILE_SITE_KEY} data-language="pl"></div>

        <div class="actions">
          <button type="submit" class="btn btn--lg" data-submit>Wyślij wiadomość</button>
          <p class="status" role="status" data-status></p>
        </div>
      </form>
    </div>
  </section>
</Base>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-contact]');
  if (form) {
    const orderField = form.querySelector<HTMLElement>('[data-order-field]')!;
    const status = form.querySelector<HTMLElement>('[data-status]')!;
    const submit = form.querySelector<HTMLButtonElement>('[data-submit]')!;

    form.querySelectorAll<HTMLInputElement>('input[name="topic"]').forEach((r) =>
      r.addEventListener('change', () => { orderField.hidden = !r.dataset.order; }),
    );

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!form.reportValidity()) return;
      submit.disabled = true;
      status.className = 'status';
      status.textContent = 'Wysyłanie…';
      try {
        const res = await fetch(form.action, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } });
        const data = await res.json().catch(() => ({}));
        if (!res.ok) throw new Error(data.error || 'Nie udało się wysłać wiadomości. Spróbuj ponownie albo napisz e-mail.');
        status.className = 'status status--ok';
        status.textContent = 'Wysłano. Odpowiemy na podany adres e-mail.';
        form.reset();
        orderField.hidden = true;
      } catch (err) {
        status.className = 'status status--err';
        status.textContent = (err as Error).message;
      } finally {
        submit.disabled = false;
        (window as any).turnstile?.reset();
      }
    });
  }
</script>

<style>
  .h3 { font-size: var(--fs-h3); }
  .small { font-size: var(--fs-small); line-height: 24px; }

  .quick-wrap { padding-bottom: var(--s-6); }
  .quick { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: var(--s-2); }
  .quick__card { padding: 32px; background: var(--c-gray-100); color: var(--c-ink); text-decoration: none; display: flex; flex-direction: column; gap: 12px; }
  .quick__title { font-size: var(--fs-h4); }
  .quick__cta { display: inline-flex; align-items: center; gap: 12px; padding-top: 8px; }

  .layout { display: flex; flex-wrap: wrap; gap: var(--s-4) var(--s-6); align-items: flex-start; }
  .info { flex: 1 1 340px; display: flex; flex-direction: column; gap: var(--s-3); }
  .info dl { margin: 0; }
  .info dl div { padding: 20px 0; border-top: 1px solid var(--c-ink-10); display: flex; flex-direction: column; gap: 4px; }
  .info dl div:last-child { border-bottom: 1px solid var(--c-ink-10); }
  .info dt { font-size: var(--fs-small); color: var(--c-ink-75); }
  .info dd { margin: 0; font-size: 1.25rem; }
  .info dd.small { font-size: 1rem; line-height: 1.6; }
  .info dd a { color: var(--c-ink); }

  .form { flex: 2 1 560px; min-width: 0; background: var(--c-white); padding: clamp(24px, 4vw, 48px); display: flex; flex-direction: column; gap: var(--s-2); }
  .form h2 { font-size: var(--fs-h4); font-weight: 400; }
  .form fieldset { margin: 0; padding: 0; border: 0; }
  .form legend { font-size: var(--fs-small); padding-bottom: var(--s-1); }
  .grid2 { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 16px; }
  .order { max-width: 320px; }
  .order[hidden] { display: none; }
  .textarea { height: auto; padding: 14px 16px; line-height: 1.5; resize: vertical; }
  .hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
  .consent { display: flex; gap: 12px; align-items: flex-start; font-size: var(--fs-small); line-height: 24px; color: var(--c-ink-75); }
  .consent input { width: 18px; height: 18px; margin: 3px 0 0; accent-color: var(--c-ink); flex-shrink: 0; }
  .actions { display: flex; flex-wrap: wrap; gap: 16px; align-items: center; }
  .actions .btn:disabled { opacity: 0.5; cursor: wait; }
  .status { font-size: 1rem; }
  .status--ok { color: var(--c-ok); }
  .status--err { color: var(--c-err); }
</style>
