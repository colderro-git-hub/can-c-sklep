---
import Base from '../../layouts/Base.astro';
import { products } from '../../data/shop';

const catalog = products.map(({ slug, price }) => ({ slug, price }));
---
<Base title="Moje konto | Can-C" description="Historia zamówień, przesyłki i ponowne zamówienia w sklepie Can-C.">
  <section class="section account-wrap">
    <div class="container account" data-account>

      <!-- Ładowanie sesji -->
      <p class="muted" data-state="loading">Ładowanie…</p>

      <!-- Logowanie -->
      <div class="login" data-state="login" hidden>
        <h1>Moje konto</h1>
        <p class="lead">Zaloguj się adresem e-mail użytym przy zamówieniu. Wyślemy link i kod – bez hasła.</p>

        <form class="login__card" data-login-form novalidate>
          <label class="field">E-mail
            <input class="input" type="email" name="email" autocomplete="email" required placeholder="jan@przyklad.pl" />
          </label>
          <button class="btn btn--lg" data-send>Wyślij link i kod</button>
          <p class="msg" role="status" data-login-msg></p>
        </form>

        <form class="login__card" data-code-form hidden novalidate>
          <p>Wysłaliśmy wiadomość na <strong data-sent-to></strong>. Kliknij link w mailu albo wpisz kod:</p>
          <label class="field">Kod z maila
            <input class="input code" type="text" name="code" inputmode="numeric" autocomplete="one-time-code" maxlength="8" pattern="[0-9]{6,8}" required placeholder="000000" />
          </label>
          <button class="btn btn--lg">Zaloguj się</button>
          <p class="msg" role="status" data-code-msg></p>
          <p class="small muted">Nie widzisz maila? Sprawdź folder Spam albo <button type="button" class="linklike" data-resend disabled>wyślij ponownie</button>.</p>
          <button type="button" class="linklike small" data-change-email>Zmień adres e-mail</button>
        </form>

        <ul class="perks">
          <li>Historia wszystkich zamówień, także z poprzedniej wersji sklepu</li>
          <li>Śledzenie przesyłek</li>
          <li>Ponowne zamówienie jednym kliknięciem</li>
        </ul>
      </div>

      <!-- Zalogowany -->
      <div class="dash" data-state="dash" hidden>
        <div class="dash__head">
          <div>
            <h1 data-hello>Moje konto</h1>
            <p class="muted" data-email></p>
          </div>
          <button type="button" class="btn btn--ghost" data-logout>Wyloguj</button>
        </div>

        <div class="reminder" data-reminder hidden>
          <div class="reminder__text">
            <span class="reminder__label">Przypomnienie o kuracji</span>
            <span class="reminder__title" data-rem-title></span>
            <span class="reminder__sub" data-rem-sub></span>
          </div>
          <a class="btn btn--accent" data-rem-cta href="/produkt/krople-can-c/">Zamów ponownie</a>
        </div>

        <section class="stats" data-stats hidden>
          <div class="stats__nums">
            <div><span class="muted">Łącznie</span><strong data-s-total></strong></div>
            <div><span class="muted">Zamówienia</span><strong data-s-count></strong></div>
            <div><span class="muted">Opakowania kropli</span><strong data-s-packs></strong></div>
          </div>
          <div class="chart" role="img" data-chart aria-label="Wydatki w ostatnich 12 miesiącach"></div>
        </section>

        <section class="codes" data-codes hidden>
          <h2 class="h4">Twoje kody rabatowe</h2>
          <ul class="codes__list" data-codes-list></ul>
        </section>

        <div class="dash__grid">
          <div class="orders">
            <h2 class="h4">Zamówienia</h2>
            <ul class="order-list" data-orders></ul>
            <p class="muted" data-orders-empty hidden>Nie masz jeszcze zamówień. <a href="/#produkty">Przejdź do sklepu</a>.</p>
            <button type="button" class="btn btn--ghost" data-more hidden>Pokaż starsze</button>
          </div>

          <aside class="profile">
            <h2 class="h4">Twoje dane</h2>
            <form class="profile__form" data-profile-form novalidate>
              <div class="grid2">
                <label class="field">Imię<input class="input" name="first_name" autocomplete="given-name" maxlength="60" /></label>
                <label class="field">Nazwisko<input class="input" name="last_name" autocomplete="family-name" maxlength="60" /></label>
              </div>
              <label class="field">Telefon<input class="input" name="phone" type="tel" autocomplete="tel" maxlength="20" /></label>
              <label class="field">Domyślny Paczkomat<input class="input" name="default_locker" maxlength="15" placeholder="np. WRO01M" /></label>
              <fieldset class="fs">
                <legend>Adres dla kuriera</legend>
                <label class="field">Ulica i numer<input class="input" name="street" autocomplete="street-address" maxlength="120" /></label>
                <div class="grid2">
                  <label class="field">Kod pocztowy<input class="input" name="postcode" maxlength="6" placeholder="00-000" /></label>
                  <label class="field">Miejscowość<input class="input" name="city" maxlength="60" /></label>
                </div>
              </fieldset>
              <fieldset class="fs">
                <legend>Dane do faktury</legend>
                <label class="field">Nazwa firmy<input class="input" name="company" autocomplete="organization" maxlength="150" /></label>
                <label class="field">NIP<input class="input" name="nip" inputmode="numeric" maxlength="13" /></label>
                <label class="field">Ulica i numer<input class="input" name="invStreet" maxlength="120" /></label>
                <div class="grid2">
                  <label class="field">Kod pocztowy<input class="input" name="invPostcode" maxlength="6" placeholder="00-000" /></label>
                  <label class="field">Miejscowość<input class="input" name="invCity" maxlength="60" /></label>
                </div>
                <p class="small muted">Dane uzupełnią się same przy zamówieniu z fakturą.</p>
              </fieldset>
              <label class="check"><input type="checkbox" name="marketing_consent" /> <span>Chcę otrzymywać informacje o promocjach i kodach rabatowych.</span></label>
              <button class="btn">Zapisz dane</button>
              <p class="msg" role="status" data-profile-msg></p>
            </form>
            <p class="small muted">E-mail <strong data-email-2></strong> służy do logowania. Zmiana adresu lub usunięcie konta: <a href="/kontakt/">napisz do nas</a>.</p>
          </aside>
        </div>
      </div>

      <p class="msg msg--err" role="alert" data-error hidden></p>
    </div>
  </section>
</Base>

<script define:vars={{ catalog }}>
  // Dane z chwili budowania jako zapas; aktualne ceny i dostępność z bazy
  window.__CANC_CATALOG__ = catalog;
  window.__CANC_READY__ = fetch('/api/produkty')
    .then((r) => (r.ok ? r.json() : null))
    .then((list) => { if (Array.isArray(list) && list.length) window.__CANC_CATALOG__ = list.filter((p) => p.avail !== 'out_of_stock' || false).concat(list.filter((p) => p.avail === 'out_of_stock').map((p) => ({ ...p, price: null }))); })
    .catch(() => {});
</script>

<script>
  import { sb } from '../../lib/sb-client';
  import { addItem } from '../../lib/cart';
  import { trackLogin, trackSignUp, setUserId, clearUserData, trackFormStart, trackFormFieldClick, trackFormFieldError, trackFormSubmit } from '../../lib/analytics';

  (async () => {
  await (window as any).__CANC_READY__;

  const root = document.querySelector<HTMLElement>('[data-account]')!;
  const $ = <T extends Element = HTMLElement>(s: string) => root.querySelector<T>(s)!;
  const show = (state: string) => root.querySelectorAll<HTMLElement>('[data-state]').forEach((el) => (el.hidden = el.dataset.state !== state));
  const esc = (s: unknown) => String(s ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);
  const pln = (g: number) => new Intl.NumberFormat('pl-PL', { style: 'currency', currency: 'PLN' }).format(g / 100);
  const day = (s: string) => new Date(s).toLocaleDateString('pl-PL', { day: 'numeric', month: 'long', year: 'numeric' });
  const catalog: { slug: string; price: number | null }[] = (window as any).__CANC_CATALOG__ ?? [];

  const STATUS: Record<string, [string, string]> = {
    pending_payment: ['Oczekuje na płatność', 'wait'], paid: ['Przyjęte do realizacji', 'info'], on_hold: ['W trakcie wyjaśniania', 'wait'],
    shipped: ['Wysłane', 'ok'], completed: ['Zrealizowane', 'ok'], cancelled: ['Anulowane', 'bad'], refunded: ['Zwrócone', 'bad'], failed: ['Nieudane', 'bad'],
  };
  const track = (carrier: string, nr: string) => {
    const c = (carrier || '').toLowerCase(), n = encodeURIComponent(nr);
    if (c.includes('dpd')) return `https://tracktrace.dpd.com.pl/parcelDetails?typ=1&p1=${n}`;
    if (c.includes('inpost') || c.includes('paczkomat') || c.includes('easypack')) return `https://inpost.pl/sledzenie-przesylek?number=${n}`;
    return 'https://furgonetka.pl/zlokalizuj';
  };
  const showError = (m: string) => { const e = $('[data-error]'); e.textContent = m; e.hidden = !m; };

  // ---------- Logowanie ----------
  let email = '';
  let cooldown = 0;
  const startCooldown = () => {
    const btn = $<HTMLButtonElement>('[data-resend]');
    cooldown = 60; btn.disabled = true;
    const t = setInterval(() => {
      cooldown--; btn.textContent = cooldown > 0 ? `wyślij ponownie (${cooldown} s)` : 'wyślij ponownie';
      if (cooldown <= 0) { btn.disabled = false; clearInterval(t); }
    }, 1000);
  };

  async function sendLink() {
    const { error } = await sb().auth.signInWithOtp({
      email,
      options: { emailRedirectTo: `${location.origin}/konto/`, shouldCreateUser: true },
    });
    if (error) throw error;
  }

  $('[data-login-form]').addEventListener('submit', async (e) => {
    e.preventDefault();
    const f = e.target as HTMLFormElement;
    const msg = $('[data-login-msg]');
    email = String(new FormData(f).get('email') || '').trim().toLowerCase();
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(email)) { msg.textContent = 'Podaj poprawny adres e-mail.'; return; }
    const btn = $<HTMLButtonElement>('[data-send]'); btn.disabled = true; msg.textContent = 'Wysyłanie…';
    try {
      await sendLink();
      f.hidden = true; $('[data-code-form]').hidden = false; $('[data-sent-to]').textContent = email;
      $<HTMLInputElement>('input[name="code"]').focus();
      startCooldown(); msg.textContent = '';
    } catch (err: any) {
      msg.textContent = /rate|limit|seconds/i.test(err?.message || '') ? 'Zbyt wiele prób. Odczekaj minutę i spróbuj ponownie.' : 'Nie udało się wysłać maila. Spróbuj ponownie za chwilę.';
      console.error(err);
    } finally { btn.disabled = false; }
  });

  $('[data-code-form]').addEventListener('submit', async (e) => {
    e.preventDefault();
    const msg = $('[data-code-msg]');
    const token = String(new FormData(e.target as HTMLFormElement).get('code') || '').replace(/\D/g, '');
    if (token.length < 6 || token.length > 8) { msg.textContent = 'Wpisz kod z maila (same cyfry).'; return; }
    msg.textContent = 'Sprawdzanie…';
    const { error } = await sb().auth.verifyOtp({ email, token, type: 'email' });
    msg.textContent = error ? 'Kod jest nieprawidłowy albo wygasł. Wyślij nowy.' : '';
  });

  $('[data-resend]').addEventListener('click', async () => {
    try { await sendLink(); startCooldown(); $('[data-code-msg]').textContent = 'Wysłaliśmy nowy kod.'; }
    catch { $('[data-code-msg]').textContent = 'Nie udało się wysłać. Spróbuj za chwilę.'; }
  });
  $('[data-change-email]').addEventListener('click', () => { $('[data-code-form]').hidden = true; $('[data-login-form]').hidden = false; });
  $('[data-logout]').addEventListener('click', async () => { await sb().auth.signOut(); show('login'); });

  // ---------- Wywołania API z tokenem sesji ----------
  async function apiUser(path: string, body?: unknown) {
    const { data } = await sb().auth.getSession();
    const token = data.session?.access_token;
    const res = await fetch(path, {
      method: body ? 'POST' : 'GET',
      headers: { 'Content-Type': 'application/json', ...(token ? { Authorization: `Bearer ${token}` } : {}) },
      body: body ? JSON.stringify(body) : undefined,
    });
    const out = await res.json().catch(() => ({}));
    if (!res.ok) throw new Error(out.error || 'Błąd serwera.');
    return out;
  }

  // ---------- Panel klienta ----------
  let page = 0;
  const PAGE = 20;

  async function loadDashboard(userEmail: string) {
    show('dash');
    $('[data-email]').textContent = userEmail;

    $('[data-email-2]').textContent = userEmail;
    loadProfile();
    loadCodes();
    loadStats();

    page = 0;
    $('[data-orders]').innerHTML = '';
    await loadOrders(true);
  }

  async function loadOrders(first = false) {
    const from = page * PAGE;
    const { data, error } = await sb()
      .from('orders')
      .select('number,created_at,paid_at,shipped_at,status,total,shipping_method,shipping_point,tracking_number,carrier,source,order_items(name,qty,product_id)')
      .order('created_at', { ascending: false })
      .range(from, from + PAGE - 1);
    if (error) { showError('Nie udało się pobrać zamówień. Odśwież stronę.'); console.error(error); return; }

    const list = $('[data-orders]');
    $('[data-orders-empty]').hidden = !(first && data.length === 0);
    $('[data-more]').hidden = data.length < PAGE;
    if (first) renderReminder(data);

    for (const o of data) {
      const [label, tone] = STATUS[o.status] || [o.status, 'info'];
      const reorderable = o.order_items.some((i: any) => catalog.some((c) => c.slug === i.product_id && c.price !== null));
      const li = document.createElement('li');
      li.className = 'order';
      li.innerHTML = `
        <div class="order__top">
          <span class="order__nr">Zamówienie ${o.number}</span>
          <span class="st st--${tone}">${esc(label)}</span>
        </div>
        <span class="muted small">${day(o.created_at)}</span>
        <ul class="order__items">${o.order_items.map((i: any) => `<li>${esc(i.name)} × ${i.qty}</li>`).join('')}</ul>
        <div class="order__foot">
          <span class="order__total">${pln(o.total)}</span>
          <span class="small">${o.shipping_method === 'dpd' ? 'Kurier DPD' : o.shipping_point ? `Paczkomat ${esc(o.shipping_point)}` : esc(o.shipping_method || '')}
            ${o.tracking_number ? ` · <a href="${track(o.carrier || o.shipping_method, o.tracking_number)}" target="_blank" rel="noopener">Śledź przesyłkę</a>` : ''}</span>
          <span class="order__btns">
            <button type="button" class="linklike small" data-ask>Napisz w sprawie zamówienia</button>
            ${['paid', 'shipped', 'completed'].includes(o.status) ? `<a class="small" href="/odstapienie-od-umowy/?nr=${o.number}#odstapienie">Odstąp od umowy</a>` : ''}
            ${reorderable ? '<button type="button" class="btn btn--ghost btn--sm" data-reorder>Zamów ponownie</button>' : ''}
          </span>
        </div>
        <form class="ask" data-ask-form hidden>
          <label class="field">Temat
            <select class="input" name="topic"><option value="pytanie">Pytanie</option><option value="dostawa">Dostawa</option><option value="zwrot">Zwrot</option><option value="reklamacja">Reklamacja</option><option value="faktura">Faktura</option><option value="inne">Inne</option></select>
          </label>
          <label class="field">Wiadomość<textarea class="input textarea" name="message" rows="3" maxlength="3000" required></textarea></label>
          <div class="ask__row"><button class="btn btn--sm">Wyślij</button><span class="msg small" role="status" data-ask-msg></span></div>
        </form>`;
      const askForm = li.querySelector<HTMLFormElement>('[data-ask-form]')!;
      li.querySelector('[data-ask]')!.addEventListener('click', () => { askForm.hidden = !askForm.hidden; if (!askForm.hidden) askForm.querySelector('textarea')!.focus(); });
      askForm.addEventListener('submit', async (ev) => {
        ev.preventDefault();
        const m = askForm.querySelector<HTMLElement>('[data-ask-msg]')!;
        const fd = new FormData(askForm);
        m.textContent = 'Wysyłanie…';
        try {
          await apiUser('/api/konto/wiadomosc', { number: o.number, topic: fd.get('topic'), message: fd.get('message') });
          m.textContent = 'Wysłano. Odpowiemy na Twój e-mail.'; askForm.reset();
        } catch (err) { m.textContent = (err as Error).message; }
      });
      li.querySelector('[data-reorder]')?.addEventListener('click', () => {
        for (const i of o.order_items) {
          if (catalog.some((c) => c.slug === i.product_id && c.price !== null)) addItem(i.product_id, i.qty);
        }
        location.href = '/koszyk/';
      });
      list.append(li);
    }
  }
  $('[data-more]').addEventListener('click', () => { page++; loadOrders(); });

  // ---------- Profil ----------
  const form = $<HTMLFormElement>('[data-profile-form]');
  const setVal = (n: string, v: unknown) => { const el = form.elements.namedItem(n) as HTMLInputElement | null; if (el) el.type === 'checkbox' ? (el.checked = Boolean(v)) : (el.value = String(v ?? '')); };
  async function loadProfile() {
    try {
      const p = await apiUser('/api/konto/profil');
      if (p.first_name) $('[data-hello]').textContent = `Dzień dobry, ${p.first_name}`;
      setVal('first_name', p.first_name); setVal('last_name', p.last_name); setVal('phone', p.phone); setVal('default_locker', p.default_locker);
      setVal('street', p.default_address?.street); setVal('postcode', p.default_address?.postcode); setVal('city', p.default_address?.city);
      setVal('company', p.billing?.company); setVal('nip', p.billing?.nip); setVal('invStreet', p.billing?.street); setVal('invPostcode', p.billing?.postcode); setVal('invCity', p.billing?.city);
      setVal('marketing_consent', p.marketing_consent);
    } catch (e) { console.error(e); }
  }
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const msg = $('[data-profile-msg]');
    const fd = new FormData(form);
    const body: Record<string, unknown> = Object.fromEntries([...fd.entries()].map(([k, v]) => [k, String(v)]));
    body.marketing_consent = fd.get('marketing_consent') !== null;
    msg.textContent = 'Zapisywanie…'; msg.classList.remove('msg--err');
    try { await apiUser('/api/konto/profil', body); msg.textContent = 'Zapisano.'; }
    catch (err) { msg.textContent = (err as Error).message; msg.classList.add('msg--err'); }
  });

  // ---------- Kody rabatowe ----------
  async function loadCodes() {
    try {
      const { codes } = await apiUser('/api/konto/kody');
      if (!codes.length) return;
      $('[data-codes]').hidden = false;
      $('[data-codes-list]').innerHTML = codes.map((c: any) => `
        <li class="code-card">
          <div><span class="code-card__value">${c.type === 'percent' ? `−${c.value}%` : `−${pln(c.value)}`}</span>
            <span class="small muted">${esc(c.description || '')}${c.min_total ? ` · od ${pln(c.min_total)}` : ''}${c.ends_at ? ` · ważny do ${day(c.ends_at)}` : ''}</span></div>
          <button type="button" class="code-card__code" data-copy="${esc(c.code)}" aria-label="Skopiuj kod ${esc(c.code)}">${esc(c.code)} <span class="small">kopiuj</span></button>
        </li>`).join('');
      $('[data-codes-list]').querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((b) => b.addEventListener('click', async () => {
        try { await navigator.clipboard.writeText(b.dataset.copy!); b.querySelector('span')!.textContent = 'skopiowano'; } catch { /* brak dostępu do schowka */ }
      }));
    } catch (e) { console.error(e); }
  }

  // ---------- Statystyki i wykres (12 miesięcy) ----------
  async function loadStats() {
    const { data, error } = await sb().from('orders').select('created_at,total,status,order_items(qty,product_id)').in('status', ['paid', 'shipped', 'completed']).limit(1000);
    if (error || !data?.length) return;
    $('[data-stats]').hidden = false;
    const total = data.reduce((s: number, o: any) => s + o.total, 0);
    const packs = data.reduce((s: number, o: any) => s + o.order_items.filter((i: any) => i.product_id === 'krople-can-c').reduce((a: number, i: any) => a + i.qty, 0), 0);
    $('[data-s-total]').textContent = pln(total);
    $('[data-s-count]').textContent = String(data.length);
    $('[data-s-packs]').textContent = String(packs);

    const now = new Date();
    const months = Array.from({ length: 12 }, (_, k) => { const d = new Date(now.getFullYear(), now.getMonth() - 11 + k, 1); return { y: d.getFullYear(), m: d.getMonth(), sum: 0 }; });
    for (const o of data) {
      const d = new Date(o.created_at);
      const b = months.find((x) => x.y === d.getFullYear() && x.m === d.getMonth());
      if (b) b.sum += o.total;
    }
    const max = Math.max(...months.map((x) => x.sum), 1);
    const names = ['sty', 'lut', 'mar', 'kwi', 'maj', 'cze', 'lip', 'sie', 'wrz', 'paź', 'lis', 'gru'];
    $('[data-chart]').innerHTML = months.map((x) => `
      <div class="bar" title="${names[x.m]} ${x.y}: ${pln(x.sum)}">
        <span class="bar__val">${x.sum ? Math.round(x.sum / 100) + ' zł' : ''}</span>
        <span class="bar__col" style="height:${Math.max(2, Math.round((x.sum / max) * 100))}%"></span>
        <span class="bar__lbl">${names[x.m]}</span>
      </div>`).join('');
  }

  // Przypomnienie: jedno opakowanie kropli ≈ 30 dni kuracji
  function renderReminder(orders: any[]) {
    const last = orders.find((o) => ['paid', 'shipped', 'completed'].includes(o.status) && o.order_items.some((i: any) => i.product_id === 'krople-can-c'));
    if (!last) return;
    const packs = last.order_items.filter((i: any) => i.product_id === 'krople-can-c').reduce((s: number, i: any) => s + i.qty, 0);
    const start = new Date(last.shipped_at || last.paid_at || last.created_at).getTime() + 3 * 864e5; // ok. 3 dni na dostawę
    const end = start + packs * 30 * 864e5;
    const left = Math.round((end - Date.now()) / 864e5);
    if (left > 21) return; // przypominamy na 3 tygodnie przed końcem
    const rem = $('[data-reminder]');
    rem.hidden = false;
    $('[data-rem-title]').textContent = left > 0 ? `Zapas kropli kończy się za około ${left} ${left === 1 ? 'dzień' : 'dni'}` : 'Zapas kropli prawdopodobnie się skończył';
    $('[data-rem-sub]').textContent = `Na podstawie zamówienia nr ${last.number} (${packs} ${packs === 1 ? 'opakowanie' : packs < 5 ? 'opakowania' : 'opakowań'}).`;
    const qty = packs >= 4 ? 4 : packs >= 2 ? 2 : 2;
    $<HTMLAnchorElement>('[data-rem-cta]').href = `/produkt/krople-can-c/?zestaw=${qty}`;
  }

  // ---------- Start ----------
  sb().auth.onAuthStateChange((event, session) => {
    if (session?.user && (event === 'SIGNED_IN' || event === 'INITIAL_SESSION')) {
      if (location.hash.includes('access_token')) history.replaceState(null, '', location.pathname);
      loadDashboard(session.user.email || '');
    } else if (event === 'SIGNED_OUT' || (event === 'INITIAL_SESSION' && !session)) {
      show('login');
    }
  });
  // Błąd z linku (np. wygasły)
  if (/error_description=/.test(location.hash)) {
    showError('Link logowania wygasł albo został już użyty. Wyślij nowy.');
    history.replaceState(null, '', location.pathname);
  }
  // ---- GA4: konto ----

  // form_start dla formularza e-mail przy pierwszym focusie
  let _loginStarted = false;
  $<HTMLInputElement>('[data-login-form] input[name="email"]').addEventListener('focus', () => {
    if (_loginStarted) return; _loginStarted = true; trackFormStart('login_form');
  });

  // form_field_click + form_field_error dla pola kodu OTP
  $<HTMLInputElement>('[data-code-form] input[name="code"]').addEventListener('focus', () => {
    trackFormFieldClick('login_form', 'otp_code');
  });

  // Nadpisz onAuthStateChange aby wysłać login/sign_up i user_id
  const _origOASC = sb().auth.onAuthStateChange;
  sb().auth.onAuthStateChange((event, session) => {
    if (session?.user) {
      const uid = session.user.id;
      if (event === 'SIGNED_IN') {
        // Supabase nie rozróżnia sign_up od login w OTP – sprawdzamy datę konta
        const created = new Date(session.user.created_at).getTime();
        const isNew = Date.now() - created < 60_000; // nowe konto = stworzone <60s temu
        if (isNew) trackSignUp('email_otp');
        trackLogin('email_otp', uid);
        setUserId(uid);
      } else if (event === 'INITIAL_SESSION') {
        setUserId(uid);
      }
    } else if (event === 'SIGNED_OUT') {
      clearUserData();
    }
  });

  // form_field_error przy błędnym kodzie OTP
  const _origCodeSubmit = $('[data-code-form]').onsubmit;
  $('[data-code-form]').addEventListener('submit', async (e) => {
    // Obsługiwane przez istniejący listener – tutaj tylko obserwujemy wynik
    // przez MutationObserver na komunikacie błędu
    const msg = $('[data-code-msg]');
    const obs = new MutationObserver(() => {
      if (msg.textContent?.includes('nieprawidłowy') || msg.textContent?.includes('wygasł')) {
        trackFormFieldError('login_form', 'otp_code', 'Nieprawidłowy lub wygasły kod');
      }
      obs.disconnect();
    });
    obs.observe(msg, { childList: true, characterData: true, subtree: true });
  });

  })();
</script>

