---
import Base from '../../layouts/Base.astro';
import { products } from '../../data/shop';

const catalog = products.map(({ slug, price }) => ({ slug, price }));
---
<Base title="Moje konto | Can-C" description="Historia zamówień, przesyłki i ponowne zamówienia w sklepie Can-C." noindex>
  <div class="w ac" data-account>

    <!-- Ładowanie sesji -->
    <p class="p ac__loading" data-state="loading">Ładowanie…</p>

    <!-- Logowanie -->
    <section class="row ac__login" data-state="login" hidden>
      <div class="ac__lhead">
        <h1 class="h1">Moje konto</h1>
        <p class="p p--lg">Zaloguj się adresem e-mail użytym przy zamówieniu. Wyślemy link i kod – bez hasła.</p>
        <ul class="checks ac__perks">
          <li>Historia wszystkich zamówień, także z poprzedniej wersji sklepu</li>
          <li>Śledzenie przesyłek i ponowne zamówienie jednym kliknięciem</li>
          <li>Twoje kody rabatowe i przypomnienie o końcu kuracji</li>
        </ul>
      </div>
      <div class="fl ac__lcard">
        <form data-login-form novalidate class="ac__lform">
          <h2 class="ac__ct">Zaloguj się</h2>
          <div><label class="lbl" for="ac-mail">E-mail</label><input id="ac-mail" class="fld" type="email" name="email" autocomplete="email" required placeholder="jan@przyklad.pl" /></div>
          <button class="btn btn--wide" data-send>Wyślij link i kod</button>
          <p class="msg k" role="status" data-login-msg></p>
        </form>
        <form data-code-form hidden novalidate class="ac__lform">
          <h2 class="ac__ct">Wpisz kod</h2>
          <p class="p">Wysłaliśmy wiadomość na <strong data-sent-to></strong>. Kliknij link w mailu albo wpisz kod:</p>
          <div><label class="lbl" for="ac-code">Kod z maila</label><input id="ac-code" class="fld ac__code" type="text" name="code" inputmode="numeric" autocomplete="one-time-code" maxlength="8" pattern="[0-9]{6,8}" required placeholder="000000" /></div>
          <button class="btn btn--wide">Zaloguj się</button>
          <p class="msg k" role="status" data-code-msg></p>
          <p class="k">Nie widzisz maila? Sprawdź folder Spam albo <button type="button" class="ac__linkbtn" data-resend disabled>wyślij ponownie</button>.</p>
          <button type="button" class="ac__linkbtn k" data-change-email>Zmień adres e-mail</button>
        </form>
      </div>
    </section>

    <!-- Zalogowany -->
    <div data-state="dash" hidden>
      <section class="row ac__head">
        <div class="ac__hello">
          <h1 class="h1" data-hello>Moje konto</h1>
          <span class="p"><span data-email></span><span data-since></span></span>
        </div>
        <button type="button" class="btn btn-o btn-s" data-logout>Wyloguj</button>
      </section>

      <div class="g4 ac__stats" data-stats hidden>
        <div class="ac__stat"><span class="ac__sv ac__sv--s" data-s-total></span><span class="ac__sl">Wydane (zł)</span></div>
        <div class="ac__stat"><span class="ac__sv" data-s-count></span><span class="ac__sl">Zamówień</span></div>
        <div class="ac__stat"><span class="ac__sv" data-s-packs></span><span class="ac__sl">Opakowań</span></div>
        <div class="ac__chartbox">
          <span class="k">Wydatki w ostatnich 12 miesiącach</span>
          <div class="ac__chart" role="img" data-chart aria-label="Wydatki w ostatnich 12 miesiącach"></div>
        </div>
      </div>

      <div class="row ac__cards" data-cards hidden>
        <div class="ac__cure" data-reminder hidden>
          <span class="ac__soft">Twoja kuracja</span>
          <div class="ac__curerow">
            <span class="ac__curet" data-rem-title></span>
            <a class="btn btn-s ac__wbtn" data-rem-cta href="/produkt/krople-can-c/">Zamów zawczasu</a>
          </div>
          <div class="ac__bar" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-label="Postęp kuracji" data-rem-bar><div data-rem-fill></div></div>
          <span class="ac__soft" data-rem-sub></span>
        </div>
        <div class="fl ac__codes" data-codes hidden>
          <span class="k" style="color: var(--ink)">Twój kod rabatowy</span>
          <div data-codes-list class="ac__clist"></div>
        </div>
      </div>

      <section class="row ac__grid">
        <div class="ac__orders">
          <div class="row ac__ohead">
            <h2 class="h2">Zamówienia</h2>
            <div role="group" aria-label="Filtr zamówień" class="ac__filters" data-filters>
              <button type="button" class="chip" aria-pressed="true" data-f="all">Wszystkie</button>
              <button type="button" class="chip" aria-pressed="false" data-f="open">W toku</button>
              <button type="button" class="chip" aria-pressed="false" data-f="done">Zakończone</button>
            </div>
          </div>
          <div class="ac__olist" data-orders></div>
          <p class="p" data-orders-empty hidden>Nie masz jeszcze zamówień. <a href="/#produkty">Przejdź do sklepu</a>.</p>
          <p class="p" data-filter-empty hidden>Brak zamówień w tej grupie.</p>
          <button type="button" class="btn btn-o btn-m" data-more hidden style="align-self:flex-start">Pokaż starsze</button>
        </div>

        <aside class="fl ac__profile">
          <form data-profile-form novalidate class="ac__pform">
            <h2 class="ac__ct">Twoje dane</h2>
            <div class="ac__g2">
              <div><label class="lbl" for="a-fn">Imię</label><input id="a-fn" class="fld" name="first_name" autocomplete="given-name" maxlength="60" /></div>
              <div><label class="lbl" for="a-ln">Nazwisko</label><input id="a-ln" class="fld" name="last_name" autocomplete="family-name" maxlength="60" /></div>
            </div>
            <div><label class="lbl" for="a-tel">Telefon</label><input id="a-tel" class="fld" name="phone" type="tel" autocomplete="tel" maxlength="20" /></div>
            <div><label class="lbl" for="a-pk">Domyślny Paczkomat</label><input id="a-pk" class="fld" name="default_locker" maxlength="15" placeholder="np. WRO01M" /></div>
            <span class="ac__sub">Adres dostawy</span>
            <div><label class="lbl" for="a-st">Ulica i numer</label><input id="a-st" class="fld" name="street" autocomplete="street-address" maxlength="120" /></div>
            <div class="ac__gzip">
              <div><label class="lbl" for="a-zip">Kod</label><input id="a-zip" class="fld" name="postcode" maxlength="6" placeholder="00-000" /></div>
              <div><label class="lbl" for="a-city">Miejscowość</label><input id="a-city" class="fld" name="city" maxlength="60" /></div>
            </div>
            <span class="ac__sub">Dane do faktury</span>
            <div><label class="lbl" for="a-co">Nazwa firmy</label><input id="a-co" class="fld" name="company" autocomplete="organization" maxlength="150" placeholder="Opcjonalnie" /></div>
            <div><label class="lbl" for="a-nip">NIP</label><input id="a-nip" class="fld" name="nip" inputmode="numeric" maxlength="13" placeholder="Opcjonalnie" /></div>
            <div><label class="lbl" for="a-ist">Ulica i numer</label><input id="a-ist" class="fld" name="invStreet" maxlength="120" /></div>
            <div class="ac__gzip">
              <div><label class="lbl" for="a-izip">Kod</label><input id="a-izip" class="fld" name="invPostcode" maxlength="6" placeholder="00-000" /></div>
              <div><label class="lbl" for="a-icity">Miejscowość</label><input id="a-icity" class="fld" name="invCity" maxlength="60" /></div>
            </div>
            <label class="ck" style="margin-top:10px" id="newsletter"><input type="checkbox" name="marketing_consent" /><span>Chcę otrzymywać informacje o promocjach i kodach rabatowych.</span></label>
            <button class="btn btn--wide" style="margin-top:10px">Zapisz dane</button>
            <p class="msg k" role="status" data-profile-msg></p>
            <span class="k">E-mail <span data-email-2></span> służy do logowania. Aby go zmienić lub usunąć konto, <a href="/kontakt/">napisz do nas</a>.</span>
          </form>
        </aside>
      </section>
    </div>

    <p class="msg msg--err" role="alert" data-error hidden></p>
  </div>
</Base>

<script define:vars={{ catalog }}>
  // Dane z chwili budowania jako zapas; aktualne ceny i dostępność z bazy
  window.__CANC_CATALOG__ = catalog;
  window.__CANC_READY__ = fetch('/api/produkty')
    .then((r) => (r.ok ? r.json() : null))
    .then((list) => { if (Array.isArray(list) && list.length) window.__CANC_CATALOG__ = list.filter((p) => p.avail !== 'out_of_stock' || false).concat(list.filter((p) => p.avail === 'out_of_stock').map((p) => ({ ...p, price: null }))); })
    .catch(() => {});
</script>

<script>
  import { sb } from '../../lib/sb-client';
  import { addItem } from '../../lib/cart';
  import { trackLogin, trackSignUp, setUserId, clearUserData, trackFormStart, trackFormFieldClick, trackFormFieldError, trackFormSubmit } from '../../lib/analytics';

  (async () => {
  await (window as any).__CANC_READY__;

  const root = document.querySelector<HTMLElement>('[data-account]')!;
  const $ = <T extends Element = HTMLElement>(s: string) => root.querySelector<T>(s)!;
  const show = (state: string) => root.querySelectorAll<HTMLElement>('[data-state]').forEach((el) => (el.hidden = el.dataset.state !== state));
  const esc = (s: unknown) => String(s ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);
  const pln = (g: number) => new Intl.NumberFormat('pl-PL', { style: 'currency', currency: 'PLN' }).format(g / 100);
  const day = (s: string) => new Date(s).toLocaleDateString('pl-PL', { day: 'numeric', month: 'long', year: 'numeric' });
  const catalog: { slug: string; price: number | null }[] = (window as any).__CANC_CATALOG__ ?? [];

  const STATUS: Record<string, [string, string, 'open' | 'done']> = {
    pending_payment: ['Oczekuje na płatność', 'wait', 'open'], paid: ['Przyjęte do realizacji', 'new', 'open'], on_hold: ['W trakcie wyjaśniania', 'wait', 'open'],
    shipped: ['Wysłane', 'sent', 'open'], completed: ['Zrealizowane', 'done', 'done'], cancelled: ['Anulowane', 'cancel', 'done'], refunded: ['Zwrócone', 'cancel', 'done'], failed: ['Nieudane', 'cancel', 'done'],
  };
  const imgOf = (slug: string) => ((catalog as any[]).find((c) => c.slug === slug)?.image as string | undefined) || '';
  const PAY: Record<string, string> = { przelewy24: 'Przelewy24', bank_transfer: 'Przelew bankowy' };
  let filter: 'all' | 'open' | 'done' = 'all';
  const applyFilter = () => {
    const els = [...root.querySelectorAll<HTMLElement>('[data-orders] > article')];
    els.forEach((el) => { el.hidden = filter !== 'all' && el.dataset.group !== filter; });
    $('[data-filter-empty]').hidden = !els.length || els.some((el) => !el.hidden);
  };
  const track = (carrier: string, nr: string) => {
    const c = (carrier || '').toLowerCase(), n = encodeURIComponent(nr);
    if (c.includes('dpd')) return `https://tracktrace.dpd.com.pl/parcelDetails?typ=1&p1=${n}`;
    if (c.includes('inpost') || c.includes('paczkomat') || c.includes('easypack')) return `https://inpost.pl/sledzenie-przesylek?number=${n}`;
    return 'https://furgonetka.pl/zlokalizuj';
  };
  const showError = (m: string) => { const e = $('[data-error]'); e.textContent = m; e.hidden = !m; };

  // ---------- Logowanie ----------
  let email = '';
  let cooldown = 0;
  const startCooldown = () => {
    const btn = $<HTMLButtonElement>('[data-resend]');
    cooldown = 60; btn.disabled = true;
    const t = setInterval(() => {
      cooldown--; btn.textContent = cooldown > 0 ? `wyślij ponownie (${cooldown} s)` : 'wyślij ponownie';
      if (cooldown <= 0) { btn.disabled = false; clearInterval(t); }
    }, 1000);
  };

  async function sendLink() {
    const { error } = await sb().auth.signInWithOtp({
      email,
      options: { emailRedirectTo: `${location.origin}/konto/`, shouldCreateUser: true },
    });
    if (error) throw error;
  }

  $('[data-login-form]').addEventListener('submit', async (e) => {
    e.preventDefault();
    const f = e.target as HTMLFormElement;
    const msg = $('[data-login-msg]');
    email = String(new FormData(f).get('email') || '').trim().toLowerCase();
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(email)) { msg.textContent = 'Podaj poprawny adres e-mail.'; return; }
    const btn = $<HTMLButtonElement>('[data-send]'); btn.disabled = true; msg.textContent = 'Wysyłanie…';
    try {
      await sendLink();
      f.hidden = true; $('[data-code-form]').hidden = false; $('[data-sent-to]').textContent = email;
      $<HTMLInputElement>('input[name="code"]').focus();
      startCooldown(); msg.textContent = '';
    } catch (err: any) {
      msg.textContent = /rate|limit|seconds/i.test(err?.message || '') ? 'Zbyt wiele prób. Odczekaj minutę i spróbuj ponownie.' : 'Nie udało się wysłać maila. Spróbuj ponownie za chwilę.';
      console.error(err);
    } finally { btn.disabled = false; }
  });

  $('[data-code-form]').addEventListener('submit', async (e) => {
    e.preventDefault();
    const msg = $('[data-code-msg]');
    const token = String(new FormData(e.target as HTMLFormElement).get('code') || '').replace(/\D/g, '');
    if (token.length < 6 || token.length > 8) { msg.textContent = 'Wpisz kod z maila (same cyfry).'; return; }
    msg.textContent = 'Sprawdzanie…';
    const { error } = await sb().auth.verifyOtp({ email, token, type: 'email' });
    msg.textContent = error ? 'Kod jest nieprawidłowy albo wygasł. Wyślij nowy.' : '';
  });

  $('[data-resend]').addEventListener('click', async () => {
    try { await sendLink(); startCooldown(); $('[data-code-msg]').textContent = 'Wysłaliśmy nowy kod.'; }
    catch { $('[data-code-msg]').textContent = 'Nie udało się wysłać. Spróbuj za chwilę.'; }
  });
  $('[data-change-email]').addEventListener('click', () => { $('[data-code-form]').hidden = true; $('[data-login-form]').hidden = false; });
  $('[data-logout]').addEventListener('click', async () => { await sb().auth.signOut(); show('login'); });

  // ---------- Wywołania API z tokenem sesji ----------
  async function apiUser(path: string, body?: unknown) {
    const { data } = await sb().auth.getSession();
    const token = data.session?.access_token;
    const res = await fetch(path, {
      method: body ? 'POST' : 'GET',
      headers: { 'Content-Type': 'application/json', ...(token ? { Authorization: `Bearer ${token}` } : {}) },
      body: body ? JSON.stringify(body) : undefined,
    });
    const out = await res.json().catch(() => ({}));
    if (!res.ok) throw new Error(out.error || 'Błąd serwera.');
    return out;
  }

  // ---------- Panel klienta ----------
  let page = 0;
  const PAGE = 20;

  async function loadDashboard(userEmail: string) {
    show('dash');
    $('[data-email]').textContent = userEmail;

    $('[data-email-2]').textContent = userEmail;
    loadProfile();
    loadCodes();
    loadStats();

    page = 0;
    $('[data-orders]').innerHTML = '';
    await loadOrders(true);
  }

  async function loadOrders(first = false) {
    const from = page * PAGE;
    const { data, error } = await sb()
      .from('orders')
      .select('id,number,created_at,paid_at,shipped_at,status,total,shipping_method,shipping_point,tracking_number,carrier,source,payment_provider,order_items(name,qty,product_id)')
      .order('created_at', { ascending: false })
      .range(from, from + PAGE - 1);
    if (error) { showError('Nie udało się pobrać zamówień. Odśwież stronę.'); console.error(error); return; }

    const list = $('[data-orders]');
    $('[data-orders-empty]').hidden = !(first && data.length === 0);
    $('[data-more]').hidden = data.length < PAGE;
    if (first) renderReminder(data);

    for (const o of data) {
      const [label, tone, group] = STATUS[o.status] || [o.status, 'new', 'open'];
      const reorderable = o.order_items.some((i: any) => catalog.some((c) => c.slug === i.product_id && c.price !== null));
      const first = o.order_items[0];
      const thumb = first ? imgOf(first.product_id) : '';
      const ship = o.shipping_method === 'dpd' ? 'Kurier DPD' : o.shipping_point ? `Paczkomat ${esc(o.shipping_point)}` : esc(o.shipping_method || '');
      const action = o.tracking_number
        ? `<a class="ac__ul" href="${track(o.carrier || o.shipping_method, o.tracking_number)}" target="_blank" rel="noopener">Śledź przesyłkę</a>`
        : o.status === 'pending_payment' && o.payment_provider === 'bank_transfer'
          ? `<a class="ac__ul" href="/zamowienie/dziekujemy/?id=${encodeURIComponent(o.id)}">Pokaż dane do przelewu</a>` : '';
      const li = document.createElement('article');
      li.className = 'ac__order';
      li.dataset.group = group;
      li.innerHTML = `
        <div class="ac__otop">
          <div class="ac__ohd"><h3 class="ac__onr">Zamówienie ${o.number}</h3><span class="k">${day(o.created_at)} · ${ship}</span></div>
          <span class="ac__st ac__st--${tone}"><span class="dot" aria-hidden="true"></span>${esc(label)}</span>
        </div>
        <div class="ac__oitems">
          ${thumb ? `<img class="ac__othumb" src="${esc(thumb)}" alt="" width="66" height="66" loading="lazy">` : '<span class="ac__othumb"></span>'}
          <span>${o.order_items.map((i: any) => `${esc(i.name)} × ${i.qty}`).join('<br>')}</span>
        </div>
        <div class="ac__ofoot">
          <div class="ac__opay">
            <span class="ac__ototal">${pln(o.total)}</span>
            ${PAY[o.payment_provider] ? `<span class="k">${PAY[o.payment_provider]}</span>` : ''}
            ${action}
          </div>
          ${reorderable ? '<button type="button" class="btn btn-o btn-s" data-reorder>Zamów ponownie</button>' : ''}
        </div>
        <div class="ac__olinks">
          <button type="button" class="ac__linkbtn k" data-ask>Napisz w sprawie zamówienia</button>
          ${['paid', 'shipped', 'completed'].includes(o.status) ? `<a class="k" href="/odstapienie-od-umowy/?nr=${o.number}#odstapienie">Odstąp od umowy</a>` : ''}
        </div>
        <form class="ac__ask" data-ask-form hidden>
          <div><label class="lbl">Temat
            <select class="fld" name="topic"><option value="pytanie">Pytanie</option><option value="dostawa">Dostawa</option><option value="zwrot">Zwrot</option><option value="reklamacja">Reklamacja</option><option value="faktura">Faktura</option><option value="inne">Inne</option></select></label>
          </div>
          <div><label class="lbl">Wiadomość<textarea class="fld" name="message" rows="3" maxlength="3000" required></textarea></label></div>
          <div class="ac__askrow"><button class="btn btn-s">Wyślij</button><span class="msg k" role="status" data-ask-msg></span></div>
        </form>`;
      const askForm = li.querySelector<HTMLFormElement>('[data-ask-form]')!;
      li.querySelector('[data-ask]')!.addEventListener('click', () => { askForm.hidden = !askForm.hidden; if (!askForm.hidden) askForm.querySelector('textarea')!.focus(); });
      askForm.addEventListener('submit', async (ev) => {
        ev.preventDefault();
        const m = askForm.querySelector<HTMLElement>('[data-ask-msg]')!;
        const fd = new FormData(askForm);
        m.textContent = 'Wysyłanie…';
        try {
          await apiUser('/api/konto/wiadomosc', { number: o.number, topic: fd.get('topic'), message: fd.get('message') });
          m.textContent = 'Wysłano. Odpowiemy na Twój e-mail.'; askForm.reset();
        } catch (err) { m.textContent = (err as Error).message; }
      });
      li.querySelector('[data-reorder]')?.addEventListener('click', () => {
        for (const i of o.order_items) {
          if (catalog.some((c) => c.slug === i.product_id && c.price !== null)) addItem(i.product_id, i.qty);
        }
        location.href = '/koszyk/';
      });
      list.append(li);
    }
    applyFilter();
  }
  root.querySelectorAll<HTMLButtonElement>('[data-f]').forEach((b) => b.addEventListener('click', () => {
    filter = b.dataset.f as typeof filter;
    root.querySelectorAll('[data-f]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    applyFilter();
  }));
  $('[data-more]').addEventListener('click', () => { page++; loadOrders(); });

  // ---------- Profil ----------
  const form = $<HTMLFormElement>('[data-profile-form]');
  const setVal = (n: string, v: unknown) => { const el = form.elements.namedItem(n) as HTMLInputElement | null; if (el) el.type === 'checkbox' ? (el.checked = Boolean(v)) : (el.value = String(v ?? '')); };
  async function loadProfile() {
    try {
      const p = await apiUser('/api/konto/profil');
      if (p.first_name) $('[data-hello]').textContent = `Dzień dobry, ${p.first_name}`;
      setVal('first_name', p.first_name); setVal('last_name', p.last_name); setVal('phone', p.phone); setVal('default_locker', p.default_locker);
      setVal('street', p.default_address?.street); setVal('postcode', p.default_address?.postcode); setVal('city', p.default_address?.city);
      setVal('company', p.billing?.company); setVal('nip', p.billing?.nip); setVal('invStreet', p.billing?.street); setVal('invPostcode', p.billing?.postcode); setVal('invCity', p.billing?.city);
      setVal('marketing_consent', p.marketing_consent);
    } catch (e) { console.error(e); }
  }
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const msg = $('[data-profile-msg]');
    const fd = new FormData(form);
    const body: Record<string, unknown> = Object.fromEntries([...fd.entries()].map(([k, v]) => [k, String(v)]));
    body.marketing_consent = fd.get('marketing_consent') !== null;
    msg.textContent = 'Zapisywanie…'; msg.classList.remove('msg--err');
    try { await apiUser('/api/konto/profil', body); msg.textContent = 'Zapisano.'; }
    catch (err) { msg.textContent = (err as Error).message; msg.classList.add('msg--err'); }
  });

  // ---------- Kody rabatowe ----------
  async function loadCodes() {
    try {
      const { codes } = await apiUser('/api/konto/kody');
      if (!codes.length) return;
      $('[data-codes]').hidden = false;
      $('[data-cards]').hidden = false;
      $('[data-codes-list]').innerHTML = codes.map((c: any, n: number) => `
        <div class="ac__citem${n ? ' ac__citem--more' : ''}">
          <div class="ac__crow">
            <span class="ac__cval">${c.type === 'percent' ? `−${c.value}%` : `−${pln(c.value)}`}</span>
            <span class="ac__ccode">${esc(c.code)}</span>
          </div>
          <span class="k" style="color: var(--ink)">${[esc(c.description || ''), c.min_total ? `od ${pln(c.min_total)}` : '', c.ends_at ? `ważny do ${day(c.ends_at)}` : ''].filter(Boolean).join(' · ')}</span>
          <button type="button" class="btn btn-o btn-s" data-copy="${esc(c.code)}">Kopiuj kod</button>
        </div>`).join('');
      $('[data-codes-list]').querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((b) => b.addEventListener('click', async () => {
        try { await navigator.clipboard.writeText(b.dataset.copy!); b.textContent = 'Skopiowano'; } catch { /* brak dostępu do schowka */ }
      }));
    } catch (e) { console.error(e); }
  }

  // ---------- Statystyki i wykres (12 miesięcy) ----------
  async function loadStats() {
    const { data, error } = await sb().from('orders').select('created_at,total,status,order_items(qty,product_id)').in('status', ['paid', 'shipped', 'completed']).limit(1000);
    if (error || !data?.length) return;
    $('[data-stats]').hidden = false;
    const total = data.reduce((s: number, o: any) => s + o.total, 0);
    const packs = data.reduce((s: number, o: any) => s + o.order_items.filter((i: any) => i.product_id === 'krople-can-c').reduce((a: number, i: any) => a + i.qty, 0), 0);
    $('[data-s-total]').textContent = new Intl.NumberFormat('pl-PL', { minimumFractionDigits: 2, maximumFractionDigits: 2 }).format(total / 100);
    const firstYear = Math.min(...data.map((o: any) => new Date(o.created_at).getFullYear()));
    $('[data-since]').textContent = ` · z nami od ${firstYear}`;
    $('[data-s-count]').textContent = String(data.length);
    $('[data-s-packs]').textContent = String(packs);

    const now = new Date();
    const months = Array.from({ length: 12 }, (_, k) => { const d = new Date(now.getFullYear(), now.getMonth() - 11 + k, 1); return { y: d.getFullYear(), m: d.getMonth(), sum: 0 }; });
    for (const o of data) {
      const d = new Date(o.created_at);
      const b = months.find((x) => x.y === d.getFullYear() && x.m === d.getMonth());
      if (b) b.sum += o.total;
    }
    const max = Math.max(...months.map((x) => x.sum), 1);
    const roman = ['I', 'II', 'III', 'IV', 'V', 'VI', 'VII', 'VIII', 'IX', 'X', 'XI', 'XII'];
    const top = months.reduce((a, b) => (b.sum > a.sum ? b : a), months[0]);
    $('[data-chart]').setAttribute('aria-label', `Wydatki w ostatnich 12 miesiącach${top.sum ? `: najwyższe w ${roman[top.m]} ${top.y} (${pln(top.sum)})` : ''}`);
    $('[data-chart]').innerHTML = months.map((x, k) => `
      <div class="ac__bcol" title="${roman[x.m]} ${x.y}: ${pln(x.sum)}">
        <div class="ac__b${k === 11 ? ' ac__b--now' : x.sum ? ' ac__b--on' : ''}" style="height:${x.sum ? Math.max(6, Math.round((x.sum / max) * 60)) : 3}px"></div>
        <span class="ac__bl">${roman[x.m]}</span>
      </div>`).join('');
  }

  // Przypomnienie: jedno opakowanie kropli ≈ 30 dni kuracji
  function renderReminder(orders: any[]) {
    const last = orders.find((o) => ['paid', 'shipped', 'completed'].includes(o.status) && o.order_items.some((i: any) => i.product_id === 'krople-can-c'));
    if (!last) return;
    const packs = last.order_items.filter((i: any) => i.product_id === 'krople-can-c').reduce((s: number, i: any) => s + i.qty, 0);
    const start = new Date(last.shipped_at || last.paid_at || last.created_at).getTime() + 3 * 864e5; // ok. 3 dni na dostawę
    const end = start + packs * 30 * 864e5;
    const left = Math.round((end - Date.now()) / 864e5);
    if (left < -60) return; // dawno po kuracji – bez karty
    const rem = $('[data-reminder]');
    rem.hidden = false;
    $('[data-cards]').hidden = false;
    $('[data-rem-title]').textContent = left > 0
      ? `Zostało ok. ${left} ${left === 1 ? 'dnia' : 'dni'} kropli z zamówienia ${last.number}`
      : `Zapas kropli z zamówienia ${last.number} prawdopodobnie się skończył`;
    const pct = Math.min(100, Math.max(0, Math.round(((Date.now() - start) / (end - start)) * 100)));
    $('[data-rem-bar]').setAttribute('aria-valuenow', String(pct));
    $<HTMLElement>('[data-rem-fill]').style.width = pct + '%';
    $('[data-rem-sub]').textContent = `Szacunek przy 1–2 kroplach do oka, dwa razy dziennie. ${packs} ${packs === 1 ? 'opakowanie ≈ 1 miesiąc' : packs < 5 ? `opakowania ≈ ${packs} miesiące` : `opakowań ≈ ${packs} miesięcy`}.`;
    $<HTMLAnchorElement>('[data-rem-cta]').textContent = left > 21 ? 'Zamów ponownie' : 'Zamów zawczasu';
    const qty = packs >= 4 ? 4 : packs >= 2 ? 2 : 2;
    $<HTMLAnchorElement>('[data-rem-cta]').href = `/produkt/krople-can-c/?zestaw=${qty}`;
  }

  const preEmail = new URLSearchParams(location.search).get('email');
  if (preEmail) $<HTMLInputElement>('[data-login-form] input[name="email"]').value = preEmail;

  // ---------- Start ----------
  sb().auth.onAuthStateChange((event, session) => {
    if (session?.user && (event === 'SIGNED_IN' || event === 'INITIAL_SESSION')) {
      if (location.hash.includes('access_token')) history.replaceState(null, '', location.pathname);
      loadDashboard(session.user.email || '');
    } else if (event === 'SIGNED_OUT' || (event === 'INITIAL_SESSION' && !session)) {
      show('login');
    }
  });
  // Błąd z linku (np. wygasły)
  if (/error_description=/.test(location.hash)) {
    showError('Link logowania wygasł albo został już użyty. Wyślij nowy.');
    history.replaceState(null, '', location.pathname);
  }
  // ---- GA4: konto ----

  // form_start dla formularza e-mail przy pierwszym focusie
  let _loginStarted = false;
  $<HTMLInputElement>('[data-login-form] input[name="email"]').addEventListener('focus', () => {
    if (_loginStarted) return; _loginStarted = true; trackFormStart('login_form');
  });

  // form_field_click + form_field_error dla pola kodu OTP
  $<HTMLInputElement>('[data-code-form] input[name="code"]').addEventListener('focus', () => {
    trackFormFieldClick('login_form', 'otp_code');
  });

  // Nadpisz onAuthStateChange aby wysłać login/sign_up i user_id
  const _origOASC = sb().auth.onAuthStateChange;
  sb().auth.onAuthStateChange((event, session) => {
    if (session?.user) {
      const uid = session.user.id;
      if (event === 'SIGNED_IN') {
        // Supabase nie rozróżnia sign_up od login w OTP – sprawdzamy datę konta
        const created = new Date(session.user.created_at).getTime();
        const isNew = Date.now() - created < 60_000; // nowe konto = stworzone <60s temu
        if (isNew) trackSignUp('email_otp');
        trackLogin('email_otp', uid);
        setUserId(uid);
      } else if (event === 'INITIAL_SESSION') {
        setUserId(uid);
      }
    } else if (event === 'SIGNED_OUT') {
      clearUserData();
    }
  });

  // form_field_error przy błędnym kodzie OTP
  const _origCodeSubmit = $('[data-code-form]').onsubmit;
  $('[data-code-form]').addEventListener('submit', async (e) => {
    // Obsługiwane przez istniejący listener – tutaj tylko obserwujemy wynik
    // przez MutationObserver na komunikacie błędu
    const msg = $('[data-code-msg]');
    const obs = new MutationObserver(() => {
      if (msg.textContent?.includes('nieprawidłowy') || msg.textContent?.includes('wygasł')) {
        trackFormFieldError('login_form', 'otp_code', 'Nieprawidłowy lub wygasły kod');
      }
      obs.disconnect();
    });
    obs.observe(msg, { childList: true, characterData: true, subtree: true });
  });

  })();
</script>

