---
import Base from '../layouts/Base.astro';
import { getEnv } from '../lib/env';
import { products } from '../data/shop';
import { getCatalog } from '../lib/catalog';
import { discountRate } from '../lib/pricing';
import { getPageContent, getSection } from '../lib/page-content';

export const prerender = false;

const env = await getEnv(Astro.locals);
// Cena kropli z bazy (zapas: dane z kodu)
const catalog = await getCatalog(env).catch(() => []);
const dropsDb = catalog.find((p) => p.id === 'krople-can-c');
const unit = dropsDb?.current ?? (products.find((p) => p.slug === 'krople-can-c')?.price ?? 0) * 100; // grosze
const pln = (g: number) => new Intl.NumberFormat('pl-PL', { style: 'currency', currency: 'PLN' }).format(g / 100);
const word = (n: number) => (n === 1 ? 'opakowanie' : n < 5 ? 'opakowania' : 'opakowań');
const plan = [
  { label: '1 miesiąc', qty: 1, set: 1 }, { label: '2 miesiące', qty: 2, set: 2 },
  { label: '3–4 miesiące', qty: 4, set: 4 }, { label: '6 miesięcy', qty: 6, set: 4 },
].map((p) => {
  const regular = unit * p.qty;
  const total = Math.round(regular * (1 - discountRate(p.qty, true)));
  const saved = regular - total;
  return {
    ...p,
    packs: p.qty === 6 ? '6 opakowań (4 + 2)' : `${p.qty} ${word(p.qty)}`,
    price: pln(total),
    save: saved ? `Oszczędzasz ${pln(saved)} (${Math.round(discountRate(p.qty, true) * 100)}%)` : 'Cena regularna',
  };
});
const defaultPlan = 2;
const toc = [
  { href: '#dawkowanie', label: 'Dawkowanie' }, { href: '#fiolka', label: 'Otwieranie fiolki' },
  { href: '#zakraplanie', label: 'Zakraplanie' }, { href: '#ile', label: 'Ile opakowań potrzebujesz' },
];
const rows = await getPageContent(env, 'how_to_use').catch(() => []);
const at = (key: string, fb: any) => getSection(rows, key) ?? fb;
const intro = at('how_to_use.intro', { h1: 'Jak stosować krople Can-C', lead: 'Pierwsze efekty mogą pojawić się po miesiącu.' });
const dosage = at('how_to_use.dosage', { h2: 'Dawkowanie', note: 'Krople Can-C nie zastępują leczenia.', doses: [{ num: '1–2', title: 'krople do oka, dwa razy dziennie', desc: 'Standardowe dawkowanie.' }, { num: '4', title: 'krople do oka dziennie to maksimum', desc: 'Większa dawka nie daje korzyści.' }, { num: '1', title: 'kropla raz dziennie, profilaktycznie', desc: 'Po zakończeniu kuracji.' }] });
const opening = at('how_to_use.opening', { h2: 'Otwieranie fiolki', lead: 'Fiolka jest fabrycznie zamknięta.', steps: ['Zdejmij dolny pierścień.', 'Dokręć nakrętkę.', 'Odkręć nakrętkę.', 'Naciśnij fiolkę.'], step_images: [null, null, null, null] as (string|null)[] });
const applying = at('how_to_use.applying', { h2: 'Zakraplanie', steps: [{ title: 'Odchyl głowę do tyłu', desc: 'Patrz w górę.' }, { title: 'Zakroplij jedną kroplę', desc: 'Nie dotykaj oka końcówką.' }, { title: 'Powoli zamknij oko', desc: 'Bez zaciskania powiek.' }, { title: 'Odczekaj 60 sekund', desc: 'Nie mrugaj.' }, { title: 'Powtórz przy drugiej kropli', desc: 'Jeśli stosujesz dwie krople.' }], image_url: null as string|null, image_alt: 'Zakraplanie kropli Can-C' });
const howTo = { '@context': 'https://schema.org', '@type': 'HowTo', name: intro.h1, step: (applying.steps as {title:string;desc:string}[]).map((s, i) => ({ '@type': 'HowToStep', position: i + 1, name: s.title, text: s.desc })) };
---
<Base title="Jak stosować krople Can-C | Dawkowanie i aplikacja" description="Dawkowanie kropli Can-C, otwieranie fiolki i prawidłowe zakraplanie krok po kroku. Sprawdź, ile opakowań potrzebujesz na kurację." nav="stosowanie">
  <script type="application/ld+json" set:html={JSON.stringify(howTo)} />

  <section class="w row us-hero">
    <div class="fl us-hero__l">
      <nav class="crumb" aria-label="Okruszki"><a href="/">Strona główna</a> / Stosowanie</nav>
      <h1 class="h1">{intro.h1}</h1>
      <p class="p p--lg" style="max-width:560px">{intro.lead}</p>
    </div>
    <nav class="fl us-toc" aria-label="Spis treści">
      {toc.map((t) => <a href={t.href} class="us-anc">{t.label} <span aria-hidden="true">↓</span></a>)}
    </nav>
  </section>

  <section id="dawkowanie" class="us-dark">
    <div class="w us-pad">
      <h2 class="h2">{dosage.h2}</h2>
      <div class="g3 us-doses">
        {(dosage.doses as { num: string; title: string; desc: string }[]).map((d) => (
          <div class="us-dose">
            <span class="us-dose__n">{d.num}</span>
            <span class="us-dose__t">{d.title}</span>
            <span class="us-dose__d">{d.desc}</span>
          </div>
        ))}
      </div>
      {dosage.note && (
        <div class="us-note">
          <span aria-hidden="true" class="us-note__i">!</span>
          <p>{dosage.note}</p>
        </div>
      )}
    </div>
  </section>

  <section id="fiolka" class="w us-sec">
    <div class="row us-sechead">
      <h2 class="h2">{opening.h2}</h2>
      <p class="p fl justify" style="width:517px">{opening.lead}</p>
    </div>
    <ol class="g4 us-steps">
      {(opening.steps as string[]).map((t, i) => {
        const img = (opening.step_images as (string | null)[])?.[i];
        return (
          <li class="us-step">
            <div class="notch us-step__img">
              {img ? <img src={img} alt={`Krok ${i + 1}: ${t}`} width="400" height="300" loading="lazy" /> : <span class="notch__ph">[ilustracja: krok {i + 1}]</span>}
              <span aria-hidden="true" class="us-step__n">{i + 1}</span>
            </div>
            <p class="us-step__t"><span class="crumb" style="display:block">Krok {i + 1}</span>{t}</p>
          </li>
        );
      })}
    </ol>
  </section>

  <section id="zakraplanie" class="us-band">
    <div class="w row us-pad us-split">
      <div class="fl us-split__l">
        <h2 class="h2">{applying.h2}</h2>
        <p class="p p--lg">Najważniejsze jest 60 sekund z zamkniętym okiem. Nawet jedno mrugnięcie wypycha większość kropli.</p>
        <div class="us-arch">
          {applying.image_url ? <img src={applying.image_url} alt={applying.image_alt || 'Zakraplanie'} width="533" height="431" loading="lazy" /> : <span class="k">[ilustracja: odchylona głowa, zakraplanie]</span>}
        </div>
      </div>
      <ol class="us-drops">
        {(applying.steps as { title: string; desc: string }[]).map((st, i) => (
          <li>
            <span aria-hidden="true" class="us-drops__n">{i + 1}</span>
            <div class="us-drops__t"><h3>{st.title}</h3><p class="p">{st.desc}</p></div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section id="ile" class="w row us-split us-last">
    <div class="fl us-split__l">
      <h2 class="h2">Ile opakowań<br />potrzebujesz</h2>
      <p class="p p--lg">Jedno opakowanie (2 × 5 ml) wystarcza na około miesiąc przy standardowym dawkowaniu.</p>
      <div class="us-leaf" aria-hidden="true"></div>
    </div>
    <div class="us-calc" data-calc>
      <span class="us-calc__q" id="kuracja-label">Jak długo planujesz kurację?</span>
      <div role="group" aria-labelledby="kuracja-label" class="us-calc__chips">
        {plan.map((p, i) => (
          <button type="button" class="chip" aria-pressed={i === defaultPlan ? 'true' : 'false'}
            data-packs={p.packs} data-price={p.price} data-save={p.save} data-set={p.set}>{p.label}</button>
        ))}
      </div>
      <div class="us-calc__res" aria-live="polite">
        <span class="k">Polecamy</span>
        <span class="us-calc__packs" data-packs-out>{plan[defaultPlan].packs}</span>
        <div class="us-calc__row">
          <span class="us-calc__price" data-price-out>{plan[defaultPlan].price}</span>
          <span class="peach" data-save-out>{plan[defaultPlan].save}</span>
        </div>
      </div>
      <a href={`/produkt/krople-can-c/?zestaw=${plan[defaultPlan].set}`} class="btn" style="align-self:flex-start" data-go>
        Przejdź do zamówienia
        <svg aria-hidden="true" width="18" height="14" viewBox="0 0 18 14"><path d="M0 7h16M10 1l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2"/></svg>
      </a>
    </div>
  </section>
</Base>

<script>
  const calc = document.querySelector<HTMLElement>('[data-calc]');
  if (calc) {
    const out = (s: string) => calc.querySelector<HTMLElement>(s)!;
    const go = calc.querySelector<HTMLAnchorElement>('[data-go]')!;
    const chips = calc.querySelectorAll<HTMLButtonElement>('.chip');
    chips.forEach((b) => b.addEventListener('click', () => {
      chips.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      out('[data-packs-out]').textContent = b.dataset.packs ?? '';
      out('[data-price-out]').textContent = b.dataset.price ?? '';
      out('[data-save-out]').textContent = b.dataset.save ?? '';
      go.href = `/produkt/krople-can-c/?zestaw=${b.dataset.set}`;
    }));
  }
</script>

<style>
  .us-hero { margin-top: 45px; display: flex; align-items: flex-end; justify-content: space-between; gap: 45px; }
  .us-hero__l { width: 819px; display: flex; flex-direction: column; gap: 24px; }
  .us-toc { width: 408px; border-bottom: 1px solid var(--line); }
  .us-anc { display: flex; align-items: center; justify-content: space-between; gap: 24px; padding: 18px 0; border-top: 1px solid var(--line); font-size: 18px; line-height: 27px; font-weight: 400; color: var(--ink); text-decoration: none; }
  .us-anc:hover { color: var(--muted); }
  section[id] { scroll-margin-top: 24px; }
  .us-pad { padding-top: 90px; padding-bottom: 90px; }
  .us-dark { margin-top: 90px; background: #1F1F1F; color: #FFFFFF; }
  .us-doses { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; margin-top: 45px; }
  .us-dose { border: 1px solid rgba(255,255,255,0.18); border-radius: var(--r-lg); padding: 32px; display: flex; flex-direction: column; gap: 14px; }
  .us-dose__n { font-size: 88px; line-height: 88px; font-weight: 200; }
  .us-dose__t { font-size: 24px; line-height: 28px; font-weight: 400; }
  .us-dose__d { font-size: 16px; line-height: 24px; font-weight: 300; color: #E8E8E8; }
  .us-note { display: flex; align-items: center; gap: 14px; margin-top: 45px; max-width: 737px; }
  .us-note__i { width: 42px; height: 42px; flex-shrink: 0; border-radius: 50%; background: var(--peach); color: #1F1F1F; display: flex; align-items: center; justify-content: center; font-size: 18px; font-weight: 500; }
  .us-note p { font-size: 16px; line-height: 24px; font-weight: 300; color: #E8E8E8; }
  .us-sec { margin-top: 90px; }
  .us-sechead { display: flex; align-items: flex-end; justify-content: space-between; gap: 45px; }
  .us-steps { list-style: none; margin: 45px 0 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 14px; }
  .us-step { display: flex; flex-direction: column; gap: 24px; }
  .us-step__img { height: 300px; }
  .us-step__img img { object-fit: cover; padding: 0; }
  .us-step__n { position: absolute; z-index: 2; right: 0; top: 0; width: 84px; height: 84px; border: 1px solid var(--ink); border-radius: 50%; background: var(--surface); display: flex; align-items: center; justify-content: center; font-size: 48px; line-height: 48px; font-weight: 200; }
  .us-step__t { font-size: 18px; line-height: 28px; font-weight: 400; }
  .us-band { margin-top: 90px; background: var(--band); }
  .us-split { display: flex; align-items: flex-start; gap: 45px; }
  .us-split__l { width: 533px; flex-shrink: 0; display: flex; flex-direction: column; gap: 24px; }
  .us-arch { height: 431px; margin-top: 21px; background: var(--image); border-radius: 500px 500px 40px 40px; display: flex; align-items: center; justify-content: center; overflow: hidden; }
  .us-arch img { width: 100%; height: 100%; object-fit: cover; }
  .us-drops { flex-grow: 1; min-width: 0; list-style: none; margin: 0; padding: 0; border-bottom: 1px solid var(--image); }
  .us-drops li { display: flex; gap: 24px; padding: 32px 0; border-top: 1px solid var(--image); }
  .us-drops__n { width: 66px; height: 66px; flex-shrink: 0; border-radius: 50%; background: var(--surface); display: flex; align-items: center; justify-content: center; font-size: 28px; font-weight: 300; }
  .us-drops__t { display: flex; flex-direction: column; gap: 10px; padding-top: 6px; }
  .us-drops__t h3 { font-size: 28px; line-height: 28px; font-weight: 400; }
  .us-last { margin-top: 90px; margin-bottom: 90px; }
  .us-leaf { width: 269px; height: 169px; margin-top: 21px; background: var(--image); border-radius: 20px 500px 20px 20px; }
  .us-calc { flex-grow: 1; min-width: 0; border: 1px solid var(--line); border-radius: 50px; padding: 45px; display: flex; flex-direction: column; gap: 24px; }
  .us-calc__q { font-size: 18px; line-height: 27px; font-weight: 400; }
  .us-calc__chips { display: flex; gap: 10px; flex-wrap: wrap; }
  .us-calc__res { border-top: 1px solid var(--line); padding-top: 24px; display: flex; flex-direction: column; gap: 6px; }
  .us-calc__packs { font-size: 48px; line-height: 72px; font-weight: 300; }
  .us-calc__row { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; }
  .us-calc__price { font-size: 28px; line-height: 42px; font-weight: 500; }
  @media (max-width: 1000px) {
    .us-dose__n { font-size: 64px; line-height: 64px; }
    .us-calc { padding: 28px; border-radius: 32px; }
    .us-calc__packs { font-size: 36px; line-height: 48px; }
    .us-leaf { display: none; }
  }
</style>
