---
import Base from '../layouts/Base.astro';
import Arrow from '../components/Arrow.astro';
import { products, lineTotal, formatPrice } from '../data/shop';
import { getPageContent, getSection } from '../lib/page-content';

export const prerender = false;

const drops = products.find((p) => p.slug === 'krople-can-c')!;
const plan = [
  { label: '1 miesiąc', qty: 1 }, { label: '2 miesiące', qty: 2 },
  { label: '3–4 miesiące', qty: 4 }, { label: '6 miesięcy', qty: 6 },
].map((p) => {
  const total = lineTotal(drops, p.qty);
  const regular = drops.price !== null ? drops.price * p.qty : null;
  const saved = total !== null && regular ? Math.round((1 - total / regular) * 100) : 0;
  return { ...p, price: `${formatPrice(total)}${saved ? ` · oszczędzasz ${saved}%` : ''}` };
});
const defaultPlan = 2;
const toc = [
  { href: '#dawkowanie', label: 'Dawkowanie' }, { href: '#otwieranie', label: 'Otwieranie fiolki' },
  { href: '#zakraplanie', label: 'Zakraplanie' }, { href: '#kuracja', label: 'Ile opakowań potrzebujesz' },
];
const env = await Astro.locals.runtime?.env ?? {};
const rows = await getPageContent(env, 'how_to_use').catch(() => []);
const at = (key: string, fb: any) => getSection(rows, key) ?? fb;
const intro = at('how_to_use.intro', { h1: 'Jak stosować krople Can-C', lead: 'Pierwsze efekty mogą pojawić się po miesiącu.' });
const dosage = at('how_to_use.dosage', { h2: 'Dawkowanie', note: 'Krople Can-C nie zastępują leczenia.', doses: [{ num: '1–2', title: 'krople do oka, dwa razy dziennie', desc: 'Standardowe dawkowanie.' }, { num: '4', title: 'krople do oka dziennie to maksimum', desc: 'Większa dawka nie daje korzyści.' }, { num: '1', title: 'kropla raz dziennie, profilaktycznie', desc: 'Po zakończeniu kuracji.' }] });
const opening = at('how_to_use.opening', { h2: 'Otwieranie fiolki', lead: 'Fiolka jest fabrycznie zamknięta.', steps: ['Zdejmij dolny pierścień.', 'Dokręć nakrętkę.', 'Odkręć nakrętkę.', 'Naciśnij fiolkę.'] });
const applying = at('how_to_use.applying', { h2: 'Zakraplanie', steps: [{ title: 'Odchyl głowę do tyłu', desc: 'Patrz w górę.' }, { title: 'Zakroplij jedną kroplę', desc: 'Nie dotykaj oka końcówką.' }, { title: 'Powoli zamknij oko', desc: 'Bez zaciskania powiek.' }, { title: 'Odczekaj 60 sekund', desc: 'Nie mrugaj.' }, { title: 'Powtórz przy drugiej kropli', desc: 'Jeśli stosujesz dwie krople.' }] });
const howTo = { '@context': 'https://schema.org', '@type': 'HowTo', name: intro.h1, step: (applying.steps as {title:string;desc:string}[]).map((s, i) => ({ '@type': 'HowToStep', position: i + 1, name: s.title, text: s.desc })) };
---
<Base title="Jak stosować krople Can-C | Dawkowanie i aplikacja" description="Dawkowanie kropli Can-C, otwieranie fiolki i prawidłowe zakraplanie krok po kroku. Sprawdź, ile opakowań potrzebujesz na kurację.">
  <script type="application/ld+json" set:html={JSON.stringify(howTo)} />

  <section class="page-hero">
    <div class="container hero-split">
      <div class="page-hero__inner">
        <nav class="crumbs" aria-label="Ścieżka"><a href="/">Strona główna</a> / Stosowanie</nav>
        <h1>{intro.h1}</h1>
        <p class="lead">{intro.lead}</p>
      </div>
      <nav class="toc" aria-label="Na tej stronie">
        {toc.map((t) => (
          <a href={t.href}>{t.label}
            <svg width="10" height="16" viewBox="0 0 10 16" fill="none" aria-hidden="true"><path d="M5 0v14M1 10l4 4 4-4" stroke="currentColor" stroke-width="1.2" /></svg>
          </a>
        ))}
      </nav>
    </div>
  </section>

  <section id="dawkowanie" class="section section--dark">
    <div class="container stack">
      <h2>{dosage.h2}</h2>
      <div class="dose-grid">
        {(dosage.doses as {num:string;title:string;desc:string}[]).map((d) => <div class="dose"><span class="dose__num">{d.num}</span><span class="dose__t">{d.title}</span><span class="dose__d">{d.desc}</span></div>)}
      </div>
      <p class="note-dark">{dosage.note}</p>
    </div>
  </section>

  <section id="otwieranie" class="section">
    <div class="container stack">
      <div class="intro">
        <h2>{opening.h2}</h2>
        <p class="lead">{opening.lead}</p>
      </div>
      <ol class="open-steps">
        {(opening.steps as string[]).map((t, i) => (
          <li>
            <div class="ph open-steps__img">[Ilustracja {i + 1}]</div>
            <span class="open-steps__n">{i + 1}</span>
            <span class="open-steps__t">{t}</span>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section id="zakraplanie" class="section section--tint">
    <div class="container split">
      <div class="split__aside">
        <h2>{applying.h2}</h2>
        <p class="lead">Najważniejsze jest 60 sekund z zamkniętym okiem. Nawet jedno mrugnięcie wypycha większość kropli.</p>
        <div class="ph apply-img">[Ilustracja: odchylona głowa, zakraplanie]</div>
      </div>
      <ol class="apply split__main">
        {(applying.steps as {title:string;desc:string}[]).map((s, i) => (
          <li>
            <span class="apply__n">{i + 1}</span>
            <span class="apply__text"><span class="apply__t">{s.title}</span><span class="muted">{s.desc}</span></span>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section id="kuracja" class="section">
    <div class="container split">
      <div class="split__aside">
        <h2 class="h3">Ile opakowań potrzebujesz</h2>
        <p class="lead">Jedno opakowanie (2 × 5 ml) wystarcza na około miesiąc przy standardowym dawkowaniu.</p>
      </div>
      <div class="calc split__main" data-calc>
        <fieldset>
          <legend>Jak długo planujesz kurację?</legend>
          <div class="pill-group">
            {plan.map((p, i) => (
              <label class="pill">
                <input type="radio" name="plan" value={p.qty} checked={i === defaultPlan} data-rec={p.rec} data-price={p.price} />
                {p.label}
              </label>
            ))}
          </div>
        </fieldset>
        <div class="calc__result" aria-live="polite">
          <span class="muted">Polecamy</span>
          <span class="calc__rec" data-rec-out>{plan[defaultPlan].rec}</span>
          <span data-price-out>{plan[defaultPlan].price}</span>
        </div>
        <a href={`/produkt/krople-can-c/?zestaw=${plan[defaultPlan].qty}`} class="btn" data-go>Przejdź do zamówienia <Arrow /></a>
      </div>
    </div>
  </section>
</Base>

<script>
  const calc = document.querySelector<HTMLElement>('[data-calc]');
  if (calc) {
    const rec = calc.querySelector<HTMLElement>('[data-rec-out]')!;
    const price = calc.querySelector<HTMLElement>('[data-price-out]')!;
    const go = calc.querySelector<HTMLAnchorElement>('[data-go]')!;
    calc.querySelectorAll<HTMLInputElement>('input[name="plan"]').forEach((r) =>
      r.addEventListener('change', () => {
        rec.textContent = r.dataset.rec ?? '';
        price.textContent = r.dataset.price ?? '';
        go.href = `/produkt/krople-can-c/?zestaw=${r.value}`;
      }),
    );
  }
</script>

<style>
  .stack { display: flex; flex-direction: column; gap: var(--s-4); }
  .intro { display: flex; flex-direction: column; gap: 16px; max-width: 600px; }
  .h3 { font-size: var(--fs-h3); }
  .split { display: flex; flex-wrap: wrap; gap: var(--s-4) var(--s-6); align-items: flex-start; }
  .split__aside { flex: 1 1 360px; display: flex; flex-direction: column; gap: var(--s-2); }
  .split__main { flex: 1 1 480px; min-width: 0; }

  .hero-split { display: flex; flex-wrap: wrap; gap: var(--s-4) var(--s-6); align-items: flex-end; }
  .hero-split .page-hero__inner { flex: 2 1 560px; }
  .toc { flex: 1 1 280px; display: flex; flex-direction: column; border-top: 1px solid var(--c-ink-10); }
  .toc a { display: flex; justify-content: space-between; align-items: center; padding: 16px 0; border-bottom: 1px solid var(--c-ink-10); color: var(--c-ink); text-decoration: none; font-size: 1.125rem; }

  section[id] { scroll-margin-top: 80px; }

  .dose-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: var(--s-2); }
  .dose { padding: var(--s-3); box-shadow: inset 0 0 0 1px var(--c-white-20); display: flex; flex-direction: column; gap: 16px; }
  .dose__num { font-size: clamp(3rem, 5vw, 4.1875rem); line-height: 1; font-weight: 300; color: var(--c-bright); }
  .dose__t { font-size: var(--fs-h4); line-height: 1.3; }
  .dose__d, .note-dark { color: var(--c-white-70); }
  .note-dark { max-width: 720px; }

  .open-steps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: var(--s-2); }
  .open-steps li { display: flex; flex-direction: column; gap: 16px; }
  .open-steps__img { aspect-ratio: 1 / 1; background: var(--c-gray-200); }
  .open-steps__n { font-size: 2.125rem; line-height: 1; font-weight: 300; color: var(--c-link); }
  .open-steps__t { font-size: 1.125rem; }

  .apply-img { aspect-ratio: 4 / 3; }
  .apply { list-style: none; margin: 0; padding: 0; }
  .apply li { display: flex; gap: var(--s-2); padding: var(--s-2) 0; border-top: 1px solid var(--c-ink-10); }
  .apply__n { flex: 0 0 48px; height: 48px; border-radius: 24px; background: var(--c-white); box-shadow: inset 0 0 0 1px var(--c-gray-400); display: flex; align-items: center; justify-content: center; font-size: 1.125rem; }
  .apply__text { display: flex; flex-direction: column; gap: 4px; padding-top: 10px; }
  .apply__t { font-size: 1.25rem; }

  .calc { padding: var(--s-3); background: var(--c-tint); display: flex; flex-direction: column; gap: var(--s-2); }
  .calc fieldset { margin: 0; padding: 0; border: 0; }
  .calc legend { padding-bottom: var(--s-1); }
  .calc__result { padding-top: var(--s-2); border-top: 1px solid var(--c-ink-20); display: flex; flex-direction: column; gap: 8px; }
  .calc__rec { font-size: 2.125rem; line-height: 1.15; font-weight: 300; }
  .calc .btn { align-self: flex-start; }
</style>
