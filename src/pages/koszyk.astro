---
import Base from '../layouts/Base.astro';
import { products } from '../data/shop';

// Do przeglądarki trafiają tylko dane potrzebne do podglądu koszyka
const catalog = products.map(({ slug, name, price, bundles, size }) => ({ slug, name, price, bundles: !!bundles, size }));
---
<Base title="Koszyk | Can-C" description="Twój koszyk w sklepie Can-C.">
  <section class="section">
    <div class="container cart-page">
      <h1>Koszyk</h1>
      <p class="cart-notice" data-notice hidden role="status"><span data-site="noticeText"></span></p>

      <div data-empty hidden class="empty">
        <p class="lead">Koszyk jest pusty.</p>
        <a href="/#produkty" class="btn">Przejdź do produktów</a>
      </div>

      <div data-filled hidden class="cart-layout">
        <ul class="lines" data-lines aria-label="Produkty w koszyku"></ul>

        <aside class="summary">
          <h2>Podsumowanie</h2>
          <dl>
            <div><dt>Produkty</dt><dd data-subtotal></dd></div>
            <div><dt>Rabat za zestaw</dt><dd data-discount></dd></div>
            <div><dt>Dostawa</dt><dd class="ok">0,00 zł</dd></div>
            <div class="total"><dt>Razem</dt><dd data-total></dd></div>
          </dl>
          <a href="/zamowienie/" class="btn btn--lg">Przejdź do dostawy i płatności</a>
          <p class="muted note">Ostateczną kwotę potwierdzimy w kolejnym kroku.</p>
        </aside>
      </div>

      <template data-line-tpl>
        <li class="line">
          <div class="ph line__img" aria-hidden="true">[foto]</div>
          <div class="line__info">
            <span class="line__name"></span>
            <span class="muted line__meta"></span>
          </div>
          <div class="qty">
            <button type="button" class="qty__btn" data-dec aria-label="Zmniejsz ilość">−</button>
            <span class="qty__val" aria-live="polite"></span>
            <button type="button" class="qty__btn" data-inc aria-label="Zwiększ ilość">+</button>
          </div>
          <span class="line__total"></span>
          <button type="button" class="line__remove" data-remove>Usuń</button>
        </li>
      </template>
    </div>
  </section>
</Base>

<script define:vars={{ catalog }}>
  // Dane z chwili budowania jako zapas; aktualne ceny i dostępność z bazy
  window.__CANC_CATALOG__ = catalog;
  window.__CANC_READY__ = fetch('/api/produkty')
    .then((r) => (r.ok ? r.json() : null))
    .then((list) => { if (Array.isArray(list) && list.length) window.__CANC_CATALOG__ = list.filter((p) => p.avail !== 'out_of_stock' || false).concat(list.filter((p) => p.avail === 'out_of_stock').map((p) => ({ ...p, price: null }))); })
    .catch(() => {});
</script>

<script>
  import { getCart, setQty, onCartChange } from '../lib/cart';

  (async () => {
  await (window as any).__CANC_READY__;

  type P = { slug: string; name: string; price: number | null; bundles: boolean; size: string };
  const catalog: P[] = (window as any).__CANC_CATALOG__ ?? [];
  const pln = new Intl.NumberFormat('pl-PL', { style: 'currency', currency: 'PLN' });
  const discountFor = (qty: number, p: P) => (!p.bundles ? 0 : qty >= 4 ? 0.1 : qty >= 2 ? 0.08 : 0);

  const $ = <T extends Element>(sel: string) => document.querySelector<T>(sel)!;
  const lines = $<HTMLUListElement>('[data-lines]');
  const tpl = $<HTMLTemplateElement>('[data-line-tpl]');

  function render() {
    const items = getCart().filter((i) => catalog.some((p) => p.slug === i.slug));
    $<HTMLElement>('[data-empty]').hidden = items.length > 0;
    $<HTMLElement>('[data-filled]').hidden = items.length === 0;
    lines.replaceChildren();

    let subtotal = 0;
    let discount = 0;
    for (const item of items) {
      const p = catalog.find((c) => c.slug === item.slug)!;
      const base = (p.price ?? 0) * item.qty;
      const d = discountFor(item.qty, p);
      subtotal += base;
      discount += base * d;

      const li = tpl.content.firstElementChild!.cloneNode(true) as HTMLLIElement;
      li.querySelector('.line__name')!.textContent = p.name;
      li.querySelector('.line__meta')!.textContent = d ? `${p.size} · rabat ${Math.round(d * 100)}%` : p.size;
      li.querySelector('.qty__val')!.textContent = String(item.qty);
      li.querySelector('.line__total')!.textContent = p.price === null ? '[CENA]' : pln.format(base * (1 - d));
      li.querySelector('[data-dec]')!.addEventListener('click', () => setQty(p.slug, item.qty - 1));
      li.querySelector('[data-inc]')!.addEventListener('click', () => setQty(p.slug, item.qty + 1));
      li.querySelector('[data-remove]')!.addEventListener('click', () => setQty(p.slug, 0));
      lines.append(li);
    }

    $<HTMLElement>('[data-subtotal]').textContent = pln.format(subtotal);
    $<HTMLElement>('[data-discount]').textContent = discount ? `−${pln.format(discount)}` : pln.format(0);
    $<HTMLElement>('[data-total]').textContent = pln.format(subtotal - discount);
  }

  render();
  onCartChange(render);
  })();
</script>

<style>
  .cart-notice { padding: 14px 18px; background: #FFF4D6; color: #7A4B00; }
  .cart-notice[hidden] { display: none; }
  .cart-page { display: flex; flex-direction: column; gap: var(--s-4); }
  .empty { display: flex; flex-direction: column; align-items: flex-start; gap: var(--s-2); }
  .cart-layout { display: flex; flex-wrap: wrap; gap: var(--s-3); align-items: flex-start; }
  .cart-layout[hidden], .empty[hidden] { display: none; }

  .lines { flex: 999 1 560px; min-width: 0; list-style: none; margin: 0; padding: 0; box-shadow: inset 0 0 0 1px var(--c-gray-400); }
  :global(.line) { display: flex; flex-wrap: wrap; align-items: center; gap: 16px 24px; padding: var(--s-2); border-bottom: 1px solid var(--c-gray-400); }
  :global(.line:last-child) { border-bottom: 0; }
  :global(.line__img) { width: 72px; height: 72px; padding: 4px; background: var(--c-gray-200); font-size: 0.6875rem; }
  :global(.line__info) { flex: 1 1 200px; display: flex; flex-direction: column; gap: 4px; }
  :global(.line__name) { font-size: 1.125rem; }
  :global(.line__meta) { font-size: var(--fs-small); }
  :global(.qty) { display: flex; align-items: center; gap: 4px; border-radius: var(--r-pill); box-shadow: inset 0 0 0 1px var(--c-gray-300); }
  :global(.qty__btn) { width: 44px; height: 44px; border: 0; background: transparent; font: inherit; font-size: 1.25rem; cursor: pointer; border-radius: var(--r-pill); }
  :global(.qty__val) { min-width: 24px; text-align: center; }
  :global(.line__total) { min-width: 110px; text-align: right; font-size: 1.125rem; }
  :global(.line__remove) { border: 0; background: transparent; padding: 12px 0; font: inherit; font-size: var(--fs-small); color: var(--c-link); text-decoration: underline; cursor: pointer; }

  .summary { flex: 1 1 340px; padding: var(--s-3); background: var(--c-gray-100); display: flex; flex-direction: column; gap: var(--s-2); }
  .summary h2 { font-size: var(--fs-h4); font-weight: 400; }
  .summary dl { margin: 0; display: flex; flex-direction: column; gap: 12px; }
  .summary dl div { display: flex; justify-content: space-between; gap: 12px; }
  .summary dd { margin: 0; }
  .summary .total { padding-top: 12px; border-top: 1px solid var(--c-ink-10); font-size: var(--fs-h4); }
  .ok { color: var(--c-ok); }
  .note { font-size: 0.8125rem; }
</style>
