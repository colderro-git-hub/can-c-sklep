# Skopiuj ten plik jako .dev.vars (NIE wysyłaj .dev.vars do GitHuba).
# Te same nazwy dodaj w Cloudflare: Worker can-c → Settings → Variables and Secrets (typ Secret).

# Formularz kontaktowy i e-maile
TURNSTILE_SECRET=1x0000000000000000000000000000000AA
RESEND_API_KEY=re_TWOJ_KLUCZ
CONTACT_FROM=Can-C <onboarding@resend.dev>
